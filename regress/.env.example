# Midscene 模型配置（https://midscenejs.com/model-provider）
# 方式一：本机 Codex CLI（已登录 ChatGPT 账号），无需 API key
MIDSCENE_MODEL_BASE_URL=codex://app-server
MIDSCENE_MODEL_NAME=gpt-6.1-sol
MIDSCENE_MODEL_FAMILY=gpt-6

# 方式二：OpenAI 兼容接口
# MIDSCENE_MODEL_BASE_URL=https://...
# MIDSCENE_MODEL_NAME=...
# MIDSCENE_MODEL_FAMILY=gpt-6
# MIDSCENE_MODEL_API_KEY=...

# 调试时打开有头浏览器
# REGRESS_HEADED=1
