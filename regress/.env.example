# Midscene 模型配置。regress/.env 中的 MIDSCENE_* 会覆盖 shell 中的同名变量。

# 推荐：本机 sub2api（docker，127.0.0.1:8080，分组 codex）
# key 取 sub2api 后台 codex 分组下的 API Key（如 codex-local）
MIDSCENE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
MIDSCENE_MODEL_NAME=gpt-6.1-sol
MIDSCENE_MODEL_FAMILY=gpt-6
MIDSCENE_MODEL_API_KEY=sk-...
# 关闭推理：gpt-6 降为 low，单步约 15s（默认 medium 约 100s）
MIDSCENE_MODEL_REASONING_ENABLED=false
# sub2api 槽位满时请求会排队，超时不能太短，否则排队中的请求被取消后重试只会继续排队
MIDSCENE_MODEL_TIMEOUT=180000
MIDSCENE_MODEL_RETRY_COUNT=2
MIDSCENE_MODEL_RETRY_INTERVAL=500

# 备选：本机 Codex CLI（ChatGPT 账号登录），无需 API key
# MIDSCENE_MODEL_BASE_URL=codex://app-server

# 判定理由与思考过程的语言，默认 Chinese，可改为 English
# MIDSCENE_PREFERRED_LANGUAGE=Chinese

# 调试时打开有头浏览器
# REGRESS_HEADED=1

# 并行用例数（默认 10）。实际吞吐受 sub2api 中能服务该模型的账号并发之和限制，超出的请求会在网关排队
REGRESS_CONCURRENCY=10

# Midscene 缓存（默认关闭）：read-write / read-only / write-only，缓存在 regress/.cache/midscene/<env>/，见 README「缓存」
# REGRESS_CACHE=read-write
