-4c6e-bbc3-73ad06759b67","title":"🟡【P2】一次勾选大量文件"},{"parent":"c9372c62-6748-4df2-b984-6a19c350ea1d","callout":[],"children":[{"parent":"241fdf26-9e67-4613-baf6-7519bbf88de6","callout":[],"children":[],"id":"19425987-e3a0-4bb0-8598-5a65be828baf","title":"前置：引用面板已打开"},{"parent":"241fdf26-9e67-4613-baf6-7519bbf88de6","callout":[],"children":[],"id":"d390774d-a9a4-41a1-b69a-d4ad183e3ba3","title":"操作：同时勾选多个文件类型"},{"parent":"241fdf26-9e67-4613-baf6-7519bbf88de6","callout":[],"children":[],"id":"d477bf92-bfed-444a-bef4-4ab3efb2cf9f","title":"预期：结果为所选类型的并集，数量与实际一致，取消勾选后结果同步更新"}],"collapsed":true,"id":"241fdf26-9e67-4613-baf6-7519bbf88de6","title":"🟡【P2】同时选择多个类型筛选"}],"collapsed":true,"id":"c9372c62-6748-4df2-b984-6a19c350ea1d","title":"边界场景"}],"collapsed":true,"id":"26fc0a4a-1da2-444d-87f3-7a39f300f804","title":"引用空间文件"},{"parent":"b964a26c-6f57-4ae1-a20a-7eac9d159534","callout":[],"lineStyle":{},"children":[{"parent":"0293951e-0cd9-4794-9c02-fd1c7eebd533","callout":[],"children":[{"parent":"e2a4c4cd-442c-49be-b349-1c929f8b41ae","callout":[],"children":[{"parent":"4c1cb1b6-2f74-43ab-996c-6eabd8873c7d","callout":[],"children":[],"id":"26d7359e-b807-4135-b2e1-9429024a31cb","title":"前置：前置：成员 A 与成员 B 均使用过 Codex 与 Claude Code；角色：房间成员；入口：来源筛选"},{"parent":"4c1cb1b6-2f74-43ab-996c-6eabd8873c7d","callout":[],"children":[],"id":"86bfe71d-960b-4a48-a7c8-966920cd292d","title":"操作：同时勾选成员 A 与 Codex"},{"parent":"4c1cb1b6-2f74-43ab-996c-6eabd8873c7d","callout":[],"children":[],"id":"bbe506bd-c7ff-41e1-923f-c64e4ae66f93","title":"预期：列表只展示成员 A 使用 Codex 产生的文件；成员 A 使用其他 Agent 的文件与其他成员使用 Codex 的文件均不展示；结果为两个条件的交集"}],"collapsed":true,"id":"4c1cb1b6-2f74-43ab-996c-6eabd8873c7d","title":"🟠【P1】成员与智能体组合筛选"},{"parent":"e2a4c4cd-442c-49be-b349-1c929f8b41ae","callout":[],"children":[{"parent":"de40d2cf-de6c-489b-b682-c718ce870fa0","callout":[],"children":[],"id":"f7eee843-07dc-4ad9-a656-927956edb5b0","title":"前置：前置：房间内多名成员的 Agent 都产生过文件；角色：房间成员；入口：工作区引用面板来源筛选"},{"parent":"de40d2cf-de6c-489b-b682-c718ce870fa0","callout":[],"children":[],"id":"9084648a-1126-4c9b-b404-e7f496bd5562","title":"操作：只勾选成员 A"},{"parent":"de40d2cf-de6c-489b-b682-c718ce870fa0","callout":[],"children":[],"id":"131b8f4f-2b17-4b2d-9464-7c15323d97ca","title":"预期：列表只展示成员 A 使用 Agent 产生的文件与文件夹；其他成员产生的文件不展示；取消筛选后完整列表恢复"}],"collapsed":true,"id":"de40d2cf-de6c-489b-b682-c718ce870fa0","title":"🟠【P1】按成员筛选文件"},{"parent":"e2a4c4cd-442c-49be-b349-1c929f8b41ae","callout":[],"children":[{"parent":"5abde511-f548-4ef5-9600-4e73be1f621e","callout":[],"children":[],"id":"588e0524-5e79-433b-af23-6683cff280e5","title":"前置：前置：房间内 Claude Code 与 Codex 都产生过文件；角色：房间成员；入口：来源筛选"},{"parent":"5abde511-f548-4ef5-9600-4e73be1f621e","callout":[],"children":[],"id":"0b10290a-0b25-4904-a1fb-fd695405f78b","title":"操作：只勾选 Codex"},{"parent":"5abde511-f548-4ef5-9600-4e73be1f621e","callout":[],"children":[],"id":"2e8fc5a6-c3e5-47d3-8bb0-44e4208dd563","title":"预期：列表只展示 Codex 产生的文件与文件夹；Claude Code 产生的文件不展示；筛选条件在切换目录后仍保持"}],"collapsed":true,"id":"5abde511-f548-4ef5-9600-4e73be1f621e","title":"🟠【P1】按智能体筛选文件"}],"collapsed":true,"id":"e2a4c4cd-442c-49be-b349-1c929f8b41ae","title":"正常场景（3）"},{"parent":"0293951e-0cd9-4794-9c02-fd1c7eebd533","callout":[],"children":[{"parent":"36465091-4670-491f-8d95-eb476a07018b","callout":[],"children":[{"parent":"43a0ae0d-4486-44c6-aad1-03cb516506ec","callout":[],"children":[],"id":"32bbc59b-2ef9-4904-a607-f9edc71410de","title":"前置：引用面板已打开"},{"parent":"43a0ae0d-4486-44c6-aad1-03cb516506ec","callout":[],"children":[],"id":"d986e20c-0299-47e0-aacd-9e501ac924a1","title":"操作：选择一个当前无任何文件的来源"},{"parent":"43a0ae0d-4486-44c6-aad1-03cb516506ec","callout":[],"children":[],"id":"bc719128-259e-482b-adcd-b45de7a30380","title":"预期：展示无结果空态提示，不显示持续加载中"}],"collapsed":true,"id":"43a0ae0d-4486-44c6-aad1-03cb516506ec","title":"🟠【P1】筛选后无结果的空态"}],"collapsed":true,"id":"36465091-4670-491f-8d95-eb476a07018b","title":"异常场景（1）"},{"parent":"0293951e-0cd9-4794-9c02-fd1c7eebd533","callout":[],"children":[{"parent":"2b679e1d-1f80-4a51-a7