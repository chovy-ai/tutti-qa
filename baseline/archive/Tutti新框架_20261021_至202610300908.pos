e","callout":[],"children":[],"id":"b186547d-0d0d-4f25-bbff-2844250377dd","title":"预期：打开产物面板，自动定位到该任务"}],"collapsed":true,"id":"baf589cc-ba69-4597-b0ad-587037ad173e","title":"🟠【P1】点击查看产物"},{"parent":"48b38975-f528-48e0-a049-69636ba9d628","callout":[],"children":[{"parent":"9e4d19da-670f-4729-aac0-4a456b3be99d","callout":[],"children":[],"id":"0feeef70-9cff-4752-8ba0-abb1cd9b46b7","title":"操作：面板已展示，点击\"任务\""},{"parent":"9e4d19da-670f-4729-aac0-4a456b3be99d","callout":[],"children":[],"id":"6fd4d5b2-5bd5-4872-bcd3-4dcc306514f9","title":"预期：“任务”分类高亮，显示该房间内的所有任务，默认显示10条记录（按创建时间倒序显示），可点击“展开更多10条\"，最多显示25条记录，在输入框输入对应关键词能搜索到对应任务，只会显示主任务"}],"collapsed":true,"id":"9e4d19da-670f-4729-aac0-4a456b3be99d","title":"🟠【P1】鼠标点击任务分类"}],"collapsed":true,"id":"48b38975-f528-48e0-a049-69636ba9d628","title":"正常场景（5）"},{"parent":"0d064ed2-4dd3-4f0a-8fd3-4c9e5e25d27b","callout":[],"children":[{"parent":"6e8fc156-1bae-48ab-957f-3526f486d617","callout":[],"children":[{"parent":"eb52397f-ce98-460d-ae42-272d5a8ec45f","callout":[],"children":[],"id":"9913bbbe-308c-458f-b55f-2ea50dc34926","title":"前置：前置：房间内存在任务且任务中心已安装；角色：房间成员；入口：@ 面板任务条目"},{"parent":"eb52397f-ce98-460d-ae42-272d5a8ec45f","callout":[],"children":[],"id":"352c5214-3ffc-4ba4-b5c9-a95e835e865d","title":"操作：@ 一个任务并发送，点击会话详情中的任务条目"},{"parent":"eb52397f-ce98-460d-ae42-272d5a8ec45f","callout":[],"children":[],"id":"df26aaa8-560e-45d4-a88b-eb6142e306d1","title":"预期：@ 面板中展示任务条目且 Agent 能识别被 @ 的任务；任务图标按类型正常着色不显示为黑色；点击任务可跳转到任务详情；不提示该应用未安装在工作区中"},{"parent":"eb52397f-ce98-460d-ae42-272d5a8ec45f","callout":[],"children":[],"id":"089eccae-ba85-4501-ac89-bcf5596bd6b8","title":"备注：#25 #241 #243 #134 #350"}],"collapsed":true,"id":"eb52397f-ce98-460d-ae42-272d5a8ec45f","title":"🔴【P0】任务无法识别与跳转"}],"collapsed":true,"id":"6e8fc156-1bae-48ab-957f-3526f486d617","title":"异常场景（1）"},{"parent":"0d064ed2-4dd3-4f0a-8fd3-4c9e5e25d27b","callout":[],"children":[{"parent":"183fe9f7-52b3-4fe5-9c82-512ab29bd809","callout":[],"children":[{"parent":"feecd860-5321-49ed-85a7-692543ef89ac","callout":[],"children":[],"id":"6b256185-23f8-4190-879f-cfb33988ad2b","title":"前置：被引用任务在引用后状态发生变化"},{"parent":"feecd860-5321-49ed-85a7-692543ef89ac","callout":[],"children":[],"id":"02fa7176-4c7b-4b49-a996-56dd64d123ad","title":"操作：查看该任务引用并点击跳转"},{"parent":"feecd860-5321-49ed-85a7-692543ef89ac","callout":[],"children":[],"id":"bf054a20-17b9-4081-8a9f-be4d7cabed7a","title":"预期：引用展示的状态与任务实际状态一致，跳转到正确的任务详情"}],"collapsed":true,"id":"feecd860-5321-49ed-85a7-692543ef89ac","title":"🟡【P2】引用状态已变更的任务"}],"collapsed":true,"id":"183fe9f7-52b3-4fe5-9c82-512ab29bd809","title":"边界场景（1）"}],"collapsed":true,"id":"0d064ed2-4dd3-4f0a-8fd3-4c9e5e25d27b","title":"任务引用"},{"parent":"d107ded5-41f7-4db0-80fd-009465906425","callout":[],"children":[{"parent":"0b94dacc-baf8-4aa4-87c8-7a58390a66c9","callout":[],"children":[{"parent":"ac4c8252-d2f4-4d5e-9307-d02caaff78d5","callout":[],"children":[{"parent":"b5a61aee-6ebf-4524-832e-4d5078a08a39","callout":[],"children":[],"id":"634f3853-0ee3-4d01-b434-ed33679eb593","title":"操作：输入 @ 查看应用列表，从列表选择应用"},{"parent":"b5a61aee-6ebf-4524-832e-4d5078a08a39","callout":[],"children":[],"id":"06fe4a6c-1b27-412b-8278-c73e7d3dc62c","title":"预期：插入 token 成功，发送消息后agent能识别到该应用"}],"collapsed":true,"id":"b5a61aee-6ebf-4524-832e-4d5078a08a39","title":"🟠【P1】引用应用"},{"parent":"ac4c8252-d2f4-4d5e-9307-d02caaff78d5","callout":[],"children":[{"parent":"e948a93f-3f96-4731-bc55-ffcbccd146b8","callout":[],"children":[],"id":"2b04e3cf-0b0e-48ed-820f-b536acc4a1a6","title":"操作：输入\"@ + 应用部分关键词\""},{"parent":"e948a93f-3f96-4731-bc55-ffcbccd146b8","callout":[],"children":[],"id":"6f2d45d0-c3f1-4f2a-a6bf-998aa74a17f8","title":"预期：实时过滤匹配应用；无结果时显示\"暂无应用\"；按方向键可选中；回车确认插入"}],"collapsed":true,"id":"e948a93f-3f96-4731-bc55-ffcbccd146b8","title":"🟠【P1】搜索应用"},{"parent":"ac4c8252-d2f4-4d5e-9307-d02caaff78d5","callout":[],"children":[{"parent":"da2860d3-4465-46d0-a675-e85508bd27f6","callout":[],"children":[],"id":"cbeea1de-e9af-4b2f-bebe-c253401494b7","title":"操作：输入 @ 查看应用列表 ，点击查看产物"},{"parent":"da2860d3-4465-46d0-a675-e85508bd27f6","callout":[],"children":[],"id":"2c4b8a14-d301-4c34-8a77-e9f7f282c9c0","title":"预期：打开产物面板，自动定位到该应用"}],"collapsed":true,"id":"da2860d3-4465-46d0-a675-e85508bd27f6","title":"🟠【P1】点击查看产物"},{"parent":"ac4c8252-d2f4-4d5e-9307-d02caaff78d5","callout":[],"children":[{"parent":"f7271f2e-d8b7-43af-9bdb-c412316dd56b","callout":[],"children":[],"id":"096f44b9-8913-4bb8-a828-83c97918b8a1","title":"操作：面板已展示，点击\"应用\""},{"parent":"f7271f2e-d8b7-43af-9bdb-c412316dd56b","callout":[],"children":[],"id":"4680fd06-cd3f-4624-821b-f5f158e0cc99","title":"预期：“应用”分类高亮，显示所有应用"}],"collapsed":true,"id":"f7271f2e-d8b7-43af-9bdb-c412316dd56b","title":"🟠【P1】鼠标点击应用分类"}],"collapsed":true,"id":"ac4c8252-d2f4-4d5e-9307-d02caaff78d5","title":"正常场景（4）"},{"parent":"0b94dacc-baf8-4aa4-87c8-7a58390a66c9","callout":[],"children":[{"parent":"84d2106c-36e9-4167-87dc-4f7f0ba7369f","callout":[],"children":[{"parent":"9fc4d239-cb98-41ff-baa8-99eca57d4559","callout":[],"children":[],"id":"345b9651-a723-4784-8da1-506f0fce50e4","title":"前置：前置：房间内已安装群聊与相关应用；角色：房间成员；入口：@ 面板应用条目"},{"parent":"9fc4d239-cb98-41ff-baa8-99eca57d4559","callout":[],"children":[],"id":"a9ca8dab-a7e7-4d5f-bf23-ab18759eefcc","title":"操作：依次 @ 群聊与其他应用并发送，再连续 @ 多个应用打开"},{"parent":"9fc4d239-cb98-41ff-baa8-99eca57d4559","callout":[],"children":[],"id":"1072ef83-4424-4edb-b6e9-b7fba7123f9e","title":"预期：发送后各应用图标与其实际类型一致；点击可正常打开对应应用；连续打开多个应用时每个页面展示自身内容，不出现空白或显示上一个应用的页面"},{"parent":"9fc4d239-cb98-41ff-baa8-99eca57d4559","callout":[],"children":[],"id":"acc575fa-bf8e-413b-9883-935e6f57598c","title":"备注：#97 #307 #341 #286"}],"collapsed":true,"id":"9fc4d239-cb98-41ff-baa8-99eca57d4559","title":"🔴【P0】@ 应用图标与打开行为异常"},{"parent":"84d2106c-36e9-4167-87dc-4f7f0ba7369f","callout":[],"children":[{"parent":"119b45c2-7935-472a-a852-74eeb06a12c1","callout":[],"children":[],"id":"7372856b-1886-4718-a8e9-333affbe58f5","title":"前置：前置：房间内已安装相关应用；角色：房间成员；入口：会话输入框"},{"parent":"119b45c2-7935-472a-a852-74eeb06a12c1","callout":[],"children":[],"id":"63523c95-30fd-44f0-ba1e-1fdef87337eb","title":"操作：让 Agent 分别 @ VibeDesign 生成网站、@ AI Doc 生成文档，并让 Agent 提供网页链接后打开"},{"parent":"119b45c2-7935-472a-a852-74eeb06a12c1","callout":[],"children":[],"id":"198c76d5-0ea0-4486-96ce-52cecfbf860a","title":"预期：应用任务在合理时间内完成并返回结果；不出现服务超时或中途意外停止；应用内界面展示自身内容，不被浏览器端口检测界面覆盖"},{"parent":"119b45c2-7935-472a-a852-74eeb06a12c1","callout":[],"children":[],"id":"64dc4e62-b803-466d-b39c-f69fbccb422e","title":"备注：#252 #160 #378"}],"collapsed":true,"id":"119b45c2-7935-472a-a852-74eeb06a12c1","title":"🔴【P0】应用生成内容超时或界面被覆盖"}],"collapsed":true,"id":"84d2106c-36e9-4167-87dc-4f7f0ba7369f","title":"异常场景（2）"},{"parent":"0b94dacc-baf8-4aa4-87c8-7a58390a66c9","callout":[],"children":[{"parent":"fe6628ad-b9fc-4c28-8883-c673430b89eb","callout":[],"children":[{"parent":"e05f0295-5c81-4c07-b869-6ce1c46af18c","callout":[],"children":[],"id":"f195f760-1432-46c3-9567-b01d82e07181","title":"前置：某应用产出内容体量很大"},{"parent":"e05f0295-5c81-4c07-b869-6ce1c46af18c","callout":[],"children":[],"id":"65cfb706-587f-4e03-aab3-3aae7ac54fa4","title":"操作：引用该应用产物并查看"},{"parent":"e05f0295-5c81-4c07-b869-6ce1c46af18c","callout":[],"children":[],"id":"d39f717b-036b-43e2-a0fe-1203fe8a73d5","title":"预期：内容分页或折叠展示，加载不卡死，可查看完整内容"}],"collapsed":true,"id":"e05f0295-5c81-4c07-b869-6ce1c46af18c","title":"🟡【P2】引用体量很大的应用产物"}],"collapsed":true,"id":"fe6628ad-b9fc-4c28-8883-c673430b89eb","title":"边界场景（1）"}],"collapsed":true,"id":"0b94dacc-baf8-4aa4-87c8-7a58390a66c9","title":"应用引用"},{"parent":"d107ded5-41f7-4db0-80fd-009465906425","callout":[],"children":[{"parent":"19ebdfb0-c677-4599-be11-d07a2b8b1fbf","callout":[],"children":[{"parent":"ba3ab31c-8b9c-4808-a41d-220bbea53a17","callout":[],"children":[{"parent":"0dc894a3-3160-43f7-93ae-fc98505b3dca","callout":[],"children":[],"id":"8e9d14f3-0a21-43ca-80c4-478b1716b74f","title":"操作：输入@，选择多个文件/会话/协作者会话/任务"},{"parent":"0dc894a3-3160-43f7-93ae-fc98505b3dca","callout":[],"children":[],"id":"0dc2f39e-bd91-485d-8c68-25e52a6f6c06","title":"预期：插入 token 成功，发送消息后agent能识别到对应的文件/会话/协作者会话/任务"}],"collapsed":true,"id":"0dc894a3-3160-43f7-93ae-fc98505b3dca","title":"🟠【P1】引用多个文件/会话/协作者会话/任务"},{"parent":"ba3ab31c-8b9c-4808-a41d-220bbea53a17","callout":[],"children":[{"parent":"c1155f15-b7b0-4da1-b90a-4cc48a9c7614","callout":[],"children":[],"id":"0e611ca2-971e-48cd-9c9a-2ff8f156ceb3","title":"操作：面板已展示，点击\"会话\""},{"parent":"c1155f15-b7b0-4da1-b90a-4cc48a9c7614","callout":[],"children":[],"id":"88c219b1-054d-46fe-a840-673f7cea1453","title":"预期：“协作”分类高亮，显示协作者和agent的所有会话，默认显示5条记录（什么规则显示），可点击“展开更多{x}条\"显示所有记录"}],"collapsed":true,"id":"c1155f15-b7b0-4da1-b90a-4cc48a9c7614","title":"🟠【P1】鼠标点击协作分类"}],"collapsed":true,"id":"ba3ab31c-8b9c-4808-a41d-220bbea53a17","title":"正常场景（2）"},{"parent":"19ebdfb0-c677-4599-be11-d07a2b8b1fbf","callout":[],"children":[{"parent":"3308c000-2b7c-49e5-9ea5-d595228ec373","callout":[],"children":[{"parent":"f2aab6cd-6614-4fa1-ad74-f0ddaaf1eeb9","callout":[],"children":[],"id":"f5b4181a-a851-4698-b47a-3346d18c1135","title":"前置：某成员已退出房间"},{"parent":"f2aab6cd-6614-4fa1-ad74-f0ddaaf1eeb9","callout":[],"children":[],"id":"ad68606c-6d0a-4acb-a2c0-1197b7e3278b","title":"操作：在 @ 面板中查找并引用该成员"},{"parent":"f2aab6cd-6614-4fa1-ad74-f0ddaaf1eeb9","callout":[],"children":[],"id":"786b18a5-2dd4-4b6b-82eb-d0c5d5847577","title":"预期：该成员不出现在可选列表中，历史引用标记为已退出而非无效跳转"}],"collapsed":true,"id":"f2aab6cd-6614-4fa1-ad74-f0ddaaf1eeb9","title":"🟠【P1】引用已退出房间的成员"}],"collapsed":true,"id":"3308c000-2b7c-49e5-9ea5-d595228ec373","title":"异常场景（1）"},{"parent":"19ebdfb0-c677-4599-be11-d07a2b8b1fbf","callout":[],"children":[{"parent":"3a2aad1b-6efb-4990-9efe-c898e9e2bc1d","callout":[],"children":[{"parent":"f7e0b0b8-917e-4139-84b2-3f78e9159f9b","callout":[],"children":[],"id":"e3d02475-8463-40aa-99e2-975a057d3443","title":"前置：房间内有大量成员"},{"parent":"f7e0b0b8-917e-4139-84b2-3f78e9159f9b","callout":[],"children":[],"id":"058ddac1-680a-4e26-ae3b-c03526f41913","title":"操作：在 @ 面板中按关键词搜索成员"},{"parent":"f7e0b0b8-917e-4139-84b2-3f78e9159f9b","callout":[],"children":[],"id":"3f9f44ff-0904-4efa-bcaa-8f9f3f6a12a9","title":"预期：搜索结果准确及时，列表可滚动查看全部匹配项"}],"collapsed":true,"id":"f7e0b0b8-917e-4139-84b2-3f78e9159f9b","title":"🟡【P2】房间成员数量很多时的搜索"}],"collapsed":true,"id":"3a2aad1b-6efb-4990-9efe-c898e9e2bc1d","title":"边界场景（1）"}],"collapsed":true,"id":"19ebdfb0-c677-4599-be11-d07a2b8b1fbf","title":"协作成员引用"}],"collapsed":true,"id":"d107ded5-41f7-4db0-80fd-009465906425","title":"4.6 组合引用"},{"parent":"c4ef9eaa-cda4-4bc6-ac33-0871edb469d9","callout":[],"children":[{"parent":"bbe35e49-d37c-4322-8786-a8f34cef0cc5","callout":[],"children":[{"parent":"9b3115ec-3944-4e2f-90d8-9787d0f1cb5a","callout":[],"children":[{"parent":"082e2ced-ad3a-4cda-93d9-727b14797d54","callout":[],"children":[{"parent":"de79a863-af17-47f2-8a62-930e931c826c","callout":[],"children":[],"id":"b1c541d2-138e-4272-83d4-305cff471b32","title":"前置：前置：账号未保存过任何提示词；角色：房间成员；入口：输入框提示词按钮"},{"parent":"de79a863-af17-47f2-8a62-930e931c826c","callout":[],"children":[],"id":"69ea5098-c4fc-4a43-843a-55cdff0606e1","title":"操作：点击按钮打开弹窗，点击任一推荐模板并保存"},{"parent":"de79a863-af17-47f2-8a62-930e931c826c","callout":[],"children":[],"id":"71899438-3b90-4f23-9912-2e7e47d74725","title":"预期：弹窗一级面板只展示推荐模板；点击推荐模板唤起新增提示词弹窗且标题与内容已自动填入；点击保存后该提示词填入会话输入框并出现在最近使用列表"}],"collapsed":true,"id":"de79a863-af17-47f2-8a62-930e931c826c","title":"🟠【P1】新用户仅展示推荐模板"},{"parent":"082e2ced-ad3a-4cda-93d9-727b14797d54","callout":[],"children":[{"parent":"b3b18e6c-fdc1-44a8-ba7d-f2178d55ca6c","callout":[],"children":[],"id":"e61c7671-690a-43c5-a989-b11173db0682","title":"前置：前置：账号已保存并使用过至少一个提示词；角色：房间成员；入口：提示词按钮"},{"parent":"b3b18e6c-fdc1-44a8-ba7d-f2178d55ca6c","callout":[],"children":[],"id":"8737d5ce-73aa-43ea-8d59-c2eff29da847","title":"操作：打开弹窗并点击「推荐」进入二级面板"},{"parent":"b3b18e6c-fdc1-44a8-ba7d-f2178d55ca6c","callout":[],"children":[],"id":"ab1ad3f0-963c-41b1-bdd5-df69d40a4c3c","title":"预期：一级面板展示「最近使用的 prompt」；推荐模板收进二级面板；点击推荐可进入二级面板查看推荐提示词模板并可返回一级面板"}],"collapsed":true,"id":"b3b18e6c-fdc1-44a8-ba7d-f2178d55ca6c","title":"🟠【P1】老用户展示最近使用的提示词"}],"collapsed":true,"id":"082e2ced-ad3a-4cda-93d9-727b14797d54","title":"正常场景（2）"},{"parent":"9b3115ec-3944-4e2f-90d8-9787d0f1cb5a","callout":[],"children":[{"parent":"ba992b0a-0c5c-4df8-9655-6607e81add6d","callout":[],"children":[{"parent":"b7a5b975-817b-4f3e-9c85-209f24501ab4","callout":[],"children":[],"id":"dcf36705-9533-4b87-95da-fcb5ff084981","title":"前置：尚未保存任何提示词"},{"parent":"b7a5b975-817b-4f3e-9c85-209f24501ab4","callout":[],"children":[],"id":"f6f7873d-8f28-4073-820f-3ed26bdb8671","title":"操作：打开提示词弹窗"},{"parent":"b7a5b975-817b-4f3e-9c85-209f24501ab4","callout":[],"children":[],"id":"85e58947-0b6a-4f76-a7a8-fea3ac72e47d","title":"预期：展示空态与新增引导，不显示空白面板"}],"collapsed":true,"id":"b7a5b975-817b-4f3e-9c85-209f24501ab4","title":"🟠【P1】无任何提示词时的空态"}],"collapsed":true,"id":"ba992b0a-0c5c-4df8-9655-6607e81add6d","title":"异常场景（1）"},{"parent":"9b3115ec-3944-4e2f-90d8-9787d0f1cb5a","callout":[],"children":[{"parent":"422a6480-569d-4d05-b714-2a0c206fa37b","callout":[],"children":[{"parent":"a815a6a1-e982-4c2d-89a8-a0119b5e79e0","callout":[],"children":[],"id":"9d2040aa-2bb5-44f7-9eda-fd668e3591d0","title":"前置：已保存数十条提示词"},{"parent":"a815a6a1-e982-4c2d-89a8-a0119b5e79e0","callout":[],"children":[],"id":"620281ad-cec7-4679-a5e6-ac04aa4528c7","title":"操作：打开提示词弹窗并滚动查看"},{"parent":"a815a6a1-e982-4c2d-89a8-a0119b5e79e0","callout":[],"children":[],"id":"186a40cc-468d-4659-8888-feb49045c741","title":"预期：列表可滚动，顺序稳定，定位与选择不受数量影响"}],"collapsed":true,"id":"a815a6a1-e982-4c2d-89a8-a0119b5e79e0","title":"🟡【P2】提示词数量很多时的展示"}],"collapsed":true,"id":"422a6480-569d-4d05-b714-2a0c206fa37b","title":"边界场景（1）"}],"collapsed":true,"id":"9b3115ec-3944-4e2f-90d8-9787d0f1cb5a","title":"提示词弹窗展示"},{"parent":"bbe35e49-d37c-4322-8786-a8f34cef0cc5","callout":[],"children":[{"parent":"47727660-416f-401f-9e44-1fd91f995490","callout":[],"children":[{"parent":"6e7480d8-3229-4fe8-a83a-14df5b85e781","callout":[],"children":[{"parent":"9a92152b-2877-4403-a8d2-93350c9bb05f","callout":[],"children":[],"id":"9a0b38c4-edc7-4264-b851-56e8dfd8d444","title":"前置：前置：新增提示词弹窗已填写内容；角色：房间成员；入口：弹窗内取消按钮"},{"parent":"9a92152b-2877-4403-a8d2-93350c9bb05f","callout":[],"children":[],"id":"ffd29ae9-7274-4a7f-8eea-16fa8ffba9d4","title":"操作：点击取消"},{"parent":"9a92152b-2877-4403-a8d2-93350c9bb05f","callout":[],"children":[],"id":"41d6568e-5831-4775-b061-a74b24a9535b","title":"预期：弹窗关闭且不创建提示词；返回一级面板列表条数不变；输入框内容未被修改"}],"collapsed":true,"id":"9a92152b-2877-4403-a8d2-93350c9bb05f","title":"🟠【P1】取消新增提示词"},{"parent":"6e7480d8-3229-4fe8-a83a-14df5b85e781","callout":[],"children":[{"parent":"770a359f-d529-4446-a086-79d6f0c804e1","callout":[],"children":[],"id":"a3473a6d-1c9a-4322-9530-d8029968916c","title":"前置：前置：提示词弹窗已打开；角色：房间成员；入口：弹窗内「新增提示词」"},{"parent":"770a359f-d529-4446-a086-79d6f0c804e1","callout":[],"children":[],"id":"52280452-6c34-47e6-9cb4-4995d674a15a","title":"操作：输入标题与提示词内容后点击保存"},{"parent":"770a359f-d529-4446-a086-79d6f0c804e1","callout":[],"children":[],"id":"7bdb2a3a-5591-4636-8eda-2b5bc1ac6b54","title":"预期：保存成功并关闭新增弹窗；新提示词出现在一级面板列表中；点击该提示词可将内容填入输入框"}],"collapsed":true,"id":"770a359f-d529-4446-a086-79d6f0c804e1","title":"🟠【P1】新增提示词并保存"}],"collapsed":true,"id":"6e7480d8-3229-4fe8-a83a-14df5b85e781","title":"正常场景（2）"},{"parent":"47727660-416f-401f-9e44-1fd91f995490","callout":[],"children":[{"parent":"d6764ae8-27db-465b-b86d-f8e59d6adb8e","callout":[],"children":[{"parent":"fd188589-2868-422a-9bf0-4e5aa6855248","callout":[],"children":[],"id":"2301e460-c84d-4c17-a868-e33bddad3eb8","title":"前置：前置：新增提示词弹窗已打开；角色：房间成员；入口：新增提示词弹窗"},{"parent":"fd188589-2868-422a-9bf0-4e5aa6855248","callout":[],"children":[],"id":"96128f8e-f92e-4994-9f98-36b752435dc8","title":"操作：只填写标题，提示词内容留空后点击保存"},{"parent":"fd188589-2868-422a-9bf0-4e5aa6855248","callout":[],"children":[],"id":"8d94ee5f-6170-419c-9a21-a307ff4e7978","title":"预期：保存按钮不可用或点击后弹出内容必填提示；弹窗保持打开；列表中不新增记录"}],"collapsed":true,"id":"fd188589-2868-422a-9bf0-4e5aa6855248","title":"🟠【P1】不输入提示词内容不可保存"},{"parent":"d6764ae8-27db-465b-b86d-f8e59d6adb8e","callout":[],"children":[{"parent":"5a828f4c-eec4-4ab1-8cdf-9031f8f3f062","callout":[],"children":[],"id":"ebb6c1f0-76ae-4311-861b-e710f6a11a9e","title":"前置：前置：新增提示词弹窗已打开；角色：房间成员；入口：新增提示词弹窗"},{"parent":"5a828f4c-eec4-4ab1-8cdf-9031f8f3f062","callout":[],"children":[],"id":"7f0b830f-d649-4f9b-95c7-188cd4469b3c","title":"操作：只填写提示词内容，标题留空后点击保存"},{"parent":"5a828f4c-eec4-4ab1-8cdf-9031f8f3f062","callout":[],"children":[],"id":"43087428-2328-4dc7-976f-f17ae5ded142","title":"预期：保存按钮不可用或点击后弹出标题必填提示；弹窗保持打开且已输入内容不丢失；列表中不新增记录"}],"collapsed":true,"id":"5a828f4c-eec4-4ab1-8cdf-9031f8f3f062","title":"🟠【P1】不输入标题不可保存"},{"parent":"d6764ae8-27db-465b-b86d-f8e59d6adb8e","callout":[],"children":[{"parent":"a79e41e4-ead1-41db-bef9-1f95046d9da0","callout":[],"children":[],"id":"9ef04a60-0b41-4aac-b6f7-df9160a033a3","title":"前置：已存在同名提示词"},{"parent":"a79e41e4-ead1-41db-bef9-1f95046d9da0","callout":[],"children":[],"id":"6edca43c-f8f2-4e8a-9e00-0ad15b3a77eb","title":"操作：新增一条同名提示词并保存"},{"parent":"a79e41e4-ead1-41db-bef9-1f95046d9da0","callout":[],"children":[],"id":"ff280103-8b98-4853-9412-e15717603824","title":"预期：给出重名提示或允许保存但可区分，不产生无法区分的重复项"}],"collapsed":true,"id":"a79e41e4-ead1-41db-bef9-1f95046d9da0","title":"🟠【P1】新增重名提示词"},{"parent":"d6764ae8-27db-465b-b86d-f8e59d6adb8e","callout":[],"children":[{"parent":"016a1791-936a-4045-a30d-e9f77f922c8a","callout":[],"children":[],"id":"060f1c27-703a-4eb4-817f-18c8a0b660e9","title":"前置：提示词弹窗已打开"},{"parent":"016a1791-936a-4045-a30d-e9f77f922c8a","callout":[],"children":[],"id":"cf115d72-0dc7-44fb-90c9-afbf0fa8b8a2","title":"操作：标题或内容留空后点击保存"},{"parent":"016a1791-936a-4045-a30d-e9f77f922c8a","callout":[],"children":[],"id":"d864d3f9-92c1-407c-b23a-7af81b7d7b59","title":"预期：拦截并提示必填项，不保存出空白条目"}],"collapsed":true,"id":"016a1791-936a-4045-a30d-e9f77f922c8a","title":"🟠【P1】标题或内容为空时保存"}],"collapsed":true,"id":"d6764ae8-27db-465b-b86d-f8e59d6adb8e","title":"异常场景（4）"},{"parent":"47727660-416f-401f-9e44-1fd91f995490","