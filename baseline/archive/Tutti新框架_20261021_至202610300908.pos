0)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"f70ad8ab-a5f8-46b0-807b-da76cf732750","callout":[],"children":[],"id":"63ae8257-b41c-487e-a0e3-656e7db23025","title":"操作：菜单打开后快速点击两项"},{"parent":"f70ad8ab-a5f8-46b0-807b-da76cf732750","callout":[],"children":[],"id":"ed5e22be-582b-4b0e-b4f8-3fc3d0a52ae2","title":"预期：只执行首个有效操作，不同时弹两个流程"}],"collapsed":true,"id":"f70ad8ab-a5f8-46b0-807b-da76cf732750","title":"🟡【P2】快速切换选项","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"93368061-c249-463b-8f78-14645d919e4d","callout":[],"children":[],"id":"1fcebdc4-f90a-44d3-869c-b820ee1ced19","title":"操作：点击项目旁边的+号，选择关联已有项目文件，选择包含中文、空格和特殊字符的目录"},{"parent":"93368061-c249-463b-8f78-14645d919e4d","callout":[],"children":[],"id":"0c4f8e4f-9c21-4049-8ac3-76d25acc72bd","title":"预期：路径正确保存并可打开，会话归属正常"}],"collapsed":true,"id":"93368061-c249-463b-8f78-14645d919e4d","title":"🟡【P2】选择的路径含中文空格","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"a44570fb-8a57-41b8-b65b-0713bbcbd86c","callout":[],"children":[],"id":"26264d21-886d-42a4-8413-0d1a76c51dca","title":"操作：点击项目旁边的+号，选择关联已有项目文件，选择接近系统长度上限的目录"},{"parent":"a44570fb-8a57-41b8-b65b-0713bbcbd86c","callout":[],"children":[],"id":"d1a74a19-d55a-43b8-8688-bcffd6bbca2d","title":"预期：可支持则正确关联，否则给出明确错误"}],"collapsed":true,"id":"a44570fb-8a57-41b8-b65b-0713bbcbd86c","title":"🟡【P2】选择超长路径","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"f48693e6-5087-416d-871a-456579b18ea4","callout":[],"children":[],"id":"1a8efbb2-c481-4ead-81f5-ad038ae3513e","title":"操作：通过侧边栏「+」号 -&gt; 新建项目 入口，输入超过文件系统/产品限制的项目名称"},{"parent":"f48693e6-5087-416d-871a-456579b18ea4","callout":[],"children":[],"id":"2c976518-0761-49c7-b5ef-dd48c86e3db1","title":"预期：两个入口均阻止创建并提示长度限制，输入框不溢出"}],"collapsed":true,"id":"f48693e6-5087-416d-871a-456579b18ea4","title":"🟡【P2】超长项目名称（创建输入阶段）","icons":[{"color":"rgb(248, 87, 103)","name":"other","index":"369"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"9542722c-76ca-473f-abc2-b94605709bdf","callout":[],"children":[],"id":"e5fde787-3e81-45a6-8bfe-579d9b1e09ee","title":"操作：通过侧边栏「+」号 -&gt; 新建项目 入口，创建多个相同时间戳项目"},{"parent":"9542722c-76ca-473f-abc2-b94605709bdf","callout":[],"children":[],"id":"1a9158e5-5585-44c3-8722-300f5a314828","title":"预期：使用稳定次级字段排序，刷新前后顺序一致"}],"collapsed":true,"id":"9542722c-76ca-473f-abc2-b94605709bdf","title":"🟡【P2】相同创建时间","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"3eaf488f-075c-4c4d-8314-71f243b54255","callout":[],"children":[],"id":"f894f270-83c6-4f5e-9af1-5964fc21f1df","title":"操作：通过侧边栏「+」号 -&gt; 新建项目 入口，输入仅空格、换行或首尾带空格的项目名称"},{"parent":"3eaf488f-075c-4c4d-8314-71f243b54255","callout":[],"children":[],"id":"5b433505-deae-44e5-9f51-0c94cfc43646","title":"预期：两个入口行为一致：按产品规则 trim 处理，或按空值禁用创建"}],"collapsed":true,"id":"3eaf488f-075c-4c4d-8314-71f243b54255","title":"🟡【P2】首尾空格与仅空格名称","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"ad257eae-8bf2-42e8-bfe1-88e6baae76a9","callout":[],"children":[],"id":"febcdcbc-97bd-4107-9f39-1fa2dfd454fc","title":"操作：通过侧边栏「+」号 -&gt; 新建项目 入口，输入中文、emoji 混合的项目名称"},{"parent":"ad257eae-8bf2-42e8-bfe1-88e6baae76a9","callout":[],"children":[],"id":"c76e7445-7790-4d1c-8d95-01c7d2c1d563","title":"预期：两个入口均创建成功，项目列表和入口正确显示，不出现乱码"}],"collapsed":true,"id":"ad257eae-8bf2-42e8-bfe1-88e6baae76a9","title":"🟡【P2】中文与 emoji 项目名","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"ac6172c8-1e99-47f3-a485-a7b07e3b6147","callout":[],"children":[],"id":"ac473dc1-860d-4f94-93cd-edd7d35dfdd5","title":"操作：菜单打开时切换应用再返回"},{"parent":"ac6172c8-1e99-47f3-a485-a7b07e3b6147","callout":[],"children":[],"id":"591dd8bd-471e-4c7c-8872-f1a961968ecc","title":"预期：菜单按规则关闭或保持，不能误触发"}],"collapsed":true,"id":"ac6172c8-1e99-47f3-a485-a7b07e3b6147","title":"🟡【P2】窗口失焦","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"36cbed3f-00a5-410d-97b5-98e87f6b8fab","callout":[],"children":[],"id":"666a5838-a6be-4291-a072-1ba8450c782f","title":"操作：放大文本后打开菜单"},{"parent":"36cbed3f-00a5-410d-97b5-98e87f6b8fab","callout":[],"children":[],"id":"478cf914-1822-42d6-bf97-b807764a4c4d","title":"预期：两项文案完整，不重叠或溢出"}],"collapsed":true,"id":"36cbed3f-00a5-410d-97b5-98e87f6b8fab","title":"🟡【P2】200% 文本缩放","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"c701a2ab-4d5a-449f-a720-2711d36e0eda","callout":[],"children":[],"id":"ea92e2f7-244a-411b-8fc5-0487f4aafbfa","title":"操作：列表只有一个项目"},{"parent":"c701a2ab-4d5a-449f-a720-2711d36e0eda","callout":[],"children":[],"id":"b62f047a-72a3-4665-be72-3603bd2a27e5","title":"预期：正常展示首位并可展开、收起和操作"}],"collapsed":true,"id":"c701a2ab-4d5a-449f-a720-2711d36e0eda","title":"🟡【P2】单项目","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"67475a87-e25e-45a9-af5e-5f016cc218ca","callout":[],"children":[],"id":"634e618b-08e0-4fc9-8497-35a53c22cb21","title":"操作：准备 500 个项目并滚动"},{"parent":"67475a87-e25e-45a9-af5e-5f016cc218ca","callout":[],"children":[],"id":"f7010426-08dd-4336-91d3-0a76c8f17b91","title":"预期：分页或虚拟滚动可用，倒序准确且无明显卡顿"}],"collapsed":true,"id":"67475a87-e25e-45a9-af5e-5f016cc218ca","title":"🟡【P2】大量项目"},{"parent":"f4477324-794b-4bdf-a0b9-97368cde37d0","callout":[],"children":[{"parent":"d82f295f-7cb8-409d-8cc1-6ea3ebec4fbd","callout":[],"children":[],"id":"2c67038c-cd98-4e5e-abf7-a2352001222d","title":"操作：不同客户端时区创建项目"},{"parent":"d82f295f-7cb8-409d-8cc1-6ea3ebec4fbd","callout":[],"children":[],"id":"4703f4c6-606b-4597-89d0-48038a3691a9","title":"预期：依据统一时间源排序，不受本地显示时区影响"}],"collapsed":true,"id":"d82f295f-7cb8-409d-8cc1-6ea3ebec4fbd","title":"🟡【P2】跨时区创建"}],"collapsed":true,"id":"f4477324-794b-4bdf-a0b9-97368cde37d0","title":"边界场景"},{"parent":"4b75710a-d85b-48f1-92c9-3d0449868a5b","callout":[],"children":[{"parent":"5bfec0cd-b60b-4faf-b825-e0eedb0f146b","callout":[],"children":[],"id":"02d5202c-9ebc-4551-bfd2-ab085928597e","title":"说明：把已有项目带入当前 Room 的入口，位于左侧「项目」加号菜单第三项。两个渠道：GitHub（公开仓库无需连接账号，私有仓库需授权）与压缩包（仅支持单个 .tar.gz）。本功能点按「点击 → 选择 → 导入 → 查看文件 → 发起会话让 Agent 识别」这一条完整链路组织用例，每个渠道一条主线跑到底，不把进度、归集、识别拆成并列分组重复走流程"},{"parent":"5bfec0cd-b60b-4faf-b825-e0eedb0f146b","callout":[],"children":[{"parent":"20436f68-dd67-4fb4-9e1b-0e15ee564f20","callout":[],"children":[],"id":"386f5bcd-f72a-45ef-8215-68b578dbfa3c","title":"说明：左侧「项目」加号菜单本次由两项变为三项：关联已有项目文件、新建项目、导入到 Tutti。「导入到 Tutti」弹窗并排两张渠道卡片：GitHub 与文件夹。本组只覆盖入口与弹窗层，具体导入流程在下面两个渠道分组里各自跑完整链路"},{"parent":"20436f68-dd67-4fb4-9e1b-0e15ee564f20","callout":[],"children":[{"parent":"8b9a9e3f-3f75-4ed3-9e34-29c6d64630ff","callout":[],"children":[{"parent":"6d1da96d-206f-4d18-94bf-6ea3b4a6b2ea","callout":[],"children":[],"id":"376a2699-a183-45f9-ac95-b3d482780647","title":"前置：已进入某个 Room 的会话页；角色：房间成员；入口：左侧会话区「项目」标题右侧的加号"},{"parent":"6d1da96d-206f-4d18-94bf-6ea3b4a6b2ea","callout":[],"children":[],"id":"c87662ff-766d-42cf-bf5c-5c1b090385a7","title":"操作：点加号展开菜单，点「导入到 Tutti」，再依次点进 GitHub 卡片与压缩包卡片，每次用标题左侧的返回箭头回到渠道选择页"},{"parent":"6d1da96d-206f-4d18-94bf-6ea3b4a6b2ea","callout":[],"children":[],"id":"182f5e26-e935-4595-a542-f1ff5d950893","title":"预期：<br>1) 菜单展示 ｜ 菜单自上而下为关联已有项目文件、新建项目、导入到 Tutti 三项，各带图标，都可点击<br>2) 列表展示 ｜ 弹窗标题为「导入到 Tutti」，副标题为「将已有项目带入当前 Room，选择一个导入渠道。」<br>3) 菜单展示 ｜ 并排两张渠道卡片：GitHub（导入 GitHub 上的公开或私有代码仓库。）与本地文件夹（选择电脑中的项目文件夹，导入后即可在 Tutti 中使用。），整张卡片可点，右侧有箭头。<br>4) 跳转定位 ｜ 点 GitHub 进入「从 GitHub 导入」页，副标题为「粘贴 GitHub HTTPS 或 SSH 地址，或从你的账号选择仓库」，下方有地址输入框与「继续」，并提示「公开仓库无需连接 GitHub 即可导入。」<br>5) 跳转定位 ｜ 点「本地文件夹」进入「导入本地文件夹」页，副标题为「选择电脑中的项目文件夹，导入后即可在 Tutti 中使用。」页面展示当前已选文件夹、项目名称输入框和「更换文件夹」按钮；未选择文件夹时「导入文件夹」按钮禁用，选择后按钮可用。<br>6) 按钮状态 ｜ 两个渠道页的返回箭头都能回到渠道选择页，右上角关闭按钮始终可用"},{"parent":"6d1da96d-206f-4d18-94bf-6ea3b4a6b2ea","callout":[],"children":[],"id":"ffc033ad-f0b6-49b7-80c1-2ba50171127b","title":"备注：左侧「项目」加号菜单本次由两项变为三项：关联已有项目文件、新建项目、导入到 Tutti。「导入到 Tutti」弹窗副标题为「将已有项目带入当前 Room，选择一个导入渠道。」，并排两张渠道卡片：GitHub（导入 GitHub 上的公开或私有代码仓库。）与本地文件夹（选择电脑中的项目文件夹，导入后即可在 Tutti 中使用。），整张卡片可点，右侧有箭头。"}],"collapsed":true,"id":"6d1da96d-206f-4d18-94bf-6ea3b4a6b2ea","title":"🔴【P0】项目菜单新增导入到 Tutti 入口并进入两个渠道","icons":[{"color":"rgb(0, 186, 74)","name":"completion","index":"317"}]}],"collapsed":true,"id":"8b9a9e3f-3f75-4ed3-9e34-29c6d64630ff","title":"正常场景"},{"parent":"20436f68-dd67-4fb4-9e1b-0e15ee564f20","callout":[],"children":[{"parent":"49d2e4d8-4308-4298-9289-946d32e8b107","callout":[],"children":[{"parent":"6f07f8db-a799-4acc-a757-19cc123eb5fb","callout":[],"children":[],"id":"d5c6e4c1-41d6-45df-a8fa-2b5947293a10","title":"前置：角色：房间成员；入口：项目加号菜单与弹窗关闭按钮"},{"parent":"6f07f8db-a799-4acc-a757-19cc123eb5fb","callout":[],"children":[],"id":"f0bf4227-ba35-4db2-8a41-e7a339ec3275","title":"操作：快速连续点击「导入到 Tutti」多次，再在某个渠道页填一半后点关闭，然后重新打开"},{"parent":"6f07f8db-a799-4acc-a757-19cc123eb5fb","callout":[],"children":[],"id":"f3288fb1-3f7b-4839-b035-a9dc71607e36","title":"预期：\n1) 列表展示 ｜ 只打开一个弹窗，不叠加多层，没有遮罩残留\n2) 列表展示 ｜ 没有进行中的导入时重新打开回到渠道选择页\n3) 副作用 ｜ 关闭弹窗不会误触发导入，项目列表与资产里没有新增任何项目"},{"parent":"6f07f8db-a799-4acc-a757-19cc123eb5fb","callout":[],"children":[],"id":"5e0bab96-f673-4805-97ea-d25c0b22e810","title":"备注：左侧「项目」加号菜单本次由两项变为三项：关联已有项目文件、新建项目、导入到 Tutti。「导入到 Tutti」弹窗副标题为「将已有项目带入当前 Room，选择一个导入渠道。」，并排两张渠道卡片：GitHub、文件夹"}],"collapsed":true,"id":"6f07f8db-a799-4acc-a757-19cc123eb5fb","title":"🟡【P2】关闭弹窗与重复点击"},{"parent":"49d2e4d8-4308-4298-9289-946d32e8b107","callout":[],"lineStyle":{},"children":[{"parent":"b4657935-5fdc-47f1-8211-4a7e7ac793c4","callout":[],"children":[],"id":"372f4a70-3618-44a7-af01-b4dd081e8e33","title":"前置：角色：房间成员；入口：导入到 Tutti 弹窗"},{"parent":"b4657935-5fdc-47f1-8211-4a7e7ac793c4","callout":[],"children":[],"id":"0a503c56-c385-4a04-96be-17995af4afc3","title":"操作：先发起一个 GitHub 导入，不等完成再回到渠道选择页发起一个压缩包导入"},{"parent":"b4657935-5fdc-47f1-8211-4a7e7ac793c4","callout":[],"children":[],"id":"6eb38ab3-3074-4dee-abfa-6fa6258e35de","title":"预期：\n1) 列表展示 ｜ 当前导入页同时展示两条任务，各自有独立状态与操作按钮\n2) 导入状态 ｜ 两条任务互不影响，其中一条失败不影响另一条\n3) 按钮状态 ｜ 若产品限制同时只能有一个导入，则第二次发起时给出明确提示，而不是静默覆盖第一条"},{"parent":"b4657935-5fdc-47f1-8211-4a7e7ac793c4","callout":[],"children":[],"id":"50b534fa-0b14-45d1-886d-1088f9d6ff22","title":"备注：左侧「项目」加号菜单本次由两项变为三项：关联已有项目文件、新建项目、导入到 Tutti。「导入到 Tutti」弹窗副标题为「将已有项目带入当前 Room，选择一个导入渠道。」，并排两张渠道卡片：GitHub、压缩包；是否允许并发导入以及并发上限，按产品定义"}],"collapsed":true,"style":{"border-radius":"6px","color":"rgb(255, 255, 255)","background":"rgba(33, 41, 48, 0.25)","text-decoration":"line-through","border-color":"rgb(255, 255, 255)","border-width":"0px","border-style":"none"},"id":"b4657935-5fdc-47f1-8211-4a7e7ac793c4","title":"🟡【P2】同时发起多个导入"},{"parent":"49d2e4d8-4308-4298-9289-946d32e8b107","callout":[],"children":[{"parent":"9ece26cb-190d-4c8f-b8ea-67eb7596ce07","callout":[],"children":[],"id":"88e0eb27-cd55-46fa-8c6a-8b4da22190ea","title":"前置：成员 A 与成员 B 在同一 Room；角色：两名房间成员；入口：各自的导入弹窗"},{"parent":"9ece26cb-190d-4c8f-b8ea-67eb7596ce07","callout":[],"children":[],"id":"83a0c547-45f4-45d6-a6d4-f90e0e3f599c","title":"操作：A 与 B 几乎同时用同一个项目名称发起导入，完成后双方查看项目列表与资产"},{"parent":"9ece26cb-190d-4c8f-b8ea-67eb7596ce07","callout":[],"children":[],"id":"12b1115e-10ab-4692-bea2-904e7db96289","title":"预期：\n1) 导入状态 ｜ 只有一个成功，另一个收到「项目名称已被占用，请换一个名称。」\n2) 列表展示 ｜ 项目列表与资产 → 全部文件里只有一个该名称的项目\n3) 副作用 ｜ 两次导入的文件没有互相覆盖，成功那一份内容完整"},{"parent":"9ece26cb-190d-4c8f-b8ea-67eb7596ce07","callout":[],"children":[],"id":"5ba33de4-294f-486d-8266-462be3ec756c","title":"备注：左侧「项目」加号菜单本次由两项变为三项：关联已有项目文件、新建项目、导入到 Tutti。「导入到 Tutti」弹窗副标题为「将已有项目带入当前 Room，选择一个导入渠道。」，并排两张渠道卡片：GitHub、文件夹"}],"collapsed":true,"id":"9ece26cb-190d-4c8f-b8ea-67eb7596ce07","title":"🟠【P1】两名成员同时导入同名项目","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"49d2e4d8-4308-4298-9289-946d32e8b107","title":"异常场景"},{"parent":"20436f68-dd67-4fb4-9e1b-0e15ee564f20","callout":[],"children":[{"parent":"0d40dec0-684a-4489-9e61-7669f66e2de3","callout":[],"children":[{"parent":"48a5b396-a27f-4ba3-9771-40600f6a9751","callout":[],"children":[],"id":"b1a6863f-af7b-4bbb-8dd8-e10881645085","title":"前置：导入到 Tutti 弹窗已打开；角色：房间成员；入口：渠道选择页与两个渠道页"},{"parent":"48a5b396-a27f-4ba3-9771-40600f6a9751","callout":[],"children":[],"id":"0b506074-fe21-4a40-b0a9-999776e6d0bf","title":"操作：把浏览器窗口收窄到最小可用宽度，再把系统文本缩放调到 200%，逐页查看"},{"parent":"48a5b396-a27f-4ba3-9771-40600f6a9751","callout":[],"children":[],"id":"399666b5-39c1-4866-b902-2b92cafff8ea","title":"预期：\n1) 视觉展示 ｜ 两张卡片自适应换行或等比缩放，标题与描述不截断到不可读，右侧箭头不重叠\n2) 视觉展示 ｜ 渠道页内的输入框、拖拽区与按钮都完整可见，弹窗不出现内容溢出\n3) 按钮状态 ｜ 关闭与返回按钮在两种情况下都可见可点"},{"parent":"48a5b396-a27f-4ba3-9771-40600f6a9751","callout":[],"children":[],"id":"0e83681a-7572-4ee8-b639-e1833bdacb9c","title":"备注：左侧「项目」加号菜单本次由两项变为三项：关联已有项目文件、新建项目、导入到 Tutti。「导入到 Tutti」弹窗副标题为「将已有项目带入当前 Room，选择一个导入渠道。」，并排两张渠道卡片：GitHub、文件夹"}],"collapsed":true,"id":"48a5b396-a27f-4ba3-9771-40600f6a9751","title":"🟡【P2】窄窗口与文本缩放下的弹窗","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"0d40dec0-684a-4489-9e61-7669f66e2de3","callout":[],"children":[{"parent":"a890301e-aacf-40e8-9a44-e2163bb3ff48","callout":[],"children":[],"id":"6f53f9a8-d95d-42e4-be36-8edcfd98b3b2","title":"前置：上一次导入已完成；角色：房间成员；入口：项目加号菜单"},{"parent":"a890301e-aacf-40e8-9a44-e2163bb3ff48","callout":[],"children":[],"id":"f6e62846-2a4e-4491-89af-99ee12753259","title":"操作：再次打开「导入到 Tutti」"},{"parent":"a890301e-aacf-40e8-9a44-e2163bb3ff48","callout":[],"children":[],"id":"d3ec40af-cd5d-4285-8dab-00c431906a0d","title":"预期：\n1) 列表展示 ｜ 已完成的任务按产品定义保留一段时间或不再展示，若保留则状态仍为「导入完成」且「打开项目」可用\n2) 导入状态 ｜ 不出现已完成任务又变回等待导入的情况"},{"parent":"a890301e-aacf-40e8-9a44-e2163bb3ff48","callout":[],"children":[],"id":"16bc2e8b-c60e-4fc3-825c-7f19db54c8d1","title":"备注：左侧「项目」加号菜单本次由两项变为三项：关联已有项目文件、新建项目、导入到 Tutti。「导入到 Tutti」弹窗副标题为「将已有项目带入当前 Room，选择一个导入渠道。」，并排两张渠道卡片：GitHub、文件夹；已完成任务在弹窗中的保留时长，按产品定义"}],"collapsed":true,"id":"a890301e-aacf-40e8-9a44-e2163bb3ff48","title":"🟡【P2】导入完成后再次打开弹窗","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"0d40dec0-684a-4489-9e61-7669f66e2de3","title":"边界场景"}],"collapsed":true,"id":"20436f68-dd67-4fb4-9e1b-0e15ee564f20","title":"导入入口与渠道选择"},{"parent":"5bfec0cd-b60b-4faf-b825-e0eedb0f146b","callout":[],"children":[{"parent":"e2795b6e-9e0a-4a03-9190-e79efce5260b","callout":[],"children":[],"id":"88064510-b10d-459b-a14f-62164d552fa3","title":"说明：按完整链路组织，不拆分组：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑到底"},{"parent":"e2795b6e-9e0a-4a03-9190-e79efce5260b","callout":[],"children":[{"parent":"9587395f-5ecf-430d-bf46-c3775bcbfa09","callout":[],"children":[{"parent":"e82f03dd-5a29-491f-b47c-7485cec5e4b2","callout":[],"children":[],"id":"f8916ba6-ac1e-4664-9dc1-b620178516ea","title":"前置：未连接 GitHub 账号；准备公开仓库 https://github.com/anthropics/skills；房间内另有一名成员 B；角色：房间成员 A；入口：项目加号菜单 → 导入到 Tutti → GitHub"},{"parent":"e82f03dd-5a29-491f-b47c-7485cec5e4b2","callout":[],"children":[],"id":"dc549287-3568-446c-b9d6-4c6c18253399","title":"操作：粘贴地址点「继续」，在确认页核对信息后点「导入仓库」，停留观察进度直到完成，点「打开项目」，再依次查看项目文件树、资产 → 全部文件、我的资产 → 我上传的，让 B 也查看一遍，最后在该项目下新建会话提问项目内容"},{"parent":"e82f03dd-5a29-491f-b47c-7485cec5e4b2","callout":[],"children":[],"id":"38947482-32f1-4adb-837a-3654a57bce08","title":"预期：\n1) 结果校验 ｜ 未连接 GitHub 也能解析成功，不弹授权页\n2) 列表展示 ｜ 确认页展示仓库 anthropics/skills 与「分支：main」，右侧有「更换」\n3) 输入框 ｜ 项目名称自动填充为仓库名 skills\n4) 提示文案 ｜ 确认页说明为「导入到当前 Room，Room 内所有成员均可访问代码。包含默认分支、完整历史及支持的 GitHub 子模块，暂不支持下载 LFS 文件」\n5) 导入状态 ｜ 点「导入仓库」后切到「当前导入」页，任务展示项目名称与 owner/repo 两行，右侧为带转圈的「等待导入」，下方有「取消导入」\n6) 提示文案 ｜ 页面顶部为「关闭弹窗后导入仍会继续。再次打开\"导入到 Tutti\"可查看进度。」\n7) 导入状态 ｜ 任务卡片状态由「等待导入」推进到「导入完成」，转圈消失，「取消导入」替换为「打开项目」\n8) 跳转定位 ｜ 点「打开项目」弹窗关闭并定位到该项目，左侧项目列表中该项目被选中\n9) 目录导航 ｜ 右侧文件区展示 该仓库 的完整目录结构，层级与来源一致，最深层文件可展开可打开\n10) 列表展示 ｜ 打开资产 → 全部文件，room 下出现与项目同名的文件夹，修改时间为本次导入时间，展开内容与项目文件树一致\n11) 可见范围 ｜ 打开我的资产 → 我上传的，翻页与搜索都找不到本次导入的项目与其中任何文件；同一账号手动上传的文件仍正常出现在该处\n12) 权限授权 ｜ 房间内另一名成员无需额外授权即可在项目列表与资产 → 全部文件中看到并打开该项目，且其「我上传的」下同样没有\n13) 上下文 ｜ 在该项目下新建会话，发送「这个项目下有哪些文件」，Agent 无需手动引用即可列出与文件树一致的清单\n14) 结果校验 ｜ 让 Agent 打开项目内某个已知文件并复述其中一段，内容与文件实际内容一致，不混入其他项目的文件\n15) 结果校验 ｜ 项目工作区内容对应仓库的默认分支，提交历史完整，支持的子模块目录有内容而不是空目录"},{"parent":"e82f03dd-5a29-491f-b47c-7485cec5e4b2","callout":[],"children":[],"id":"3fae8fb1-fa1a-40c3-8475-dd5e353e6cf6","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"e82f03dd-5a29-491f-b47c-7485cec5e4b2","title":"🔴【P0】公开仓库粘贴地址导入 · 全链路","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"9587395f-5ecf-430d-bf46-c3775bcbfa09","callout":[],"children":[{"parent":"6a138963-7208-47c5-b393-a3c528c60e1f","callout":[],"children":[],"id":"551319ff-7526-43dd-8065-406f6ae3fdc0","title":"前置：未连接 GitHub 账号；账号下有可访问的私有仓库；角色：房间成员；入口：从 GitHub 导入页的「连接 GitHub」"},{"parent":"6a138963-7208-47c5-b393-a3c528c60e1f","callout":[],"children":[],"id":"9cf36637-ab04-4e10-ac8a-802c6501737f","title":"操作：点「连接 GitHub」完成授权，回来后在仓库列表里选一个私有仓库，确认页改一个项目名称后点「导入仓库」，等完成后打开项目并走完资产与会话校验"},{"parent":"6a138963-7208-47c5-b393-a3c528c60e1f","callout":[],"children":[],"id":"012cff6a-4613-456f-b455-1117dca7d18f","title":"预期：\n1) 跳转定位 ｜ 跳转到 GitHub 授权页，标题为 Tutti is requesting additional permissions，应用展示为 Tutti by tutti-lab，授权完成后回到原来的导入弹窗\n2) 绑定授权 ｜ 回来后区块变为已连接态，展示 GitHub 账号名与「断开连接 / 切换账号」\n3) 列表展示 ｜ 下方出现搜索框与仓库列表，每行展示 owner/repo，私有仓库右侧有锁图标与「私有」，只出现我有权访问的仓库\n4) 跳转定位 ｜ 点列表中的私有仓库进入确认页，仓库卡片展示该仓库与默认分支，项目名称默认取仓库名\n5) 归属与顺序 ｜ 在确认页改过名称后，最终生成的项目名以输入框里的名称为准，不是仓库名\n6) 导入状态 ｜ 任务卡片状态由「等待导入」推进到「导入完成」，转圈消失，「取消导入」替换为「打开项目」\n7) 跳转定位 ｜ 点「打开项目」弹窗关闭并定位到该项目，左侧项目列表中该项目被选中\n8) 目录导航 ｜ 右侧文件区展示 该私有仓库 的完整目录结构，层级与来源一致，最深层文件可展开可打开\n9) 列表展示 ｜ 打开资产 → 全部文件，room 下出现与项目同名的文件夹，修改时间为本次导入时间，展开内容与项目文件树一致\n10) 可见范围 ｜ 打开我的资产 → 我上传的，翻页与搜索都找不到本次导入的项目与其中任何文件；同一账号手动上传的文件仍正常出现在该处\n11) 权限授权 ｜ 房间内另一名成员无需额外授权即可在项目列表与资产 → 全部文件中看到并打开该项目，且其「我上传的」下同样没有\n12) 上下文 ｜ 在该项目下新建会话，发送「这个项目下有哪些文件」，Agent 无需手动引用即可列出与文件树一致的清单\n13) 结果校验 ｜ 让 Agent 打开项目内某个已知文件并复述其中一段，内容与文件实际内容一致，不混入其他项目的文件\n14) 等价性 ｜ 除来源是列表选择外，链路上的每一步与粘贴地址方式完全一致"},{"parent":"6a138963-7208-47c5-b393-a3c528c60e1f","callout":[],"children":[],"id":"a2e13569-a106-4bb4-adf1-17c4b0dae843","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"6a138963-7208-47c5-b393-a3c528c60e1f","title":"🔴【P0】连接账号后从仓库列表选私有仓库导入 · 全链路","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"9587395f-5ecf-430d-bf46-c3775bcbfa09","callout":[],"children":[{"parent":"7a897ad0-2fa3-401f-aeb2-30bc46e80d0e","callout":[],"children":[],"id":"1fd01255-d066-48f6-a26f-bb2661d6e343","title":"前置：准备同一仓库的 SSH 地址如 git@github.com:anthropics/skills.git；角色：房间成员；入口：GitHub 仓库地址输入框"},{"parent":"7a897ad0-2fa3-401f-aeb2-30bc46e80d0e","callout":[],"children":[],"id":"9fab3371-51ae-4c6b-8221-9018b0ce5b0b","title":"操作：粘贴 SSH 地址走完整条链路，与用 HTTPS 地址导入的结果逐项对照"},{"parent":"7a897ad0-2fa3-401f-aeb2-30bc46e80d0e","callout":[],"children":[],"id":"89da589d-3195-4366-baa4-2727aa78acb8","title":"预期：\n1) 结果校验 ｜ SSH 与 HTTPS 解析到同一个仓库，进入同一个确认页\n2) 等价性 ｜ 从确认页到打开项目、目录结构、资产归集、Agent 识别，每一步与 HTTPS 方式一致\n3) 可见范围 ｜ 同样不出现在我的资产 → 我上传的下"},{"parent":"7a897ad0-2fa3-401f-aeb2-30bc46e80d0e","callout":[],"children":[],"id":"1933218c-d274-4ec7-bf32-c0fce8f98204","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"7a897ad0-2fa3-401f-aeb2-30bc46e80d0e","title":"🟠【P1】SSH 地址导入 · 等价性抽检","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"9587395f-5ecf-430d-bf46-c3775bcbfa09","callout":[],"children":[{"parent":"62488787-3dfd-42e1-a08d-6d129a70a9c8","callout":[],"children":[],"id":"0e54ee66-54e9-43d8-ab25-9c4907b86ebe","title":"前置：已跳到 GitHub 授权页；角色：房间成员；入口：GitHub 授权页"},{"parent":"62488787-3dfd-42e1-a08d-6d129a70a9c8","callout":[],"children":[],"id":"59376d69-c6d4-401b-a4ee-8e3488b26e6d","title":"操作：逐项核对授权页内容后同意授权"},{"parent":"62488787-3dfd-42e1-a08d-6d129a70a9c8","callout":[],"children":[],"id":"3757ea60-a910-4109-b598-6c936a6aaad1","title":"预期：\n1) 权限授权 ｜ Repositories 一项为 Public and private，private 被高亮标出\n2) 列表展示 ｜ Existing access 下为 Read all user profile data 与 Access user email addresses (read-only)，各带勾\n3) 列表展示 ｜ Organization access 下逐个列出我所在的组织，已授权的带勾，未授权的带叉并在右侧提供 Request 按钮\n4) 绑定授权 ｜ 同意后回到导入弹窗，仓库列表中包含个人仓库与已授权组织下的仓库"},{"parent":"62488787-3dfd-42e1-a08d-6d129a70a9c8","callout":[],"children":[],"id":"f5c285bc-8398-415f-9156-5e82b41a451b","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"62488787-3dfd-42e1-a08d-6d129a70a9c8","title":"🟠【P1】授权页的权限项与组织授权","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"9587395f-5ecf-430d-bf46-c3775bcbfa09","callout":[],"children":[{"parent":"a0c9a0a7-dcc9-4c9a-946d-f628a0cbacec","callout":[],"children":[],"id":"b2425fa2-bf7b-4232-b987-a6954da65875","title":"前置：已发起一次 GitHub 导入；角色：房间成员；入口：弹窗关闭按钮与项目加号菜单"},{"parent":"a0c9a0a7-dcc9-4c9a-946d-f628a0cbacec","callout":[],"children":[],"id":"9c6e634b-6c24-4a60-b8c3-33926a9ba519","title":"操作：导入进行中关掉弹窗，去做别的操作再刷新一次页面，然后重新打开「导入到 Tutti」，等完成后打开项目并校验"},{"parent":"a0c9a0a7-dcc9-4c9a-946d-f628a0cbacec","callout":[],"children":[],"id":"b219fa3b-a8c3-4588-9fbc-01a9230176b8","title":"预期：\n1) 导入状态 ｜ 重新打开后直接进入「当前导入」页展示同一条任务与最新进度，而不是回到渠道选择页\n2) 持久化 ｜ 关闭弹窗与刷新页面期间导入都在服务端继续推进，进度不回退也不重来\n3) 跳转定位 ｜ 完成后「打开项目」可用，项目内容完整\n4) 列表展示 ｜ 资产 → 全部文件中出现该项目，我的资产 → 我上传的下没有"},{"parent":"a0c9a0a7-dcc9-4c9a-946d-f628a0cbacec","callout":[],"children":[],"id":"fb7b0203-bc11-45d6-97cc-6d38bc1f6214","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"a0c9a0a7-dcc9-4c9a-946d-f628a0cbacec","title":"🟠【P1】关闭弹窗后导入继续并回到进度页","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"9587395f-5ecf-430d-bf46-c3775bcbfa09","callout":[],"children":[{"parent":"f920fb92-0f02-46dc-9214-b202ac53100b","callout":[],"children":[],"id":"e49adccc-ee8e-4302-972f-224de62edad4","title":"前置：已连接 GitHub 且仓库较多；角色：房间成员；入口：仓库列表与确认页"},{"parent":"f920fb92-0f02-46dc-9214-b202ac53100b","callout":[],"children":[],"id":"a4d50ddc-3f2c-48ca-9db7-ceb388992872","title":"操作：搜索一个靠后的仓库并选中，在确认页点「更换」换成另一个仓库，再回到列表点「切换账号」换账号，最后点「断开连接」"},{"parent":"f920fb92-0f02-46dc-9214-b202ac53100b","callout":[],"children":[],"id":"84886c45-f878-42cd-8d85-3223722b1cf3","title":"预期：\n1) 搜索筛选 ｜ 搜索命中未加载出来的仓库，不区分大小写，清空后恢复完整列表，无匹配时展示空状态文案\n2) 跳转定位 ｜ 「更换」回到地址输入与仓库选择页，重新选择后项目名称随新仓库名更新\n3) 绑定授权 ｜ 切换账号后展示新账号名，仓库列表刷新为新账号有权访问的仓库\n4) 绑定授权 ｜ 断开连接后回到未连接态，重新展示「连接 GitHub」，仓库列表清空\n5) 持久化 ｜ 断开连接不影响已经导入完成的项目，已导入的代码仍可正常访问"},{"parent":"f920fb92-0f02-46dc-9214-b202ac53100b","callout":[],"children":[],"id":"5c200300-28d7-47f3-84f1-37ad0bec95f7","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"f920fb92-0f02-46dc-9214-b202ac53100b","title":"🟠【P1】仓库搜索、更换与切换账号","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"9587395f-5ecf-430d-bf46-c3775bcbfa09","title":"正常场景"},{"parent":"e2795b6e-9e0a-4a03-9190-e79efce5260b","callout":[],"children":[{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"2da28272-8e71-40b9-9a92-03b3421ce853","callout":[],"children":[],"id":"170ea075-da37-45ac-9628-82911df9c99d","title":"前置：角色：房间成员；入口：GitHub 仓库地址输入框"},{"parent":"2da28272-8e71-40b9-9a92-03b3421ce853","callout":[],"children":[],"id":"02aa74bb-1f49-496a-9311-1e1a0198a82b","title":"操作：粘贴带 tree 子路径的地址 https://github.com/anthropics/skills/tree/main/skills 点「继续」，看到报错后点「重试」，再改成仓库根地址继续走完导入"},{"parent":"2da28272-8e71-40b9-9a92-03b3421ce853","callout":[],"children":[],"id":"0751cd48-cc97-4ef2-8299-122dfc072188","title":"预期：\n1) 提示文案 ｜ 页面顶部展示红色错误条「请检查 GitHub 仓库地址和项目名称。」，右侧有「重试」\n2) 输入框 ｜ 原地址仍保留在输入框里可直接编辑，不被清空\n3) 副作用 ｜ 不进入确认页，也不产生任何导入任务，项目列表与资产里无残留\n4) 恢复重试 ｜ 不改地址点「重试」仍报同一条错误，不转圈不返回\n5) 结果校验 ｜ 改成仓库根地址后能正常解析并走完导入，错误条消失"},{"parent":"2da28272-8e71-40b9-9a92-03b3421ce853","callout":[],"children":[],"id":"fec71a4e-c2e9-4047-9575-f8ecef117923","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组；带子路径的地址是否自动截取到仓库根，待产品确认，当前按报错写"}],"collapsed":true,"id":"2da28272-8e71-40b9-9a92-03b3421ce853","title":"🟡【P2】地址带子路径时报错并可恢复","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"957fed50-024d-4822-abf6-9854ccf21d69","callout":[],"children":[],"id":"0ed431cf-b85f-4221-93f2-5c082f40725e","title":"前置：Room 内已存在名为 skills 的项目；角色：房间成员；入口：确认页"},{"parent":"957fed50-024d-4822-abf6-9854ccf21d69","callout":[],"children":[],"id":"068bc959-ddd0-4227-93e4-3697cc420b91","title":"操作：保持项目名称为 skills 点「导入仓库」，报错后在原位改成 skills1 点「重试」，等导入完成后查看项目列表"},{"parent":"957fed50-024d-4822-abf6-9854ccf21d69","callout":[],"children":[],"id":"625d82ac-6dc5-4c93-b66d-c9c75b792603","title":"预期：\n1) 提示文案 ｜ 顶部展示红色错误条「项目名称已被占用，请换一个名称。」，右侧有「重试」\n2) 输入框 ｜ 仓库卡片与项目名称输入框都保留，可直接在原位改名\n3) 副作用 ｜ 占用报错时不产生半个项目，项目列表里没有多出 skills 的第二份\n4) 恢复重试 ｜ 改名后重试能走完整条链路，错误条消失\n5) 列表展示 ｜ 最终项目列表与资产中，skills 与 skills1 各一份，内容互不影响"},{"parent":"957fed50-024d-4822-abf6-9854ccf21d69","callout":[],"children":[],"id":"62cec4f0-08fd-437a-b5ef-3da1923e633f","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"957fed50-024d-4822-abf6-9854ccf21d69","title":"🟠【P1】项目名称已被占用","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"2464fe9a-465d-491a-8529-5499191c393f","callout":[],"children":[],"id":"5ca027d1-9237-4d25-817c-c7058471aa98","title":"前置：某条导入任务处于「等待导入」；角色：房间成员；入口：任务卡片上的「取消导入」"},{"parent":"2464fe9a-465d-491a-8529-5499191c393f","callout":[],"children":[],"id":"3036585f-ce88-4d66-9de1-cdfd755b187e","title":"操作：点「取消导入」，随后查看项目列表、资产 → 全部文件与我的资产，再用同一个项目名重新发起导入"},{"parent":"2464fe9a-465d-491a-8529-5499191c393f","callout":[],"children":[],"id":"104b0cde-3279-41ce-a50b-691e24890cf3","title":"预期：\n1) 导入状态 ｜ 任务从列表中移除或转为已取消状态，不再继续推进\n2) 副作用 ｜ 三处都不留下该项目的任何文件，不出现取消后过一会儿又导入成功\n3) 恢复重试 ｜ 用同名重新导入不提示名称被占用，且能正常走完链路"},{"parent":"2464fe9a-465d-491a-8529-5499191c393f","callout":[],"children":[],"id":"453e81c2-437d-463c-ac79-78b2573f9321","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"2464fe9a-465d-491a-8529-5499191c393f","title":"🟠【P1】取消进行中的导入","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"6d6f513e-2982-4d3a-af27-06abd9ee4854","callout":[],"children":[],"id":"5c921692-20b0-47ab-b512-b363b88637c1","title":"前置：正在导入一个私有仓库；角色：房间成员；入口：当前导入页"},{"parent":"6d6f513e-2982-4d3a-af27-06abd9ee4854","callout":[],"children":[],"id":"2b71fae3-d3fe-4726-9984-ff29ba4b7113","title":"操作：导入进行中在 GitHub 侧撤销 Tutti 的授权，观察任务状态，随后检查项目列表与资产"},{"parent":"6d6f513e-2982-4d3a-af27-06abd9ee4854","callout":[],"children":[],"id":"bac01183-bae1-4960-9eb2-198db7b2a754","title":"预期：\n1) 导入状态 ｜ 任务转为失败态并说明原因是无权访问仓库，不停在「等待导入」不动\n2) 副作用 ｜ 不留下一个只有部分文件的项目，项目列表与资产里都没有该项目\n3) 恢复重试 ｜ 重新授权后可以用同名重新发起导入并正常完成"},{"parent":"6d6f513e-2982-4d3a-af27-06abd9ee4854","callout":[],"children":[],"id":"8c0d4fa2-436d-40e1-8d59-84da43ba8fa0","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组；失败态的文案与是否提供重试入口，按产品定义"}],"collapsed":true,"id":"6d6f513e-2982-4d3a-af27-06abd9ee4854","title":"🟠【P1】导入过程中权限被回收"},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"79789872-e4c6-4119-936b-cd212c24864c","callout":[],"children":[],"id":"a7489a4b-04c0-4539-8cc1-d943d349108e","title":"前置：我所在的某个组织在授权页上是未授权状态；角色：房间成员；入口：仓库列表与地址输入框"},{"parent":"79789872-e4c6-4119-936b-cd212c24864c","callout":[],"children":[],"id":"9ff99a87-778f-4811-9171-8da65499f83e","title":"操作：先在搜索框里搜该组织下的仓库，再直接粘贴该组织仓库的地址点「继续」"},{"parent":"79789872-e4c6-4119-936b-cd212c24864c","callout":[],"children":[],"id":"b2116b43-d48d-4873-aca3-b3a69419e35e","title":"预期：\n1) 列表展示 ｜ 仓库列表中不出现未授权组织下的仓库\n2) 提示文案 ｜ 直接粘贴地址时给出无权访问的提示，指向去 GitHub 为该组织授权，而不是笼统的地址错误\n3) 权限授权 ｜ 不出现能进入确认页但导入时才失败的情况"},{"parent":"79789872-e4c6-4119-936b-cd212c24864c","callout":[],"children":[],"id":"2d561850-8e3f-4e17-9c46-ff18c2ee5eaa","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组；未授权组织仓库的提示文案与是否给 Request 入口，按产品定义"}],"collapsed":true,"id":"79789872-e4c6-4119-936b-cd212c24864c","title":"🟠【P1】组织未授权时的仓库不可导入","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"93052661-7fc8-4b0e-92c8-a52a3c00f320","callout":[],"children":[],"id":"127d591c-82ef-4ae4-b5c8-f6e0e29f752a","title":"前置：未连接 GitHub 账号；准备一个自己有权限的私有仓库地址；角色：房间成员；入口：GitHub 仓库地址输入框"},{"parent":"93052661-7fc8-4b0e-92c8-a52a3c00f320","callout":[],"children":[],"id":"5e3b9176-1f50-476e-8d9c-638c4e65a745","title":"操作：粘贴私有仓库地址点「继续」，随后点「连接 GitHub」完成授权再回来继续"},{"parent":"93052661-7fc8-4b0e-92c8-a52a3c00f320","callout":[],"children":[],"id":"a5db1736-3a3f-4a9d-ae74-2a004c89ba43","title":"预期：\n1) 提示文案 ｜ 提示需要连接 GitHub 才能访问私有仓库，或展示统一的地址校验失败提示，不出现无反馈的空白态\n2) 跳转定位 ｜ 「连接 GitHub」是明确的下一步\n3) 恢复重试 ｜ 授权完成回来后该地址可继续，能走完整条链路"},{"parent":"93052661-7fc8-4b0e-92c8-a52a3c00f320","callout":[],"children":[],"id":"c144190b-4c08-45c3-8e81-b9661703315f","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组；私有仓库未授权时的提示文案是否与地址校验失败共用一条，待确认"}],"collapsed":true,"id":"93052661-7fc8-4b0e-92c8-a52a3c00f320","title":"🟡【P2】未连接账号时粘贴私有仓库地址","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"6ee656cf-5708-44cc-adc8-4599d0b09c73","callout":[],"children":[],"id":"b8413117-d483-448f-87a8-90c0b15a086a","title":"前置：角色：房间成员；入口：GitHub 仓库地址输入框"},{"parent":"6ee656cf-5708-44cc-adc8-4599d0b09c73","callout":[],"children":[],"id":"9ec7d71e-981c-4fd7-9a82-ec2d2dd8bfce","title":"操作：依次尝试：不输入直接点「继续」、输入一串乱字符、输入一个 GitLab 地址、输入纯域名 https://github.com、输入一个不存在的仓库地址"},{"parent":"6ee656cf-5708-44cc-adc8-4599d0b09c73","callout":[],"children":[],"id":"31cfeee4-e7e3-41b5-b5d0-e0b52b3ba424","title":"预期：\n1) 按钮状态 ｜ 输入框为空时「继续」禁用，或点击后给出必填提示且不发起请求\n2) 提示文案 ｜ 其余四种都给出「请检查 GitHub 仓库地址和项目名称。」错误条，不出现未捕获错误或页面白屏\n3) 副作用 ｜ 五种情况都不产生导入任务，项目列表与资产无变化"},{"parent":"6ee656cf-5708-44cc-adc8-4599d0b09c73","callout":[],"children":[],"id":"662ef9a2-112b-4b9e-b0fa-6ab4afebc590","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"6ee656cf-5708-44cc-adc8-4599d0b09c73","title":"🟡【P2】非法地址、空地址与仓库不存在","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"4bc8a7d7-8ace-42c4-a402-6cdb27c786be","callout":[],"children":[],"id":"001379c4-af4e-4afb-b693-75f2497e1e80","title":"前置：已进入确认页；角色：房间成员；入口：项目名称输入框"},{"parent":"4bc8a7d7-8ace-42c4-a402-6cdb27c786be","callout":[],"children":[],"id":"19655c84-8707-49f7-a799-6d87f51ec52c","title":"操作：清空项目名称点「导入仓库」，再输入斜杠、冒号等路径非法字符点「导入仓库」"},{"parent":"4bc8a7d7-8ace-42c4-a402-6cdb27c786be","callout":[],"children":[],"id":"09cfcf2c-5f36-4072-b7f0-4c9b3571fecc","title":"预期：\n1) 按钮状态 ｜ 名称为空时「导入仓库」禁用或点击后给出必填提示\n2) 提示文案 ｜ 含非法字符时给出明确的命名规则提示，而不是导入到一半失败\n3) 副作用 ｜ 两种情况都不产生导入任务"},{"parent":"4bc8a7d7-8ace-42c4-a402-6cdb27c786be","callout":[],"children":[],"id":"89ca0cfc-d5c1-4f75-9a5e-815a73816a8b","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组；项目名称的字符集与长度限制按产品定义"}],"collapsed":true,"id":"4bc8a7d7-8ace-42c4-a402-6cdb27c786be","title":"🟡【P2】项目名称为空或含非法字符"},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"dc4f99c3-8fd6-41ff-9a68-ed5cfc46df27","callout":[],"children":[],"id":"d9b3d5b9-6a4c-4e47-8ddd-f386362a31e6","title":"前置：角色：房间成员；入口：GitHub 授权页与从 GitHub 导入页"},{"parent":"dc4f99c3-8fd6-41ff-9a68-ed5cfc46df27","callout":[],"children":[],"id":"e459d399-8a74-4ab5-b7fd-ecc27fd43b86","title":"操作：第一轮在授权页点取消并关闭窗口；第二轮用一个已在 GitHub 侧撤销授权的账号打开导入弹窗；第三轮模拟仓库列表接口失败"},{"parent":"dc4f99c3-8fd6-41ff-9a68-ed5cfc46df27","callout":[],"children":[],"id":"225a54fd-e18c-47f7-8c60-a881a1f3417f","title":"预期：\n1) 绑定授权 ｜ 取消授权后弹窗仍停留在未连接态，不出现连接成功的假象，也不一直转圈，再次点击能重新发起\n2) 绑定授权 ｜ 授权已失效时识别出来并回到未连接态或给出重新连接提示，不展示一份拉不动的旧仓库列表\n3) 提示文案 ｜ 列表加载失败时展示失败与重试入口，不展示空列表让人误以为没有仓库\n4) 恢复重试 ｜ 三种情况都能通过重试或重新连接恢复"},{"parent":"dc4f99c3-8fd6-41ff-9a68-ed5cfc46df27","callout":[],"children":[],"id":"c70523ba-d564-4aba-9276-42942b0bac37","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"dc4f99c3-8fd6-41ff-9a68-ed5cfc46df27","title":"🟡【P2】授权中途取消、授权过期与列表加载失败","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"e414a00e-8450-46ec-98b9-afd1f5036dba","callout":[],"children":[{"parent":"dde5ead2-e066-4ac1-8603-a17e4e577d44","callout":[],"children":[],"id":"13ded31d-2d36-4232-8e4f-f1e51414963c","title":"前置：模拟导入服务返回失败；角色：房间成员；入口：当前导入页"},{"parent":"dde5ead2-e066-4ac1-8603-a17e4e577d44","callout":[],"children":[],"id":"8d890e0b-fa37-4e07-9f08-b71170a1eaf4","title":"操作：发起一次导入并等待结果，随后检查项目列表与资产"},{"parent":"dde5ead2-e066-4ac1-8603-a17e4e577d44","callout":[],"children":[],"id":"180a9794-e52b-4843-a7d6-04fa0b9d4206","title":"预期：\n1) 导入状态 ｜ 任务展示失败状态与可读的失败原因，不停在「等待导入」不动\n2) 副作用 ｜ 项目列表、资产 → 全部文件与我的资产三处都没有残留\n3) 恢复重试 ｜ 提供重新导入的入口，重试后能正常完成整条链路"},{"parent":"dde5ead2-e066-4ac1-8603-a17e4e577d44","callout":[],"children":[],"id":"415097b6-f8c2-4530-8abf-44bd0a98404f","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"dde5ead2-e066-4ac1-8603-a17e4e577d44","title":"🟠【P1】导入服务异常","icons":[{"color":"rgb(0, 186, 74)","name":"completion","index":"317"}]}],"collapsed":true,"id":"e414a00e-8450-46ec-98b9-afd1f5036dba","title":"异常场景"},{"parent":"e2795b6e-9e0a-4a03-9190-e79efce5260b","callout":[],"children":[{"parent":"ba520516-9824-491b-91fd-ac81cbfc4ae5","callout":[],"children":[{"parent":"eb32ff81-db47-43ad-af2b-1f6862be02e0","callout":[],"children":[],"id":"c0f560b7-6cda-48d5-bb98-fcafe74ac04f","title":"前置：准备一个没有任何文件的空仓库与一个只有 README 的仓库；角色：房间成员；入口：确认页"},{"parent":"eb32ff81-db47-43ad-af2b-1f6862be02e0","callout":[],"children":[],"id":"bcb0398b-968f-4883-b2f0-bcfbc719f352","title":"操作：分别导入这两个仓库，完成后打开项目、查看资产，并在项目下提问项目内容"},{"parent":"eb32ff81-db47-43ad-af2b-1f6862be02e0","callout":[],"children":[],"id":"73ef2c06-e843-463e-8bb8-dd40e056dae6","title":"预期：\n1) 导入状态 ｜ 两次都能走完导入流程并给出完成状态，空仓库不报错卡住\n2) 目录导航 ｜ 空仓库导入后项目存在但目录为空，展示空状态而不是加载失败\n3) 上下文 ｜ 在空项目下提问时 Agent 明确回答项目为空，不编造文件清单\n4) 列表展示 ｜ 两个项目都出现在资产 → 全部文件，且都不出现在我的资产 → 我上传的下"},{"parent":"eb32ff81-db47-43ad-af2b-1f6862be02e0","callout":[],"children":[],"id":"a0d886eb-5df8-40e3-b2b3-b5f6ecd0bb9a","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"eb32ff81-db47-43ad-af2b-1f6862be02e0","title":"🟡【P2】空仓库与只有 README 的仓库 · 全链路","icons":[{"color":"rgb(248, 87, 103)","name":"other","index":"369"}]},{"parent":"ba520516-9824-491b-91fd-ac81cbfc4ae5","callout":[],"children":[{"parent":"082416ab-518b-4a13-9cd5-64cfe9bbc871","callout":[],"children":[],"id":"80979a02-328b-4af4-9ab6-952ec9cb2af9","title":"前置：准备一个文件数很多、目录层级很深的仓库；角色：房间成员；入口：确认页"},{"parent":"082416ab-518b-4a13-9cd5-64cfe9bbc871","callout":[],"children":[],"id":"577d809f-d953-4760-91e9-950fad632873","title":"操作：发起导入并全程观察进度，完成后展开到最深一层目录，并让 Agent 定位一个深层文件"},{"parent":"082416ab-518b-4a13-9cd5-64cfe9bbc871","callout":[],"children":[],"id":"7f204d2a-f25f-4648-8086-d2ad65ff1a02","title":"预期：\n1) 性能 ｜ 导入过程中进度状态持续更新，不出现长时间无反馈\n2) 目录导航 ｜ 导入后目录层级与仓库一致，最深层文件可正常展开与打开\n3) 上下文 ｜ Agent 能定位到深层文件，不因文件多而只看到顶层，首次识别有进行中的反馈"},{"parent":"082416ab-518b-4a13-9cd5-64cfe9bbc871","callout":[],"children":[],"id":"49b03836-0d35-45ca-9d0b-7d75e09b3d9f","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"082416ab-518b-4a13-9cd5-64cfe9bbc871","title":"🟡【P2】超大仓库与深层目录 · 全链路","icons":[{"color":"rgb(248, 87, 103)","name":"other","index":"369"}]},{"parent":"ba520516-9824-491b-91fd-ac81cbfc4ae5","callout":[],"children":[{"parent":"4b0b1e79-f87c-477c-8c66-4f76b83f2eda","callout":[],"children":[],"id":"badf3126-b075-485b-a3e3-8818f76074a8","title":"前置：准备一个使用 Git LFS 的仓库；角色：房间成员；入口：确认页与导入后的文件树"},{"parent":"4b0b1e79-f87c-477c-8c66-4f76b83f2eda","callout":[],"children":[],"id":"4bbfec51-7587-4656-9084-ca9e0b1fc59c","title":"操作：导入该仓库，完成后在文件树与资产中打开其中的 LFS 文件"},{"parent":"4b0b1e79-f87c-477c-8c66-4f76b83f2eda","callout":[],"children":[],"id":"945baf54-773a-487a-ac02-17c0df06f8dc","title":"预期：\n1) 提示文案 ｜ 确认页说明已写明暂不支持下载 LFS 文件，导入完成后对 LFS 文件有明确标识或提示\n2) 文件落盘 ｜ LFS 文件不被当成正常文件静默交付一份指针内容，打开时能让人知道内容未下载\n3) 上下文 ｜ Agent 读取该文件时同样能说明内容未下载，不把指针内容当成文件正文"},{"parent":"4b0b1e79-f87c-477c-8c66-4f76b83f2eda","callout":[],"children":[],"id":"3aabf1ca-9bd7-44da-a89e-0c529ced5f93","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组；LFS 文件在文件树中的具体呈现方式按产品定义"}],"collapsed":true,"id":"4b0b1e79-f87c-477c-8c66-4f76b83f2eda","title":"🟡【P2】含 LFS 文件的仓库","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"ba520516-9824-491b-91fd-ac81cbfc4ae5","callout":[],"children":[{"parent":"fec0f416-aedf-4f58-8116-09cef13f4e10","callout":[],"children":[],"id":"3c9fa3b1-b816-4b0f-86b3-9013d04ea9cd","title":"前置：角色：房间成员；入口：地址输入框与项目名称输入框"},{"parent":"fec0f416-aedf-4f58-8116-09cef13f4e10","callout":[],"children":[],"id":"6bf47a21-9819-4a52-a220-8270a4cbaaa8","title":"操作：分别粘贴带 .git 结尾、带尾部斜杠、首尾带空格、大小写与实际仓库不一致的同一个地址；再导入一个名称很长的仓库并把项目名改成中文加 emoji"},{"parent":"fec0f416-aedf-4f58-8116-09cef13f4e10","callout":[],"children":[],"id":"4395bac7-d5d5-4ed3-9e4f-c9563e8e0dc7","title":"预期：\n1) 结果校验 ｜ 四种地址写法都解析到同一个仓库，首尾空格被自动去掉，大小写差异按 GitHub 规则处理\n2) 视觉展示 ｜ 超长名称在输入框、任务卡片与项目列表中截断可读，不撑破弹窗\n3) 列表展示 ｜ 中文与 emoji 名称在项目列表、资产与文件树里展示一致，不出现乱码"},{"parent":"fec0f416-aedf-4f58-8116-09cef13f4e10","callout":[],"children":[],"id":"09e6c465-4d53-4fb7-bbf0-478871e8a5da","title":"备注：本分组按完整链路组织：粘贴地址或从账号选仓库 → 确认页改名 → 点「导入仓库」→ 当前导入进度 → 打开项目 → 校验目录结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我上传的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。每条主用例都把这条链路跑完，不拆成多个分组"}],"collapsed":true,"id":"fec0f416-aedf-4f58-8116-09cef13f4e10","title":"🟡【P2】地址写法差异、超长名称与中文项目名","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"ba520516-9824-491b-91fd-ac81cbfc4ae5","title":"边界场景"}],"collapsed":true,"id":"e2795b6e-9e0a-4a03-9190-e79efce5260b","title":"从 GitHub 导入"},{"parent":"5bfec0cd-b60b-4faf-b825-e0eedb0f146b","callout":[],"children":[{"parent":"19cd12b3-98d0-45e0-a1c1-73de06c784cd","callout":[],"children":[],"id":"b1841893-f8fc-41ee-bc0c-0f653d6a43c2","title":"说明：同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集 → 在该项目下发起会话验证 Agent 识别。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room"},{"parent":"19cd12b3-98d0-45e0-a1c1-73de06c784cd","callout":[],"children":[{"parent":"f6f8a892-3d95-48b9-b032-3ff897aafd8e","callout":[],"children":[{"parent":"2327e39b-8111-4fe8-afc0-fe3842ff7125","callout":[],"children":[],"id":"8693f9a5-b52b-4dae-b6ae-6320a311e34b","title":"前置：本地准备 tutti-computer-logs-20260915-144447文件夹，文件夹内有多层目录；房间内另有一名成员 B；角色：房间成员 A；入口：项目加号菜单 → 导入到 Tutti → 文件夹"},{"parent":"2327e39b-8111-4fe8-afc0-fe3842ff7125","callout":[],"children":[],"id":"0539ba2e-2be0-456b-9039-868dd0a956d3","title":"操作：点击文件夹选择区域选择该文件，确认项目名称后点「导入文件夹」，全程观察进度直到完成，点「打开项目」，再把目录结构与本地读取结果逐层对照，依次查看资产 → 全部文件、我的资产 → 我上传的，让 B 也查看一遍，最后在该项目下新建会话提问项目内容"},{"parent":"2327e39b-8111-4fe8-afc0-fe3842ff7125","callout":[],"children":[],"id":"033f4ca6-f152-4501-8a9a-73b2d5135006","title":"预期： 1) 列表展示 ｜ 文件夹选择区域变为已选态，展示完整文件名与文件图标，下方提示变为「点击选择文件夹以更换」 2) 输入框 ｜ 项目名称自动填充为所选文件夹名称 tutti-computer-logs-20260915-144447 3) 按钮状态 ｜ 「导入文件夹」由禁用变为可点 4) 提示文案 ｜ 下方说明为「文件夹将读取到独立的项目目录，并保留文件夹内文件夹结构。Room 内所有成员均可访问导入的代码。」 5) 导入状态 ｜ 点击后切到「当前导入」页，任务行展示项目名称与「正在导入」这样的状态，导入状态持续推进并最终完成，读取完成后进入导入阶段并有对应状态 6) 提示文案 ｜ 顶部提示为「可以关闭弹窗，稍后重新打开查看进度。导入完成前请保留当前页面，并留在此 Room。」 7) 导入状态 ｜ 任务卡片状态由「等待导入」推进到「导入完成」，转圈消失，「取消导入」替换为「打开项目」 8) 跳转定位 ｜ 点「打开项目」弹窗关闭并定位到该项目，左侧项目列表中该项目被选中 9) 目录导航 ｜ 右侧文件区展示 该文件夹 的完整目录结构，层级与来源一致，最深层文件可展开可打开 10) 列表展示 ｜ 打开资产 → 全部文件，room 下出现与项目同名的文件夹，修改时间为本次导入时间，展开内容与项目文件树一致 11) 可见范围 ｜ 打开我的资产 → 我上传的，翻页与搜索都找不到本次导入的项目与其中任何文件；同一账号手动上传的文件仍正常出现在该处 12) 权限授权 ｜ 房间内另一名成员无需额外授权即可在项目列表与资产 → 全部文件中看到并打开该项目，且其「我上传的」下同样没有 13) 上下文 ｜ 在该项目下新建会话，发送「这个项目下有哪些文件」，Agent 无需手动引用即可列出与文件树一致的清单 14) 结果校验 ｜ 让 Agent 打开项目内某个已知文件并复述其中一段，内容与文件实际内容一致，不混入其他项目的文件 15) 目录导航 ｜ 读取到以项目名命名的独立项目目录下，文件夹内文件夹层级、名称与顺序与本地读取结果一致 16) 文件落盘 ｜ 逐个抽查文件内容与本地一致，不缺文件也不多出临时文件<br>"},{"parent":"2327e39b-8111-4fe8-afc0-fe3842ff7125","callout":[],"children":[],"id":"7b40a4a9-bf8e-45aa-936a-9a8f4ad81e32","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room<br>"}],"collapsed":true,"id":"2327e39b-8111-4fe8-afc0-fe3842ff7125","title":"🔴【P0】本地文件夹导入 · 全链路","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f6f8a892-3d95-48b9-b032-3ff897aafd8e","callout":[],"children":[{"parent":"4053153e-e99d-4d27-8645-9712fc46d005","callout":[],"children":[],"id":"cea96d67-90dd-474e-bb1c-fdf378b9563a","title":"前置：把同一份代码分别做成 GitHub 仓库与本地文件夹；角色：房间成员；入口：两个渠道"},{"parent":"4053153e-e99d-4d27-8645-9712fc46d005","callout":[],"children":[],"id":"64cfb645-52ae-471a-b16e-b3d813a44b0c","title":"操作：用两个渠道各导入一次成为两个项目，逐项对照项目列表、文件树、资产 → 全部文件、我的资产 → 我上传的，以及各自项目下会话中 Agent 的识别结果"},{"parent":"4053153e-e99d-4d27-8645-9712fc46d005","callout":[],"children":[],"id":"97c3a65b-c9bb-413f-9e5f-cc7c82f7e34b","title":"预期：\n1) 等价性 ｜ 两个项目在项目列表与资产 → 全部文件中的展示方式一致\n2) 可见范围 ｜ 两者都不出现在我的资产 → 我上传的下\n3) 归属与顺序 ｜ 除文件内容差异外，归属口径没有渠道差别\n4) 上下文 ｜ 两个项目下 Agent 列出的文件清单一致"},{"parent":"4053153e-e99d-4d27-8645-9712fc46d005","callout":[],"children":[],"id":"22df354e-82a7-4d8f-970e-4405ac48c6bd","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room"}],"collapsed":true,"id":"4053153e-e99d-4d27-8645-9712fc46d005","title":"🔴【P0】两个渠道导入结果的等价性抽检","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f6f8a892-3d95-48b9-b032-3ff897aafd8e","callout":[],"children":[{"parent":"c9ea941b-b7e5-4ba8-98a1-0e3c7b4e73e6","callout":[],"children":[],"id":"ffa2274b-63fb-4852-8d83-715ebd840207","title":"前置：本地准备两个 文件夹；角色：房间成员；入口：文件夹选择区域"},{"parent":"c9ea941b-b7e5-4ba8-98a1-0e3c7b4e73e6","callout":[],"children":[],"id":"ddfffc37-067e-4480-b9d3-ce4466e1ac86","title":"操作：先选择第一个文件夹，再点一次文件夹选择区域选择第二个文件夹，随后走完导入并校验"},{"parent":"c9ea941b-b7e5-4ba8-98a1-0e3c7b4e73e6","callout":[],"children":[],"id":"fccaa9b6-9748-4da9-88eb-cc073f9a3d14","title":"预期： 1) 等价性 ｜ 点击选择与选择两种方式得到的已选态与后续链路完全一致 2) 列表展示 ｜ 更换后文件名更新为新选的文件夹，旧包不再展示 3) 输入框 ｜ 项目名称是否随新文件夹名更新符合产品定义，若已手动改过则不被覆盖 4) 文件落盘 ｜ 最终导入的是第二个文件夹的内容，不混入第一个文件夹的文件<br>"},{"parent":"c9ea941b-b7e5-4ba8-98a1-0e3c7b4e73e6","callout":[],"children":[],"id":"7d98c403-adcd-4b3c-8ab7-9c03cd9fe260","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；手动改过名称后换包是否覆盖，待产品确认"}],"collapsed":true,"id":"c9ea941b-b7e5-4ba8-98a1-0e3c7b4e73e6","title":"🟠【P1】用选择方式选文件夹并更换已选的文件夹","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"f6f8a892-3d95-48b9-b032-3ff897aafd8e","title":"正常场景"},{"parent":"19cd12b3-98d0-45e0-a1c1-73de06c784cd","callout":[],"children":[{"parent":"d41e3171-d2d2-400c-b1a9-b4bb2f247cc2","callout":[],"children":[{"parent":"d33d2cd9-6471-4a02-961a-7676cbe59921","callout":[],"children":[],"id":"dfe0c334-9955-480b-8766-762e234ab991","title":"前置：本地准备 .zip、.rar、.tar、.tgz 各一份与两个 .tar.gz；角色：房间成员；"},{"parent":"d33d2cd9-6471-4a02-961a-7676cbe59921","callout":[],"children":[],"id":"f9d62539-2f84-41b1-b395-d1596326a9e0","title":"操作：依次选择那四种文件，再同时选择两个 文件夹，最后在未选文件时点「导入文件夹」"},{"parent":"d33d2cd9-6471-4a02-961a-7676cbe59921","callout":[],"children":[],"id":"8ee1a5e1-8b24-4b2c-af42-50ffda05babb","title":"预期： 1) 提示文案 ｜ 非文件夹对象被拒绝，提示与「仅支持选择单个文件夹」口径一致 2) 提示文案 ｜ 同时选择多个文件时提示仅支持单个文件，不出现同时选中两个的状态，也不静默只取第一个 3) 按钮状态 ｜ 被拒绝后文件夹选择区域保持未选态，未选文件时「导入文件夹」为禁用 4) 副作用 ｜ 三种情况都不发起导入，不产生导入任务<br>"},{"parent":"d33d2cd9-6471-4a02-961a-7676cbe59921","callout":[],"children":[],"id":"033d25bb-564c-403d-81b0-4e2e0b31ef96","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；文件夹选择器对非文件夹对象的处理，按产品定义"}],"collapsed":true,"id":"d33d2cd9-6471-4a02-961a-7676cbe59921","title":"🟡【P2】导入非 文件夹 文件与一次选择多个文件","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"d41e3171-d2d2-400c-b1a9-b4bb2f247cc2","callout":[],"children":[{"parent":"49d7d5c1-e65e-4a59-bfd5-6c6910c39c30","callout":[],"children":[],"id":"0c082482-9ed4-4373-be27-9429135794cf","title":"前置：压缩包正在上传中；角色：房间成员；入口：当前导入页"},{"parent":"49d7d5c1-e65e-4a59-bfd5-6c6910c39c30","callout":[],"children":[],"id":"672f06d4-db93-4cfa-affb-30978be8b65e","title":"操作：上传到一半断开网络，等待一段时间后恢复网络，随后检查项目列表与资产"},{"parent":"49d7d5c1-e65e-4a59-bfd5-6c6910c39c30","callout":[],"children":[],"id":"085ea62e-e901-45eb-a7fc-c75e9e7f91e9","title":"预期：\n1) 导入状态 ｜ 进度停止增长并转为失败或等待重连态，给出明确原因，不停在某个百分比假装还在传\n2) 恢复重试 ｜ 网络恢复后能续传或提供重新上传入口，重试后能走完整条链路\n3) 副作用 ｜ 失败时项目列表、资产 → 全部文件与我的资产三处都不留下半个项目"},{"parent":"49d7d5c1-e65e-4a59-bfd5-6c6910c39c30","callout":[],"children":[],"id":"3c4bee74-f50a-4b91-9a9b-0fb856ed6caa","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；断网后是恢复导入还是重新选择文件夹，按产品定义"}],"collapsed":true,"id":"49d7d5c1-e65e-4a59-bfd5-6c6910c39c30","title":"🟠【P1】上传过程中断网","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"d41e3171-d2d2-400c-b1a9-b4bb2f247cc2","callout":[],"children":[{"parent":"ee3fb8f9-5972-429c-b699-c88cdf25a7bb","callout":[],"children":[],"id":"ddbf56f4-dc39-4881-bb46-8f873777d4fa","title":"前置：文件夹正在导入中；角色：房间成员；入口：当前导入页"},{"parent":"ee3fb8f9-5972-429c-b699-c88cdf25a7bb","callout":[],"children":[],"id":"150e3cd5-3c1c-464b-9c2f-19b17dd213aa","title":"操作：直接刷新页面；再对比一次 GitHub 渠道刷新后的表现"},{"parent":"ee3fb8f9-5972-429c-b699-c88cdf25a7bb","callout":[],"children":[],"id":"f6c7935b-2037-4f7b-b760-ad2270edd98d","title":"预期： 1) 导入状态 ｜ 离开或刷新导致导入中断时给出明确的失败或中断提示，与顶部「请保留当前页面」的说明一致 2) 副作用 ｜ 中断后不留下半个项目 3) 等价性 ｜ GitHub 渠道刷新后导入在服务端继续，重新打开仍能看到任务，两个渠道的差异被正确体现，不混用同一套提示 4) 恢复重试 ｜ 回到该 Room 后能重新发起导入并走完链路<br>"},{"parent":"ee3fb8f9-5972-429c-b699-c88cdf25a7bb","callout":[],"children":[],"id":"11f15de8-0f2b-46ff-a734-fe4ec72f4d17","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；离开 Room 后导入是否一定中断，需与前端实现对齐"}],"collapsed":true,"id":"ee3fb8f9-5972-429c-b699-c88cdf25a7bb","title":"🟠【P1】导入中刷新页面"},{"parent":"d41e3171-d2d2-400c-b1a9-b4bb2f247cc2","callout":[],"children":[{"parent":"1984429a-8dcc-4cc2-8045-0c4a4677291a","callout":[],"children":[],"id":"f23b154a-e575-4686-8de7-ec320bd1df0a","title":"前置：Room 内已存在同名项目；角色：房间成员；入口：项目名称输入框"},{"parent":"1984429a-8dcc-4cc2-8045-0c4a4677291a","callout":[],"children":[],"id":"1936e540-73e5-4493-b716-86a7cf3d6491","title":"操作：保持自动填充的名称点「导入文件夹」，报错后改名重试并走完链路"},{"parent":"1984429a-8dcc-4cc2-8045-0c4a4677291a","callout":[],"children":[],"id":"39053d01-b948-47ae-9e93-f55102c93252","title":"预期： 1) 提示文案 ｜ 与 GitHub 渠道一致，展示「项目名称已被占用，请换一个名称。」与「重试」 2) 恢复重试 ｜ 改名后重试能正常走完导入并完成资产与会话校验 3) 等价性 ｜ 两个渠道的重名提示与恢复方式一致<br>"},{"parent":"1984429a-8dcc-4cc2-8045-0c4a4677291a","callout":[],"children":[],"id":"ca7b84c8-0e72-45ce-aefd-6c57cfaa0136","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room"}],"collapsed":true,"id":"1984429a-8dcc-4cc2-8045-0c4a4677291a","title":"🟠【P1】文件夹渠道的项目名称被占用"},{"parent":"d41e3171-d2d2-400c-b1a9-b4bb2f247cc2","callout":[],"lineStyle":{},"children":[{"parent":"cfd630bf-b919-4635-b942-8e7dc7ce900c","callout":[],"children":[],"id":"489e9e1d-f3d1-4667-b647-cebf049a7c06","title":"前置：导入正在进行中；角色：房间成员；入口：资产 → 全部文件"},{"parent":"cfd630bf-b919-4635-b942-8e7dc7ce900c","callout":[],"children":[],"id":"67c54afd-0e05-4497-ba2e-b4f60ed5890b","title":"操作：在导入未完成时打开资产查看，完成后再刷新查看"},{"parent":"cfd630bf-b919-4635-b942-8e7dc7ce900c","callout":[],"children":[],"id":"7935dc02-9a0a-4d77-a6fd-36598230c3b6","title":"预期：\n1) 列表展示 ｜ 要么不展示该项目，要么展示为导入中的中间态且明确可辨，不展示一个点开是空的正常文件夹\n2) 结果校验 ｜ 导入完成后刷新资产能看到完整内容"},{"parent":"cfd630bf-b919-4635-b942-8e7dc7ce900c","callout":[],"children":[],"id":"61289c16-36c4-44b9-b677-39664c95eb1d","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、不出现在我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；导入中在资产里是否可见及如何标识，按产品定义"}],"collapsed":true,"style":{"border-radius":"6px","color":"rgb(255, 255, 255)","background":"rgba(33, 41, 48, 0.25)","text-decoration":"line-through","border-color":"rgb(255, 255, 255)","border-width":"0px","border-style":"none"},"id":"cfd630bf-b919-4635-b942-8e7dc7ce900c","title":"🟡【P2】导入完成前查看资产"}],"collapsed":true,"id":"d41e3171-d2d2-400c-b1a9-b4bb2f247cc2","title":"异常场景"},{"parent":"19cd12b3-98d0-45e0-a1c1-73de06c784cd","callout":[],"children":[{"parent":"5269ab2b-c0c3-421a-a0ed-41a87f662834","callout":[],"children":[{"parent":"7a563920-c61e-46d5-8e0e-7e14ace72711","callout":[],"children":[],"id":"422f560c-bd41-4933-9ea6-9975696df7d2","title":"前置：准备一个空的 文件夹 与一个只含空文件夹的包；角色：房间成员；入口：文件夹选择区域"},{"parent":"7a563920-c61e-46d5-8e0e-7e14ace72711","callout":[],"children":[],"id":"e2480337-ff97-44d5-9761-248557cfcd4d","title":"操作：分别选择这两个文件夹，完成后打开项目、查看资产并在项目下提问"},{"parent":"7a563920-c61e-46d5-8e0e-7e14ace72711","callout":[],"children":[],"id":"09ad18cf-916e-4390-b49e-4c7df5eb8e4a","title":"预期： 1) 导入状态 ｜ 都能走完流程并给出完成或明确的失败状态，不卡在导入中 2) 目录导航 ｜ 导入后项目存在，目录为空或只有空文件夹，与文件夹内结构一致 3) 上下文 ｜ Agent 明确回答项目为空，不编造文件清单<br>"},{"parent":"7a563920-c61e-46d5-8e0e-7e14ace72711","callout":[],"children":[],"id":"e11d3b24-9e4a-4885-a6fd-d06ed05a02e4","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room"}],"collapsed":true,"id":"7a563920-c61e-46d5-8e0e-7e14ace72711","title":"🟡【P2】空文件夹与只含空目录的包 · 全链路","icons":[{"color":"rgb(0, 186, 74)","name":"completion","index":"317"}]},{"parent":"5269ab2b-c0c3-421a-a0ed-41a87f662834","callout":[],"children":[{"parent":"3fbbe0bd-3a7d-47a4-9bb1-e5eb1eafbde1","callout":[],"children":[],"id":"bc009386-509e-4a40-9c80-c465eec6dc93","title":"前置：准备一个接近上限大小的文件夹与一个超过上限的包；角色：房间成员；入口：文件夹选择区"},{"parent":"3fbbe0bd-3a7d-47a4-9bb1-e5eb1eafbde1","callout":[],"children":[],"id":"0273dfc4-3390-4122-9d5a-5bee15e98b5d","title":"操作：分别选择这两个文件夹并全程观察进度"},{"parent":"3fbbe0bd-3a7d-47a4-9bb1-e5eb1eafbde1","callout":[],"children":[],"id":"7858da28-5cc1-417a-b872-e74e4abf6f63","title":"预期： 1) 性能 ｜ 接近上限的包进度稳定推进，浏览器不卡死，最终能完成整条链路 2) 提示文案 ｜ 超过大小上限时提前拦截并给出上限值，而不是传到一半失败<br>"},{"parent":"3fbbe0bd-3a7d-47a4-9bb1-e5eb1eafbde1","callout":[],"children":[],"id":"08ed5a32-7529-498f-be53-f6693ef6a477","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；文件夹大小上限按产品定义"}],"collapsed":true,"id":"3fbbe0bd-3a7d-47a4-9bb1-e5eb1eafbde1","title":"🟡【P2】超大文件夹","icons":[{"color":"rgb(0, 186, 74)","name":"completion","index":"317"}]},{"parent":"5269ab2b-c0c3-421a-a0ed-41a87f662834","callout":[],"children":[{"parent":"142701ff-0027-4c4a-83f5-7f24740df13d","callout":[],"children":[],"id":"afaed1b9-b842-4b76-8bfd-9d0dc738a2a9","title":"前置：准备一个文件夹内含中文文件名、很长路径、多层嵌套目录且顶层文件夹名与项目名不同的 文件夹；角色：房间成员；入口：文件夹选择区域"},{"parent":"142701ff-0027-4c4a-83f5-7f24740df13d","callout":[],"children":[],"id":"ef051440-4320-4d0e-bf22-ee3c03d05e65","title":"操作：导入该包，完成后在文件树中逐层展开，并让 Agent 读取其中一个中文名的深层文件"},{"parent":"142701ff-0027-4c4a-83f5-7f24740df13d","callout":[],"children":[],"id":"55362b12-8c3b-4ab0-8367-5defa054f319","title":"预期： 1) 目录导航 ｜ 读取到以项目名命名的独立项目目录下，文件夹内的顶层文件夹作为其子目录保留，不出现双层同名或丢一层 2) 列表展示 ｜ 中文文件名不乱码，超长路径在文件树中截断可读且可完整查看 3) 上下文 ｜ Agent 能读到中文名的深层文件并正确复述内容<br>"},{"parent":"142701ff-0027-4c4a-83f5-7f24740df13d","callout":[],"children":[],"id":"a0c021a5-39c6-4f9b-a85b-12269874ce6a","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；文件夹内顶层文件夹是否被拍平，待产品确认"}],"collapsed":true,"id":"142701ff-0027-4c4a-83f5-7f24740df13d","title":"🟡【P2】文件夹内中文名、超长路径、深层嵌套与顶层文件夹"},{"parent":"5269ab2b-c0c3-421a-a0ed-41a87f662834","callout":[],"children":[{"parent":"319e3f96-bca1-4944-acef-04364e51a301","callout":[],"children":[],"id":"79696b46-e31a-48fd-bf25-dad70f9cb412","title":"前置：已导入一个项目并在其下聊过一轮；角色：房间成员；入口：项目更多操作、资产与原会话"},{"parent":"319e3f96-bca1-4944-acef-04364e51a301","callout":[],"children":[],"id":"3936d1f1-7408-4ad7-ad48-ddb0e0f48790","title":"操作：删除该项目后查看资产 → 全部文件，并在原会话中继续提问项目内文件"},{"parent":"319e3f96-bca1-4944-acef-04364e51a301","callout":[],"children":[],"id":"f89bf840-43b5-44e8-8bd5-74b5180b56ec","title":"预期：<br>1) 列表展示 ｜ 资产 → 全部文件里对应的文件夹按产品定义同步移除或保留，两处口径一致<br>2) 副作用 ｜ 不出现项目列表里没有了但资产里还能打开并继续编辑的情况<br>3) 上下文 ｜ Agent 不再返回该项目的文件内容，给出项目已不存在的说明<br>"},{"parent":"319e3f96-bca1-4944-acef-04364e51a301","callout":[],"children":[],"id":"e51a174c-3966-477d-9e5a-f135816a4f07","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；删除项目是否同时删除资产中的文件，按产品定义"}],"collapsed":true,"id":"319e3f96-bca1-4944-acef-04364e51a301","title":"🟡【P2】导入的项目被删除后的表现"},{"parent":"5269ab2b-c0c3-421a-a0ed-41a87f662834","callout":[],"lineStyle":{},"children":[{"parent":"241ee1bb-fb98-41bc-8360-8f5a3c5f4446","callout":[],"children":[],"id":"11f4af0a-bb46-4d53-a856-b72694c037db","title":"前置：已有导入完成的项目；角色：房间成员；入口：不绑定任何项目的新会话"},{"parent":"241ee1bb-fb98-41bc-8360-8f5a3c5f4446","callout":[],"children":[],"id":"2b0bf969-e3dd-4216-af63-fb2753db8ef3","title":"操作：在不选项目的会话中直接提问该项目下有哪些文件"},{"parent":"241ee1bb-fb98-41bc-8360-8f5a3c5f4446","callout":[],"children":[],"id":"66b3e7cb-7eaf-4837-b105-feefbbed514d","title":"预期：\n1) 上下文 ｜ Agent 不自动读取该项目的内容，明确说明当前会话没有绑定项目\n2) 环境隔离 ｜ 需要时通过引用或切换项目才能访问，不出现跨项目的隐式读取"},{"parent":"241ee1bb-fb98-41bc-8360-8f5a3c5f4446","callout":[],"children":[],"id":"b73036c3-1c2c-4f1d-9ddc-f709386ba5c1","title":"备注：本分组同样按完整链路组织：选文件夹 → 项目名称自动填充 → 点「导入文件夹」→ 导入进度 → 导入完成 → 打开项目 → 校验文件夹内文件夹结构 → 校验资产归集（出现在资产-全部文件、我的资产-我导入的）→ 在该项目下发起会话验证 Agent 能识别项目内文件。与 GitHub 渠道的差异是导入需要前端参与，导入完成前要保留当前页面并留在此 Room；删除项目是否同时删除资产中的文件，按产品定义"}],"collapsed":true,"style":{"border-radius":"6px","color":"rgb(255, 255, 255)","background":"rgba(33, 41, 48, 0.25)","text-decoration":"line-through","border-color":"rgb(255, 255, 255)","border-width":"0px","border-style":"none"},"id":"241ee1bb-fb98-41bc-8360-8f5a3c5f4446","title":"🟡【P2】不在项目下的会话不识别项目文件"}],"collapsed":true,"id":"5269ab2b-c0c3-421a-a0ed-41a87f662834","title":"边界场景"}],"collapsed":true,"id":"19cd12b3-98d0-45e0-a1c1-73de06c784cd","title":"导入本地文件夹"}],"collapsed":true,"id":"5bfec0cd-b60b-4faf-b825-e0eedb0f146b","title":"导入到 Tutti"}],"collapsed":true,"id":"4b75710a-d85b-48f1-92c9-3d0449868a5b","title":"侧边栏项目添加与排序"},{"parent":"a97b4588-6d5d-4123-953b-e42b98f2d87f","callout":[],"children":[{"parent":"3f00381c-f865-4c8a-a7d9-06d0b38b93db","callout":[],"children":[{"parent":"8a72ae2b-229e-4298-940d-efb474035b70","callout":[],"children":[{"parent":"a58b0bd6-345e-4f28-b256-ce220ae5882a","callout":[],"children":[],"id":"7321d412-c13d-48be-8683-cb55a4e989e9","title":"操作：点击输入框左下角的项目"},{"parent":"a58b0bd6-345e-4f28-b256-ce220ae5882a","callout":[],"children":[],"id":"98d94e11-cb9c-425e-9f8b-d1e42bb4e8e4","title":"预期：下拉列表显示「新建项目」、「使用房间项目」、「上传本地项目」和 「不使用项目」四项"}],"collapsed":true,"id":"a58b0bd6-345e-4f28-b256-ce220ae5882a","title":"🔴【P0】打开项目菜单","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8a72ae2b-229e-4298-940d-efb474035b70","callout":[],"children":[{"parent":"4ceb8793-db72-4ada-b041-f70c736f5882","callout":[],"children":[],"id":"8ec961e0-b073-4417-88e9-6147897b1023","title":"操作：点击添加项目"},{"parent":"4ceb8793-db72-4ada-b041-f70c736f5882","callout":[],"children":[],"id":"7fe45fc0-8e40-441c-9843-c22c2013e5d2","title":"预期：\n1. 显示项目名称输入框、取消和创建按钮，并说明在 /workspace下 创建文件夹，\n2. 创建成功后项目：显示在侧边栏项目列表第一位；显示在输入框左下角下拉菜单项目列表第一位并处于选中态；同步显示在其他 Agent 的项目下"}],"collapsed":true,"id":"4ceb8793-db72-4ada-b041-f70c736f5882","title":"🔴【P0】新建项目","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8a72ae2b-229e-4298-940d-efb474035b70","callout":[],"children":[{"parent":"84f9369f-46a9-4f64-b7c1-0b66919226ee","callout":[],"children":[],"id":"432ad1d0-be51-4d49-baeb-ef3d6c96d31d","title":"操作：点击新建项目，输入名称后点击取消"},{"parent":"84f9369f-46a9-4f64-b7c1-0b66919226ee","callout":[],"children":[],"id":"5808a516-49d5-454e-9db8-48ac1d836411","title":"预期：关闭弹窗，不创建目录或项目记录"}],"collapsed":true,"id":"84f9369f-46a9-4f64-b7c1-0b66919226ee","title":"🟠【P1】取消创建","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8a72ae2b-229e-4298-940d-efb474035b70","callout":[],"children":[{"parent":"ec1134bf-3446-4e38-b8f4-1800731dc043","callout":[],"children":[],"id":"c3ee889a-a194-4087-8564-3586f625b058","title":"操作：点击新建项目，输入框为空后输入合法名称"},{"parent":"ec1134bf-3446-4e38-b8f4-1800731dc043","callout":[],"children":[],"id":"bf331857-cd4e-4be9-835c-006870551308","title":"预期：空值时创建禁用，合法值时按钮可用"}],"collapsed":true,"id":"ec1134bf-3446-4e38-b8f4-1800731dc043","title":"🔴【P0】创建按钮状态","icons":[{"color":"rgb