43-4624e27408d4","callout":[],"children":[{"parent":"a2df95c2-475a-40dd-a326-51b05756b460","customWidth":430,"callout":[],"children":[],"id":"49005ec1-dc5b-4a1c-b9f5-0e5ac584c12c","title":"操作：加载 Agent 已被删除的决策卡片"},{"parent":"a2df95c2-475a-40dd-a326-51b05756b460","customWidth":460,"callout":[],"children":[],"id":"f52d6a7a-1df4-499f-8bca-0a6623abeedf","title":"预期：使用历史头像或不可用占位，仍可识别来源并可安全处理"}],"collapsed":true,"id":"a2df95c2-475a-40dd-a326-51b05756b460","title":"【P1】卡片 Agent 已被删除"},{"parent":"cec334ff-cd5d-4a2f-9243-4624e27408d4","callout":[],"children":[{"parent":"38890908-a287-47e6-a769-40eea6d0fcbe","customWidth":430,"callout":[],"children":[],"id":"beecce1b-9204-45d8-a32b-a9ca75970f5f","title":"操作：关闭 Agent 本地进程后查看其待授权卡片"},{"parent":"38890908-a287-47e6-a769-40eea6d0fcbe","customWidth":460,"callout":[],"children":[],"id":"036c21e5-35dd-4dba-84f3-723f54440a1b","title":"预期：卡片保留并提示 Agent 离线，选项按规则置灰或提交后进入待恢复状态"}],"collapsed":true,"id":"38890908-a287-47e6-a769-40eea6d0fcbe","title":"【P1】执行 Agent 已离线"},{"parent":"cec334ff-cd5d-4a2f-9243-4624e27408d4","callout":[],"children":[{"parent":"26e0c831-da7d-4c76-a956-14250a2762cd","customWidth":430,"callout":[],"children":[],"id":"1ca1ebf5-72dc-499e-937c-b9aba49dceec","title":"操作：在命令代码块中返回 HTML、脚本标签和控制字符"},{"parent":"26e0c831-da7d-4c76-a956-14250a2762cd","customWidth":460,"callout":[],"children":[],"id":"a7e2b78c-01ee-4638-b1e2-485ac6174430","title":"预期：按纯文本安全渲染，不执行命令或脚本，不破坏卡片布局"}],"collapsed":true,"id":"26e0c831-da7d-4c76-a956-14250a2762cd","title":"【P1】命令正文包含 HTML 与脚本标签"},{"parent":"cec334ff-cd5d-4a2f-9243-4624e27408d4","callout":[],"children":[{"parent":"7508ffd1-8610-4e22-8179-f3b809636688","customWidth":430,"callout":[],"children":[],"id":"eac6bccc-598d-444d-bafc-69474bde6592","title":"操作：在会话详情页直接回复该决策后返回房间看板待处理区域"},{"parent":"7508ffd1-8610-4e22-8179-f3b809636688","customWidth":460,"callout":[],"children":[],"id":"47fbc94b-8f3c-4144-9413-5793cdecc6ee","title":"预期：卡片自动移除，不出现已处理但仍展示的僵尸卡片"}],"collapsed":true,"id":"7508ffd1-8610-4e22-8179-f3b809636688","title":"【P1】决策已在会话详情内处理"},{"parent":"cec334ff-cd5d-4a2f-9243-4624e27408d4","callout":[],"children":[{"parent":"a1dfff2d-94b8-4fd1-878b-74352656e97c","customWidth":430,"callout":[],"children":[],"id":"6a76458e-e559-4f57-959e-cbbc9c84e5a9","title":"操作：待处理区域存在卡片时被移出该房间，触发一次数据加载"},{"parent":"a1dfff2d-94b8-4fd1-878b-74352656e97c","customWidth":460,"callout":[],"children":[],"id":"a4eeedee-5722-46df-ba61-7dc7d06e0335","title":"预期：卡片随房间权限一并失效并移除，不可继续操作"}],"collapsed":true,"id":"a1dfff2d-94b8-4fd1-878b-74352656e97c","title":"【P2】被移出房间后待处理区域残留"}],"collapsed":true,"id":"cec334ff-cd5d-4a2f-9243-4624e27408d4","title":"异常场景"},{"parent":"998a16a1-ba95-445d-b054-94607ad0eaac","callout":[],"children":[{"parent":"a4795750-df6f-4780-9e52-07d9a08770da","callout":[],"children":[{"parent":"927ec472-792b-4ebc-99d9-36c1579056b1","customWidth":430,"callout":[],"children":[],"id":"7e3c02e9-fb6e-418c-aa90-940825dbf8e7","title":"操作：构造仅一个选项的决策卡片"},{"parent":"927ec472-792b-4ebc-99d9-36c1579056b1","customWidth":460,"callout":[],"children":[],"id":"4d28e13c-374d-4a91-a7ed-7652b65b3443","title":"预期：唯一选项正常纵向展示并作为主操作"}],"collapsed":true,"id":"927ec472-792b-4ebc-99d9-36c1579056b1","title":"【P1】决策卡片只有一个选项"},{"parent":"a4795750-df6f-4780-9e52-07d9a08770da","callout":[],"children":[{"parent":"b978a018-39c5-4516-9505-e2f40de4da64","customWidth":430,"callout":[],"children":[],"id":"78f10cbf-cc1a-464e-8d84-c01113f68710","title":"操作：构造二十个选项的决策卡片"},{"parent":"b978a018-39c5-4516-9505-e2f40de4da64","customWidth":460,"callout":[],"children":[],"id":"cfc46061-20b1-4383-b0ba-7bde9e5d2000","title":"预期：选项区域可滚动或完整扩展，不重叠且每项可准确选择"}],"collapsed":true,"id":"b978a018-39c5-4516-9505-e2f40de4da64","title":"【P1】决策卡片大量选项"},{"parent":"a4795750-df6f-4780-9e52-07d9a08770da","callout":[],"children":[{"parent":"6ba5ddea-2aef-4a21-a833-d1aec27f05a6","customWidth":430,"callout":[],"children":[],"id":"b390bb2d-8332-4fca-912f-465d3f3641ac","title":"操作：返回超过多屏的决策问题正文"},{"parent":"6ba5ddea-2aef-4a21-a833-d1aec27f0