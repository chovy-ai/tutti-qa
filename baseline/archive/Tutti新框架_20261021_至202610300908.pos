fc-bcce-3f235b8e114f","callout":[],"children":[{"parent":"c6df07b1-d9ae-4ba7-b45d-a3c72d221454","callout":[],"children":[{"parent":"4d845b0b-eca1-487a-a52b-3027597a5458","callout":[],"children":[{"parent":"f8482c5e-2c9e-4d62-9574-2ff49fa62e36","callout":[],"children":[{"parent":"52cc77f0-53f4-4c04-94b5-5f930bb95f19","callout":[],"children":[],"id":"0499ff8b-b1b6-4021-910e-d6f3843d6321","title":"前置：前置：账号未保存过任何提示词；角色：房间成员；入口：输入框提示词按钮"},{"parent":"52cc77f0-53f4-4c04-94b5-5f930bb95f19","callout":[],"children":[],"id":"303b182f-8031-4129-8447-24721a128e8d","title":"操作：点击按钮打开弹窗，点击任一推荐模板并保存"},{"parent":"52cc77f0-53f4-4c04-94b5-5f930bb95f19","callout":[],"children":[],"id":"744be89d-ba33-457d-b90d-c9e1c47293ad","title":"预期：弹窗一级面板只展示推荐模板；点击推荐模板唤起新增提示词弹窗且标题与内容已自动填入；点击保存后该提示词填入会话输入框并出现在最近使用列表"}],"collapsed":true,"id":"52cc77f0-53f4-4c04-94b5-5f930bb95f19","title":"🟠【P1】新用户仅展示推荐模板"},{"parent":"f8482c5e-2c9e-4d62-9574-2ff49fa62e36","callout":[],"children":[{"parent":"27cb652a-75e2-4a4a-b2ec-8e948884fb51","callout":[],"children":[],"id":"b3db2dbc-194f-4fe1-b094-548ed7b70716","title":"前置：前置：账号已保存并使用过至少一个提示词；角色：房间成员；入口：提示词按钮"},{"parent":"27cb652a-75e2-4a4a-b2ec-8e948884fb51","callout":[],"children":[],"id":"17bf78f2-66b2-4934-906a-557e3ca79b8d","title":"操作：打开弹窗并点击「推荐」进入二级面板"},{"parent":"27cb652a-75e2-4a4a-b2ec-8e948884fb51","callout":[],"children":[],"id":"e53bdf2f-d16b-4ad5-a428-8291bd52c429","title":"预期：一级面板展示「最近使用的 prompt」；推荐模板收进二级面板；点击推荐可进入二级面板查看推荐提示词模板并可返回一级面板"}],"collapsed":true,"id":"27cb652a-75e2-4a4a-b2ec-8e948884fb51","title":"🟠【P1】老用户展示最近使用的提示词"}],"collapsed":true,"id":"f8482c5e-2c9e-4d62-9574-2ff49fa62e36","title":"正常场景（2）"},{"parent":"4d845b0b-eca1-487a-a52b-3027597a5458","callout":[],"children":[{"parent":"1d206ebc-04de-4cfb-a73a-3d01b18cceaa","callout":[],"children":[{"parent":"23464a7e-39d2-4acd-9c76-e8e851d2c3b7","callout":[],"children":[],"id":"9d39f0fa-8539-4e40-b1d3-13e08f927b24","title":"前置：尚未保存任何提示词"},{"parent":"23464a7e-39d2-4acd-9c76-e8e851d2c3b7","callout":[],"children":[],"id":"633b7f58-20c9-43bc-bd29-15f440c9579d","title":"操作：打开提示词弹窗"},{"parent":"23464a7e-39d2-4acd-9c76-e8e851d2c3b7","callout":[],"children":[],"id":"11a4b516-93cb-4d23-aca0-609ad9a26b14","title":"预期：展示空态与新增引导，不显示空白面板"}],"collapsed":true,"id":"23464a7e-39d2-4acd-9c76-e8e851d2c3b7","title":"🟠【P1】无任何提示词时的空态"}],"collapsed":true,"id":"1d206ebc-04de-4cfb-a73a-3d01b18cceaa","title":"异常场景（1）"},{"parent":"4d845b0b-eca1-487a-a52b-3027597a5458","callout":[],"children":[{"parent":"750e79ae-8395-4c82-819e-33250680983f","callout":[],"children":[{"parent":"680a26a9-b725-4d72-9f15-c1a4362d7776","callout":[],"children":[],"id":"ae37a4b7-e82a-4b6a-b69e-db6a14543e05","title":"前置：已保存数十条提示词"},{"parent":"680a26a9-b725-4d72-9f15-c1a4362d7776","callout":[],"children":[],"id":"cbeada18-c2bb-4bd1-b8c0-959176667b30","title":"操作：打开提示词弹窗并滚动查看"},{"parent":"680a26a9-b725-4d72-9f15-c1a4362d7776","callout":[],"children":[],"id":"85fd9a04-fffe-4cb8-b189-f7f9f0033a7f","title":"预期：列表可滚动，顺序稳定，定位与选择不受数量影响"}],"collapsed":true,"id":"680a26a9-b725-4d72-9f15-c1a4362d7776","title":"🟡【P2】提示词数量很多时的展示"}],"collapsed":true,"id":"750e79ae-8395-4c82-819e-33250680983f","title":"边界场景（1）"}],"collapsed":true,"id":"4d845b0b-eca1-487a-a52b-3027597a5458","title":"提示词弹窗展示"},{"parent":"c6df07b1-d9ae-4ba7-b45d-a3c72d221454","callout":[],"children":[{"parent":"d7a28a0f-98c1-4544-874d-521a4f9a3684","callout":[],"children":[{"parent":"0c40bd0b-adcc-4d9c-ba70-b2cef19ef18b","callout":[],"children":[{"parent":"83ab5056-253c-4819-a98f-9e648da4c6ef","callout":[],"children":[],"id":"47a1f8ed-a7cb-430d-b300-f6a6f204f8d5","title":"前置：前置：新增提示词弹窗已填写内容；角色：房间成员；入口：弹窗内取消按钮"},{"parent":"83ab5056-253c-4819-a98f-9e648da4c6ef","callout":[],"children":[],"id":"08e898e3-9905-4c16-a4ba-a863fba627c4","title":"操作：点击取消"},{"parent":"83ab5056-253c-4819-a98f-9e648da4c6ef","callout":[],"children":[],"id":"a10eff19-94a8-4caf-abd8-19be3a8405d5","title":"预期：弹窗关闭且不创建提示词；返回一级面板列表条数不变；输入框内容未被修改"}],"collapsed":true,"id":"83ab5056-253c-4819-a98f-9e648da4c6ef","title":"🟠【P1】取消新增提示词"},{"parent":"0c40bd0b-adcc-4d9c-ba70-b2cef19ef18b","callout":[],"children":[{"parent":"de6d3500-d692-4437-a8fc-a333c8c0f2f5","callout":[],"children":[],"id":"d7cc3f21-2312-4e44-ab2a-ba59f7d8f354","title":"前置：前置：提示词弹窗已打开；角色：房间成员；入口：弹窗内「新增提示词」"},{"parent":"de6d3500-d692-4437-a8fc-a333c8c0f2f5","callout":[],"children":[],"id":"5f67686c-3ffe-4841-ae99-68c58dc4f725","title":"操作：输入标题与提示词内容后点击保存"},{"parent":"de6d3500-d692-4437-a8fc-a333c8c0f2f5","callout":[],"children":[],"id":"9c3924f0-0c3a-4c0f-ba4f-c4a6e2d8756d","title":"预期：保存成功并关闭新增弹窗；新提示词出现在一级面板列表中；点击该提示词可将内容填入输入框"}],"collapsed":true,"id":"de6d3500-d692-4437-a8fc-a333c8c0f2f5","title":"🟠【P1】新增提示词并保存"}],"collapsed":true,"id":"0c40bd0b-adcc-4d9c-ba70-b2cef19ef18b","title":"正常场景（2）"},{"parent":"d7a28a0f-98c1-4544-874d-521a4f9a3684","callout":[],"children":[{"parent":"753d30bf-1465-40eb-bfac-85cf4ad542ee","callout":[],"children":[{"parent":"981f71fc-a0c1-4033-8bce-697fd7cbb8f5","callout":[],"children":[],"id":"c74d4322-b0d1-4729-abbb-ed817c4f53ac","title":"前置：前置：新增提示词弹窗已打开；角色：房间成员；入口：新增提示词弹窗"},{"parent":"981f71fc-a0c1-4033-8bce-697fd7cbb8f5","callout":[],"children":[],"id":"60eb5e43-b4c5-41b2-9c32-ece4cc03d3bf","title":"操作：只填写标题，提示词内容留空后点击保存"},{"parent":"981f71fc-a0c1-4033-8bce-697fd7cbb8f5","callout":[],"children":[],"id":"a91cc294-eacf-43c6-9147-2a7dc0087a45","title":"预期：保存按钮不可用或点击后弹出内容必填提示；弹窗保持打开；列表中不新增记录"}],"collapsed":true,"id":"981f71fc-a0c1-4033-8bce-697fd7cbb8f5","title":"🟠【P1】不输入提示词内容不可保存"},{"parent":"753d30bf-1465-40eb-bfac-85cf4ad542ee","callout":[],"children":[{"parent":"05a86190-98ea-4d66-afa3-a60f700b2b72","callout":[],"children":[],"id":"b1838de0-9a10-40ef-b0d8-28a70cc971e2","title":"前置：前置：新增提示词弹窗已打开；角色：房间成员；入口：新增提示词弹窗"},{"parent":"05a86190-98ea-4d66-afa3-a60f700b2b72","callout":[],"children":[],"id":"ea10edbb-f7c1-4d54-8f42-db7e398b518c","title":"操作：只填写提示词内容，标题留空后点击保存"},{"parent":"05a86190-98ea-4d66-afa3-a60f700b2b72","callout":[],"children":[],"id":"42809d0f-4aaf-42fb-a29a-4893c1ea5e8b","title":"预期：保存按钮不可用或点击后弹出标题必填提示；弹窗保持打开且已输入内容不丢失；列表中不新增记录"}],"collapsed":true,"id":"05a86190-98ea-4d66-afa3-a60f700b2b72","title":"🟠【P1】不输入标题不可保存"},{"parent":"753d30bf-1465-40eb-bfac-85cf4ad542ee","callout":[],"children":[{"parent":"76d1471d-4fd3-4f16-859a-32f733b8486b","callout":[],"children":[],"id":"bcf34f81-dc32-47e5-b6c8-f362cc6318fd","title":"前置：已存在同名提示词"},{"parent":"76d1471d-4fd3-4f16-859a-32f733b8486b","callout":[],"children":[],"id":"ceea6fa8-d7b9-4676-b1da-ac218f68d2c9","title":"操作：新增一条同名提示词并保存"},{"parent":"76d1471d-4fd3-4f16-859a-32f733b8486b","callout":[],"children":[],"id":"dbf7eb7a-93ad-4ec5-9172-e88b804af078","title":"预期：给出重名提示或允许保存但可区分，不产生无法区分的重复项"}],"collapsed":true,"id":"76d1471d-4fd3-4f16-859a-32f733b8486b","title":"🟠【P1】新增重名提示词"},{"parent":"753d30bf-1465-40eb-bfac-85cf4ad542ee","callout":[],"children":[{"parent":"7f10a261-6f2d-4ed3-99cc-397f00719252","callout":[],"children":[],"id":"fb56ea2c-70e3-4495-8bfb-2dec71a0d51e","title":"前置：提示词弹窗已打开"},{"parent":"7f10a261-6f2d-4ed3-99cc-397f00719252","callout":[],"children":[],"id":"c973782c-b9e0-4530-b911-325e37099da2","title":"操作：标题或内容留空后点击保存"},{"parent":"7f10a261-6f2d-4ed3-99cc-397f00719252","callout":[],"children":[],"id":"4d36f23b-96a6-4757-9b63-cfc89f07e1cb","title":"预期：拦截并提示必填项，不保存出空白条目"}],"collapsed":true,"id":"7f10a261-6f2d-4ed3-99cc-397f00719252","title":"🟠【P1】标题或内容为空时保存"}],"collapsed":true,"id":"753d30bf-1465-40eb-bfac-85cf4ad542ee","title":"异常场景（4）"},{"parent":"d7a28a0f-98c1-4544-874d-521a4f9a3684","callout":[],"children":[{"parent":"8776e206-5e76-4aaf-89c5-6ac392dce84b","callout":[],"children":[{"parent":"60e22f76-aba8-4b32-91e9-daba1696594f","callout":[],"children":[],"id":"c6fc3d10-6087-4b96-b0e6-b2ba7ae6ba25","title":"前置：前置：新增提示词弹窗已打开；角色：房间成员；入口：新增提示词弹窗"},{"parent":"60e22f76-aba8-4b32-91e9-daba1696594f","callout":[],"children":[],"id":"8f506184-dbe4-4dc9-bb17-b8da0a7885da","title":"操作：在标题与内容中分别粘贴达到系统允许的最大长度及超出该长度的文本"},{"parent":"60e22f76-aba8-4b32-91e9-daba1696594f","callout":[],"children":[],"id":"48c623db-bc34-41b6-a52a-5b285618d0e6","title":"预期：达到最大长度时停止继续输入或给出长度提示；超出部分不被保存；保存后列表中标题超长时省略显示且悬浮可见完整内容，弹窗不出现布局错乱"}],"collapsed":true,"id":"60e22f76-aba8-4b32-91e9-daba1696594f","title":"🟡【P2】标题与内容超长输入"},{"parent":"8776e206-5e76-4aaf-89c5-6ac392dce84b","callout":[],"children":[{"parent":"42919709-8f43-4f31-a3b6-764494b0b0d0","callout":[],"children":[],"id":"3432dace-baf7-45b3-b3b8-953cf5fb8887","title":"前置：前置：已存在标题为「日报」的提示词；角色：房间成员；入口：新增提示词弹窗"},{"parent":"42919709-8f43-4f31-a3b6-764494b0b0d0","callout":[],"children":[],"id":"264eb4d7-3e76-404c-9ec5-784ed9426e27","title":"操作：再次以「日报」为标题新增一条内容不同的提示词"},{"parent":"42919709-8f43-4f31-a3b6-764494b0b0d0","callout":[],"children":[],"id":"0da59e44-a251-40ca-a1b8-4409ee238b4b","title":"预期：允许创建成功，列表中出现两条同名提示词且内容各自独立；点击任一条填入输入框的内容与其自身内容一致"}],"collapsed":true,"id":"42919709-8f43-4f31-a3b6-764494b0b0d0","title":"🟡【P2】标题与已有提示词重名"},{"parent":"8776e206-5e76-4aaf-89c5-6ac392dce84b","callout":[],"children":[{"parent":"447024a4-93bf-4500-8e5f-2fa70808d807","callout":[],"children":[],"id":"4f3451dd-5d77-4414-bcb0-5f6465f9a300","title":"前置：提示词弹窗已打开"},{"parent":"447024a4-93bf-4500-8e5f-2fa70808d807","callout":[],"children":[],"id":"608aa15d-5f3e-4d5a-bd18-c75049be4358","title":"操作：输入远超常规长度的提示词内容并保存"},{"parent":"447024a4-93bf-4500-8e5f-2fa70808d807","callout":[],"children":[],"id":"cd21341c-46f0-4bef-9075-b7a93c7db71b","title":"预期：保存成功且列表中合理截断展示，使用时内容完整不丢失"}],"collapsed":true,"id":"447024a4-93bf-4500-8e5f-2fa70808d807","title":"🟡【P2】超长提示词内容"}],"collapsed":true,"id":"8776e206-5e76-4aaf-89c5-6ac392dce84b","title":"边界场景（3）"}],"collapsed":true,"id":"d7a28a0f-98c1-4544-874d-521a4f9a3684","title":"新增提示词"},{"parent":"c6df07b1-d9ae-4ba7-b45d-a3c72d221454","callout":[],"children":[{"parent":"a3871652-1387-434e-acdb-29e3066e7b90","callout":[],"children":[{"parent":"ec9d3137-012f-4966-882b-96022a7739e0","callout":[],"children":[{"parent":"84b00093-1688-48b6-821d-c432fbfa710b","callout":[],"children":[],"id":"12f7d7f5-8de7-4d5e-ba09-28eaf7c6ec71","title":"前置：前置：已保存多条提示词；角色：房间成员；入口：提示词弹窗搜索框"},{"parent":"84b00093-1688-48b6-821d-c432fbfa710b","callout":[],"children":[],"id":"8420d9a8-1611-4cba-95ee-ac546e0291d3","title":"操作：输入某条提示词正文中的部分字符"},{"parent":"84b00093-1688-48b6-821d-c432fbfa710b","callout":[],"children":[],"id":"2fe50471-2390-426c-bc71-2d54d246a6d4","title":"预期：模糊匹配出正文包含该字符的提示词；结果条目展示标题并可直接点击使用；清空搜索恢复完整列表"}],"collapsed":true,"id":"84b00093-1688-48b6-821d-c432fbfa710b","title":"🟠【P1】按提示词内容模糊搜索"},{"parent":"ec9d3137-012f-4966-882b-96022a7739e0","callout":[],"children":[{"parent":"a421b643-eefe-4065-aa50-f5c225aeda98","callout":[],"children":[],"id":"5f717b5f-5a49-470f-9b8c-62b52ac50ca0","title":"前置：前置：已保存多条提示词；角色：房间成员；入口：提示词弹窗搜索框"},{"parent":"a421b643-eefe-4065-aa50-f5c225aeda98","callout":[],"children":[],"id":"7c23e373-7a21-494c-8529-747a1cab2505","title":"操作：输入某条提示词标题中的部分字符"},{"parent":"a421b643-eefe-4065-aa50-f5c225aeda98","callout":[],"children":[],"id":"e4f0a91b-18e0-4237-89e1-ff252e3c6e15","title":"预期：模糊匹配出标题包含该字符的提示词；不匹配的条目不展示；清空搜索后完整列表恢复"}],"collapsed":true,"id":"a421b643-eefe-4065-aa50-f5c225aeda98","title":"🟠【P1】按标题模糊搜索"}],"collapsed":true,"id":"ec9d3137-012f-4966-882b-96022a7739e0","title":"正常场景（2）"},{"parent":"a3871652-1387-434e-acdb-29e3066e7b90","callout":[],"children":[{"parent":"b8727833-923a-4e14-a0d5-eb4b0918421e","callout":[],"children":[{"parent":"0072d7e4-c1d5-4acb-8e17-cac9cb62b9ac","callout":[],"children":[],"id":"9ee313dc-c3ca-4f58-82f7-10a649f11843","title":"前置：已保存若干提示词"},{"parent":"0072d7e4-c1d5-4acb-8e17-cac9cb62b9ac","callout":[],"children":[],"id":"fac8dd51-4736-48a8-ac37-8bd69f2bc95a","title":"操作：搜索一个不存在的关键词"},{"parent":"0072d7e4-c1d5-4acb-8e17-cac9cb62b9ac","callout":[],"children":[],"id":"361b7b1f-58e9-45b3-9583-9328189396b4","title":"预期：展示无结果空态，不显示加载中或残留上次结果"}],"collapsed":true,"id":"0072d7e4-c1d5-4acb-8e17-cac9cb62b9ac","title":"🟠【P1】搜索无匹配结果"}],"collapsed":true,"id":"b8727833-923a-4e14-a0d5-eb4b0918421e","title":"异常场景（1）"},{"parent":"a3871652-1387-434e-acdb-29e3066e7b90","callout":[],"children":[{"parent":"2f173ebc-cca0-47f1-aa08-a8dcfba2d4fe","callout":[],"children":[{"parent":"6c864f81-4b9e-431d-a4fe-b54edf4b8e75","callout":[],"children":[],"id":"1d48b1d3-cfae-4c25-b3a4-cbefc516926f","title":"前置：已保存若干提示词"},{"parent":"6c864f81-4b9e-431d-a4fe-b54edf4b8e75","callout":[],"children":[],"id":"f23fc4b9-ee2d-426c-a196-89c0c37e6919","title":"操作：用不同大小写和部分关键词搜索"},{"parent":"6c864f81-4b9e-431d-a4fe-b54edf4b8e75","callout":[],"children":[],"id":"53d19b9a-d3a7-4f51-938d-011890ab2a20","title":"预期：匹配不区分大小写且支持部分匹配，结果一致稳定"}],"collapsed":true,"id":"6c864f81-4b9e-431d-a4fe-b54edf4b8e75","title":"🟡【P2】搜索关键词大小写与部分匹配"}],"collapsed":true,"id":"2f173ebc-cca0-47f1-aa08-a8dcfba2d4fe","title":"边界场景（1）"}],"collapsed":true,"id":"a3871652-1387-434e-acdb-29e3066e7b90","title":"搜索提示词"},{"parent":"c6df07b1-d9ae-4ba7-b45d-a3c72d221454","callout":[],"children":[{"parent":"83f0fbce-fcb0-48e4-ac6d-4dcafdda1be0","callout":[],"children":[{"parent":"f7e8effe-b891-4a5d-9b6e-90efc30d519d","callout":[],"children":[{"parent":"314f158b-feef-4376-aef5-82a12ea4463a","callout":[],"children":[],"id":"c18907be-ee6d-408d-b0fe-cb4d48a24ae1","title":"前置：前置：账号下有两个及以上最近使用的提示词；角色：房间成员；入口：提示词弹窗排序入口"},{"parent":"314f158b-feef-4376-aef5-82a12ea4463a","callout":[],"children":[],"id":"7539ccf2-2c9e-4d48-b6de-dbd0f8a68fb2","title":"操作：点击进入排序模式，拖动调整顺序后点击完成"},{"parent":"314f158b-feef-4376-aef5-82a12ea4463a","callout":[],"children":[],"id":"0a0e6bec-92be-475a-a39a-8256468985f0","title":"预期：进入排序模式后条目可拖动；点击完成保存新顺序并退出排序模式；重新打开弹窗顺序保持为调整后的顺序"}],"collapsed":true,"id":"314f158b-feef-4376-aef5-82a12ea4463a","title":"🟠【P1】拖动排序并保存"}],"collapsed":true,"id":"f7e8effe-b891-4a5d-9b6e-90efc30d519d","title":"正常场景（1）"},{"parent":"83f0fbce-fcb0-48e4-ac6d-4dcafdda1be0","callout":[],"children":[{"parent":"c3f6f379-76c0-4134-bf79-61c643c5140d","callout":[],"children":[{"parent":"3e8d96a9-3671-4df7-bcc6-5c809e8b8a6e","callout":[],"children":[],"id":"c7919ff0-0486-4264-8e61-5abfd00f39f8","title":"前置：前置：搜索框中已输入关键词；角色：房间成员；入口：提示词弹窗排序入口"},{"parent":"3e8d96a9-3671-4df7-bcc6-5c809e8b8a6e","callout":[],"children":[],"id":"f7170781-6e9e-4712-a85c-f99ec9f42c63","title":"操作：悬浮并点击排序按钮，再清空搜索内容"},{"parent":"3e8d96a9-3671-4df7-bcc6-5c809e8b8a6e","callout":[],"children":[],"id":"d100ffba-acc6-4527-b40e-e92e44228584","title":"预期：搜索状态下排序按钮置灰不可点击，悬浮提示需清空搜索内容后才能调整顺序；清空搜索后按钮恢复可点击并能进入排序模式"}],"collapsed":true,"id":"3e8d96a9-3671-4df7-bcc6-5c809e8b8a6e","title":"🟠【P1】搜索状态下不可排序"}],"collapsed":true,"id":"c3f6f379-76c0-4134-bf79-61c643c5140d","title":"异常场景（1）"},{"parent":"83f0fbce-fcb0-48e4-ac6d-4dcafdda1be0","callout":[],"children":[{"parent":"6d49c47b-86f5-49aa-8604-72a5f3d4417e","callout":[],"children":[{"parent":"289e5089-66fc-40ef-8885-940914e205ac","callout":[],"children":[],"id":"ca2bfe80-10f6-488a-8711-109a32d72784","title":"前置：前置：账号下只保存了一个提示词；角色：房间成员；入口：提示词弹窗排序入口"},{"parent":"289e5089-66fc-40ef-8885-940914e205ac","callout":[],"children":[],"id":"bc23f660-7e5f-4551-8bb7-5ed7e285e65e","title":"操作：查看并点击排序按钮"},{"parent":"289e5089-66fc-40ef-8885-940914e205ac","callout":[],"children":[],"id":"b27379f6-fdb5-4347-8af9-f34ec03b48ac","title":"预期：排序按钮不可点击且置灰；点击无任何响应，不进入排序模式"}],"collapsed":true,"id":"289e5089-66fc-40ef-8885-940914e205ac","title":"🟡【P2】仅一个提示词时不可排序"},{"parent":"6d49c47b-86f5-49aa-8604-72a5f3d4417e","callout":[],"children":[{"parent":"fa9affdc-f580-4605-abf6-139f19c65279","callout":[],"children":[],"id":"0ccfb8f1-933e-4326-be2f-94977d3fee56","title":"前置：已保存多条提示词"},{"parent":"fa9affdc-f580-4605-abf6-139f19c65279","callout":[],"children":[],"id":"c9527291-d18e-45c2-9877-81f828014953","title":"操作：将一条提示词拖到列表最顶部和最底部"},{"parent":"fa9affdc-f580-4605-abf6-139f19c65279","callout":[],"children":[],"id":"148d57c8-eb3e-4587-9544-49384ddc020e","title":"预期：顺序正确保存，刷新后保持，不出现位置回弹"}],"collapsed":true,"id":"fa9affdc-f580-4605-abf6-139f19c65279","title":"🟡【P2】拖动到列表首尾位置"}],"collapsed":true,"id":"6d49c47b-86f5-49aa-8604-72a5f3d4417e","title":"边界场景（2）"}],"collapsed":true,"id":"83f0fbce-fcb0-48e4-ac6d-4dcafdda1be0","title":"调整提示词顺序"},{"parent":"c6df07b1-d9ae-4ba7-b45d-a3c72d221454","callout":[],"children":[{"parent":"3639b023-16f9-4791-bc2a-56d2157227db","callout":[],"children":[{"parent":"103fb457-8f77-4304-a86b-fdb94f0e88c8","callout":[],"children":[{"parent":"bb6184b8-8137-4366-a159-d7d6c7aeb935","callout":[],"children":[],"id":"c1cfbc77-b66b-4780-830d-8c36cad64842","title":"前置：前置：已保存提示词；角色：房间成员；入口：悬浮提示词条目出现的删除按钮"},{"parent":"bb6184b8-8137-4366-a159-d7d6c7aeb935","callout":[],"children":[],"id":"c51e31ae-4444-4dd3-8508-206d6c6814c7","title":"操作：点击删除弹出二次确认，先点取消再点删除"},{"parent":"bb6184b8-8137-4366-a159-d7d6c7aeb935","callout":[],"children":[],"id":"ed23e930-353f-415d-ac73-b700eed58fd5","title":"预期：点击取消时弹窗关闭且提示词保留；点击删除后该提示词从列表移除，条数减一；重新打开弹窗不再出现该提示词"}],"collapsed":true,"id":"bb6184b8-8137-4366-a159-d7d6c7aeb935","title":"🟠【P1】删除提示词二次确认"},{"parent":"103fb457-8f77-4304-a86b-fdb94f0e88c8","callout":[],"children":[{"parent":"8378e4dc-0e2a-4872-874f-d25c99319bf4","callout":[],"children":[],"id":"047f96df-8b51-481e-9fc0-4fedfab0fc68","title":"前置：前置：已保存提示词；角色：房间成员；入口：悬浮提示词条目出现的编辑按钮"},{"parent":"8378e4dc-0e2a-4872-874f-d25c99319bf4","callout":[],"children":[],"id":"8e299252-e68b-4d28-bf5a-de16c7307544","title":"操作：点击编辑，修改标题与内容后保存，再尝试清空内容保存"},{"parent":"8378e4dc-0e2a-4872-874f-d25c99319bf4","callout":[],"children":[],"id":"9aec68fd-7813-407e-8353-35a8d66dfc7f","title":"预期：编辑弹窗内标题与内容可修改并保存成功，列表展示更新后的标题；清空内容后保存按钮不可用；取消编辑不影响原提示词"}],"collapsed":true,"id":"8378e4dc-0e2a-4872-874f-d25c99319bf4","title":"🟠【P1】编辑提示词"}],"collapsed":true,"id":"103fb457-8f77-4304-a86b-fdb94f0e88c8","title":"正常场景（2）"},{"parent":"3639b023-16f9-4791-bc2a-56d2157227db","callout":[],"children":[{"parent":"61853f49-fc67-4c2a-bed1-0292f092cacc","callout":[],"children":[{"parent":"cfe98738-2acc-4acf-b9c8-c666252c9350","callout":[],"children":[],"id":"1b506a01-51fa-4b88-b0e2-a24f2453fe6a","title":"前置：输入框中已插入某提示词内容"},{"parent":"cfe98738-2acc-4acf-b9c8-c666252c9350","callout":[],"children":[],"id":"1add3b05-4ead-49a4-83fd-21bf57f784c4","title":"操作：删除该提示词模板"},{"parent":"cfe98738-2acc-4acf-b9c8-c666252c9350","callout":[],"children":[],"id":"37a27333-6797-4a04-89cd-da7da076f858","title":"预期：已插入输入框的内容不受影响；模板列表中该条被移除"}],"collapsed":true,"id":"cfe98738-2acc-4acf-b9c8-c666252c9350","title":"🟠【P1】删除正在使用的提示词"}],"collapsed":true,"id":"61853f49-fc67-4c2a-bed1-0292f092cacc","title":"异常场景（1）"},{"parent":"3639b023-16f9-4791-bc2a-56d2157227db","callout":[],"children":[{"parent":"519cf403-3329-4111-a2a7-a7495856ec7a","callout":[],"children":[{"parent":"8a7da4f4-5642-4284-97c4-fb30644d0147","callout":[],"children":[],"id":"92e524ab-94af-493a-acef-268d8e3835e7","title":"前置：已打开某提示词的编辑界面"},{"parent":"8a7da4f4-5642-4284-97c4-fb30644d0147","callout":[],"children":[],"id":"262c115f-a6f5-44a0-a2f4-6ad8fac904a9","title":"操作：修改内容后取消退出，再重新打开该提示词"},{"parent":"8a7da4f4-5642-4284-97c4-fb30644d0147","callout":[],"children":[],"id":"350f3e38-7582-40a1-ad31-efc45ecc68c7","title":"预期：内容保持修改前的状态，未保存的改动不生效"}],"collapsed":true,"id":"8a7da4f4-5642-4284-97c4-fb30644d0147","title":"🟡【P2】编辑后取消不保存"}],"collapsed":true,"id":"519cf403-3329-4111-a2a7-a7495856ec7a","title":"边界场景（1）"}],"collapsed":true,"id":"3639b023-16f9-4791-bc2a-56d2157227db","title":"编辑与删除提示词"},{"parent":"c6df07b1-d9ae-4ba7-b45d-a3c72d221454","callout":[],"children":[{"parent":"82010502-4904-4ef6-8ba0-0f36e8262352","callout":[],"children":[{"parent":"d727dea3-ba0a-4ce0-804a-d2c02a881d2a","callout":[],"children":[{"parent":"50449a70-fe03-4c63-9e96-0dfe5d9193ad","callout":[],"children":[],"id":"ec0d3c12-12e2-4a2e-8e7b-218e82c5e63e","title":"前置：前置：已进入推荐模板二级面板；角色：房间成员；入口：任一推荐模板"},{"parent":"50449a70-fe03-4c63-9e96-0dfe5d9193ad","callout":[],"children":[],"id":"e48cc850-c760-4ce5-9cb1-20ae3fc3f404","title":"操作：点击该模板，在自动填入内容的新增弹窗中点击保存"},{"parent":"50449a70-fe03-4c63-9e96-0dfe5d9193ad","callout":[],"children":[],"id":"9f79a13f-f294-4127-a172-ba70197e14ac","title":"预期：新增提示词弹窗自动填入模板标题与内容；保存后提示词填入会话输入框，并出现在一级面板最近使用列表中"}],"collapsed":true,"id":"50449a70-fe03-4c63-9e96-0dfe5d9193ad","title":"🟠【P1】保存推荐模板并填入输入框"},{"parent":"d727dea3-ba0a-4ce0-804a-d2c02a881d2a","callout":[],"children":[{"parent":"c59f1c34-2f56-41ae-9aad-0f1be405ffa2","callout":[],"children":[],"id":"35c41ba4-b09b-4c0c-9c82-2cd210ba1a8b","title":"前置：前置：账号已有最近使用的提示词；角色：房间成员；入口：提示词弹窗内「推荐」"},{"parent":"c59f1c34-2f56-41ae-9aad-0f1be405ffa2","callout":[],"children":[],"id":"d2c1ece2-4094-4d13-947f-9be28a254c90","title":"操作：点击推荐"},{"parent":"c59f1c34-2f56-41ae-9aad-0f1be405ffa2","callout":[],"children":[],"id":"d047eb2d-a169-4d66-a7f6-508c9fe24575","title":"预期：进入二级面板并展示推荐提示词模板列表；提供返回入口可回到一级面板"}],"collapsed":true,"id":"c59f1c34-2f56-41ae-9aad-0f1be405ffa2","title":"🟠【P1】进入推荐模板二级面板"}],"collapsed":true,"id":"d727dea3-ba0a-4ce0-804a-d2c02a881d2a","title":"正常场景（2）"},{"parent":"82010502-4904-4ef6-8ba0-0f36e8262352","callout":[],"children":[{"parent":"faa4c61e-7166-48ad-b065-f7c4b23f594e","callout":[],"children":[{"parent":"8efa9fc0-228f-40dd-81b9-4fa0247eaf3f","callout":[],"children":[],"id":"385de0eb-c2fb-4818-8a46-a61cd7f26c07","title":"前置：推荐提示词接口异常"},{"parent":"8efa9fc0-228f-40dd-81b9-4fa0247eaf3f","callout":[],"children":[],"id":"0458ed57-1da6-4cb8-bf0a-d4ecd050a189","title":"操作：查看推荐提示词区域"},{"parent":"8efa9fc0-228f-40dd-81b9-4fa0247eaf3f","callout":[],"children":[],"id":"1128d99e-993a-4243-9443-c3ed502c2ac5","title":"预期：展示失败提示与重试入口，不显示空白区域也不影响已保存提示词的使用"}],"collapsed":true,"id":"8efa9fc0-228f-40dd-81b9-4fa0247eaf3f","title":"🟠【P1】推荐列表加载失败"}],"collapsed":true,"id":"faa4c61e-7166-48ad-b065-f7c4b23f594e","title":"异常场景（1）"},{"parent":"82010502-4904-4ef6-8ba0-0f36e8262352","callout":[],"children":[{"parent":"388f895b-460e-4335-86df-8de677b8bf12","callout":[],"children":[{"parent":"d7cff8d2-3f94-47c9-81ca-17bf99c486ec","callout":[],"children":[],"id":"1a6dd5dc-4496-4bd2-8d69-2217f8ba67ab","title":"前置：推荐列表正常展示"},{"parent":"d7cff8d2-3f94-47c9-81ca-17bf99c486ec","callout":[],"children":[],"id":"ffd5c410-285a-4514-bf31-ae95b77db6dd","title":"操作：把一条推荐提示词保存到自己的模板列表"},{"parent":"d7cff8d2-3f94-47c9-81ca-17bf99c486ec","callout":[],"children":[],"id":"a0606d80-5196-4ea8-9e41-c4cc6afcb151","title":"预期：保存成功且内容完整，出现在自有列表中并可继续编辑"}],"collapsed":true,"id":"d7cff8d2-3f94-47c9-81ca-17bf99c486ec","title":"🟡【P2】将推荐提示词保存为自有模板"}],"collapsed":true,"id":"388f895b-460e-4335-86df-8de677b8bf12","title":"边界场景（1）"}],"collapsed":true,"id":"82010502-4904-4ef6-8ba0-0f36e8262352","title":"推荐提示词模板"},{"parent":"c6df07b1-d9ae-4ba7-b45d-a3c72d221454","callout":[],"children":[{"parent":"16c45987-d599-4c89-b808-269e2c2971fa","callout":[],"children":[{"parent":"6f0c6fba-da1d-44c3-babe-5f079f5cad76","callout":[],"children":[{"parent":"f767bf7c-dfb3-470d-b26b-7a319a2ac5cf","callout":[],"children":[],"id":"3b374b68-cd69-4440-a2bd-3def21e561b5","title":"前置：前置：一级面板存在已保存提示词；角色：房间成员；入口：提示词列表条目"},{"parent":"f767bf7c-dfb3-470d-b26b-7a319a2ac5cf","callout":[],"children":[],"id":"b488dba8-adcc-4b57-8d60-35e84baf6ca9","title":"操作：点击其中一条提示词"},{"parent":"f767bf7c-dfb3-470d-b26b-7a319a2ac5cf","callout":[],"children":[],"id":"29712534-ff2f-4f84-9e33-0080997fba1b","title":"预期：提示词内容自动填入会话输入框且弹窗关闭；输入框中原有内容与提示词内容按插入位置正确拼接，不覆盖已输入文字"}],"collapsed":true,"id":"f767bf7c-dfb3-470d-b26b-7a319a2ac5cf","title":"🟠【P1】一级面板点击提示词填入输入框"}],"collapsed":true,"id":"6f0c6fba-da1d-44c3-babe-5f079f5cad76","title":"正常场景（1）"},{"parent":"16c45987-d599-4c89-b808-269e2c2971fa","callout":[],"children":[{"parent":"88dd3119-6744-4ca5-8519-49753db3c792","callout":[],"children":[{"parent":"4e755fdb-e270-47bd-9f6f-808edd712356","callout":[],"children":[],"id":"f03771bf-cde7-4cfc-b985-f75094c5aba8","title":"前置：输入框中已有文本"},{"parent":"4e755fdb-e270-47bd-9f6f-808edd712356","callout":[],"children":[],"id":"dd6ae0b7-27bc-4597-a609-25160993cb39","title":"操作：选择并插入一条提示词"},{"parent":"4e755fdb-e270-47bd-9f6f-808edd712356","callout":[],"children":[],"id":"ad73e471-bbaf-42a0-a8ab-2a33bcb23cfb","title":"预期：按预期插入到光标位置且不覆盖已有内容，或有明确的替换提示"}],"collapsed":true,"id":"4e755fdb-e270-47bd-9f6f-808edd712356","title":"🟠【P1】在已有内容的输入框中插入提示词"}],"collapsed":true,"id":"88dd3119-6744-4ca5-8519-49753db3c792","title":"异常场景（1）"},{"parent":"16c45987-d599-4c89-b808-269e2c2971fa","callout":[],"children":[{"parent":"f0ed62e2-9097-4be5-8bd3-4bfb7c2ba7f7","callout":[],"children":[{"parent":"8889636b-6a45-4bd7-a8a7-2d611f8de77f","callout":[],"children":[],"id":"f471e3e5-401c-4477-ab5f-625cd962d062","title":"前置：已保存多条提示词"},{"parent":"8889636b-6a45-4bd7-a8a7-2d611f8de77f","callout":[],"children":[],"id":"0d6b0a00-3974-4ae2-9086-4151a97720fb","title":"操作：在同一输入框中连续插入两条提示词"},{"parent":"8889636b-6a45-4bd7-a8a7-2d611f8de77f","callout":[],"children":[],"id":"6e57a0ea-b29a-4969-98ab-aede7065463d","title":"预期：两条内容按插入顺序拼接，格式正常不粘连成一行"}],"collapsed":true,"id":"8889636b-6a45-4bd7-a8a7-2d611f8de77f","title":"🟡【P2】连续插入多条提示词"}],"collapsed":true,"id":"f0ed62e2-9097-4be5-8bd3-4bfb7c2ba7f7","title":"边界场景（1）"}],"collapsed":true,"id":"16c45987-d599-4c89-b808-269e2c2971fa","title":"使用已保存提示词"}],"collapsed":true,"id":"c6df07b1-d9ae-4ba7-b45d-a3c72d221454","title":"提示词模板"},{"parent":"a0b6f3c0-e11a-40fc-bcce-3f235b8e114f","callout":[],"children":[{"parent":"db70f347-fb1e-4774-bd9f-385cd0140af9","callout":[],"children":[],"id":"b142d09b-8c64-4474-86d8-9d7c9442ff5d","title":"说明：「任务」页签是 @ 面板的第三个页签（智能体 / 会话 / 任务 / 文件）。右上角依次为：房间选择（默认「本房间」，下拉可搜索房间，列出我加入的全部房间，当前房间打勾）、「分配给我 / 全部任务」切换（默认全部任务）、「包含已完成」勾选（默认不勾）。每行显示负责人（未分配显示「未分配」）、任务标题与状态（如「待办」）。已定口径：@ 后继续输入关键词，按任务标题在当前筛选范围内搜索；关闭面板再打开，筛选恢复默认；消息中的任务引用点击后打开任务详情，跨房间的跳到对应房间，无权限时提示无权限；发送时 Agent 读到的是任务当时的最新内容，任务已删除时提示引用失效。"},{"parent":"db70f347-fb1e-4774-bd9f-385cd0140af9","callout":[],"children":[{"parent":"cb0c3cb3-1752-4599-b029-67e114fce0a7","callout":[],"children":[{"parent":"16eae6f6-dc13-4dba-a167-4d6d3c882326","callout":[],"children":[{"parent":"2472cbdc-8b34-4a95-987e-454dda431f33","callout":[],"children":[],"id":"835947a6-04b7-473c-906f-08a869c24767","title":"前置：当前房间有分配给自己、分配给他人、未分配、已完成的任务各若干；角色：房间成员；入口：会话输入框"},{"parent":"2472cbdc-8b34-4a95-987e-454dda431f33","callout":[],"children":[],"id":"ee6d3d88-758b-48d7-8646-79251e3b3026","title":"操作：输入 @ 打开面板 → 点「任务」页签"},{"parent":"2472cbdc-8b34-4a95-987e-454dda431f33","callout":[],"children":[],"id":"3f127049-599c-4f5b-874a-69d0c773abb2","title":"预期：\n1) 菜单展示 ｜ 「任务」页签高亮，右上角显示「本房间」、「分配给我 / 全部任务」（默认全部任务）与「包含已完成」（默认不勾）\n2) 列表展示 ｜ 列出本房间未完成的全部任务，已完成的不出现\n3) 列表展示 ｜ 每行显示负责人头像与名称、任务标题与状态；没有负责人的显示「未分配」\n4) 视觉展示 ｜ 鼠标悬停的行高亮"}],"collapsed":true,"id":"2472cbdc-8b34-4a95-987e-454dda431f33","title":"🔴【P0】切到「任务」页签查看本房间任务"},{"parent":"16eae6f6-dc13-4dba-a167-4d6d3c882326","callout":[],"children":[{"parent":"3b0d5189-baed-4dd0-8da2-cbc94a07ce25","callout":[],"children":[],"id":"e5bb95bf-72e4-44b1-8102-c064129d727f","title":"前置：角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"3b0d5189-baed-4dd0-8da2-cbc94a07ce25","callout":[],"children":[],"id":"8ec46f9a-fb9c-422d-8711-b6a675ae667b","title":"操作：切到其他房间、选「分配给我」、勾「包含已完成」→ 关闭面板 → 重新输入 @ 并切到「任务」页签"},{"parent":"3b0d5189-baed-4dd0-8da2-cbc94a07ce25","callout":[],"children":[],"id":"a1e1b8f5-1f01-400d-80dd-7df564e26eea","title":"预期：\n1) 结果校验 ｜ 筛选恢复为「本房间」「全部任务」「不含已完成」，列表随之恢复"}],"collapsed":true,"id":"3b0d5189-baed-4dd0-8da2-cbc94a07ce25","title":"🟠【P1】关闭面板后筛选恢复默认"},{"parent":"16eae6f6-dc13-4dba-a167-4d6d3c882326","callout":[],"children":[{"parent":"3bd9b544-39d6-42e1-a10d-60b4d4682498","callout":[],"children":[],"id":"4a02d8c8-9708-4c8a-b4c2-926395dbc1db","title":"前置：角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"3bd9b544-39d6-42e1-a10d-60b4d4682498","callout":[],"children":[],"id":"a2e1e738-ef8b-43e3-9cff-75ba6aae98eb","title":"操作：在「任务」页签输入关键词并选「分配给我」→ 切到「会话」「文件」页签 → 再切回「任务」"},{"parent":"3bd9b544-39d6-42e1-a10d-60b4d4682498","callout":[],"children":[],"id":"88908444-afac-4eff-ba90-23eaf08c79fb","title":"预期：\n1) 结果校验 ｜ 「会话」「文件」页签保持各自的默认状态，不继承任务页签的筛选与关键词\n2) 结果校验 ｜ 面板未关闭时切回「任务」，筛选与关键词保持"}],"collapsed":true,"id":"3bd9b544-39d6-42e1-a10d-60b4d4682498","title":"🟠【P1】任务页签的筛选不影响其他页签"}],"id":"16eae6f6-dc13-4dba-a167-4d6d3c882326","title":"正常场景"},{"parent":"cb0c3cb3-1752-4599-b029-67e114fce0a7","callout":[],"children":[{"parent":"cc8e8d03-efb1-459f-b264-00b0224094d5","callout":[],"children":[{"parent":"083619c7-0118-408d-b17d-5a4b53fd9f42","callout":[],"children":[],"id":"41c3535a-a8f6-466c-8fe7-d1b9e0b5968f","title":"前置：网络异常；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"083619c7-0118-408d-b17d-5a4b53fd9f42","callout":[],"children":[],"id":"fdf6a6b3-ac9d-479e-8ffa-e41f62d6d7ee","title":"操作：切到「任务」页签；恢复网络后重新打开"},{"parent":"083619c7-0118-408d-b17d-5a4b53fd9f42","callout":[],"children":[],"id":"3b2644e4-b948-4cfb-a8e8-70dc53bd93a4","title":"预期：\n1) 提示文案 ｜ 提示加载失败并可重试，输入框里已输入的内容不丢失\n2) 恢复重试 ｜ 恢复后可正常加载"}],"collapsed":true,"id":"083619c7-0118-408d-b17d-5a4b53fd9f42","title":"🟡【P2】任务列表加载失败"}],"id":"cc8e8d03-efb1-459f-b264-00b0224094d5","title":"异常场景"},{"parent":"cb0c3cb3-1752-4599-b029-67e114fce0a7","callout":[],"children":[{"parent":"264c11f3-0489-4f5c-8612-811560b4be7d","callout":[],"children":[{"parent":"c162eef4-0edb-48d1-88c3-3bd96dba8582","callout":[],"children":[],"id":"255e1fbb-4c2d-4257-91f2-4ccff3cf284b","title":"前置：当前房间没有任何任务；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"c162eef4-0edb-48d1-88c3-3bd96dba8582","callout":[],"children":[],"id":"aeaeb36a-2bb2-433d-a75a-7050f54e94b4","title":"操作：查看「任务」页签；再勾选「包含已完成」"},{"parent":"c162eef4-0edb-48d1-88c3-3bd96dba8582","callout":[],"children":[],"id":"42f531d2-72c4-4973-aeff-78e7ac715a9e","title":"预期：\n1) 列表展示 ｜ 显示空态提示，不显示空白区域\n2) 按钮状态 ｜ 筛选控件仍可用，可切到其他房间"}],"collapsed":true,"id":"c162eef4-0edb-48d1-88c3-3bd96dba8582","title":"🟡【P2】本房间没有任务时的空态"},{"parent":"264c11f3-0489-4f5c-8612-811560b4be7d","callout":[],"children":[{"parent":"f3293309-5894-4114-978e-5d2b8ad679b5","callout":[],"children":[],"id":"37b33200-efba-4563-a0e2-8b68d1d7808f","title":"前置：存在标题与负责人名称都很长的任务；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"f3293309-5894-4114-978e-5d2b8ad679b5","callout":[],"children":[],"id":"d9921837-cfde-4e97-8813-d958f425935f","title":"操作：查看该行"},{"parent":"f3293309-5894-4114-978e-5d2b8ad679b5","callout":[],"children":[],"id":"1df5f21e-9cb5-4b90-958a-24b991904269","title":"预期：\n1) 视觉展示 ｜ 超长内容省略显示并可悬停查看全文，状态完整可见，不撑破面板"}],"collapsed":true,"id":"f3293309-5894-4114-978e-5d2b8ad679b5","title":"🟡【P2】任务标题或负责人名称超长"},{"parent":"264c11f3-0489-4f5c-8612-811560b4be7d","callout":[],"children":[{"parent":"e0582b86-6215-4848-ad60-4bc831c7a50a","callout":[],"children":[],"id":"10b8de3b-e2a1-4f1d-a9d8-8ea0c722e289","title":"前置：当前房间有 200 个以上任务；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"e0582b86-6215-4848-ad60-4bc831c7a50a","callout":[],"children":[],"id":"c0d4982d-2d75-4575-9b44-3e8d8ec546cd","title":"操作：从头滚动到底部，再用关键词定位其中一个"},{"parent":"e0582b86-6215-4848-ad60-4bc831c7a50a","callout":[],"children":[],"id":"1907ab4b-d037-4725-8978-00b6a283a6c9","title":"预期：\n1) 性能 ｜ 滚动流畅，搜索能快速定位"}],"collapsed":true,"id":"e0582b86-6215-4848-ad60-4bc831c7a50a","title":"🟡【P2】任务很多时的滚动与定位"}],"id":"264c11f3-0489-4f5c-8612-811560b4be7d","title":"边界场景"}],"id":"cb0c3cb3-1752-4599-b029-67e114fce0a7","title":"任务页签与列表展示"},{"parent":"db70f347-fb1e-4774-bd9f-385cd0140af9","callout":[],"children":[{"parent":"767d6024-7390-4e7c-98c9-969df31d3a88","callout":[],"children":[{"parent":"74c34fe7-e170-4e0d-9ad5-079df0b28dab","callout":[],"children":[{"parent":"8d83ae49-c348-4473-bd4a-6f1edef5caa3","callout":[],"children":[],"id":"41877699-a700-4190-aeaf-52df3b4d7862","title":"前置：当前房间有标题包含「视频上传」的任务；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"8d83ae49-c348-4473-bd4a-6f1edef5caa3","callout":[],"children":[],"id":"8e525d8a-84e9-4e30-977b-ddc53ba25426","title":"操作：在 @ 后继续输入「视频上传」；再改成英文关键词与大小写不同的写法"},{"parent":"8d83ae49-c348-4473-bd4a-6f1edef5caa3","callout":[],"children":[],"id":"d081ee25-3cad-4e05-8701-61eb79207c1b","title":"预期：\n1) 搜索筛选 ｜ 只列出标题匹配的任务\n2) 搜索筛选 ｜ 中英文、大小写都能匹配\n3) 搜索筛选 ｜ 搜索在当前房间与筛选条件范围内进行"}],"collapsed":true,"id":"8d83ae49-c348-4473-bd4a-6f1edef5caa3","title":"🔴【P0】按标题搜索任务"},{"parent":"74c34fe7-e170-4e0d-9ad5-079df0b28dab","callout":[],"children":[{"parent":"b93d83e4-bd72-4e39-b873-f1afd592ff04","callout":[],"children":[],"id":"9be708f5-2526-4867-9ee5-f85c6a3c30d5","title":"前置：当前房间有分配给自己与分配给他人的任务；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"b93d83e4-bd72-4e39-b873-f1afd592ff04","callout":[],"children":[],"id":"e5692bd7-c63a-449e-b372-9c539c48b2f6","title":"操作：点「分配给我」→ 再点「全部任务」"},{"parent":"b93d83e4-bd72-4e39-b873-f1afd592ff04","callout":[],"children":[],"id":"c8f59407-46b3-498c-8db3-a3ca49bd8aa8","title":"预期：\n1) 搜索筛选 ｜ 「分配给我」只显示负责人是自己的任务\n2) 搜索筛选 ｜ 切回「全部任务」后全部未完成任务恢复显示\n3) 视觉展示 ｜ 当前选中的一项高亮"}],"collapsed":true,"id":"b93d83e4-bd72-4e39-b873-f1afd592ff04","title":"🔴【P0】切换「分配给我」与「全部任务」"},{"parent":"74c34fe7-e170-4e0d-9ad5-079df0b28dab","callout":[],"children":[{"parent":"2a10f923-27f7-4127-9046-bece391d2004","callout":[],"children":[],"id":"299c7d07-49c2-4e36-b720-da4acf017793","title":"前置：当前房间有已完成的任务；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"2a10f923-27f7-4127-9046-bece391d2004","callout":[],"children":[],"id":"30eb1969-3421-4e2d-a8f5-0a74e31e170e","title":"操作：勾选「包含已完成」→ 再取消"},{"parent":"2a10f923-27f7-4127-9046-bece391d2004","callout":[],"children":[],"id":"01e7a80f-d028-47d1-9065-6b161c96a431","title":"预期：\n1) 搜索筛选 ｜ 勾选后已完成的任务出现，状态显示为已完成\n2) 搜索筛选 ｜ 取消后已完成的任务消失"}],"collapsed":true,"id":"2a10f923-27f7-4127-9046-bece391d2004","title":"🔴【P0】勾选「包含已完成」"},{"parent":"74c34fe7-e170-4e0d-9ad5-079df0b28dab","callout":[],"children":[{"parent":"57834a1c-e209-4074-a6cf-c7826f06a4f0","callout":[],"children":[],"id":"709fa3d9-f50d-4773-a7d6-49b693c3acff","title":"前置：自己加入了多个房间，房间「模型路由bug」有任务；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"57834a1c-e209-4074-a6cf-c7826f06a4f0","callout":[],"children":[],"id":"a31f30f3-b8a4-4768-a765-a676386b0835","title":"操作：点「本房间」打开房间下拉 → 在「搜索房间」里输入「模型路由」→ 选中「模型路由bug」"},{"parent":"57834a1c-e209-4074-a6cf-c7826f06a4f0","callout":[],"children":[],"id":"56d0e5c5-bcfc-4d13-b844-a99d174b8cd3","title":"预期：\n1) 菜单展示 ｜ 下拉顶部有「搜索房间」输入框，列出我加入的全部房间（本地与云端），当前房间打勾\n2) 搜索筛选 ｜ 输入关键词后只列出名称匹配的房间\n3) 列表展示 ｜ 选中后按钮显示该房间名，列表换成该房间的任务\n4) 结果校验 ｜ 「分配给我」「包含已完成」在新房间下照常生效"}],"collapsed":true,"id":"57834a1c-e209-4074-a6cf-c7826f06a4f0","title":"🔴【P0】切换到其他房间查看任务"},{"parent":"74c34fe7-e170-4e0d-9ad5-079df0b28dab","callout":[],"children":[{"parent":"ea9e505f-ed44-4b76-b0ff-d8bd5c383916","callout":[],"children":[],"id":"e61c1964-de2e-4179-a5eb-7b8779bd2183","title":"前置：角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"ea9e505f-ed44-4b76-b0ff-d8bd5c383916","callout":[],"children":[],"id":"d19f944c-2c40-4f3f-96c0-0904d2b24105","title":"操作：切到另一个房间 → 选「分配给我」→ 勾「包含已完成」→ 再输入关键词"},{"parent":"ea9e505f-ed44-4b76-b0ff-d8bd5c383916","callout":[],"children":[],"id":"b1fb2947-9a2a-43a4-8941-21c842828c51","title":"预期：\n1) 搜索筛选 ｜ 结果同时满足房间、负责人、完成状态与关键词四个条件"}],"collapsed":true,"id":"ea9e505f-ed44-4b76-b0ff-d8bd5c383916","title":"🟠【P1】多个筛选组合"}],"id":"74c34fe7-e170-4e0d-9ad5-079df0b28dab","title":"正常场景"},{"parent":"767d6024-7390-4e7c-98c9-969df31d3a88","callout":[],"children":[{"parent":"a905f0e7-185d-47b8-9559-1b441d76141b","callout":[],"children":[{"parent":"5b2fe186-11ec-4e1a-959e-723860663423","callout":[],"children":[],"id":"55dc90bf-52f1-45b1-b146-dc67bd19359f","title":"前置：自己已退出房间 X，从未加入房间 Y；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"5b2fe186-11ec-4e1a-959e-723860663423","callout":[],"children":[],"id":"89cf8d47-0bd2-4a7c-95af-fa9542773c52","title":"操作：打开房间下拉并搜索 X、Y 的名称"},{"parent":"5b2fe186-11ec-4e1a-959e-723860663423","callout":[],"children":[],"id":"0e512e3c-5d8c-4e89-b300-aa9404349b6e","title":"预期：\n1) 可见范围 ｜ X、Y 都不出现，它们的任务不能被查看或引用"}],"collapsed":true,"id":"5b2fe186-11ec-4e1a-959e-723860663423","title":"🟠【P1】没加入或已退出的房间不出现"},{"parent":"a905f0e7-185d-47b8-9559-1b441d76141b","callout":[],"children":[{"parent":"df8d06e1-ca58-4272-b8bc-7b3c8b783f00","callout":[],"children":[],"id":"49efff21-10d0-4d7e-afbf-21707a0c8890","title":"前置：角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"df8d06e1-ca58-4272-b8bc-7b3c8b783f00","callout":[],"children":[],"id":"63b56f57-1345-4fe1-bb1e-5e27dfc69854","title":"操作：输入一个不存在的标题；再删掉关键词"},{"parent":"df8d06e1-ca58-4272-b8bc-7b3c8b783f00","callout":[],"children":[],"id":"90ef2745-94e1-4d56-b126-e2a96713ecba","title":"预期：\n1) 提示文案 ｜ 显示无匹配的提示\n2) 恢复重试 ｜ 删掉关键词后列表恢复"}],"collapsed":true,"id":"df8d06e1-ca58-4272-b8bc-7b3c8b783f00","title":"🟡【P2】搜索任务无匹配"},{"parent":"a905f0e7-185d-47b8-9559-1b441d76141b","callout":[],"children":[{"parent":"eccbfa53-e7dd-4f8a-b517-8530bfd3218d","callout":[],"children":[],"id":"a904a436-f4ce-4813-a0c1-960b190568ef","title":"前置：角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"eccbfa53-e7dd-4f8a-b517-8530bfd3218d","callout":[],"children":[],"id":"ef7b5c75-1173-4678-86f2-5e32fb2a0414","title":"操作：在「搜索房间」里输入一个不存在的房间名"},{"parent":"eccbfa53-e7dd-4f8a-b517-8530bfd3218d","callout":[],"children":[],"id":"8b826352-f7b2-4662-9bbf-3944b28a487d","title":"预期：\n1) 提示文案 ｜ 下拉显示无匹配，当前房间选择不变"}],"collapsed":true,"id":"eccbfa53-e7dd-4f8a-b517-8530bfd3218d","title":"🟡【P2】搜索房间无匹配"}],"id":"a905f0e7-185d-47b8-9559-1b441d76141b","title":"异常场景"}],"id":"767d6024-7390-4e7c-98c9-969df31d3a88","title":"任务搜索与筛选"},{"parent":"db70f347-fb1e-4774-bd9f-385cd0140af9","callout":[],"children":[{"parent":"5ced78a1-579c-4e1e-98f4-7ea5a904d1f1","callout":[],"children":[{"parent":"8c3fd2cd-9f69-46a1-868a-2124ff443938","callout":[],"children":[{"parent":"baefb59a-9b38-4d73-afa7-b115e83addfc","callout":[],"children":[],"id":"d9f748d5-5fc2-4ceb-89a8-5e0ab1382ebe","title":"前置：本房间有任务「Agent会话：视频上传进度卡在最后阶段」（未分配、待办）；房间里有可用的 Agent；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"baefb59a-9b38-4d73-afa7-b115e83addfc","callout":[],"children":[],"id":"a2cec78f-4e65-427a-a8f7-f0149a8cee7a","title":"操作：点击该任务 → 在引用后输入「给出排查方案」并发送 → 等 Agent 回复 → 点击消息里的任务引用"},{"parent":"baefb59a-9b38-4d73-afa7-b115e83addfc","callout":[],"children":[],"id":"79f306eb-2529-40b1-98b1-6a26d4d70769","title":"预期：\n1) 输入框 ｜ 任务以引用标签插入输入框，显示任务标题，面板关闭，光标在引用之后\n2) 结果回传 ｜ Agent 读到任务的标题、状态与负责人，方案与任务内容对应\n3) 消息渲染 ｜ 消息中保留任务引用块\n4) 跳转定位 ｜ 点击引用打开该任务的详情\n5) 可见范围 ｜ 房间里其他成员也能看到这条引用并打开任务详情"}],"collapsed":true,"id":"baefb59a-9b38-4d73-afa7-b115e83addfc","title":"🔴【P0】引用本房间任务后让 Agent 处理 · 全链路"},{"parent":"8c3fd2cd-9f69-46a1-868a-2124ff443938","callout":[],"children":[{"parent":"5f6d42ac-0cd6-4cb2-94ec-857550d39c33","callout":[],"children":[],"id":"f0c3c450-2513-4682-b478-4b4d1ceb2858","title":"前置：自己加入的房间「Tutti-官网组」有任务 T；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"5f6d42ac-0cd6-4cb2-94ec-857550d39c33","callout":[],"children":[],"id":"85843e08-eca4-4640-a568-cd04f96ba6b6","title":"操作：切到「Tutti-官网组」→ 选 T → 发送给 Agent → 点击消息里的引用"},{"parent":"5f6d42ac-0cd6-4cb2-94ec-857550d39c33","callout":[],"children":[],"id":"df7822a5-3a54-4684-8e24-7033639f2e5b","title":"预期：\n1) 结果回传 ｜ Agent 读到 T 的内容\n2) 跳转定位 ｜ 点击引用跳到「Tutti-官网组」并打开 T 的详情"}],"collapsed":true,"id":"5f6d42ac-0cd6-4cb2-94ec-857550d39c33","title":"🔴【P0】引用其他房间的任务"},{"parent":"8c3fd2cd-9f69-46a1-868a-2124ff443938","callout":[],"children":[{"parent":"30038e0b-1ab4-41af-a89b-b5fbbfa63183","callout":[],"children":[],"id":"c4551dc6-943f-41b8-8475-f50a7dae08a6","title":"前置：角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"30038e0b-1ab4-41af-a89b-b5fbbfa63183","callout":[],"children":[],"id":"8ebca516-61d1-4a9d-a8ac-e9fa591939bd","title":"操作：用上下键在任务间移动，回车选中；再用退格删除引用标签"},{"parent":"30038e0b-1ab4-41af-a89b-b5fbbfa63183","callout":[],"children":[],"id":"55773f56-8865-4646-bcde-49bce3d83b06","title":"预期：\n1) 按钮状态 ｜ 上下键切换选中行，回车插入引用\n2) 输入框 ｜ 退格整体删除引用标签，不留残字"}],"collapsed":true,"id":"30038e0b-1ab4-41af-a89b-b5fbbfa63183","title":"🟠【P1】键盘选择任务与删除引用"},{"parent":"8c3fd2cd-9f69-46a1-868a-2124ff443938","callout":[],"children":[{"parent":"74347f5e-fe92-4c47-92b3-e394a815fca1","callout":[],"children":[],"id":"27f9068d-7b41-4fa3-880f-c14265d42dc0","title":"前置：本房间有任务 T1、T2；角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"74347f5e-fe92-4c47-92b3-e394a815fca1","callout":[],"children":[],"id":"c7961416-b416-488a-b266-3e87ec3b70df","title":"操作：依次 @ 引用 T1、T2，让 Agent 对比两个任务"},{"parent":"74347f5e-fe92-4c47-92b3-e394a815fca1","callout":[],"children":[],"id":"00bcf270-6862-4763-a818-52cbb5a67d87","title":"预期：\n1) 输入框 ｜ 两个引用标签都在输入框里\n2) 结果回传 ｜ Agent 同时读到两个任务的内容"}],"collapsed":true,"id":"74347f5e-fe92-4c47-92b3-e394a815fca1","title":"🟠【P1】一次引用多个任务"},{"parent":"8c3fd2cd-9f69-46a1-868a-2124ff443938","callout":[],"children":[{"parent":"9d39d1c9-6ed8-4785-91f6-0842192cc2b7","callout":[],"children":[],"id":"691b292a-a2dd-49ec-b75c-3856548e8dc3","title":"前置：角色：房间成员；入口：会话输入框"},{"parent":"9d39d1c9-6ed8-4785-91f6-0842192cc2b7","callout":[],"children":[],"id":"268d0b81-f419-4ab2-b4b3-49ef5380acaf","title":"操作：依次 @ 一个智能体、一条会话、一个文件、一个任务，下发指令"},{"parent":"9d39d1c9-6ed8-4785-91f6-0842192cc2b7","callout":[],"children":[],"id":"c36adad9-8dd8-4670-9133-4373cdd40a54","title":"预期：\n1) 等价性 ｜ 与「组合引用场景」的规则一致\n2) 结果回传 ｜ 被 @ 的智能体读到会话、文件与任务三类内容"}],"collapsed":true,"id":"9d39d1c9-6ed8-4785-91f6-0842192cc2b7","title":"🟠【P1】任务与会话、文件、智能体组合引用"}],"id":"8c3fd2cd-9f69-46a1-868a-2124ff443938","title":"正常场景"},{"parent":"5ced78a1-579c-4e1e-98f4-7ea5a904d1f1","callout":[],"children":[{"parent":"0f4d58a8-33b3-4de5-9ce6-15e3640b7b90","callout":[],"children":[{"parent":"32d959ef-41a7-4976-8b3f-a4a13fd1f607","callout":[],"children":[],"id":"289bd197-ce99-496e-9ae8-358e241371cc","title":"前置：已在输入框引用任务 T，尚未发送；角色：房间成员；入口：会话输入框"},{"parent":"32d959ef-41a7-4976-8b3f-a4a13fd1f607","callout":[],"children":[],"id":"3b8fd70b-cf5d-490e-9d78-22f17a3ef8b6","title":"操作：另一位成员把 T 的标题和状态改掉后，再发送"},{"parent":"32d959ef-41a7-4976-8b3f-a4a13fd1f607","callout":[],"children":[],"id":"0cd234ab-6a11-4a3e-92f8-ebf630606a9f","title":"预期：\n1) 结果回传 ｜ Agent 读到的是修改后的最新标题与状态，不是选中时的旧内容"}],"collapsed":true,"id":"32d959ef-41a7-4976-8b3f-a4a13fd1f607","title":"🟠【P1】引用后发送前任务被修改"},{"parent":"0f4d58a8-33b3-4de5-9ce6-15e3640b7b90","callout":[],"children":[{"parent":"5cddbc63-f76e-417f-8806-2a10c32d58dc","callout":[],"children":[],"id":"d7b3faad-7093-4d20-b568-1fa8e8070be9","title":"前置：已在输入框引用任务 T，尚未发送；角色：房间成员；入口：会话输入框"},{"parent":"5cddbc63-f76e-417f-8806-2a10c32d58dc","callout":[],"children":[],"id":"fb4ad387-0dd1-48ca-a99a-76c739a9d69c","title":"操作：另一位成员删除 T 后发送；再点击历史消息里对 T 的引用"},{"parent":"5cddbc63-f76e-417f-8806-2a10c32d58dc","callout":[],"children":[],"id":"78a9bcc9-3b63-4a42-a28e-8ee129b0369f","title":"预期：\n1) 提示文案 ｜ 发送时提示引用的任务已失效，不把旧内容发给 Agent\n2) 提示文案 ｜ 点击历史引用提示任务已删除，不报错"}],"collapsed":true,"id":"5cddbc63-f76e-417f-8806-2a10c32d58dc","title":"🟠【P1】引用的任务被删除"},{"parent":"0f4d58a8-33b3-4de5-9ce6-15e3640b7b90","callout":[],"children":[{"parent":"d2568db1-5d89-43c7-97ba-5d7807d1aa54","callout":[],"children":[],"id":"c408e524-a512-4d31-bc9c-a93a93798257","title":"前置：成员 A 在共享会话里引用了只有 A 所在房间能看的任务 T；成员 B 能看到该会话但不在 T 的房间；角色：成员 B；入口：会话详情"},{"parent":"d2568db1-5d89-43c7-97ba-5d7807d1aa54","callout":[],"children":[],"id":"9862b66b-eac6-421e-a4e2-845f78a24e63","title":"操作：B 点击消息里对 T 的引用"},{"parent":"d2568db1-5d89-43c7-97ba-5d7807d1aa54","callout":[],"children":[],"id":"ad346a3b-794f-4f59-97f7-2906a2e2b854","title":"预期：\n1) 权限授权 ｜ 提示无权限查看，不展示 T 的详情内容"}],"collapsed":true,"id":"d2568db1-5d89-43c7-97ba-5d7807d1aa54","title":"🟠【P1】没有权限的成员点击任务引用"}],"id":"0f4d58a8-33b3-4de5-9ce6-15e3640b7b90","title":"异常场景"},{"parent":"5ced78a1-579c-4e1e-98f4-7ea5a904d1f1","callout":[],"children":[{"parent":"0ff83163-e4ee-4fe4-a01e-5e2149b7ae78","callout":[],"children":[{"parent":"2280d0de-9cfe-45ec-9388-bc706a9a2591","callout":[],"children":[],"id":"689e499f-4d8f-4b0f-99ed-e1d04334c443","title":"前置：角色：房间成员；入口：会话输入框输入 @ →「任务」页签"},{"parent":"2280d0de-9cfe-45ec-9388-bc706a9a2591","callout":[],"children":[],"id":"7d089e3a-a30b-46f5-b4b7-14f968426009","title":"操作：勾选「包含已完成」后引用一个已完成任务并发送"},{"parent":"2280d0de-9cfe-45ec-9388-bc706a9a2591","callout":[],"children":[],"id":"faa84836-75c1-4b92-8b8e-e32794663f99","title":"预期：\n1) 结果回传 ｜ Agent 读到状态为已完成"}],"collapsed":true,"id":"2280d0de-9cfe-45ec-9388-bc706a9a2591","title":"🟡【P2】引用已完成的任务"}],"id":"0ff83163-e4ee-4fe4-a01e-5e2149b7ae78","title":"边界场景"}],"id":"5ced78a1-579c-4e1e-98f4-7ea5a904d1f1","title":"引用任务与执行"}],"id":"db70f347-fb1e-4774-bd9f-385cd0140af9","title":"@ 任务"}],"id":"a0b6f3c0-e11a-40fc-bcce-3f235b8e114f","title":"引用与输入增强"},{"parent":"28a940bb-0eef-4cac-8062-351774ac194f","callout":[],"children":[{"parent":"bdf50357-f876-4ee3-b76a-bbe899c8ccbd","callout":[],"children":[{"parent":"1a7e51f6-063c-4a42-ae51-0732caf96e03","callout":[],"children":[{"parent":"e8320fc2-b281-489c-9c98-1c2ad63fd359","callout":[],"children":[{"parent":"a9e76e91-726d-44e5-b3e8-4f25f50a069a","callout":[],"children":[{"parent":"9d267bf1-c7e8-4b80-91e9-8f6befd8c74c","callout":[],"children":[],"id":"89f30d59-2573-434b-a276-e2d17d9014e8","title":"操作：输入指令/init触发环境初始化"},{"parent":"9d267bf1-c7e8-4b80-91e9-8f6befd8c74c","callout":[],"children":[],"id":"56ab47d9-958c-43b4-9eec-f52b5188fcc8","title":"预期：Agent 完成会话环境、工作目录初始化，返回初始化成功提示，工作空间就绪"}],"collapsed":true,"id":"9d267bf1-c7e8-4b80-91e9-8f6befd8c74c","title":"🔴【P0】/init"},{"parent":"a9e76e91-726d-44e5-b3e8-4f25f50a069a","callout":[],"children":[{"parent":"813730ec-f87c-4144-a905-680b1420fef5","callout":[],"children":[],"id":"cb95122a-83d6-44fd-9c36-0332a1ab1521","title":"操作：切换 {Agent} Agent，下发绘图提示词「生成一张风景插画」"},{"parent":"813730ec-f87c-4144-a905-680b1420fef5","callout":[],"children":[],"id":"74bf26e6-1a96-4748-84c0-b00dadf8d490","title":"预期：{Agent} 正常生成图片并在对话展示；Nexight 等其他 Agent 下发同指令无法生成图片，不生成空白 / 破损图片"}],"collapsed":true,"id":"813730ec-f87c-4144-a905-680b1420fef5","title":"🔴【P0】Agent 生成图片","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"a9e76e91-726d-44e5-b3e8-4f25f50a069a","callout":[],"children":[{"parent":"b1515c58-9ff8-44d2-bcf0-0e5caddd149a","callout":[],"children":[],"id":"9bb0e7f6-e801-42a0-aec4-3cee36de4e81","title":"操作：Agent 完成任务后查看最终回复"},{"parent":"b1515c58-9ff8-44d2-bcf0-0e5caddd149a","callout":[],"children":[],"id":"7a5ae07e-dc72-4b21-bf8d-4b522524a11a","title":"预期：输出完成摘要、变更文件和后续建议"}],"collapsed":true,"id":"b1515c58-9ff8-44d2-bcf0-0e5caddd149a","title":"🔴【P0】任务完成总结","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"a9e76e91-726d-44e5-b3e8-4f25f50a069a","callout":[],"children":[{"parent":"3031d42f-b30a-4ee5-8804-7e2dbb950afc","callout":[],"children":[],"id":"75e41abf-1955-411c-a679-ad3c3eb06493","title"