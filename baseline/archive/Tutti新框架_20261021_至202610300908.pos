408a-8853-14f6c8a4223e","callout":[],"children":[],"id":"91b3189f-cade-4bea-97d6-f913ec128831","title":"预期：\n1) 结果校验 ｜ 只中断被拒绝的那一台，另一台不受影响"}],"collapsed":true,"id":"ef05128b-c56b-408a-8853-14f6c8a4223e","title":"🟠【P1】拒绝的是当前这台","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"a5b73b13-84bc-42a0-9412-174f3ff16173","title":"边界场景（1）"}],"id":"225a981c-cbb5-4dba-b29d-90746ec6f0bf","title":"拒绝授权与添加中断"},{"parent":"1b418dc7-8f38-4eec-8a4d-77705eae940d","callout":[],"children":[{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"70876506-73b2-4a76-a869-005b233de7c1","callout":[],"children":[{"parent":"6327e575-5585-424b-9668-62202319537a","callout":[],"children":[{"parent":"47f9e1f3-9c47-4cb3-8985-74b08ee01fda","callout":[],"children":[],"id":"e3b7a285-3a36-451a-8b28-4426de73e696","title":"前置：已登录 Web 端；角色：账号所有者；入口：左侧全局区的「电脑」"},{"parent":"47f9e1f3-9c47-4cb3-8985-74b08ee01fda","callout":[],"children":[],"id":"5fedcb39-0336-4c5c-984a-ce4df24bada3","title":"操作：进入电脑页，查看 Agent 列表中的 OpenCode"},{"parent":"47f9e1f3-9c47-4cb3-8985-74b08ee01fda","callout":[],"children":[],"id":"123b1716-d230-4da0-849b-f479218d1e2e","title":"预期：<br>1) 列表展示｜展示 OpenCode 图标、名称及当前状态，位置与产品设计一致<br>2) 状态展示｜状态文案与真实接入能力一致；截图基线为「待开放」<br>"}],"collapsed":true,"id":"47f9e1f3-9c47-4cb3-8985-74b08ee01fda","title":"🔴【P0】OpenCode 入口展示"},{"parent":"6327e575-5585-424b-9668-62202319537a","callout":[],"children":[{"parent":"53e10664-0bd7-4021-a767-6c49addaea29","callout":[],"children":[],"id":"f6407302-8bda-4c65-bc2a-3b0e09d23a85","title":"前置：Claude Code、Codex 或其他 Agent 至少一个可用"},{"parent":"53e10664-0bd7-4021-a767-6c49addaea29","callout":[],"children":[],"id":"818f882d-1ef6-4e0e-aea7-71c6967bc3c7","title":"操作：查看同一台电脑上的 Agent 列表"},{"parent":"53e10664-0bd7-4021-a767-6c49addaea29","callout":[],"children":[],"id":"b14476b0-6117-46d1-a71a-0692b920f81f","title":"预期：<br>1) 列表展示｜OpenCode 与其他 Agent 分栏/卡片边界清晰<br>2) 归属与状态｜OpenCode 的状态不受其他 Agent 在线状态变化影响<br>"}],"collapsed":true,"id":"53e10664-0bd7-4021-a767-6c49addaea29","title":"🔴【P0】OpenCode 与其他 Agent 独立展示"},{"parent":"6327e575-5585-424b-9668-62202319537a","callout":[],"children":[{"parent":"3a739b87-f57b-47ed-999d-ad57272c2ac1","callout":[],"children":[],"id":"5640038c-083b-430e-9055-79967825f7e1","title":"前置：账号下绑定 2 台及以上 Computer，且设备状态不同"},{"parent":"3a739b87-f57b-47ed-999d-ad57272c2ac1","callout":[],"children":[],"id":"4e1fc8c9-2450-454b-83b2-546ab5bfc42e","title":"操作：查看每台 Computer 的 OpenCode 行"},{"parent":"3a739b87-f57b-47ed-999d-ad57272c2ac1","callout":[],"children":[],"id":"f430e7d1-60de-4ca6-9eb7-6e724b4ced8f","title":"预期：<br>1) 设备状态｜每台设备分别展示 OpenCode 状态，不串设备<br>2) 排序与归属｜Computer 排序规则不变，OpenCode 显示在正确设备下<br>"}],"collapsed":true,"id":"3a739b87-f57b-47ed-999d-ad57272c2ac1","title":"🟠【P1】多个 Computer 上的 OpenCode 状态"},{"parent":"6327e575-5585-424b-9668-62202319537a","callout":[],"children":[{"parent":"5050f910-7f81-4873-a7eb-ff7012c77328","callout":[],"children":[],"id":"b389e986-ff5e-4239-af04-cf2cc42adbe8","title":"前置：已进入电脑页"},{"parent":"5050f910-7f81-4873-a7eb-ff7012c77328","callout":[],"children":[],"id":"d78f4f3e-6b6f-4514-84cb-6c4abd3e2724","title":"操作：点击右上角「刷新」，观察 OpenCode 状态"},{"parent":"5050f910-7f81-4873-a7eb-ff7012c77328","callout":[],"children":[],"id":"3ee524bd-55f6-405f-ab98-7e401b94f17e","title":"预期：<br>1) 持久化｜刷新后仍展示服务端返回的真实状态<br>2) 视觉反馈｜刷新过程中有明确加载反馈，不出现空白、重复卡片或旧状态长期残留<br>"}],"collapsed":true,"id":"5050f910-7f81-4873-a7eb-ff7012c77328","title":"🟠【P1】刷新后状态保持正确"}],"collapsed":true,"id":"6327e575-5585-424b-9668-62202319537a","title":"正常场景"},{"parent":"70876506-73b2-4a76-a869-005b233de7c1","callout":[],"children":[{"parent":"68a015cf-515c-4447-ac93-9bc2a24de908","callout":[],"children":[{"parent":"a4c0c1d1-b1f7-4079-bfd6-80492233c933","callout":[],"children":[],"id":"5fa416de-21ce-474b-996c-14aefa1f2418","title":"前置：已登录 Web 端"},{"parent":"a4c0c1d1-b1f7-4079-bfd6-80492233c933","callout":[],"children":[],"id":"15a1ec15-fac2-4026-8d13-3fcd25f85bdb","title":"操作：将窗口缩窄至 1024 及以下，并将页面缩放至 150%"},{"parent":"a4c0c1d1-b1f7-4079-bfd6-80492233c933","callout":[],"children":[],"id":"238c29de-7564-4955-954e-b8409fc0892b","title":"预期：<br>1) 视觉展示｜OpenCode 名称、图标、状态文案不重叠、不被截断到无法识别<br>2) 操作区域｜其他 Agent 的操作不被 OpenCode 卡片遮挡<br>"}],"collapsed":true,"id":"a4c0c1d1-b1f7-4079-bfd6-80492233c933","title":"🟡【P2】窄窗口与页面缩放"},{"parent":"68a015cf-515c-4447-ac93-9bc2a24de908","callout":[],"children":[{"parent":"6aae96a1-32d4-4310-b0ae-9798e0746214","callout":[],"children":[],"id":"79239e27-78f3-4378-9cd6-2f2bcb557ab8","title":"前置：已进入电脑页"},{"parent":"6aae96a1-32d4-4310-b0ae-9798e0746214","callout":[],"children":[],"id":"b390129e-0849-4d96-a319-924249ab549f","title":"操作：分别执行浏览器刷新、前进、后退后再次进入电脑页"},{"parent":"6aae96a1-32d4-4310-b0ae-9798e0746214","callout":[],"children":[],"id":"3eaadbdb-3d66-4b57-ab8e-a8562ce39c55","title":"预期：<br>1) 结果校验｜OpenCode 状态与页面首次进入时一致<br>2) 稳定性｜不出现重复请求导致的闪烁、错误弹窗或状态回退<br>"}],"collapsed":true,"id":"6aae96a1-32d4-4310-b0ae-9798e0746214","title":"🟡【P2】浏览器刷新与前进后退"}],"collapsed":true,"id":"68a015cf-515c-4447-ac93-9bc2a24de908","title":"边界场景"},{"parent":"70876506-73b2-4a76-a869-005b233de7c1","callout":[],"children":[{"parent":"90dd4add-6450-484d-8281-b360e4c21014","callout":[],"children":[{"parent":"206bbdb0-a9b3-49a1-be4e-06ee53693f63","callout":[],"children":[],"id":"f4caedd3-7d92-4de9-9f1b-932b55c76d97","title":"前置：Computer 在线，OpenCode 进程启动失败"},{"parent":"206bbdb0-a9b3-49a1-be4e-06ee53693f63","callout":[],"children":[],"id":"032da455-e9ea-41cf-b150-65e3f39b232f","title":"操作：刷新电脑页"},{"parent":"206bbdb0-a9b3-49a1-be4e-06ee53693f63","callout":[],"children":[],"id":"8ad76ac1-6547-4b08-869e-5081f905ee70","title":"预期：OpenCode 显示不可用或异常状态；提供原因提示；不影响同一 Computer 上其他 Agent。"}],"collapsed":true,"id":"206bbdb0-a9b3-49a1-be4e-06ee53693f63","title":"🟠【P1】Computer 在线但 OpenCode 启动失败"}],"collapsed":true,"id":"90dd4add-6450-484d-8281-b360e4c21014","title":"异常场景"}],"collapsed":true,"id":"70876506-73b2-4a76-a869-005b233de7c1","title":"全局电脑页"},{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"38d9612f-0b72-434c-b6b8-b06fbccb20f4","callout":[],"children":[{"parent":"3c9447aa-5c8c-48af-a9dc-574dfffeaad6","callout":[],"children":[{"parent":"4d663afb-0c97-4267-a3ed-88ff3384d73a","callout":[],"children":[],"id":"03b2aab4-f1bf-434d-ac0a-50d6a0561b40","title":"前置：当前账号有免费模型额度；模型在当前账号体系中可用"},{"parent":"4d663afb-0c97-4267-a3ed-88ff3384d73a","callout":[],"children":[],"id":"26b6c319-3f6d-49e5-8fb2-84753580fe0c","title":"操作：选择免费模型并发送普通任务"},{"parent":"4d663afb-0c97-4267-a3ed-88ff3384d73a","callout":[],"children":[],"id":"51f988d2-f487-40c6-bf6e-3abe9ad07acc","title":"预期：任务正常执行；模型名称、账号体系和额度消耗记录正确。<br>"}],"collapsed":true,"id":"4d663afb-0c97-4267-a3ed-88ff3384d73a","title":"🟠【P1】免费模型可用调用"},{"parent":"3c9447aa-5c8c-48af-a9dc-574dfffeaad6","callout":[],"children":[{"parent":"a3d4332e-8326-43e5-97d4-ad8fc35b47e3","callout":[],"children":[],"id":"17126e9d-1aa1-458c-86ff-74f1d1986ea0","title":"前置：用户拥有有效的 OpenCode API Key；Computer 在线"},{"parent":"a3d4332e-8326-43e5-97d4-ad8fc35b47e3","callout":[],"children":[],"id":"ed01a083-6a14-4ca9-89aa-42fd8e16f29b","title":"操作：选择纯 API 账号体系，配置 API Key 并保存"},{"parent":"a3d4332e-8326-43e5-97d4-ad8fc35b47e3","callout":[],"children":[],"id":"94db4a1a-6277-4f33-adf8-09d5f93029ee","title":"预期：<br>1) 配置结果｜配置成功并展示当前账号类型为「纯 API」<br>2) 调用结果｜可正常发起 OpenCode 任务，任务使用 API 账号对应的模型和权限<br>3) 安全性｜API Key 不明文展示，不出现在页面日志、会话内容或错误提示中<br>"}],"collapsed":true,"id":"a3d4332e-8326-43e5-97d4-ad8fc35b47e3","title":"🔴【P0】纯 API 账号配置"},{"parent":"3c9447aa-5c8c-48af-a9dc-574dfffeaad6","callout":[],"children":[{"parent":"d499b789-3e78-4ecc-b9f4-dd0817898a60","callout":[],"children":[],"id":"a1be8294-eefc-420e-902e-0eb7d6d688f6","title":"前置：用户拥有有效的 Go 套餐账号；已完成对应登录或授权"},{"parent":"d499b789-3e78-4ecc-b9f4-dd0817898a60","callout":[],"children":[],"id":"7b9131d1-8781-4e95-95c5-b6e50e4629a8","title":"操作：选择 Go 套餐账号体系并完成绑定"},{"parent":"d499b789-3e78-4ecc-b9f4-dd0817898a60","callout":[],"children":[],"id":"017e343a-e4c1-4b74-839b-ad3ff5e8b990","title":"预期：<br>1) 配置结果｜展示账号类型为「Go 套餐」<br>2) 调用结果｜可正常选择套餐支持的模型并发起任务<br>3) 额度信息｜展示或正确识别 Go 套餐的额度状态<br>"}],"collapsed":true,"id":"d499b789-3e78-4ecc-b9f4-dd0817898a60","title":"🔴【P0】Go 套餐账号配置"},{"parent":"3c9447aa-5c8c-48af-a9dc-574dfffeaad6","callout":[],"children":[{"parent":"de715a6f-b4a4-412e-acb5-9f4e49c701b6","callout":[],"children":[],"id":"cd76233d-2db8-4199-9e1b-76b4f7d0073c","title":"前置：用户拥有有效的 Zen 套餐账号；已完成对应登录或授权"},{"parent":"de715a6f-b4a4-412e-acb5-9f4e49c701b6","callout":[],"children":[],"id":"aa4e26e2-5e06-493f-a87c-6b86500f4f5d","title":"操作：选择 Zen 套餐账号体系并完成绑定"},{"parent":"de715a6f-b4a4-412e-acb5-9f4e49c701b6","callout":[],"children":[],"id":"a5da5bbf-04f8-4214-b345-4053f6780822","title":"预期：<br>1) 配置结果｜展示账号类型为「Zen 套餐」<br>2) 调用结果｜可正常选择套餐支持的模型并发起任务<br>3) 额度信息｜展示或正确识别 Zen 套餐的额度状态<br>"}],"collapsed":true,"id":"de715a6f-b4a4-412e-acb5-9f4e49c701b6","title":"🔴【P0】Zen 套餐账号配置"}],"collapsed":true,"id":"3c9447aa-5c8c-48af-a9dc-574dfffeaad6","title":"正常场景"},{"parent":"38d9612f-0b72-434c-b6b8-b06fbccb20f4","callout":[],"children":[{"parent":"c131129f-b105-4a0c-83a5-f5572feb2ebc","callout":[],"children":[{"parent":"1639089e-9188-4d4f-a7a5-87857cefda32","callout":[],"children":[],"id":"a04ba65e-6984-458e-b058-b37dac604bb0","title":"前置：配置错误、过期或撤销的 API Key"},{"parent":"1639089e-9188-4d4f-a7a5-87857cefda32","callout":[],"children":[],"id":"20086f7c-3e22-46cf-985e-6a50ce94ab04","title":"操作：发起 OpenCode 任务"},{"parent":"1639089e-9188-4d4f-a7a5-87857cefda32","callout":[],"children":[],"id":"0cf73a35-6a4b-4c90-b695-5d5048992d2e","title":"预期：<br>1) 调用拦截｜任务不进入执行中状态，不产生假成功结果<br>2) 提示文案｜明确提示认证失败或 API Key 无效<br>3) 信息安全｜不回显完整 API Key<br>"}],"collapsed":true,"id":"1639089e-9188-4d4f-a7a5-87857cefda32","title":"🔴【P0】纯 API Key 无效"},{"parent":"c131129f-b105-4a0c-83a5-f5572feb2ebc","callout":[],"children":[{"parent":"d1b5de54-28bc-4682-9c34-d11207e1cad8","callout":[],"children":[],"id":"f0ee9529-07a8-4b26-a79c-807b06dda67f","title":"前置：Go 套餐登录态过期、账号被退出或授权被撤销"},{"parent":"d1b5de54-28bc-4682-9c34-d11207e1cad8","callout":[],"children":[],"id":"cc15244c-4b84-479f-83da-cb6138789e2e","title":"操作：发起任务或刷新账号状态"},{"parent":"d1b5de54-28bc-4682-9c34-d11207e1cad8","callout":[],"children":[],"id":"1df08e86-13e8-4dc9-bb2d-0236809142e7","title":"预期：<br>1) 状态展示｜明确展示需要重新登录或授权<br>2) 任务处理｜任务被拦截，不长期停留在排队或运行中<br>3) 恢复能力｜重新授权后可继续使用，不需要重新绑定 Computer<br>"}],"collapsed":true,"id":"d1b5de54-28bc-4682-9c34-d11207e1cad8","title":"🔴【P0】Go 套餐授权失效"},{"parent":"c131129f-b105-4a0c-83a5-f5572feb2ebc","callout":[],"children":[{"parent":"555c5c75-f83f-44c1-9e19-b2f6d5cf461a","callout":[],"children":[],"id":"405b5065-3dd9-49fe-aca6-63d754b099af","title":"前置：Zen 套餐登录态过期、账号被退出或授权被撤销"},{"parent":"555c5c75-f83f-44c1-9e19-b2f6d5cf461a","callout":[],"children":[],"id":"006b56cb-ebf6-4c16-a041-fdb62b9b5b55","title":"操作：发起任务或刷新账号状态"},{"parent":"555c5c75-f83f-44c1-9e19-b2f6d5cf461a","callout":[],"children":[],"id":"248c9680-98e9-46de-b588-0b3a8f6f617c","title":"预期：与 Go 套餐授权失效的处理一致，且不影响其他账号体系。"}],"collapsed":true,"id":"555c5c75-f83f-44c1-9e19-b2f6d5cf461a","title":"🔴【P0】Zen 套餐授权失效"},{"parent":"c131129f-b105-4a0c-83a5-f5572feb2ebc","callout":[],"children":[{"parent":"913ef471-0b63-43b3-bd22-5dedbba03090","callout":[],"children":[],"id":"f5f5594c-0e52-423e-a7a5-a3bfc67bb778","title":"前置：同时配置纯 API、Go 套餐和 Zen 套餐，且默认账号不明确"},{"parent":"913ef471-0b63-43b3-bd22-5dedbba03090","callout":[],"children":[],"id":"5a7de735-89b6-494c-8326-89a781865eed","title":"操作：进入 OpenCode 配置或发起任务"},{"parent":"913ef471-0b63-43b3-bd22-5dedbba03090","callout":[],"children":[],"id":"660e7e96-12ff-4896-aa8a-a32ed8a7de08","title":"预期：<br>1) 选择明确｜展示当前生效账号，不静默随机选择<br>2) 调用一致｜任务使用页面明确显示的账号体系<br>3) 提示清晰｜必要时要求用户选择默认账号<br>"}],"collapsed":true,"id":"913ef471-0b63-43b3-bd22-5dedbba03090","title":"🟠【P1】账号体系配置冲突"}],"collapsed":true,"id":"c131129f-b105-4a0c-83a5-f5572feb2ebc","title":"异常场景"},{"parent":"38d9612f-0b72-434c-b6b8-b06fbccb20f4","callout":[],"children":[{"parent":"2aecba10-6259-4373-adea-f01e4b7f0243","callout":[],"children":[{"parent":"c16ed3c5-2e74-41b5-82a4-e0d380f457d1","callout":[],"children":[],"id":"cf2c9b8c-3ac6-403f-aeaf-db610f396339","title":"前置：同一 Go 或 Zen 账号在多个端登录"},{"parent":"c16ed3c5-2e74-41b5-82a4-e0d380f457d1","callout":[],"children":[],"id":"d88786c7-7e02-4d4c-8b7a-4f7586993901","title":"操作：一端修改授权或账号状态，另一端刷新并发起任务"},{"parent":"c16ed3c5-2e74-41b5-82a4-e0d380f457d1","callout":[],"children":[],"id":"f85b5cb5-5e92-4434-9884-894d27b85516","title":"预期：账号状态最终一致；失效状态及时同步；不出现一端显示可用但实际调用失败的长期错误。"}],"collapsed":true,"id":"c16ed3c5-2e74-41b5-82a4-e0d380f457d1","title":"🟡【P2】同一账号多端登录"}],"collapsed":true,"id":"2aecba10-6259-4373-adea-f01e4b7f0243","title":"边界场景"}],"collapsed":true,"id":"38d9612f-0b72-434c-b6b8-b06fbccb20f4","title":"OpenCode 账号体系与登录"},{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"f2719b79-7354-4702-9eb4-f9739f18bafa","callout":[],"children":[{"parent":"697a0cb1-48dc-4f70-a549-c8e1e5e20894","callout":[],"children":[],"id":"7d3f3ffe-218e-49f4-9f98-e116394276d0","title":"前置：服务端将 OpenCode 配置为可用；已进入电脑页"},{"parent":"697a0cb1-48dc-4f70-a549-c8e1e5e20894","callout":[],"children":[],"id":"57ff728a-8f3e-4524-a529-6b526c13d54a","title":"操作：选择 OpenCode"},{"parent":"697a0cb1-48dc-4f70-a549-c8e1e5e20894","callout":[],"children":[],"id":"f8b8919b-b1b3-423b-a5f3-613fb2434944","title":"预期：<br>1) 设备状态｜状态及时更新，不继续展示接入状态<br>2) 会话保护｜已有会话按产品定义收敛，新任务被拦截并给出原因，不产生丢失或无限排队<br>"}],"collapsed":true,"id":"697a0cb1-48dc-4f70-a549-c8e1e5e20894","title":"🔴【P0】点击接入的 OpenCode"},{"parent":"f2719b79-7354-4702-9eb4-f9739f18bafa","callout":[],"children":[{"parent":"03322a4e-ca25-48d2-bb4b-99b17a1e7643","callout":[],"children":[],"id":"f73e8e79-f759-4dfd-be79-2a5a2372ee84","title":"前置：OpenCode 初始可用，服务端撤销能力或服务异常"},{"parent":"03322a4e-ca25-48d2-bb4b-99b17a1e7643","callout":[],"children":[],"id":"90b6bdbb-524c-4f64-9022-143f61b632a5","title":"操作：刷新电脑页并尝试选择 OpenCode"},{"parent":"03322a4e-ca25-48d2-bb4b-99b17a1e7643","callout":[],"children":[],"id":"aa1109db-e35c-497f-a2d6-c19a7ba93621","title":"预期：<br>1) 设备状态｜状态及时更新，不继续展示可用状态<br>2) 会话保护｜已有会话按产品定义收敛，新任务被拦截并给出原因，不产生丢失或无限排队<br>"}],"collapsed":true,"id":"03322a4e-ca25-48d2-bb4b-99b17a1e7643","title":"🟠【P1】状态从可用变为待开放/不可用"}],"collapsed":true,"id":"f2719b79-7354-4702-9eb4-f9739f18bafa","title":"OpenCode 交互限制"},{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"172a146b-cf42-4ca9-a0ab-c84dc69e18a1","callout":[],"children":[{"parent":"3de51f0d-4bde-480a-946c-899a3a484236","callout":[],"children":[{"parent":"ab1ef579-c7cc-493e-8f30-58f452be20cd","callout":[],"children":[],"id":"02050e2c-0593-4281-9d36-a080a3d4e1ef","title":"前置：Computer 已绑定；项目目录包含 Git 仓库或明确的项目配置文件"},{"parent":"ab1ef579-c7cc-493e-8f30-58f452be20cd","callout":[],"children":[],"id":"928914ab-e6ff-4ac0-99ad-896131a5bdba","title":"操作：在项目目录启动 OpenCode，执行需要读取项目结构的任务"},{"parent":"ab1ef579-c7cc-493e-8f30-58f452be20cd","callout":[],"children":[],"id":"aa555843-2c53-43f0-aeba-f935456006cc","title":"预期：<br>1) 项目发现｜正确识别当前项目根目录，不误识别为上级目录或子目录<br>2) 上下文｜能够读取项目文件、目录结构和版本控制信息<br>"}],"collapsed":true,"id":"ab1ef579-c7cc-493e-8f30-58f452be20cd","title":"🔴【P0】自动识别项目根目录"},{"parent":"3de51f0d-4bde-480a-946c-899a3a484236","callout":[],"children":[{"parent":"a328beab-3cea-4296-b2bd-cb100095e62a","callout":[],"children":[],"id":"32c46b10-0cf4-47b8-96ad-027561160231","title":"前置：项目根目录存在 AGENTS.md，文件中配置明确规则，例如语言、禁止操作和测试命令"},{"parent":"a328beab-3cea-4296-b2bd-cb100095e62a","callout":[],"children":[],"id":"bb025445-9ab9-4d04-8fbb-0ce16bea877e","title":"操作：启动 OpenCode 并执行一个会触发规则的任务"},{"parent":"a328beab-3cea-4296-b2bd-cb100095e62a","callout":[],"children":[],"id":"9dfbf94f-b9e1-47cd-b905-ae573e1c97f1","title":"预期：<br>1) 规则加载｜自动读取并遵守根目录 AGENTS.md<br>2) 结果校验｜回复或执行结果体现文件中的规则，不需要用户重复粘贴<br>3) 可追溯性｜能够说明当前使用了哪一级 AGENTS.md 规则<br>"}],"collapsed":true,"id":"a328beab-3cea-4296-b2bd-cb100095e62a","title":"🔴【P0】自动加载 AGENTS.md"},{"parent":"3de51f0d-4bde-480a-946c-899a3a484236","callout":[],"children":[{"parent":"d5b4b71f-078b-4705-ac14-864bcb794f43","callout":[],"children":[],"id":"435db2cf-6bc8-4d09-995f-4db787c850dd","title":"前置：项目存在适用的 SKILL.md，文件包含任务流程和验证要求"},{"parent":"d5b4b71f-078b-4705-ac14-864bcb794f43","callout":[],"children":[],"id":"ae9f40d9-2149-4c86-90df-443a59dd3df7","title":"操作：执行与该 Skill 匹配的任务"},{"parent":"d5b4b71f-078b-4705-ac14-864bcb794f43","callout":[],"children":[],"id":"b5367954-6f15-4b97-8c47-d9cee4355c7c","title":"预期：<br>1) Skill 发现｜自动发现并加载适用的 SKILL.md<br>2) 流程遵守｜按照 Skill 要求执行，不跳过必要步骤<br>3) 结果校验｜按 Skill 要求产出验证结果或交付物<br>"}],"collapsed":true,"id":"d5b4b71f-078b-4705-ac14-864bcb794f43","title":"🔴【P0】自动加载 SKILL.md"},{"parent":"3de51f0d-4bde-480a-946c-899a3a484236","callout":[],"children":[{"parent":"0c45b14b-3103-47ed-b589-25fb50707ab8","callout":[],"children":[],"id":"ef5a17db-e9d6-4b66-8ff2-0354bc118f20","title":"前置：根目录、子目录分别存在 AGENTS.md 或 SKILL.md，且规则存在继承或覆盖关系"},{"parent":"0c45b14b-3103-47ed-b589-25fb50707ab8","callout":[],"children":[],"id":"beca0535-1240-4f25-9112-a42d17892e6d","title":"操作：在根目录和子目录分别启动 OpenCode 执行相同类型任务"},{"parent":"0c45b14b-3103-47ed-b589-25fb50707ab8","callout":[],"children":[],"id":"fad41e62-163e-44a5-938c-6fb8b9718c9c","title":"预期：<br>1) 规则范围｜根目录规则作用于全项目，子目录规则仅作用于对应范围<br>2) 优先级｜冲突时按照产品定义的优先级处理，不随机选择规则<br>3) 结果一致｜同一目录内多次执行结果遵守相同规则<br>"}],"collapsed":true,"id":"0c45b14b-3103-47ed-b589-25fb50707ab8","title":"🔴【P0】规则文件层级覆盖"},{"parent":"3de51f0d-4bde-480a-946c-899a3a484236","callout":[],"children":[{"parent":"9193b7ed-654e-4eff-ac31-1a663b94dfed","callout":[],"children":[],"id":"bccd2cd9-ed50-4e62-921a-3d4dd99b009c","title":"前置：项目中存在多个 Skill，其中只有一个与当前任务匹配"},{"parent":"9193b7ed-654e-4eff-ac31-1a663b94dfed","callout":[],"children":[],"id":"1edfd357-7f40-4390-8aa5-14f9d242585e","title":"操作：执行任务并查看 OpenCode 的规则选择"},{"parent":"9193b7ed-654e-4eff-ac31-1a663b94dfed","callout":[],"children":[],"id":"fdcf21e8-c7ac-4e1c-bef5-b9ddd9c829b5","title":"预期：<br>1) 匹配结果｜只加载适用 Skill，不误用无关 Skill<br>2) 资源控制｜不会因无关 Skill 全部加载导致明显变慢或上下文污染<br>"}],"collapsed":true,"id":"9193b7ed-654e-4eff-ac31-1a663b94dfed","title":"🟠【P1】多个 Skill 的匹配"},{"parent":"3de51f0d-4bde-480a-946c-899a3a484236","callout":[],"children":[{"parent":"6be97839-96a0-45a9-84a9-624ca89eceb6","callout":[],"children":[],"id":"dd1dd2b6-869a-4047-b46c-af3a57e73a27","title":"前置：项目不包含 AGENTS.md 或 SKILL.md"},{"parent":"6be97839-96a0-45a9-84a9-624ca89eceb6","callout":[],"children":[],"id":"d0dd7f70-a385-454d-b8be-7073b45a4bd8","title":"操作：启动 OpenCode 并执行普通任务"},{"parent":"6be97839-96a0-45a9-84a9-624ca89eceb6","callout":[],"children":[],"id":"516c8647-3693-4d13-92f8-fdf296ef81fb","title":"预期：<br>1) 容错｜正常执行，不因缺少可选规则文件崩溃<br>2) 提示｜如产品需要，明确说明未发现规则文件，不伪造已加载结果<br>"}],"collapsed":true,"id":"6be97839-96a0-45a9-84a9-624ca89eceb6","title":"🟠【P1】缺少规则文件"},{"parent":"3de51f0d-4bde-480a-946c-899a3a484236","callout":[],"children":[{"parent":"6033f237-71c3-4a4b-868e-9a7609a5201f","callout":[],"children":[],"id":"32276cbc-b667-473c-b352-a948f89e0327","title":"前置：AGENTS.md 或 SKILL.md 包含非法格式、空文件或无法解析的内容"},{"parent":"6033f237-71c3-4a4b-868e-9a7609a5201f","callout":[],"children":[],"id":"13e3bed2-fec5-45c8-a5eb-e3de9760a62a","title":"操作：启动 OpenCode 并执行任务"},{"parent":"6033f237-71c3-4a4b-868e-9a7609a5201f","callout":[],"children":[],"id":"d636db1a-7481-442d-b243-ad0485c7e3f9","title":"预期：<br>1) 异常提示｜明确指出文件路径和解析问题<br>2) 安全执行｜不因单个规则文件错误而误执行危险操作<br>3) 降级策略｜按产品定义跳过、回退或要求修复，不静默忽略<br>"}],"collapsed":true,"id":"6033f237-71c3-4a4b-868e-9a7609a5201f","title":"🟠【P1】规则文件格式错误"},{"parent":"3de51f0d-4bde-480a-946c-899a3a484236","callout":[],"children":[{"parent":"132cb24d-18c5-42b5-bb3e-ba63cf4186fb","callout":[],"children":[],"id":"09d6fbf9-106c-45a4-833f-e916550d59f5","title":"前置：项目通过符号链接打开，或路径包含大小写相近的目录名"},{"parent":"132cb24d-18c5-42b5-bb3e-ba63cf4186fb","callout":[],"children":[],"id":"8c9d51d6-7637-47cd-95a2-923b1d40d695","title":"操作：启动 OpenCode 并执行项目扫描"},{"parent":"132cb24d-18c5-42b5-bb3e-ba63cf4186fb","callout":[],"children":[],"id":"612067a3-cdb0-4537-b8b0-a616fc8586f4","title":"预期：<br>1) 路径识别｜项目根目录和规则文件定位正确<br>2) 防重复｜不因链接导致同一项目被重复扫描或重复加载<br>"}],"collapsed":true,"id":"132cb24d-18c5-42b5-bb3e-ba63cf4186fb","title":"🟡【P2】符号链接与大小写目录"}],"collapsed":true,"id":"3de51f0d-4bde-480a-946c-899a3a484236","title":"正常场景"},{"parent":"172a146b-cf42-4ca9-a0ab-c84dc69e18a1","callout":[],"children":[{"parent":"c3b2053e-9c31-42cc-b3e1-114fdc370aeb","callout":[],"children":[{"parent":"83e30555-86d2-49f4-88ad-1e5c007da8f5","callout":[],"children":[],"id":"068c0b94-5ebf-4d79-8f60-6c56b419964c","title":"前置：规则文件为空、损坏或格式错误"},{"parent":"83e30555-86d2-49f4-88ad-1e5c007da8f5","callout":[],"children":[],"id":"0a18fc35-cf6e-48df-ab09-609145480cfc","title":"操作：启动 OpenCode 并执行任务"},{"parent":"83e30555-86d2-49f4-88ad-1e5c007da8f5","callout":[],"children":[],"id":"cdbbf0c2-a535-4a62-9cde-63b205264438","title":"预期：指出具体文件和错误；不静默跳过；不因错误规则执行危险操作。"}],"collapsed":true,"id":"83e30555-86d2-49f4-88ad-1e5c007da8f5","title":"🟠【P1】AGENTS.md 或 SKILL.md 无法解析"},{"parent":"c3b2053e-9c31-42cc-b3e1-114fdc370aeb","callout":[],"children":[{"parent":"5b8a76ae-4b54-4c48-8e53-32f8520654fc","callout":[],"children":[],"id":"a6f4c4a8-3e1e-4e9c-a5c0-1a878cf05f3b","title":"前置：AGENTS.md 或 SKILL.md 与用户当前指令冲突"},{"parent":"5b8a76ae-4b54-4c48-8e53-32f8520654fc","callout":[],"children":[],"id":"02b0aabe-c978-49b8-afef-f4cacd4bfd38","title":"操作：执行任务"},{"parent":"5b8a76ae-4b54-4c48-8e53-32f8520654fc","callout":[],"children":[],"id":"cb2512fa-5f77-493f-abf5-6d1602c9f5ff","title":"预期：按系统安全策略和权限处理冲突；明确说明未执行的原因；不盲目服从项目文件中的危险指令。<br>"}],"collapsed":true,"id":"5b8a76ae-4b54-4c48-8e53-32f8520654fc","title":"🟠【P1】规则文件要求与用户指令冲突"}],"collapsed":true,"id":"c3b2053e-9c31-42cc-b3e1-114fdc370aeb","title":"异常场景"},{"parent":"172a146b-cf42-4ca9-a0ab-c84dc69e18a1","callout":[],"children":[{"parent":"06407a9d-803e-4f80-8d34-ac1b16e82904","callout":[],"children":[{"parent":"7daba79d-b2c8-4900-b840-2874af460487","callout":[],"children":[],"id":"1e0139ec-e5ee-467f-9db5-815153bc5ef9","title":"前置：根目录、子目录、父目录均存在规则文件"},{"parent":"7daba79d-b2c8-4900-b840-2874af460487","callout":[],"children":[],"id":"9874c774-b1a0-4803-b2b7-cf214a17894d","title":"操作：分别在不同目录执行任务"},{"parent":"7daba79d-b2c8-4900-b840-2874af460487","callout":[],"children":[],"id":"2b70014d-70f2-44c6-bd40-c81f9086852b","title":"预期：规则按目录范围和优先级生效；不重复加载、不遗漏适用规则。"}],"collapsed":true,"id":"7daba79d-b2c8-4900-b840-2874af460487","title":"🟡【P2】多层规则文件同时存在"},{"parent":"06407a9d-803e-4f80-8d34-ac1b16e82904","callout":[],"children":[{"parent":"d7416351-e124-47f7-abc1-06ebcf1616b2","callout":[],"children":[],"id":"d3923c57-71de-4c04-b731-d60e44524924","title":"前置：OpenCode 会话已启动并已加载项目规则"},{"parent":"d7416351-e124-47f7-abc1-06ebcf1616b2","callout":[],"children":[],"id":"2a918a48-3a95-4894-a0f2-0e393603b474","title":"操作：修改 AGENTS.md 或 SKILL.md 后重新发起任务"},{"parent":"d7416351-e124-47f7-abc1-06ebcf1616b2","callout":[],"children":[],"id":"50aa4172-d279-41f8-880d-e0e188bdc965","title":"预期：<br>1) 更新生效｜按产品定义重新加载或明确提示需要重启会话<br>2) 状态一致｜不得继续静默使用已失效规则<br>"}],"collapsed":true,"id":"d7416351-e124-47f7-abc1-06ebcf1616b2","title":"🟠【P1】规则文件动态修改"}],"collapsed":true,"id":"06407a9d-803e-4f80-8d34-ac1b16e82904","title":"边界场景"}],"collapsed":true,"id":"172a146b-cf42-4ca9-a0ab-c84dc69e18a1","title":"OpenCode 项目发现与规则加载&nbsp;<br>"},{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"8377fd64-7eb0-4c4f-856a-36e27ec7571b","callout":[],"children":[{"parent":"5069c343-a122-45a0-90a4-a7ee1eb77f76","callout":[],"children":[{"parent":"47330845-1fda-4dd0-8a7b-e6436b23900b","callout":[],"children":[],"id":"82a4dc73-0b40-4e2a-bd39-b0e30f8da0e0","title":"前置：OpenCode 状态为「可用」；用户已进入房间"},{"parent":"47330845-1fda-4dd0-8a7b-e6436b23900b","callout":[],"children":[],"id":"d7fe4ea2-b84d-41d4-88f8-86d8f53df77a","title":"操作：打开消息输入区的 Agent 选择器"},{"parent":"47330845-1fda-4dd0-8a7b-e6436b23900b","callout":[],"children":[],"id":"ece28667-e460-4019-9971-c6a8f456815f","title":"预期：<br>1) 列表展示｜展示「我的 OpenCode」、图标、所属 Computer 和「可用」状态<br>2) 归属信息｜所属设备名称与电脑页展示一致<br>"}],"collapsed":true,"id":"47330845-1fda-4dd0-8a7b-e6436b23900b","title":"🔴【P0】房间 Agent 选择器展示 OpenCode"},{"parent":"5069c343-a122-45a0-90a4-a7ee1eb77f76","callout":[],"children":[{"parent":"bf27456c-acfe-4eb0-b6c6-19d10bbd656c","callout":[],"children":[],"id":"425a8938-ce10-4fe3-b8c0-4a90311e1058","title":"前置：OpenCode 状态为「可用」；用户已进入房间"},{"parent":"bf27456c-acfe-4eb0-b6c6-19d10bbd656c","callout":[],"children":[],"id":"0c3dab08-19be-497f-aa0f-6b8f02e94da9","title":"操作：在 Agent 选择器中选择 OpenCode"},{"parent":"bf27456c-acfe-4eb0-b6c6-19d10bbd656c","callout":[],"children":[],"id":"c01bbdef-5f37-4c4c-8eb6-d13c4e0d8920","title":"预期：<br>1) 选择结果｜选择器展示当前已选 OpenCode<br>2) 发送能力｜输入框和发送按钮可正常使用<br>3) 会话归属｜新任务发送到所选 OpenCode，不误发给 Claude Code、Codex 或 Tutti Agent<br>"}],"collapsed":true,"id":"bf27456c-acfe-4eb0-b6c6-19d10bbd656c","title":"🔴【P0】选择我的 OpenCode"},{"parent":"5069c343-a122-45a0-90a4-a7ee1eb77f76","callout":[],"children":[{"parent":"5a399da7-ebf0-4efd-9ffc-9ee8a7e8568e","callout":[],"children":[],"id":"ec521b01-6089-4f54-b178-6d7b9f399d06","title":"前置：房间内已选择 OpenCode"},{"parent":"5a399da7-ebf0-4efd-9ffc-9ee8a7e8568e","callout":[],"children":[],"id":"18798e4c-f1b7-40fc-a425-0f0ffa4b0e3f","title":"操作：发送一条可识别的测试指令"},{"parent":"5a399da7-ebf0-4efd-9ffc-9ee8a7e8568e","callout":[],"children":[],"id":"b611f8a2-efe0-4681-afd6-b6ef75ca1f67","title":"预期：<br>1) 消息展示｜回复明确标识来自 OpenCode<br>2) Agent 信息｜展示 OpenCode 名称、图标及所属 Computer<br>3) 会话历史｜刷新或重新进入房间后，消息和 Agent 归属不改变<br>"}],"collapsed":true,"id":"5a399da7-ebf0-4efd-9ffc-9ee8a7e8568e","title":"🔴【P0】OpenCode 回复归属正确"},{"parent":"5069c343-a122-45a0-90a4-a7ee1eb77f76","callout":[],"children":[{"parent":"8d3ae12c-4870-437f-ae21-6df177165bfc","callout":[],"children":[],"id":"0f1182ba-bca7-4f06-b371-6d8b17b1542d","title":"前置：房间内已有 OpenCode 会话；同一房间支持其他 Agent"},{"parent":"8d3ae12c-4870-437f-ae21-6df177165bfc","callout":[],"children":[],"id":"eec30876-3591-4cf2-80a3-731406211a5a","title":"操作：在 OpenCode、Claude Code、Codex 之间切换并分别发送任务"},{"parent":"8d3ae12c-4870-437f-ae21-6df177165bfc","callout":[],"children":[],"id":"df6db68b-92ef-426f-ba27-7bb57e5b5ac3","title":"预期：<br>1) 路由正确｜每条任务发送到当前选择的 Agent<br>2) 上下文隔离｜切换 Agent 不串用其他 Agent 的会话上下文<br>3) UI 状态｜选择器始终显示当前生效的 Agent<br>"}],"collapsed":true,"id":"8d3ae12c-4870-437f-ae21-6df177165bfc","title":"🔴【P0】切换 Agent 后发送任务"},{"parent":"5069c343-a122-45a0-90a4-a7ee1eb77f76","callout":[],"children":[{"parent":"903fa326-8e72-4df0-a197-c54f14ee0ebf","callout":[],"children":[],"id":"12e1d9d2-6e15-4699-a690-3df2f732cc35","title":"前置：OpenCode 状态变为离线、待开放或服务异常"},{"parent":"903fa326-8e72-4df0-a197-c54f14ee0ebf","callout":[],"children":[],"id":"f19e7022-ee1f-48b6-b9b5-6bae8be92ed3","title":"操作：打开 Agent 选择器并尝试选择 OpenCode"},{"parent":"903fa326-8e72-4df0-a197-c54f14ee0ebf","callout":[],"children":[],"id":"e1afb233-6685-4858-9296-659d246556db","title":"预期：<br>1) 状态同步｜显示真实不可用状态<br>2) 交互限制｜不可选择或发送按钮被拦截<br>3) 会话保护｜已有历史会话可查看，发送新任务时给出明确提示<br>"}],"collapsed":true,"id":"903fa326-8e72-4df0-a197-c54f14ee0ebf","title":"🟠【P1】OpenCode 不可用时的房间表现"},{"parent":"5069c343-a122-45a0-90a4-a7ee1eb77f76","callout":[],"children":[{"parent":"7b0a2b00-34be-4071-bc2d-b8e6b4b4ce2e","callout":[],"children":[],"id":"d35c9a4e-003c-4470-a722-31a859ab23f9","title":"前置：进入房间并选择 OpenCode"},{"parent":"7b0a2b00-34be-4071-bc2d-b8e6b4b4ce2e","callout":[],"children":[],"id":"164739b3-0d22-4785-a8b4-560884a636c3","title":"操作：缩窄窗口或放大页面"},{"parent":"7b0a2b00-34be-4071-bc2d-b8e6b4b4ce2e","callout":[],"children":[],"id":"1ebb3e3c-addc-4138-81d1-e45f73537127","title":"预期：<br>1) 视觉展示｜OpenCode 名称、图标、模型/额度信息不重叠<br>2) 可操作性｜项目选择、附件、发送和 Agent 切换入口仍可点击<br>"}],"collapsed":true,"id":"7b0a2b00-34be-4071-bc2d-b8e6b4b4ce2e","title":"🟡【P2】输入区窄屏展示"}],"collapsed":true,"id":"5069c343-a122-45a0-90a4-a7ee1eb77f76","title":"正常场景"},{"parent":"8377fd64-7eb0-4c4f-856a-36e27ec7571b","callout":[],"children":[{"parent":"c89450ed-b3c1-4350-b54f-8f235d6e2774","callout":[],"children":[{"parent":"63e63dfc-0e58-4e6b-8ee9-e73ce7210a6d","callout":[],"children":[],"id":"a77d72e8-79ad-4939-92fa-2e8f8c91d816","title":"前置：房间已选择 OpenCode"},{"parent":"63e63dfc-0e58-4e6b-8ee9-e73ce7210a6d","callout":[],"children":[],"id":"e9234425-8b2f-41a3-9b5f-60b8629931a1","title":"操作：发送任务时关闭或断开 Computer"},{"parent":"63e63dfc-0e58-4e6b-8ee9-e73ce7210a6d","callout":[],"children":[],"id":"5f6bb457-c106-44c8-b42b-7baf5047fd8c","title":"预期：发送失败并提示掉线原因；不生成假成功消息；任务按产品定义取消或进入可恢复状态。"}],"collapsed":true,"id":"63e63dfc-0e58-4e6b-8ee9-e73ce7210a6d","title":"🟠【P1】发送任务时 OpenCode 掉线"},{"parent":"c89450ed-b3c1-4350-b54f-8f235d6e2774","callout":[],"children":[{"parent":"679d5b5c-19e6-4a5c-875f-538ca3197cdf","callout":[],"children":[],"id":"4b7d05ec-364a-43d5-9d16-00934bdd4b63","title":"前置：OpenCode 正在执行任务"},{"parent":"679d5b5c-19e6-4a5c-875f-538ca3197cdf","callout":[],"children":[],"id":"a2edc9c0-e415-4a6a-b49c-25954e2525ce","title":"操作：中断网络连接"},{"parent":"679d5b5c-19e6-4a5c-875f-538ca3197cdf","callout":[],"children":[],"id":"db3b4a8f-967f-42ff-a6c1-f5cad0992d17","title":"预期：会话状态收敛为失败或中断；日志不显示虚假完成；恢复网络后可按产品定义重试。"}],"collapsed":true,"id":"679d5b5c-19e6-4a5c-875f-538ca3197cdf","title":"🟠【P1】OpenCode 执行中网络中断"},{"parent":"c89450ed-b3c1-4350-b54f-8f235d6e2774","callout":[],"children":[{"parent":"a2a2ea1c-6d94-4ba3-ad8b-c0ad7f1f0cf0","callout":[],"children":[],"id":"9b010496-2bc7-4f5b-9f20-76aa6df20dc8","title":"前置：成员未被共享到 OpenCode 所在房间"},{"parent":"a2a2ea1c-6d94-4ba3-ad8b-c0ad7f1f0cf0","callout":[],"children":[],"id":"49df7040-cd51-407e-8591-e0eb2395b865","title":"操作：进入房间并尝试选择或发送 OpenCode 任务"},{"parent":"a2a2ea1c-6d94-4ba3-ad8b-c0ad7f1f0cf0","callout":[],"children":[],"id":"1c3216b1-27bc-445f-b291-1cec45705f1f","title":"预期：OpenCode 不可见或不可选；发送被拦截；不创建任务。"}],"collapsed":true,"id":"a2a2ea1c-6d94-4ba3-ad8b-c0ad7f1f0cf0","title":"🟠【P1】成员无权使用 OpenCode"}],"collapsed":true,"id":"c89450ed-b3c1-4350-b54f-8f235d6e2774","title":"异常场景"},{"parent":"8377fd64-7eb0-4c4f-856a-36e27ec7571b","callout":[],"children":[{"parent":"b7526316-9747-4055-8a9e-2aa3be467f36","callout":[],"children":[{"parent":"b40b7217-ae71-4447-8b17-a046b54594c4","callout":[],"children":[],"id":"0f61bbc9-3330-4086-bb0e-0e5aa5e6ac43","title":"前置：房间同时存在多个可用 Agent"},{"parent":"b40b7217-ae71-4447-8b17-a046b54594c4","callout":[],"children":[],"id":"f27f06a7-b545-44ac-8995-1cf4f220b24b","title":"操作：快速切换 OpenCode、Codex、Claude Code 并发送任务"},{"parent":"b40b7217-ae71-4447-8b17-a046b54594c4","callout":[],"children":[],"id":"442505b4-697d-4f35-b2b9-f897c0158f55","title":"预期：每条任务发送到最终选中的 Agent；不串上下文、不重复发送。"}],"collapsed":true,"id":"b40b7217-ae71-4447-8b17-a046b54594c4","title":"🟡【P2】多个 Agent 快速切换"},{"parent":"b7526316-9747-4055-8a9e-2aa3be467f36","callout":[],"children":[{"parent":"0c7735ba-a880-4fc5-af44-38bba4793850","callout":[],"children":[],"id":"9b41b693-7098-48d4-b643-e5fbfcfea928","title":"前置：多人房间已共享 OpenCode"},{"parent":"0c7735ba-a880-4fc5-af44-38bba4793850","callout":[],"children":[],"id":"92ab7df1-2ed4-4fdf-9d53-365f8db00eb4","title":"操作：多个成员同时发送任务"},{"parent":"0c7735ba-a880-4fc5-af44-38bba4793850","callout":[],"children":[],"id":"f5699220-f8ef-459a-962f-3761b690e1cf","title":"预期：消息、回复、成员和会话归属准确；任务顺序符合产品定义；不丢消息。"}],"collapsed":true,"id":"0c7735ba-a880-4fc5-af44-38bba4793850","title":"🟡【P2】多人同时发送任务"}],"collapsed":true,"id":"b7526316-9747-4055-8a9e-2aa3be467f36","title":"边界场景"}],"collapsed":true,"id":"8377fd64-7eb0-4c4f-856a-36e27ec7571b","title":"房间内opencode使用"},{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"693604e3-020f-4d59-9215-c1f2d0a42812","callout":[],"children":[{"parent":"05f13ae2-280a-4063-9c9f-105881e3b636","callout":[],"children":[{"parent":"467f605d-f818-49f6-a43d-c28be2422665","callout":[],"children":[],"id":"4a6afcf6-8877-4742-907f-bea4dd8bf035","title":"前置：账号已拥有可用 OpenCode；角色：账号所有者；入口：共享管理"},{"parent":"467f605d-f818-49f6-a43d-c28be2422665","callout":[],"children":[],"id":"b8170a07-ab07-4340-8df3-916328064ab1","title":"操作：进入共享管理页面并定位 OpenCode 卡片"},{"parent":"467f605d-f818-49f6-a43d-c28be2422665","callout":[],"children":[],"id":"ec25145c-dbc0-4572-aa41-e2672ec7fda0","title":"预期：<br>1) 卡片展示｜展示 OpenCode、所属 Computer 和当前共享房间数量<br>2) 数据一致｜与电脑页和房间 Agent 选择器中的名称、图标、设备一致<br>"}],"collapsed":true,"id":"467f605d-f818-49f6-a43d-c28be2422665","title":"🔴【P0】共享管理展示 OpenCode"},{"parent":"05f13ae2-280a-4063-9c9f-105881e3b636","callout":[],"children":[{"parent":"f66ee3eb-2574-4703-809f-d111f1282f7e","callout":[],"children":[],"id":"d580a7b9-a50e-4778-94bb-9ab18ec0a63d","title":"前置：新绑定 OpenCode；未配置共享房间"},{"parent":"f66ee3eb-2574-4703-809f-d111f1282f7e","callout":[],"children":[],"id":"487d1345-a7a1-4968-8dfa-db2f536f4ed0","title":"操作：查看 OpenCode 的共享管理卡片"},{"parent":"f66ee3eb-2574-4703-809f-d111f1282f7e","callout":[],"children":[],"id":"e3d37a52-dcf2-4bdd-bd88-f1e85323c906","title":"预期：<br>1) 默认状态｜共享房间数量为 0<br>2) 权限状态｜所有房间开关默认关闭，不因其他 Agent 的共享配置自动开启<br>"}],"collapsed":true,"id":"f66ee3eb-2574-4703-809f-d111f1282f7e","title":"🔴【P0】OpenCode 默认未共享"},{"parent":"05f13ae2-280a-4063-9c9f-105881e3b636","callout":[],"children":[{"parent":"ee96c8d8-9c78-4cf6-99e2-dcd93642df59","callout":[],"children":[],"id":"8a3c1a28-00f3-4c37-80b1-705c3672aad1","title":"前置：账号所有者进入 OpenCode 共享管理卡片"},{"parent":"ee96c8d8-9c78-4cf6-99e2-dcd93642df59","callout":[],"children":[],"id":"edc02c41-6764-4fae-bca7-1dc2f2c5e0bf","title":"操作：打开指定房间的共享开关"},{"parent":"ee96c8d8-9c78-4cf6-99e2-dcd93642df59","callout":[],"children":[],"id":"c920e9da-7c18-4607-b21e-e5304b093b84","title":"预期：<br>1) 持久化｜开关状态保存成功，刷新页面后保持开启<br>2) 房间可见｜该房间成员可在 Agent 选择器中看到 OpenCode<br>3) 权限边界｜未共享的房间仍看不到 OpenCode<br>"}],"collapsed":true,"id":"ee96c8d8-9c78-4cf6-99e2-dcd93642df59","title":"🔴【P0】将 OpenCode 共享到房间"},{"parent":"05f13ae2-280a-4063-9c9f-105881e3b636","callout":[],"children":[{"parent":"d1be621e-ab6a-4366-a3c5-c580945bd6e7","callout":[],"children":[],"id":"96f644c7-a702-4863-859c-c9776b0ac376","title":"前置：OpenCode 已共享到指定房间"},{"parent":"d1be621e-ab6a-4366-a3c5-c580945bd6e7","callout":[],"children":[],"id":"44732316-826c-436b-841a-6305b52be9ee","title":"操作：关闭该房间的共享开关"},{"parent":"d1be621e-ab6a-4366-a3c5-c580945bd6e7","callout":[],"children":[],"id":"5118e38f-f69f-4242-89aa-4ee821d7fe3b","title":"预期：<br>1) 持久化｜刷新后开关保持关闭，共享数量正确减少<br>2) 房间限制｜该房间不再允许新建 OpenCode 任务<br>3) 历史保留｜已有历史消息和产物按产品定义保留，不被误删<br>"}],"collapsed":true,"id":"d1be621e-ab6a-4366-a3c5-c580945bd6e7","title":"🔴【P0】取消 OpenCode 房间共享"},{"parent":"05f13ae2-280a-4063-9c9f-105881e3b636","callout":[],"children":[{"parent":"f1f337fb-1ea9-4684-9a1f-0b91dd9249c4","callout":[],"children":[],"id":"064c031e-9392-4e74-807d-8fc447fb3798","title":"前置：可配置房间超过页面默认展示数量"},{"parent":"f1f337fb-1ea9-4684-9a1f-0b91dd9249c4","callout":[],"children":[],"id":"0eea8861-5e2a-4b56-acb4-4bcbc1885214","title":"操作：点击「展开其余房间」"},{"parent":"f1f337fb-1ea9-4684-9a1f-0b91dd9249c4","callout":[],"children":[],"id":"5d740864-a0d8-4ce2-9949-81927ca99df9","title":"预期：<br>1) 列表展示｜展示全部可配置房间，房间名称和开关对应正确<br>2) 状态保持｜展开、收起不重置已配置的开关状态<br>"}],"collapsed":true,"id":"f1f337fb-1ea9-4684-9a1f-0b91dd9249c4","title":"🟠【P1】展开更多房间"},{"parent":"05f13ae2-280a-4063-9c9f-105881e3b636","callout":[],"children":[{"parent":"8bb0e065-409a-4ba5-ba6c-4c7f62600ea5","callout":[],"children":[],"id":"e82c2ebc-68a2-4368-a860-ea4cfd794707","title":"前置：模拟共享配置保存接口超时或返回 5xx"},{"parent":"8bb0e065-409a-4ba5-ba6c-4c7f62600ea5","callout":[],"children":[],"id":"30668f4f-552d-45a3-a936-2f16a8c773ae","title":"操作：切换 OpenCode 房间开关"},{"parent":"8bb0e065-409a-4ba5-ba6c-4c7f62600ea5","callout":[],"children":[],"id":"6efb81ea-7e71-4af3-ab48-9f2c5518350f","title":"预期：<br>1) 状态回滚｜保存失败时开关回到服务端真实状态<br>2) 提示文案｜明确提示保存失败并提供重试<br>3) 权限安全｜不能出现页面显示已开启但实际权限未开启的假状态<br>"}],"collapsed":true,"id":"8bb0e065-409a-4ba5-ba6c-4c7f62600ea5","title":"🟠【P1】共享管理接口失败"},{"parent":"05f13ae2-280a-4063-9c9f-105881e3b636","callout":[],"children":[{"parent":"1b994a46-9b68-433e-806c-cac1b50c4bc6","callout":[],"children":[],"id":"d6eda37b-3e91-44dc-bf74-71d8a4833cfb","title":"前置：存在多个房间，且房间名称较长"},{"parent":"1b994a46-9b68-433e-806c-cac1b50c4bc6","callout":[],"children":[],"id":"f752b250-bfe6-4f70-a62d-02c25e6a1b5d","title":"操作：缩窄窗口或放大页面，查看 OpenCode 卡片"},{"parent":"1b994a46-9b68-433e-806c-cac1b50c4bc6","callout":[],"children":[],"id":"e40466ca-d68b-4ee0-9c5d-256576f35868","title":"预期：<br>1) 视觉展示｜房间名称、共享开关、展开入口不重叠<br>2) 可操作性｜长名称可识别或可查看完整内容，开关仍可点击<br>"}],"collapsed":true,"id":"1b994a46-9b68-433e-806c-cac1b50c4bc6","title":"🟡【P2】共享管理窄屏与长房间名"}],"collapsed":true,"id":"05f13ae2-280a-4063-9c9f-105881e3b636","title":"正常场景"},{"parent":"693604e3-020f-4d59-9215-c1f2d0a42812","callout":[],"children":[{"parent":"9a69540f-7bcd-4d9a-97d6-97a3a1e31265","callout":[],"children":[{"parent":"3b294884-1f0b-4a3f-aa4e-6d116db08c53","callout":[],"children":[],"id":"7cae6d52-7ecb-47be-b2dd-b734aafa4c0d","title":"前置：进入 OpenCode 共享管理页；模拟接口失败"},{"parent":"3b294884-1f0b-4a3f-aa4e-6d116db08c53","callout":[],"children":[],"id":"4be4b1b2-3242-4a19-86f5-b5caafdddd94","title":"操作：开启或关闭房间共享开关"},{"parent":"3b294884-1f0b-4a3f-aa4e-6d116db08c53","callout":[],"children":[],"id":"a753a048-46e3-4987-98a8-f5c947f8639e","title":"预期：提示保存失败；开关回滚为服务端真实状态；不显示虚假的共享结果。<br>"}],"collapsed":true,"id":"3b294884-1f0b-4a3f-aa4e-6d116db08c53","title":"🟠【P1】保存共享配置失败"},{"parent":"9a69540f-7bcd-4d9a-97d6-97a3a1e31265","callout":[],"children":[{"parent":"e1ad2be6-fec9-4727-b7c6-8e738a364229","callout":[],"children":[],"id":"b7ec102c-5e9e-4403-bcce-1c82e3dd974a","title":"前置：成员正在使用 OpenCode，会话尚未结束"},{"parent":"e1ad2be6-fec9-4727-b7c6-8e738a364229","callout":[],"children":[],"id":"a8e30347-2c0d-4666-b128-ec24106dd692","title":"操作：关闭该房间的 OpenCode 共享"},{"parent":"e1ad2be6-fec9-4727-b7c6-8e738a364229","callout":[],"children":[],"id":"fb48b462-9abb-4649-a04d-bda47eb8e7bb","title":"预期：已有历史可按产品定义保留；新任务被禁止；正在执行的任务有明确的收敛提示。"}],"collapsed":true,"id":"e1ad2be6-fec9-4727-b7c6-8e738a364229","title":"🟠【P1】权限变更后已有会话处理"}],"collapsed":true,"id":"9a69540f-7bcd-4d9a-97d6-97a3a1e31265","title":"异常场景"},{"parent":"693604e3-020f-4d59-9215-c1f2d0a42812","callout":[],"children":[{"parent":"a6f570e8-a705-4416-8d7c-8e1538cbd7cc","callout":[],"children":[{"parent":"cdffe351-e8ff-45f8-a625-3a840b4a3272","callout":[],"children":[],"id":"ff36eb54-34d1-4a5f-81fb-d894ec97a31c","title":"前置：OpenCode 可共享到多个房间"},{"parent":"cdffe351-e8ff-45f8-a625-3a840b4a3272","callout":[],"children":[],"id":"9761640d-b881-4891-96c1-8513d5adee16","title":"操作：连续开启、关闭多个房间开关"},{"parent":"cdffe351-e8ff-45f8-a625-3a840b4a3272","callout":[],"children":[],"id":"4fac64e7-bd33-4aee-834c-32c2f2c48e89","title":"预期：每个房间状态独立保存；共享数量准确；不因一次失败覆盖其他房间结果。<br>"}],"collapsed":true,"id":"cdffe351-e8ff-45f8-a625-3a840b4a3272","title":"🟡【P2】同时修改多个房间开关"},{"parent":"a6f570e8-a705-4416-8d7c-8e1538cbd7cc","callout":[],"children":[{"parent":"c3413a30-e3fd-4668-a6e2-61788e813d76","callout":[],"children":[],"id":"cf3d6c36-1863-43fe-9020-2b684e45fd4d","title":"前置：存在长名称房间和大量可配置房间"},{"parent":"c3413a30-e3fd-4668-a6e2-61788e813d76","callout":[],"children":[],"id":"d9eb1a49-b059-483e-a48b-153d47284913","title":"操作：展开、收起并修改共享状态"},{"parent":"c3413a30-e3fd-4668-a6e2-61788e813d76","callout":[],"children":[],"id":"0bd6b71c-ecdc-455a-8fa0-38dbaf0764ab","title":"预期：名称可识别；开关与房间对应正确；滚动和展开不丢失状态。<br>"}],"collapsed":true,"id":"c3413a30-e3fd-4668-a6e2-61788e813d76","title":"🟡【P2】长房间名与大量房间"}],"collapsed":true,"id":"a6f570e8-a705-4416-8d7c-8e1538cbd7cc","title":"边界场景"}],"collapsed":true,"id":"693604e3-020f-4d59-9215-c1f2d0a42812","title":"OpenCode 共享管理与权限"},{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"7fb43a6f-49d9-477c-a222-1d482c361811","callout":[],"children":[{"parent":"e2acdd00-4f62-4ab6-963e-c5d7650a4282","callout":[],"children":[],"id":"e442d504-d45f-4202-a3e3-8ab288865310","title":"前置：项目包含源码、配置文件、忽略文件和敏感文件"},{"parent":"e2acdd00-4f62-4ab6-963e-c5d7650a4282","callout":[],"children":[],"id":"541026d4-6199-4798-afe4-f1dc693b2b35","title":"操作：要求 OpenCode 分析项目并修改指定文件"},{"parent":"e2acdd00-4f62-4ab6-963e-c5d7650a4282","callout":[],"children":[],"id":"54574560-1a34-47e1-86c1-ea9895b0d80a","title":"预期：<br>1) 文件范围｜读取和修改范围符合项目规则及用户指令<br>2) 忽略规则｜遵守 .gitignore 或产品定义的忽略规则<br>3) 安全性｜不主动读取或输出密钥、令牌、私钥等敏感内容<br>"}],"collapsed":true,"id":"e2acdd00-4f62-4ab6-963e-c5d7650a4282","title":"🔴【P0】项目文件读取范围正确"},{"parent":"7fb43a6f-49d9-477c-a222-1d482c361811","callout":[],"children":[{"parent":"ebd9f98b-a5ae-4119-b305-7b1b3a452ca2","callout":[],"children":[],"id":"efbe2cbd-fab9-477b-a859-4349505fefa2","title":"前置：AGENTS.md 指定唯一测试命令或禁止某些命令"},{"parent":"ebd9f98b-a5ae-4119-b305-7b1b3a452ca2","callout":[],"children":[],"id":"bcc9460e-5cc8-4b7c-9839-012a885bc36c","title":"操作：要求 OpenCode 修改代码并验证"},{"parent":"ebd9f98b-a5ae-4119-b305-7b1b3a452ca2","callout":[],"children":[],"id":"7752c51d-4e42-42e3-964f-bf8b040638ff","title":"预期：<br>1) 工具调用｜执行指定测试命令，不擅自替换为其他命令<br>2) 结果校验｜准确报告命令、退出码、失败原因和未执行项<br>"}],"collapsed":true,"id":"ebd9f98b-a5ae-4119-b305-7b1b3a452ca2","title":"🔴【P0】按 AGENTS.md 执行测试命令"},{"parent":"7fb43a6f-49d9-477c-a222-1d482c361811","callout":[],"children":[{"parent":"8f348e2e-94c0-46ef-a76d-ee1e9ffde15d","callout":[],"children":[],"id":"afa21a38-a2f2-4de5-865c-ce007299deba","title":"前置：同一 Computer 下存在多个项目或多个 Agent"},{"parent":"8f348e2e-94c0-46ef-a76d-ee1e9ffde15d","callout":[],"children":[],"id":"99bff3b9-ef33-41a9-8ff8-a589cfffe624","title":"操作：分别从不同项目发起 OpenCode 任务"},{"parent":"8f348e2e-94c0-46ef-a76d-ee1e9ffde15d","callout":[],"children":[],"id":"d8f49332-f755-412a-8710-6de26c2eca56","title":"预期：<br>1) 设备归属｜任务在正确的 Computer 上执行<br>2) 项目归属｜不会读取或修改另一个项目的文件<br>3) 会话隔离｜不同项目的上下文、历史和产物不串线<br>"}],"collapsed":true,"id":"8f348e2e-94c0-46ef-a76d-ee1e9ffde15d","title":"🔴【P0】OpenCode 会话归属正确"},{"parent":"7fb43a6f-49d9-477c-a222-1d482c361811","callout":[],"children":[{"parent":"cc80decc-80b1-4ed6-aca0-32e03b6778a2","callout":[],"children":[],"id":"29fe960b-6d9d-4861-9e63-b5a92bd78efb","title":"前置：OpenCode 正在执行长任务"},{"parent":"cc80decc-80b1-4ed6-aca0-32e03b6778a2","callout":[],"children":[],"id":"b97783ab-6238-408f-9a99-d845ef36f970","title":"操作：点击取消或中断会话"},{"parent":"cc80decc-80b1-4ed6-aca0-32e03b6778a2","callout":[],"children":[],"id":"7d4b5de0-1b5a-482d-9d94-a1cfd942b770","title":"预期：<br>1) 会话状态｜状态收敛为已取消/已中断，不长期显示运行中<br>2) 进程清理｜相关子进程按产品定义退出，不继续修改文件<br>3) 产物保护｜已产生的文件保持可追溯，不出现半写入损坏<br>"}],"collapsed":true,"id":"cc80decc-80b1-4ed6-aca0-32e03b6778a2","title":"🔴【P0】取消任务后进程收敛"},{"parent":"7fb43a6f-49d9-477c-a222-1d482c361811","callout":[],"children":[{"parent":"005c0c30-5f39-4caa-96d4-51c56bc6c58c","callout":[],"children":[],"id":"fc689f07-cefe-424f-867d-ffa08da9ee6b","title":"前置：同一 Computer 上同时运行两个 OpenCode 会话"},{"parent":"005c0c30-5f39-4caa-96d4-51c56bc6c58c","callout":[],"children":[],"id":"fd46920c-fd25-4a2e-8a01-bb40c5776092","title":"操作：分别要求修改不同文件并执行测试"},{"parent":"005c0c30-5f39-4caa-96d4-51c56bc6c58c","callout":[],"children":[],"id":"f67e9560-e303-4d0b-a517-2714215b3aba","title":"预期：<br>1) 资源隔离｜工作目录、环境变量和输出不串线<br>2) 任务状态｜一条任务失败不影响另一条任务<br>3) 结果归属｜每条会话展示自己的日志、文件变更和退出码<br>"}],"collapsed":true,"id":"005c0c30-5f39-4caa-96d4-51c56bc6c58c","title":"🟠【P1】并发任务隔离"},{"parent":"7fb43a6f-49d9-477c-a222-1d482c361811","callout":[],"children":[{"parent":"a9a4859d-5415-415a-9e40-f0fbc7edccbd","callout":[],"children":[],"id":"554f66f0-04e5-4548-bb66-006addfa504f","title":"前置：Computer 正在执行任务，且已有待执行任务"},{"parent":"a9a4859d-5415-415a-9e40-f0fbc7edccbd","callout":[],"children":[],"id":"e45aa7b8-dbf4-4cd9-a32f-1aa7d79f69dd","title":"操作：继续发送任务、取消其中一条，再恢复网络"},{"parent":"a9a4859d-5415-415a-9e40-f0fbc7edccbd","callout":[],"children":[],"id":"b9694928-a613-489c-ae43-7cd7d0dad34e","title":"预期：<br>1) 顺序｜队列顺序符合产品定义，不丢失、不重复执行<br>2) 重试｜仅重试失败或明确要求重试的任务<br>3) 幂等｜重试不会造成重复提交或重复修改<br>"}],"collapsed":true,"id":"a9a4859d-5415-415a-9e40-f0fbc7edccbd","title":"🟠【P1】排队与重试"},{"parent":"7fb43a6f-49d9-477c-a222-1d482c361811","callout":[],"children":[{"parent":"9b1bcc4a-9548-4625-8bb5-720d9da12861","callout":[],"children":[],"id":"792499af-96f1-428d-a51c-6a8a34cb5ba1","title":"前置：OpenCode 会话正在运行"},{"parent":"9b1bcc4a-9548-4625-8bb5-720d9da12861","callout":[],"children":[],"id":"8f5f7800-7237-4a72-931c-439cbd4a9c71","title":"操作：对所在 Computer 执行重启或升级"},{"parent":"9b1bcc4a-9548-4625-8bb5-720d9da12861","callout":[],"children":[],"id":"662a524c-5211-405b-8331-af3590ecf720","title":"预期：<br>1) 中断说明｜会话明确提示因 Computer 重启/升级而中断<br>2) 状态收敛｜不长期显示运行中，不生成假成功结果<br>3) 恢复后续性｜按产品定义支持在原会话继续或明确要求重新执行<br>"}],"collapsed":true,"id":"9b1bcc4a-9548-4625-8bb5-720d9da12861","title":"🟠【P1】Computer 重启或升级期间执行 OpenCode"}],"collapsed":true,"id":"7fb43a6f-49d9-477c-a222-1d482c361811","title":"OpenCode 任务执行与 Computer 联动"},{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"e87b6460-5eb2-4989-b4f5-8820bb8b7a5d","callout":[],"children":[{"parent":"8c848608-c80f-4cd0-93a1-dffd8cf49c1b","callout":[],"children":[],"id":"7880542f-dfa5-4ca8-bb42-0282bf00a1cb","title":"前置：Computer 使用支持范围内的 OpenCode 版本"},{"parent":"8c848608-c80f-4cd0-93a1-dffd8cf49c1b","callout":[],"children":[],"id":"de5904eb-2232-42af-8c14-a3b5864dabf4","title":"操作：查看版本并执行基本任务"},{"parent":"8c848608-c80f-4cd0-93a1-dffd8cf49c1b","callout":[],"children":[],"id":"67251cd0-0173-4359-b43d-ee0ed8b13268","title":"预期：<br>1) 版本展示｜Web 端、Computer 端和 OpenCode 实际版本一致<br>2) 兼容性｜支持版本可正常启动、发现项目和执行任务<br>"}],"collapsed":true,"id":"8c848608-c80f-4cd0-93a1-dffd8cf49c1b","title":"🔴【P0】OpenCode 版本兼容"},{"parent":"e87b6460-5eb2-4989-b4f5-8820bb8b7a5d","callout":[],"children":[{"parent":"3456e668-9c3a-45a2-a198-2513cf4907f2","callout":[],"children":[],"id":"1c4128cc-7f2f-4509-b2ec-8985c109b524","title":"前置：存在旧版本 OpenCode，项目含 AGENTS.md 和 SKILL.md"},{"parent":"3456e668-9c3a-45a2-a198-2513cf4907f2","callout":[],"children":[],"id":"03b8b9ce-739b-44bd-9005-fcc3fc65ab16","title":"操作：升级 OpenCode 后重新执行任务"},{"parent":"3456e668-9c3a-45a2-a198-2513cf4907f2","callout":[],"children":[],"id":"3d2bfed8-7248-43cb-b2ab-0ac69c35687f","title":"预期：<br>1) 回归｜升级不丢失项目发现和规则加载能力<br>2) 兼容｜旧项目无需额外迁移即可正常运行<br>"}],"collapsed":true,"id":"3456e668-9c3a-45a2-a198-2513cf4907f2","title":"🟠【P1】旧版本升级后规则仍生效"}],"collapsed":true,"id":"e87b6460-5eb2-4989-b4f5-8820bb8b7a5d","title":"升级与兼容性"},{"parent":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","callout":[],"children":[{"parent":"622724e3-3afd-4787-bf2d-dc832533b08e","callout":[],"children":[{"parent":"2a853c12-414e-479c-8095-f4f36a7be065","callout":[],"children":[],"id":"0e8f1846-ca34-45f7-a316-f53190d3d271","title":"前置：项目内规则文件包含危险命令、删除文件或访问外部系统的指令"},{"parent":"2a853c12-414e-479c-8095-f4f36a7be065","callout":[],"children":[],"id":"41d43aa7-107e-40cd-9a34-8cfe957416cb","title":"操作：启动 OpenCode 并执行普通任务"},{"parent":"2a853c12-414e-479c-8095-f4f36a7be065","callout":[],"children":[],"id":"90cdf394-6d2b-463a-9037-6b88ce247ef6","title":"预期：<br>1) 安全确认｜高风险操作仍需用户确认或按权限拦截<br>2) 指令边界｜AGENTS.md、SKILL.md 不能绕过系统安全策略和用户明确指令<br>3) 审计｜记录被拦截的操作及原因<br>"}],"collapsed":true,"id":"2a853c12-414e-479c-8095-f4f36a7be065","title":"🔴【P0】规则文件不可越权执行"},{"parent":"622724e3-3afd-4787-bf2d-dc832533b08e","callout":[],"children":[{"parent":"e995214c-489b-4306-b59c-7f31978b9ad7","callout":[],"children":[],"id":"b99ad02d-3819-4664-85bb-a79c19074e50","title":"前置：项目包含 .env、密钥文件、SSH 配置或私有凭证"},{"parent":"e995214c-489b-4306-b59c-7f31978b9ad7","callout":[],"children":[],"id":"1ac6c7bf-7e4f-44f2-9037-a4a9ce0575bb","title":"操作：要求 OpenCode 总结项目并查看日志、会话历史和产物"},{"parent":"e995214c-489b-4306-b59c-7f31978b9ad7","callout":[],"children":[],"id":"d5e5e09c-212c-49e7-b359-371f597d1851","title":"预期：<br>1) 脱敏｜日志、页面和最终回复不展示完整敏感值<br>2) 访问控制｜无权限文件不可被 OpenCode 读取或上传<br>"}],"collapsed":true,"id":"e995214c-489b-4306-b59c-7f31978b9ad7","title":"🔴【P0】敏感信息不泄露"},{"parent":"622724e3-3afd-4787-bf2d-dc832533b08e","callout":[],"children":[{"parent":"8ee1b57d-0b47-484d-b692-068ba6b8c543","callout":[],"children":[],"id":"6d5f7a57-e277-4461-869f-06ed74c688b3","title":"前置：账号成员已被授权查看电脑页，但无管理权限"},{"parent":"8ee1b57d-0b47-484d-b692-068ba6b8c543","callout":[],"children":[],"id":"1e990e80-f8f3-4975-bd66-1936f18f9ce6","title":"操作：进入电脑页并查看 OpenCode"},{"parent":"8ee1b57d-0b47-484d-b692-068ba6b8c543","callout":[],"children":[],"id":"d451b6d8-367f-47b5-b847-48092f912bbe","title":"预期：<br>1) 权限校验｜展示结果符合成员权限，不泄露不可见设备或内部配置<br>2) 操作限制｜不可执行超出权限的连接、配置或启用操作<br>"}],"collapsed":true,"id":"8ee1b57d-0b47-484d-b692-068ba6b8c543","title":"🔴【P0】非账号所有者查看 OpenCode"},{"parent":"622724e3-3afd-4787-bf2d-dc832533b08e","callout":[],"children":[{"parent":"53b0bb9e-c441-4592-b4d0-363aea2345eb","callout":[],"children":[],"id":"26f0f855-4c7c-47ed-92f8-91401c4cc5a7","title":"前置：模拟 OpenCode 状态接口超时或返回 5xx"},{"parent":"53b0bb9e-c441-4592-b4d0-363aea2345eb","callout":[],"children":[],"id":"ecc2ee1e-cfa4-44ae-9226-f0eec03da1e2","title":"操作：进入电脑页或点击刷新"},{"parent":"53b0bb9e-c441-4592-b4d0-363aea2345eb","callout":[],"children":[],"id":"d9799fb7-5840-4721-8700-c248f20e5a64","title":"预期：<br>1) 提示文案｜展示可理解的加载失败/暂时不可用提示<br>2) 可恢复性｜提供重试路径，不将接口失败误显示为「可用」<br>"}],"collapsed":true,"id":"53b0bb9e-c441-4592-b4d0-363aea2345eb","title":"🟠【P1】OpenCode 状态接口失败"},{"parent":"622724e3-3afd-4787-bf2d-dc832533b08e","callout":[],"children":[{"parent":"6b958431-609c-4e08-ba7d-ee204c3f6e06","callout":[],"children":[],"id":"2c4320de-1585-4301-bd0b-1f0c9bfc4b08","title":"前置：已进入电脑页，OpenCode 状态可正常展示"},{"parent":"6b958431-609c-4e08-ba7d-ee204c3f6e06","callout":[],"children":[],"id":"480ed9fa-d91a-47a8-8bb5-6e10063f353a","title":"操作：断网后点击刷新，再恢复网络并重试"},{"parent":"6b958431-609c-4e08-ba7d-ee204c3f6e06","callout":[],"children":[],"id":"2071200c-ebc3-4043-9182-95794edb026d","title":"预期：<br>1) 结果校验｜断网时不崩溃、不展示错误可用状态<br>2) 持久化｜网络恢复后可获取最新状态，其他 Agent 状态不被覆盖<br>"}],"collapsed":true,"id":"6b958431-609c-4e08-ba7d-ee204c3f6e06","title":"🟠【P1】网络中断后恢复"},{"parent":"622724e3-3afd-4787-bf2d-dc832533b08e","callout":[],"children":[{"parent":"581683b8-9a40-4991-bc68-dfba2e8335c8","callout":[],"children":[],"id":"d6635805-b366-49bc-ac21-0dba0f68ffdf","title":"前置：系统分别切换中文与英文"},{"parent":"581683b8-9a40-4991-bc68-dfba2e8335c8","callout":[],"children":[],"id":"98bda30d-d41d-4b4c-b4ec-8511d574f793","title":"操作：进入电脑页，查看 OpenCode 名称、状态及提示文案"},{"parent":"581683b8-9a40-4991-bc68-dfba2e8335c8","callout":[],"children":[],"id":"235db020-6d87-4fb8-b4e3-a404f8593441","title":"预期：<br>1) 文案校对｜翻译准确，无中英文混排错误、占位符或错别字<br>2) 一致性｜同一状态在电脑页、弹窗和拦截提示中的含义一致<br>"}],"collapsed":true,"id":"581683b8-9a40-4991-bc68-dfba2e8335c8","title":"🟡【P2】中英文文案"},{"parent":"622724e3-3afd-4787-bf2d-dc832533b08e","callout":[],"children":[{"parent":"5d359c19-c120-4f21-a425-8cac192637da","callout":[],"children":[],"id":"4fb4404f-5ba6-4243-a3db-db05d0d7c0fa","title":"前置：已进入电脑页"},{"parent":"5d359c19-c120-4f21-a425-8cac192637da","callout":[],"children":[],"id":"5b342f3d-ad01-4d1f-aeb2-97bd2755e812","title":"操作：连续点击 OpenCode、刷新按钮或状态区域"},{"parent":"5d359c19-c120-4f21-a425-8cac192637da","callout":[],"children":[],"id":"dcb15e57-ef89-4acf-a743-31d027c96759","title":"预期：<br>1) 幂等性｜只产生一次有效请求或一次提示<br>2) 稳定性｜不重复打开弹窗、不重复创建会话、不出现状态错乱<br>"}],"collapsed":true,"id":"5d359c19-c120-4f21-a425-8cac192637da","title":"🟡【P2】重复点击与快速刷新"}],"collapsed":true,"id":"622724e3-3afd-4787-bf2d-dc832533b08e","title":"安全与审计"}],"collapsed":true,"id":"c49e56e2-fbed-452e-8b86-5d8aeed60a96","title":"opencode"},{"parent":"1b418dc7-8f38-4eec-8a4d-77705eae940d","callout":[],"children":[{"parent":"a5f6893f-b31d-4420-9b5d-93e59b29bf88","callout":[],"children":[{"parent":"94048088-28b1-45ff-9dfb-4c8f066ca3b3","callout":[],"children":[{"parent":"3abc01da-a824-45cc-ad45-fb75bdf1e49b","callout":[],"children":[{"parent":"448fff1b-08e1-4e1c-8900-69d326286be7","callout":[],"children":[],"id":"3736beee-2c41-4767-b505-bc02c43b1e8d","title":"前置：中国大陆地区；已登录 Web 端；已绑定 Computer"},{"parent":"448fff1b-08e1-4e1c-8900-69d326286be7","callout":[],"children":[],"id":"034158cc-1da6-4bcd-97e6-5ba37149f712","title":"操作：进入电脑页，查看 Agent 列表中的 WorkBuddy"},{"parent":"448fff1b-08e1-4e1c-8900-69d326286be7","callout":[],"children":[],"id":"c4464a40-1065-47ec-b4be-dfe8c382393b","title":"预期：<br>1) 列表展示｜展示 WorkBuddy 图标、名称、所属 Computer 和状态<br>2) 状态展示｜可用状态与实际服务状态一致<br>"}],"collapsed":true,"id":"448fff1b-08e1-4e1c-8900-69d326286be7","title":"🔴【P0】WorkBuddy 入口展示","icons":[{"color":"rgb(0, 186, 74)","name":"completion","index":"317"}]},{"parent":"3abc01da-a824-45cc-ad45-fb75bdf1e49b","callout":[],"children":[{"parent":"0d87f749-1b4c-4736-9496-563bfa418777","callout":[],"children":[],"id":"fb4628ae-5936-499d-9e39-5f3e09afe709","title":"前置：WorkBuddy 可用"},{"parent":"0d87f749-1b4c-4736-9496-563bfa418777","callout":[],"children":[],"id":"061660bb-4c73-4148-9dc2-dc345f522bc6","title":"操作：点击 WorkBuddy 的模型来源入口"},{"parent":"0d87f749-1b4c-4736-9496-563bfa418777","callout":[],"children":[],"id":"39172924-5b73-44f6-997d-2b2310d30aba","title":"预期：<br>1) 弹窗展示｜打开「WorkBuddy · 模型来源」弹窗<br>2) 来源展示｜展示官方订阅、Tutti API、API Key 等来源<br>3) 状态展示｜当前已登录或已配置的来源状态正确展示<br>"}],"collapsed":true,"id":"0d87f749-1b4c-4736-9496-563bfa418777","title":"🔴【P0】WorkBuddy 模型来源弹窗","icons":[{"color":"rgb(0, 186, 74)","name":"completion","index":"317"}]},{"parent":"3abc01da-a824-45cc-ad45-fb75bdf1e49b","callout":[],"children":[{"parent":"0cd19ad2-797e-432c-b965-4dcec21140be","callout":[],"children":[],"id":"0fc769ce-e217-4f96-b3ab-fe55b677901e","title":"前置：Claude Code、Codex 或其他 Agent 可用"},{"parent":"0cd19ad2-797e-432c-b965-4dcec21140be","callout":[],"children":[],"id":"dbbd9b5d-a480-4d85-af02-5b61a82b2a17","title":"操作：查看同一 Computer 下的 Agent 列表"},{"parent":"0cd19ad2-797e-432c-b965-4dcec21140be","callout":[],"children":[],"id":"4cf6ed74-42ce-46b2-8128-73b6ff7e1158","title":"预期：WorkBuddy 的名称、图标、状态和配置不与其他 Agent 串联。<br>"}],"collapsed":true,"id":"0cd19ad2-797e-432c-b965-4dcec21140be","title":"🟠【P1】WorkBuddy 与其他 Agent 独立展示","icons":[{"color":"rgb(0, 186, 74)","name":"completion","index":"317"}]}],"collapsed":true,"id":"3abc01da-a824-45cc-ad45-fb75bdf1e49b","title":"正常场景"},{"parent":"94048088-28b1-45ff-9dfb-4c8f066ca3b3","callout":[],"children":[{"parent":"fc1e7009-6c55-48e1-af05-49f2e4e09c26","callout":[],"children":[{"parent":"44ac8888-618c-4ccf-87e7-0804752ef7e8","callout":[],"children":[],"id":"6df015a7-8c1f-4663-b26e-1bb51c71831f","title":"前置：Computer 在线，但 WorkBuddy 服务异常"},{"parent":"44ac8888-618c-4ccf-87e7-0804752ef7e8","callout":[],"children":[],"id":"83367818-0595-4123-a273-9bd5c681f766","t