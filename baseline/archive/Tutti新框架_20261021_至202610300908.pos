07b76-7a95-4790-a2af-1a03b3a9de8b","callout":[],"children":[{"parent":"21c0d1b3-a68a-45a8-9b8f-5cf3b6e88a42","callout":[],"children":[{"parent":"33dbf924-d8e7-41d3-8e7d-0bd37780c4d7","callout":[],"children":[],"id":"5bb012d5-b80e-4b7e-ad88-65990c5165a4","title":"前置：当前会话所属项目下 Agent 已启动多个服务；角色：房间成员；入口：浏览器标签页的 Localhost 区"},{"parent":"33dbf924-d8e7-41d3-8e7d-0bd37780c4d7","callout":[],"children":[],"id":"c4bf5999-ab67-4389-983e-96776bd375ab","title":"操作：查看端口列表"},{"parent":"33dbf924-d8e7-41d3-8e7d-0bd37780c4d7","callout":[],"children":[],"id":"53f72f20-be97-44a4-a3f9-1e810900fce6","title":"预期：\n1) 列表展示 ｜ 显示当前会话所在项目 Agent 起的所有端口\n2) 列表展示 ｜ 每条展示页面缩略图、workspace 路径与 localhost 端口号"}],"collapsed":true,"id":"33dbf924-d8e7-41d3-8e7d-0bd37780c4d7","title":"🔴【P0】展示当前项目 Agent 起的所有端口"},{"parent":"21c0d1b3-a68a-45a8-9b8f-5cf3b6e88a42","callout":[],"children":[{"parent":"a752fa64-2166-43a5-bc07-ea7c7132af42","callout":[],"children":[],"id":"3837ac4f-3fde-406e-a527-e5168af1c637","title":"前置：端口列表中至少有一个可用端口；角色：房间成员；入口：端口卡片"},{"parent":"a752fa64-2166-43a5-bc07-ea7c7132af42","callout":[],"children":[],"id":"66c9702e-bf30-41cc-857e-fb8668a43b4e","title":"操作：点击其中一条端口记录"},{"parent":"a752fa64-2166-43a5-bc07-ea7c7132af42","callout":[],"children":[],"id":"f7bcaab6-755b-4864-aafd-5d65437b8243","title":"预期：\n1) 跳转定位 ｜ 打开该端口的网页预览页面\n2) 产物预览 ｜ 预览内容与该端口实际服务一致"}],"collapsed":true,"id":"a752fa64-2166-43a5-bc07-ea7c7132af42","title":"🔴【P0】点击端口打开预览"},{"parent":"21c0d1b3-a68a-45a8-9b8f-5cf3b6e88a42","callout":[],"children":[{"parent":"0ee46cec-2494-4eda-8995-a1c6993616bc","callout":[],"children":[],"id":"a4b8f9ff-f065-4973-98f3-590160729093","title":"前置：端口列表已加载，随后 Agent 新起了一个服务；角色：房间成员；入口：端口列表右上角的 Refresh"},{"parent":"0ee46cec-2494-4eda-8995-a1c6993616bc","callout":[],"children":[],"id":"4958e3f3-b184-4ee3-af50-099e7e9a72de","title":"操作：点击 Refresh"},{"parent":"0ee46cec-2494-4eda-8995-a1c6993616bc","callout":[],"children":[],"id":"0afec355-8638-4aa2-99d4-ff3e2ffb24d9","title":"预期：\n1) 列表展示 ｜ 实时同步端口状态，新起的端口出现在列表中\n2) 列表展示 ｜ 已关闭的端口从列表移除"}],"collapsed":true,"id":"0ee46cec-2494-4eda-8995-a1c6993616bc","title":"🔴【P0】刷新端口状态"},{"parent":"21c0d1b3-a68a-45a8-9b8f-5cf3b6e88a42","callout":[],"children":[{"parent":"d3b4c10b-b466-4dae-a52b-d8b0ffdfb23d","callout":[],"children":[],"id":"359c7e80-6105-4c84-a3d9-9469a35f6351","title":"前置：端口列表中至少有一个可用端口；角色：房间成员；入口：端口卡片上的分享按钮"},{"parent":"d3b4c10b-b466-4dae-a52b-d8b0ffdfb23d","callout":[],"children":[],"id":"c00d0de5-15e8-431b-a127-46d75c376c7c","title":"操作：点击该按钮"},{"parent":"d3b4c10b-b466-4dae-a52b-d8b0ffdfb23d","callout":[],"children":[],"id":"754fc535-56fc-43d4-aa49-df55528f6f25","title":"预期：\n1) 结果校验 ｜ 剪贴板内容为该端口对应的可访问链接\n2) 提示文案 ｜ 给出复制成功反馈"}],"collapsed":true,"id":"d3b4c10b-b466-4dae-a52b-d8b0ffdfb23d","title":"🟠【P1】复制网页链接"}],"collapsed":true,"id":"21c0d1b3-a68a-45a8-9b8f-5cf3b6e88a42","title":"正常场景（4）"},{"parent":"a9507b76-7a95-4790-a2af-1a03b3a9de8b","callout":[],"children":[{"parent":"ec0d4016-2cb6-4065-80fa-e6455a2f1357","callout":[],"children":[{"parent":"a95b1b74-eb20-4bba-b572-cf08e54c94e7","callout":[],"children":[],"id":"9339619e-242a-4132-a963-0a20a32aa795","title":"前置：当前项目下没有任何 Agent 起的服务；角色：房间成员；入口：浏览器标签页的 Localhost 区"},{"parent":"a95b1b74-eb20-4bba-b572-cf08e54c94e7","callout":[],"children":[],"id":"5c2de5fe-74f5-4d69-98b8-20e0fd1afb5d","title":"操作：查看端口列表"},{"parent":"a95b1b74-eb20-4bba-b572-cf08e54c94e7","callout":[],"children":[],"id":"ca1badef-5b71-4a9c-9d29-889e2fb2695b","title":"预期：\n1) 提示文案 ｜ 显示「暂未发现可用本地端口」，不显示空列表或一直加载中"}],"collapsed":true,"id":"a95b1b74-eb20-4bba-b572-cf08e54c94e7","title":"🟠【P1】无可用端口"},{"parent":"ec0d4016-2cb6-4065-80fa-e6455a2f1357","callout":[],"children":[{"parent":"9b43dee2-6c6a-4d19-ac31-b0a04d1cce93","callout":[],"children":[],"id":"d0821776-d5a2-4eca-9c76-401587a4d58e","title":"前置：端口列表中的某个服务已被停止；角色：房间成员；入口：端口卡片"},{"parent":"9b43dee2-6c6a-4d19-ac31-b0a04d1cce93","callout":[],"children":[],"id":"87679aae-c551-419c-93bc-70d904e33364","title":"操作：点击该端口记录"},{"parent":"9b43dee2-6c6a-4d19-ac31-b0a04d1cce93","callout":[],"children":[],"id":"e5728476-098a-45ce-939a-ca2cc8e392ad","title":"预期：\n1) 提示文案 ｜ 提示服务不可用并建议刷新，不停留在长时间加载\n2) 列表展示 ｜ 刷新后该端口从列表移除"}],"collapsed":true,"id":"9b43dee2-6c6a-4d19-ac31-b0a04d1cce93","title":"🟠【P1】端口服务已停止"}],"collapsed":true,"id":"ec0d4016-2cb6-4065-80fa-e6455a2f1357","title":"异常场景（2）"},{"parent":"a9507b76-7a95-4790-a2af-1a03b3a9de8b","callout":[],"children":[{"parent":"a659f19d-50b9-40da-a4c8-c947c51f3378","callout":[],"children":[{"parent":"ec5687e2-5532-4a38-a50f-96f55645479e","callout":[],"children":[],"id":"35cfd839-fcbf-46a1-bd9b-fc292135df1b","title":"前置：当前项目下有 20 个以上端口；角色：房间成员；入口：Localhost 区"},{"parent":"ec5687e2-5532-4a38-a50f-96f55645479e","callout":[],"children":[],"id":"fb5e5bd7-990d-4b84-a2e0-91ed4555276c","title":"操作：滚动查看端口列表"},{"parent":"ec5687e2-5532-4a38-a50f-96f55645479e","callout":[],"children":[],"id":"1d03bc8d-c9f0-445c-a0aa-0852223d3e29","title":"预期：\n1) 性能 ｜ 列表可滚动，缩略图按需加载不卡顿\n2) 列表展示 ｜ 数量与实际一致，不重复不遗漏"}],"collapsed":true,"id":"ec5687e2-5532-4a38-a50f-96f55645479e","title":"🟡【P2】端口数量很多"},{"parent":"a659f19d-50b9-40da-a4c8-c947c51f3378","callout":[],"children":[{"parent":"f60c9668-e43a-4f19-a033-1afbb55b1cf8","callout":[],"children":[],"id":"28a47002-3d91-4421-8198-76487300c88c","title":"前置：某端口对应的 workspace 路径超过 60 字符；角色：房间成员；入口：端口卡片"},{"parent":"f60c9668-e43a-4f19-a033-1afbb55b1cf8","callout":[],"children":[],"id":"279cb9a1-09b2-4f27-be74-010e2cb5ddac","title":"操作：查看该端口卡片"},{"parent":"f60c9668-e43a-4f19-a033-1afbb55b1cf8","callout":[],"children":[],"id":"e97535c2-da46-4ef2-a85b-b83d52be5779","title":"预期：\n1) 视觉展示 ｜ 路径合理截断，悬浮或复制可得完整路径\n2) 视觉展示 ｜ 截断不影响端口号与分享按钮的展示"}],"collapsed":true,"id":"f60c9668-e43a-4f19-a033-1afbb55b1cf8","title":"🟡【P2】超长 workspace 路径"}],"collapsed":true,"id":"a659f19d-50b9-40da-a4c8-c947c51f3378","title":"边界场景（2）"}],"collapsed":true,"id":"a9507b76-7a95-4790-a2af-1a03b3a9de8b","title":"本地端口列表"},{"parent":"c6c5be0e-c7a7-4f52-a4b9-62b991770990","callout":[],"children":[{"parent":"9ee4ac15-a1a2-4e41-8381-cf9d0f3f9e99","callout":[],"children":[{"parent":"e7539f84-5130-45bb-b212-4f5d02c1eb14","callout":[],"children":[{"parent":"f6ac5eb3-bb96-43df-bd1e-a27a5889ccda","callout":[],"children":[],"id":"9e609063-d141-4c38-b99a-d4135b05f55e","title":"前置：本机安装了 Chrome 且有已登录的 profile；角色：房间成员；入口：浏览器标签页底部的 Choose Profile"},{"parent":"f6ac5eb3-bb96-43df-bd1e-a27a5889ccda","callout":[],"children":[],"id":"28d677ff-8e40-4c4c-b348-1f0325fab95a","title":"操作：点击 Choose Profile"},{"parent":"f6ac5eb3-bb96-43df-bd1e-a27a5889ccda","callout":[],"children":[],"id":"bc9dbbbc-9b37-430d-bb38-f88ab6de9987","title":"预期：\n1) 登录导入 ｜ 弹出 Import login state 弹窗\n2) 提示文案 ｜ 弹窗说明只导入登录 Cookie，不导入密码、书签与历史\n3) 列表展示 ｜ 列出本机 Chrome 与 Dia 中登录过的 profile，每条显示头像、名称、邮箱与所属浏览器"}],"collapsed":true,"id":"f6ac5eb3-bb96-43df-bd1e-a27a5889ccda","title":"🔴【P0】打开导入登录状态弹窗"},{"parent":"e7539f84-5130-45bb-b212-4f5d02c1eb14","callout":[],"children":[{"parent":"490de86d-9fee-4cc6-bad1-dd391e7d6d00","callout":[],"children":[],"id":"61675fe4-d686-4c49-a9bb-74f10cc78dfa","title":"前置：Import login state 弹窗已打开且列出多个 profile；角色：房间成员；入口：弹窗中的 profile 列表"},{"parent":"490de86d-9fee-4cc6-bad1-dd391e7d6d00","callout":[],"children":[],"id":"fbf16bfe-cb92-4956-9f35-fb424d7633d6","title":"操作：选中一个 profile 后点击 Import Cookies"},{"parent":"490de86d-9fee-4cc6-bad1-dd391e7d6d00","callout":[],"children":[],"id":"a193e823-4142-457b-bef6-5b7f788d0ebe","title":"预期：\n1) 登录导入 ｜ 导入成功并给出结果反馈\n2) 登录状态 ｜ 在浏览器中打开对应站点时已是登录态"}],"collapsed":true,"id":"490de86d-9fee-4cc6-bad1-dd391e7d6d00","title":"🔴【P0】选择 profile 导入 Cookie"},{"parent":"e7539f84-5130-45bb-b212-4f5d02c1eb14","callout":[],"children":[{"parent":"d8d4de3c-cb9d-43f8-9269-33a4e0817fd7","callout":[],"children":[],"id":"fad123a4-9f3c-4235-9a45-6107618dce88","title":"前置：已成功导入某个 Google 账号的登录状态；角色：房间成员；入口：新建网页窗口"},{"parent":"d8d4de3c-cb9d-43f8-9269-33a4e0817fd7","callout":[],"children":[],"id":"3f3892c8-abfe-45b2-9515-da24affb57f8","title":"操作：新建一个网页窗口并访问同一站点"},{"parent":"d8d4de3c-cb9d-43f8-9269-33a4e0817fd7","callout":[],"children":[],"id":"1b3aae36-db29-4c5a-8d1b-92aaf02d9447","title":"预期：\n1) 登录状态 ｜ 新窗口仍保持登录状态，不需要重新导入"}],"collapsed":true,"id":"d8d4de3c-cb9d-43f8-9269-33a4e0817fd7","title":"🔴【P0】导入后新窗口保持登录"},{"parent":"e7539f84-5130-45bb-b212-4f5d02c1eb14","callout":[],"children":[{"parent":"5a963365-8fe0-4bad-9828-872363415aaf","callout":[],"children":[],"id":"17500896-7136-4482-ba09-785ddaf8e7f4","title":"前置：已成功导入登录状态；角色：房间成员；入口：应用"},{"parent":"5a963365-8fe0-4bad-9828-872363415aaf","callout":[],"children":[],"id":"e03031fd-a30d-4619-8441-7a94b9d1f06c","title":"操作：退出应用后重新打开并访问同一站点"},{"parent":"5a963365-8fe0-4bad-9828-872363415aaf","callout":[],"children":[],"id":"cc6706f2-e887-4b35-a197-e4ce9e769b86","title":"预期：\n1) 持久化 ｜ 账号仍处于登录中\n2) 登录状态 ｜ 后续新开的窗口同样保持登录"}],"collapsed":true,"id":"5a963365-8fe0-4bad-9828-872363415aaf","title":"🔴【P0】退出应用后登录状态保持"},{"parent":"e7539f84-5130-45bb-b212-4f5d02c1eb14","callout":[],"children":[{"parent":"5f6c1b01-e9d3-4481-8dd9-36a31673ecc8","callout":[],"children":[],"id":"ac0df0ca-41b9-4863-8b2e-e9fbf538e22a","title":"前置：Import login state 弹窗已打开；角色：房间成员；入口：弹窗的 Cancel 按钮"},{"parent":"5f6c1b01-e9d3-4481-8dd9-36a31673ecc8","callout":[],"children":[],"id":"92e5162c-2ffd-4c19-97f6-a4860ddcb22a","title":"操作：点击 Cancel"},{"parent":"5f6c1b01-e9d3-4481-8dd9-36a31673ecc8","callout":[],"children":[],"id":"5b1f6613-c251-4a3d-a5e4-3fe8f8fa46bf","title":"预期：\n1) 登录导入 ｜ 弹窗关闭且不导入任何 Cookie\n2) 副作用 ｜ 浏览器登录状态与打开弹窗前一致"}],"collapsed":true,"id":"5f6c1b01-e9d3-4481-8dd9-36a31673ecc8","title":"🟠【P1】取消导入"}],"collapsed":true,"id":"e7539f84-5130-45bb-b212-4f5d02c1eb14","title":"正常场景（5）"},{"parent":"9ee4ac15-a1a2-4e41-8381-cf9d0f3f9e99","callout":[],"children":[{"parent":"0007def6-b5ac-4f54-a16c-ee40a57f9932","callout":[],"children":[{"parent":"b678da89-d0c7-4436-beec-395f85722c49","callout":[],"children":[],"id":"d82c6747-34c9-4b59-b0f8-8fbe169fad9d","title":"前置：Import login state 弹窗已打开且未选中任何 profile；角色：房间成员；入口：弹窗的 Import Cookies 按钮"},{"parent":"b678da89-d0c7-4436-beec-395f85722c49","callout":[],"children":[],"id":"24826fa8-afc3-4f43-b2d6-0cc66ff31912","title":"操作：直接点击 Import Cookies"},{"parent":"b678da89-d0c7-4436-beec-395f85722c49","callout":[],"children":[],"id":"fff7e052-dc7c-413c-8cee-d79fef589773","title":"预期：\n1) 按钮状态 ｜ 按钮为不可用态，点击无响应，不发起导入请求"}],"collapsed":true,"id":"b678da89-d0c7-4436-beec-395f85722c49","title":"🟠【P1】未选中 profile 时不可导入"},{"parent":"0007def6-b5ac-4f54-a16c-ee40a57f9932","callout":[],"children":[{"parent":"fdaa04a9-26a4-44f1-b375-221fad28fb26","callout":[],"children":[],"id":"29705bfb-2c53-4b3c-a2ca-fcce97bfa33e","title":"前置：本机未安装 Chrome 与 Dia 或没有已登录的 profile；角色：房间成员；入口：Choose Profile"},{"parent":"fdaa04a9-26a4-44f1-b375-221fad28fb26","callout":[],"children":[],"id":"f97099c0-1d17-43b5-aacc-19f01d93166d","title":"操作：点击 Choose Profile"},{"parent":"fdaa04a9-26a4-44f1-b375-221fad28fb26","callout":[],"children":[],"id":"6a0f80d4-4b2e-4bd4-a927-00d5c7ac35c1","title":"预期：\n1) 提示文案 ｜ 弹窗给出没有可导入 profile 的说明与处理建议，不显示空列表"}],"collapsed":true,"id":"fdaa04a9-26a4-44f1-b375-221fad28fb26","title":"🟠【P1】本机没有可导入的 profile"},{"parent":"0007def6-b5ac-4f54-a16c-ee40a57f9932","callout":[],"children":[{"parent":"b2ecb94a-7179-490a-b1d9-83598d3f7f9c","callout":[],"children":[],"id":"910ecaff-630b-4cce-9e4a-b7bd1658874e","title":"前置：目标 profile 正被本机 Chrome 占用或无读取权限；角色：房间成员；入口：弹窗的 Import Cookies 按钮"},{"parent":"b2ecb94a-7179-490a-b1d9-83598d3f7f9c","callout":[],"children":[],"id":"3a6f5ef6-329c-4a27-a56b-fde5de342614","title":"操作：选中该 profile 后点击 Import Cookies"},{"parent":"b2ecb94a-7179-490a-b1d9-83598d3f7f9c","callout":[],"children":[],"id":"a0b5223c-29b1-49e4-bf25-3052bbd2f5e8","title":"预期：\n1) 提示文案 ｜ 提示导入失败并说明原因\n2) 副作用 ｜ 不产生半导入状态，原有登录状态不被破坏"}],"collapsed":true,"id":"b2ecb94a-7179-490a-b1d9-83598d3f7f9c","title":"🟠【P1】导入过程中读取失败"}],"collapsed":true,"id":"0007def6-b5ac-4f54-a16c-ee40a57f9932","title":"异常场景（3）"},{"parent":"9ee4ac15-a1a2-4e41-8381-cf9d0f3f9e99","callout":[],"children":[{"parent":"f48b5192-a57f-4791-8713-cc22