c9e241b7e","title":"2) 跳转定位 ｜ 进入所选示例房间"},{"parent":"4b05cc88-99ba-41e7-a413-36685004120f","callout":[],"children":[],"id":"db191fc4-5326-4f6c-842e-6235b703b604","title":"3) 等价性 ｜ 示例阅读及Agent执行限制与欢迎页进入的对应示例一致"}],"collapsed":true,"id":"4b05cc88-99ba-41e7-a413-36685004120f","title":"预期"}],"collapsed":true,"id":"1fa2b26c-1e06-4865-a89d-d4687c77e476","title":"🟠【P1】从Tutti菜单重新进入示例房间〔NU-096〕"}],"collapsed":true,"id":"56f7425d-2a4c-4a48-ac8d-96516797b4dc","title":"正常场景"}],"collapsed":true,"id":"ca47c8d7-bac7-47d6-92ef-0c7e89c936cb","title":"再次体验示例"}],"collapsed":true,"id":"3d7c7a59-4ed0-4d98-be93-3dd668da0c01","title":"Tutti菜单"}],"collapsed":true,"id":"1e559368-683b-4d95-8fdb-8006bc2e486c","title":"首页"},{"parent":"c2b82107-c0e1-4db2-b244-534818432d60","callout":[],"children":[{"parent":"6ae8aaed-77af-4cbb-8db1-cd6b8ad98c8e","callout":[],"children":[{"parent":"b402051e-8c89-4f37-8d95-54dfa6a0a6ac","callout":[],"children":[{"parent":"d634ce03-4fee-454f-8136-2ae60d4c58d1","callout":[],"children":[{"parent":"f603904e-4bf1-4c93-8d06-d0bb80e83acc","callout":[],"children":[{"parent":"05041e02-fcf8-49f1-9327-fabd7b5de967","callout":[],"children":[{"parent":"867e0fe5-e618-46cd-a97a-6eca7690f3ec","callout":[],"children":[],"id":"b000ad23-dc0b-4c48-9528-db3676fc9433","title":"新账号没有在线可用电脑及个人房间；具有可完成准备的测试电脑和本地 Agent 账号；角色：房间成员；入口：本地房间创建与首次会话"}],"collapsed":true,"id":"867e0fe5-e618-46cd-a97a-6eca7690f3ec","title":"前置"},{"parent":"05041e02-fcf8-49f1-9327-fabd7b5de967","callout":[],"children":[{"parent":"8bd74746-a235-42a7-8a1c-42021b96bc01","callout":[],"children":[],"id":"5d3fb69a-8ad9-4352-98e3-9b21ad1b9dfc","title":"1. 选择本地房间并点击下一步；从添加电脑入口按连接安装引导完成安装授权和本地 Agent 登录。电脑在线后手动重新打开创建房间，选择本地房间填写信息创建；检查新房间零项目、零会话状态，选择可用 Agent 发送消息。"}],"collapsed":true,"id":"8bd74746-a235-42a7-8a1c-42021b96bc01","title":"操作"},{"parent":"05041e02-fcf8-49f1-9327-fabd7b5de967","callout":[],"children":[{"parent":"a777a38f-d967-46a2-ba21-120fbf957fd5","callout":[],"children":[],"id":"070d4ff1-d79c-4690-8ffe-61042196cf35","title":"1) 提示文案 ｜ 无在线电脑时提示本地房间需要一台在线电脑，并提供添加电脑入口"},{"parent":"a777a38f-d967-46a2-ba21-120fbf957fd5","callout":[],"children":[],"id":"58767cde-b4ff-4ea7-9322-8ec23b47e4cc","title":"2) 按钮状态 ｜ 缺少电脑时创建不可提交"},{"parent":"a777a38f-d967-46a2-ba21-120fbf957fd5","callout":[],"children":[],"id":"25cbabb2-0d80-4652-a8b0-afd47f3caff8","title":"3) 列表展示 ｜ 创建页展示房间名称、头像及协作者权限说明"},{"parent":"a777a38f-d967-46a2-ba21-120fbf957fd5","callout":[],"children":[],"id":"d3c0d0cb-3780-48d7-bab9-b00aad1be8a8","title":"4) 跳转定位 ｜ 连接后手动重开创建入口，识别在线电脑并成功进入新房间"},{"parent":"a777a38f-d967-46a2-ba21-120fbf957fd5","callout":[],"children":[],"id":"bdedad0c-e77e-43f9-a9d8-11219c4003ce","title":"5) 设备状态 ｜ 房间顶部关联正确电脑"},{"parent":"a777a38f-d967-46a2-ba21-120fbf957fd5","callout":[],"children":[],"id":"a95a8b32-01e0-46bc-b82c-ad64a2634975","title":"6) 列表展示 ｜ 新房间显示暂无项目、还没有会话及新会话入口"},{"parent":"a777a38f-d967-46a2-ba21-120fbf957fd5","callout":[],"children":[],"id":"a1ea16b4-7455-4769-98e6-900cffc9aa60","title":"7) 输入框 ｜ 主区显示今天想完成什么、Agent 选择及消息输入区"},{"parent":"a777a38f-d967-46a2-ba21-120fbf957fd5","callout":[],"children":[],"id":"ef578b2a-264d-4580-b17c-e1881b2b1881","title":"8) 结果回传 ｜ 本地 Agent 可用后首次消息发送成功并收到回复"}],"collapsed":true,"id":"a777a38f-d967-46a2-ba21-120fbf957fd5","title":"预期"},{"parent":"05041e02-fcf8-49f1-9327-fabd7b5de967","callout":[],"children":[{"parent":"e2b96d40-306e-4f15-a0ad-1753fc3947a0","callout":[],"children":[],"id":"972983a1-a943-48fe-bf46-85b15808a8f3","title":"已定口径：连接电脑后需手动重新打开创建入口。"}],"collapsed":true,"id":"e2b96d40-306e-4f15-a0ad-1753fc3947a0","title":"备注"}],"collapsed":true,"id":"05041e02-fcf8-49f1-9327-fabd7b5de967","title":"🔴【P0】本地房间创建至首次对话完整链路〔NU-097〕"}],"collapsed":true,"id":"f603904e-4bf1-4c93-8d06-d0bb80e83acc","title":"正常场景"}],"collapsed":true,"id":"d634ce03-4fee-454f-8136-2ae60d4c58d1","title":"本地房间创建与首次会话"},{"parent":"b402051e-8c89-4f37-8d95-54dfa6a0a6ac","callout":[],"children":[{"parent":"d5dd9d12-54e3-4b60-b938-74eb5989cbca","callout":[],"children":[{"parent":"973fdcb8-8a8d-4cf9-9ea4-209c4ed23995","callout":[],"children":[{"parent":"56786ef2-1f24-46ce-a64c-bf1b55256791","callout":[],"children":[{"parent":"d97fe269-6a63-48f6-b928-df5bcf9fffe8","callout":[],"children":[],"id":"6ffb90b8-29a4-406e-9196-ebe79e7e0213","title":"新用户无个人云端房间，暂时没有可用 Agent；具备可连接 Computer 和接入目标 Agent 的测试条件；目标云端 Agent 明确支持 Tutti 积分，当前账号积分充足；官方订阅未登录；角色：房间成员；入口：云端房间创建与首次会话"}],"collapsed":true,"id":"d97fe269-6a63-48f6-b928-df5bcf9fffe8","title":"前置"},{"parent":"56786ef2-1f24-46ce-a64c-bf1b55256791","callout":[],"children":[{"parent":"e8ebd7c9-7bb4-4e70-aedf-1f417d25eaa5","callout":[],"children":[],"id":"fb3a458c-63b0-4eb2-bb11-5ef3f91f3be2","title":"1. 创建云端房间，查看无可用 Agent 时的引导，点击用自己电脑的 Agent；按“我的 Agent”章节完成 Computer 安装、登录授权连接、目标云端 Agent 接入及积分方式准备，返回房间选择该 Agent 完成首次发送。"}],"collapsed":true,"id":"e8ebd7c9-7bb4-4e70-aedf-1f417d25eaa5","title":"操作"},{"parent":"56786ef2-1f24-46ce-a64c-bf1b55256791","callout":[],"children":[{"parent":"302b7d01-7237-4b18-ae48-7d68926c6bdc","callout":[],"children":[],"id":"dfcfa2f9-b1e5-471e-acf6-c173eb79aa60","title":"1) 结果校验 ｜ 无可用 Agent 也能先创建云端房间，成功进入并显示云端电脑标识"},{"parent":"302b7d01-7237-4b18-ae48-7d68926c6bdc","callout":[],"children":[],"id":"054a36e7-7e1b-4f2f-84cd-64d7f5f4ac78","title":"2) 提示文案 ｜ 无可用 Agent 时显示邀请伙伴共享 Agent，或用自己的 Agent，并提供两个准备入口"},{"parent":"302b7d01-7237-4b18-ae48-7d68926c6bdc","callout":[],"children":[],"id":"e93f18ee-eb50-45b4-accc-b6bec0e80b1d","title":"3) 输入框 ｜ 未就绪时不提供可发送任务的输入框"},{"parent":"302b7d01-7237-4b18-ae48-7d68926c6bdc","callout":[],"children":[],"id":"b9d66602-884c-473a-9449-867fd68caa9c","title":"4) 跳转定位 ｜ 用自己电脑的 Agent 进入我的 Agent，未连接时提供连接电脑入口"},{"parent":"302b7d01-7237-4b18-ae48-7d68926c6bdc","callout":[],"children":[],"id":"53cfbb3e-ca66-48e1-b5e0-124a37ee93af","title":"5) 可用状态 ｜ 房间创建成功和 Agent 就绪分别判断；目标云端 Agent 及其支持的使用方式准备完成后可继续首次使用"},{"parent":"302b7d01-7237-4b18-ae48-7d68926c6bdc","callout":[],"children":[],"id":"80c5c5f3-2d04-409b-a3b8-e282e2764c5d","title":"6) 登录状态 ｜ 官方账号未登录时可提示登录，但目标明确支持积分且积分方式已就绪时，不强制完成官方登录"},{"parent":"302b7d01-7237-4b18-ae48-7d68926c6bdc","callout":[],"children":[],"id":"3b3041fc-b979-4271-aa01-96e290c622c0","title":"7) 结果回传 ｜ 目标 Agent 支持的积分方式就绪且积分充足时，可发送并收到回复，不要求额外官方订阅"}],"collapsed":true,"id":"302b7d01-7237-4b18-ae48-7d68926c6bdc","title":"预期"}],"collapsed":true,"id":"56786ef2-1f24-46ce-a64c-bf1b55256791","title":"🔴【P0】云端房间创建至积分方式首次对话完整链路〔NU-098〕"}],"collapsed":true,"id":"973fdcb8-8a8d-4cf9-9ea4-209c4ed23995","title":"正常场景"}],"collapsed":true,"id":"d5dd9d12-54e3-4b60-b938-74eb5989cbca","title":"云端房间创建与首次会话"},{"parent":"b402051e-8c89-4f37-8d95-54dfa6a0a6ac","callout":[],"children":[{"parent":"48f5d22c-7378-42f8-882f-853f3e2a35ee","callout":[],"children":[{"parent":"8bb169dc-f243-402b-8da5-e634963c7dfe","callout":[],"children":[{"parent":"7e08e55d-00dc-4f26-b814-7a53f805c734","callout":[],"children":[{"parent":"9ffc2446-133c-48da-8f86-25de1851e522","callout":[],"children":[],"id":"6adeace8-fcf6-450f-abcf-5727371525e6","title":"新成员已加入，但自己没有可用 Agent，伙伴也未共享可用 Agent；角色：房间成员；入口：无可用 Agent 引导"}],"collapsed":true,"id":"9ffc2446-133c-48da-8f86-25de1851e522","title":"前置"},{"parent":"7e08e55d-00dc-4f26-b814-7a53f805c734","callout":[],"children":[{"parent":"a36771c2-169b-4b02-9155-2463d4a1c02b","callout":[],"children":[],"id":"d793e020-c764-45bf-a024-586d6f0d1c19","title":"1. 打开新会话页。"}],"collapsed":true,"id":"a36771c2-169b-4b02-9155-2463d4a1c02b","title":"操作"},{"parent":"7e08e55d-00dc-4f26-b814-7a53f805c734","callout":[],"children":[{"parent":"d01f1c67-0f2b-43d8-88dc-053bcb2ddff1","callout":[],"children":[],"id":"82c4bf75-77e8-4b64-905a-d15cf16fb34a","title":"1) 列表展示 ｜ 停留准备引导，显示邀请伙伴共享 Agent，或用自己的 Agent及两个入口"},{"parent":"d01f1c67-0f2b-43d8-88dc-053bcb2ddff1","callout":[],"children":[],"id":"d91ba73d-9243-47dc-96bb-691c13cb0a9a","title":"2) 结果校验 ｜ 未补齐条件前不能开始 Agent 对话。只限制该对话能力，不推断群聊等全部功能不可用"}],"collapsed":true,"id":"d01f1c67-0f2b-43d8-88dc-053bcb2ddff1","title":"预期"}],"collapsed":true,"id":"7e08e55d-00dc-4f26-b814-7a53f805c734","title":"🟠【P1】自己和伙伴都无可用 Agent〔NU-099〕"}],"collapsed":true,"id":"8bb169dc-f243-402b-8da5-e634963c7dfe","title":"正常场景"}],"collapsed":true,"id":"48f5d22c-7378-42f8-882f-853f3e2a35ee","title":"无可用 Agent 引导"},{"parent":"b402051e-8c89-4f37-8d95-54dfa6a0a6ac","callout":[],"children":[{"parent":"9dcbc098-6451-48f2-81ad-486d88007325","callout":[],"children":[{"parent":"8b874069-2408-4ce2-bac3-8496fe8dae9e","callout":[],"children":[{"parent":"a50b6ac2-c18c-4d4e-abdb-9cd4b17e9385","callout":[],"children":[{"parent":"95ed79e4-fc76-4cbf-b7b8-308c746073a0","callout":[],"children":[],"id":"824be645-0ea1-4528-ac34-08de65dc76b9","title":"已进入有邀请入口的房间；角色：房间成员；入口：房间右上角"}],"collapsed":true,"id":"95ed79e4-fc76-4cbf-b7b8-308c746073a0","title":"前置"},{"parent":"a50b6ac2-c18c-4d4e-abdb-9cd4b17e9385","callout":[],"children":[{"parent":"97e8fa7d-d594-4a7f-b2eb-bd8fd38a06cf","callout":[],"children":[],"id":"9d2b8f16-29d7-4e90-af89-e0bd1d595e44","title":"1. 查看房间右上角操作区。"}],"collapsed":true,"id":"97e8fa7d-d594-4a7f-b2eb-bd8fd38a06cf","title":"操作"},{"parent":"a50b6ac2-c18c-4d4e-abdb-9cd4b17e9385","callout":[],"children":[{"parent":"15cf50d0-66b5-417c-a7d1-04a2da53ed39","callout":[],"children":[],"id":"b4ced2db-3806-4c45-ba9c-098ecab56bc3","title":"1) 菜单展示 ｜ 提供“邀请协作者”入口"}],"collapsed":true,"id":"15cf50d0-66b5-417c-a7d1-04a2da53ed39","title":"预期"}],"collapsed":true,"id":"a50b6ac2-c18c-4d4e-abdb-9cd4b17e9385","title":"🟠【P1】房间展示邀请协作者入口〔NU-100〕"}],"collapsed":true,"id":"8b874069-2408-4ce2-bac3-8496fe8dae9e","title":"正常场景"}],"collapsed":true,"id":"9dcbc098-6451-48f2-81ad-486d88007325","title":"邀请协作者"}],"collapsed":true,"id":"b402051e-8c89-4f37-8d95-54dfa6a0a6ac","title":"公共区域"},{"parent":"6ae8aaed-77af-4cbb-8db1-cd6b8ad98c8e","callout":[],"children":[{"parent":"a008fc98-9638-4854-bfba-0361296dd697","callout":[],"children":[{"parent":"4c881ed1-eaaf-4899-a412-5d78d4b2869e","callout":[],"children":[{"parent":"b77f4542-faaf-44d8-a3ea-42f569ca2508","callout":[],"children":[{"parent":"cde5d529-b570-42ab-b021-6d6b5ff562ae","callout":[],"c