cc4-a436-3f0e74515cd9","title":"预期：正确展示 tutti agent 所选模型的上下文用量\nKimi K2.6：256k                230,400\nKimi K2.7 Code：256k.     230,400\nGLM-5.1：200k                 180k\nGLM-5.2 / Deepseek V4 Flash / MiniMax M3 / kimi k3 / DeepSeek V4 Pro : 1000k"}],"collapsed":true,"id":"344ec6af-ba1f-41ec-86bd-f7618dff17bf","title":"🔴【P0】tutti agent 上下文用量限制展示","icons":[{"color":"rgb(248, 87, 103)","name":"other","index":"369"}]},{"parent":"2c3e3893-384f-4613-be89-4c009e601faf","callout":[],"children":[{"parent":"ff860cff-eaaa-4bf8-8a52-76da555c253c","callout":[],"children":[],"id":"f0a0323c-c9a7-4e1b-b3d6-4fac1ff3b0bd","title":"操作：发送一条消息并等待回复完成后查看上下文用量"},{"parent":"ff860cff-eaaa-4bf8-8a52-76da555c253c","callout":[],"children":[],"id":"f6b2d214-d6d4-44e7-83cc-24b315626085","title":"预期：上下文用量数值随对话轮次正确累加，不出现明显偏差或不更新"}],"collapsed":true,"id":"ff860cff-eaaa-4bf8-8a52-76da555c253c","title":"🔴【P0】发送会话后上下文用量显示正确","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"2c3e3893-384f-4613-be89-4c009e601faf","callout":[],"children":[{"parent":"9f3998ad-11a4-4a31-897b-539c3bef9624","callout":[],"children":[],"id":"a591b33c-e060-4a42-a75d-d73008729089","title":"操作：打开用量面板查看总用量入口"},{"parent":"9f3998ad-11a4-4a31-897b-539c3bef9624","callout":[],"children":[],"id":"d1452e5e-d3b9-42d2-a4ab-cd8fd7fa79f8","title":"预期：正确展示当前会话或当前账号的总上下文用量统计，数据与实际消耗一致"}],"collapsed":true,"id":"9f3998ad-11a4-4a31-897b-539c3bef9624","title":"🔴【P0】查看总用量","icons":[{"color":"rgb(248, 87, 103)","name":"other","index":"369"}]},{"parent":"2c3e3893-384f-4613-be89-4c009e601faf","callout":[],"children":[{"parent":"afe53a92-bdbe-4024-a46c-00d24c9188c8","callout":[],"children":[],"id":"8f5b01b7-8b4c-4b69-8f7c-330d1fc77835","title":"操作：切换到另一个模型后新建会话并发送消息"},{"parent":"afe53a92-bdbe-4024-a46c-00d24c9188c8","callout":[],"children":[],"id":"cdc9f300-1fb9-490c-bf8c-d7c48f8b014b","title":"预期：总用量按新模型的计费/计数规则及时更新，不沿用旧模型的用量基数"}],"collapsed":true,"id":"afe53a92-bdbe-4024-a46c-00d24c9188c8","title":"🟠【P1】切换模型再发起新会话后总用量及时更新"}],"collapsed":true,"id":"2c3e3893-384f-4613-be89-4c009e601faf","title":"正常场景（9）"},{"parent":"36824f60-825d-49b5-9228-44ac75f47190","callout":[],"children":[{"parent":"44e0dd38-e751-4d0a-8817-1d742089a89e","callout":[],"children":[{"parent":"e7a9b3fd-72dd-4e67-b58d-e8e17dd8c134","callout":[],"children":[],"id":"dbc867e3-c7bd-4c71-81ea-baa95e1eb472","title":"前置：前置：在应用内使用 Tutti Agent 的模型完成若干请求；角色：账号所有者；入口：Web 端用量管理"},{"parent":"e7a9b3fd-72dd-4e67-b58d-e8e17dd8c134","callout":[],"children":[],"id":"a552d1b2-65c4-4ce6-9c10-9d027ebbf0c5","title":"操作：查看请求记录中的用户输入内容"},{"parent":"e7a9b3fd-72dd-4e67-b58d-e8e17dd8c134","callout":[],"children":[],"id":"ea569796-b48d-4fb3-b9fc-6b10c1cdf289","title":"预期：用量管理中的请求记录正常渲染并可识别对应的用户输入；不出现内容渲染错乱或无法识别"},{"parent":"e7a9b3fd-72dd-4e67-b58d-e8e17dd8c134","callout":[],"children":[],"id":"6b0239f9-617c-4285-9634-5a12f07c8f71","title":"备注：#216"}],"collapsed":true,"id":"e7a9b3fd-72dd-4e67-b58d-e8e17dd8c134","title":"🟠【P1】Web 端用量记录渲染正常"},{"parent":"44e0dd38-e751-4d0a-8817-1d742089a89e","callout":[],"children":[{"parent":"ec560b8a-bf56-43a4-a55c-9f4c468b6811","callout":[],"children":[],"id":"52979314-5d5a-4d4d-ba20-4e76c30096fb","title":"前置：前置：Agent 通过 API Key 配置；角色：房间成员；入口：会话详情上下文用量入口"},{"parent":"ec560b8a-bf56-43a4-a55c-9f4c468b6811","callout":[],"children":[],"id":"2d56df4d-3a8e-4242-8975-8d8719ca7cd6","title":"操作：发送消息运行会话查看实时用量，关闭 Agent GUI 后重新进入同一会话继续对话"},{"parent":"ec560b8a-bf56-43a4-a55c-9f4c468b6811","callout":[],"children":[],"id":"88d48bf0-ca6c-4e5a-a3b6-4394f75214e0","title":"预期：运行中与恢复后均能看到上下文用量；不出现关闭再进入后用量入口消失；共享 Agent 的会话同样展示上下文用量"},{"parent":"ec560b8a-bf56-43a4-a55c-9f4c468b6811","callout":[],"children":[],"id":"e18e4de9-083a-419e-b64a-c1393d2c3bbf","title":"备注：#6 #289 #400 #80"}],"collapsed":true,"id":"ec560b8a-bf56-43a4-a55c-9f4c468b6811","title":"🟠【P1】运行中与恢复后均能看到上下文用量"},{"parent":"44e0dd38-e751-4d0a-8817-1d742089a89e","callout":[],"children":[{"parent":"a0f3fed9-f0a4-4c14-9563-e767f46667ae","callout":[],"children":[],"id":"f