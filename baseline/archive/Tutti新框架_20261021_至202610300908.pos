e":"other","index":"368"}]}],"collapsed":true,"id":"ccf5f16f-9d18-4027-9f93-8ed9d6acd037","title":"边界场景（1）"}],"collapsed":true,"id":"863b70e0-6db4-4a73-a1b7-e43864027a86","title":"快速模式（/fast）"},{"parent":"7151a7d8-0cf0-4ded-b9bf-366be687f2f8","callout":[],"children":[{"parent":"5b796089-9b4e-4e52-8064-b10e76dd846f","callout":[],"children":[{"parent":"7ac40cfb-3868-420e-b936-730cf6ad4a1a","callout":[],"children":[{"parent":"6be2b2c8-24ae-4195-9726-853dbd4e7fdf","callout":[],"children":[],"id":"681f1e5a-2e24-4d2b-9c4f-8c71cdf3188f","title":"操作：在新会话输入 /goal，设置一个目标，运行中删除"},{"parent":"6be2b2c8-24ae-4195-9726-853dbd4e7fdf","callout":[],"children":[],"id":"495c7063-1056-48fc-8369-a4cdbba8291b","title":"预期：目标从输入框上方消失，正在执行的轮次会继续执行，下一轮次不会继续"}],"collapsed":true,"id":"6be2b2c8-24ae-4195-9726-853dbd4e7fdf","title":"🔴【P0】任务进行过程中删除目标"},{"parent":"7ac40cfb-3868-420e-b936-730cf6ad4a1a","callout":[],"children":[{"parent":"4279512a-e367-42ff-8554-1d49c4901789","callout":[],"children":[],"id":"2bfad3d9-5f3d-447b-867c-5c1f77997b55","title":"操作：在新会话输入 /goal，设置一个目标，运行中暂停，再恢复"},{"parent":"4279512a-e367-42ff-8554-1d49c4901789","callout":[],"children":[],"id":"b92bb501-1448-4d18-b25f-38e0991c991c","title":"预期：会话重新变成运行中，直至任务完成，goal消失"}],"collapsed":true,"id":"4279512a-e367-42ff-8554-1d49c4901789","title":"🔴【P0】恢复目标"},{"parent":"7ac40cfb-3868-420e-b936-730cf6ad4a1a","callout":[],"children":[{"parent":"f302b25d-5e65-469c-a782-5fcc8355f7ed","callout":[],"children":[],"id":"fe078d6e-21ab-44c6-ad89-1b256eb6a2b0","title":"操作：在新会话输入 /goal，设置一个目标，运行中暂停"},{"parent":"f302b25d-5e65-469c-a782-5fcc8355f7ed","callout":[],"children":[],"id":"a05eac97-0152-440f-8b8a-8d410b8ee386","title":"预期：正在执行的轮次会继续执行，下一轮次会暂停，会话变成已完成"}],"collapsed":true,"id":"f302b25d-5e65-469c-a782-5fcc8355f7ed","title":"🔴【P0】暂停目标"},{"parent":"7ac40cfb-3868-420e-b936-730cf6ad4a1a","callout":[],"children":[{"parent":"9c64d1be-2271-4e8b-9aed-0581bd8782a4","callout":[],"children":[],"id":"9df630fb-a53c-48f5-8e77-8b6cf9ebbb5f","title":"操作：在新会话输入 /goal，设置一个目标，等待完成"},{"parent":"9c64d1be-2271-4e8b-9aed-0581bd8782a4","callout":[],"children":[],"id":"3d9d01d0-9cde-47f1-a6c1-d6c54beb3f50","title":"预期：进行中目标会显示在输入框上方，状态是进行中，完成后目标会消失"}],"collapsed":true,"id":"9c64d1be-2271-4e8b-9aed-0581bd8782a4","title":"🔴【P0】等待任务完成"},{"parent":"7ac40cfb-3868-420e-b936-730cf6ad4a1a","callout":[],"children":[{"parent":"1879157f-837b-4a04-9eda-3ea51b694a52","callout":[],"children":[],"id":"7f794dc8-9a38-4423-a602-ddce177f8aaa","title":"操作：在新会话输入 /goal"},{"parent":"1879157f-837b-4a04-9eda-3ea51b694a52","callout":[],"children":[],"id":"f7888ec8-f011-4ce4-91c5-e727c841b6a3","title":"预期：@图标旁边显示目标，可点击清除目标"}],"collapsed":true,"id":"1879157f-837b-4a04-9eda-3ea51b694a52","title":"🔴【P0】输入 /goal"},{"parent":"7ac40cfb-3868-420e-b936-730cf6ad4a1a","callout":[],"children":[{"parent":"0c464b14-fa81-4bbd-b0c2-f0cbca14eab0","callout":[],"children":[],"id":"1f432d4a-c7ae-4bb5-a158-61c66fe8af6a","title":"前置：前置：会话已建立；角色：房间成员；入口：会话输入框"},{"parent":"0c464b14-fa81-4bbd-b0c2-f0cbca14eab0","callout":[],"children":[],"id":"47b5e6c8-d717-4e35-9dfe-f39e9c63aaa5","title":"操作：执行 /goal 创建目标，执行任务直至完成，观察目标状态变化"},{"parent":"0c464b14-fa81-4bbd-b0c2-f0cbca14eab0","callout":[],"children":[],"id":"2f2e7490-95b0-4ec0-84ba-4040decfcdd4","title":"预期：创建后目标状态为进行中并发送对应的目标状态事件；任务完成后目标状态变为完成并从进行中移除；状态变化在会话详情与目标展示位同步"},{"parent":"0c464b14-fa81-4bbd-b0c2-f0cbca14eab0","callout":[],"children":[],"id":"c32037b9-116d-40ae-856b-050b8518b675","title":"备注：附件3 CC-037"}],"collapsed":true,"id":"0c464b14-fa81-4bbd-b0c2-f0cbca14eab0","title":"🟠【P1】目标状态从进行到完成"}],"collapsed":true,"id":"7ac40cfb-3868-420e-b936-730cf6ad4a1a","title":"正常场景（6）"},{"parent":"5b796089-9b4e-4e52-8064-b10e76dd846f","callout":[],"children":[{"parent":"b5e2203e-db81-4303-9a53-cba0d04c801b","callout":[],"children":[{"parent":"7980fd91-8ba7-465f-b202-6449bab6be18","callout":[],"children":[],"id":"1feef181-cadd-493b-b6ca-21bfbaeb15e3","title":"前置：前置：会话中已发起 /goal 任务；角色：房间成员；入口：会话详情与输入框上方 goal 展示位"},{"parent":"7980fd91-8ba7-465f-b202-6449bab6be18","callout":[],"children":[],"id":"b71e15fb-afc5-407b-9a52-303789404c68","title":"操作：等待 goal 执行完成后查看会话状态与 goal 状态"},{"parent":"7980fd91-8ba7-465f-b202-6449bab6be18","callout":[],"children":[],"id":"f039bbf6-f2ab-415f-82ca-24814ab26c6c","title":"预期：goal 完成后输入框上方的目标状态变为完成并从进行中移除；会话状态同步变为已完成；不出现目标常驻显示进行中"},{"parent":"7980fd91-8ba7-465f-b202-6449bab6be18","callout":[],"children":[],"id":"4e1dd0fb-29ac-4739-a3bd-5c49c666d3fb","title":"备注：#54 #186 #29 附件3 CC-037"}],"collapsed":true,"id":"7980fd91-8ba7-465f-b202-6449bab6be18","title":"🔴【P0】goal 完成后目标未消除"},{"parent":"b5e2203e-db81-4303-9a53-cba0d04c801b","callout":[],"children":[{"parent":"351b8c70-0bcd-4ae1-ab88-015cce920cc2","callout":[],"children":[],"id":"35987427-9ef4-4523-800f-dbac31ae34e6","title":"前置：前置：处于 /goal 模式；角色：房间成员；入口：会话输入框"},{"parent":"351b8c70-0bcd-4ae1-ab88-015cce920cc2","callout":[],"children":[],"id":"6861c632-9642-46b3-aa23-88c0f4f2cad7","title":"操作：发送一条消息并持续观察会话详情与状态"},{"parent":"351b8c70-0bcd-4ae1-ab88-015cce920cc2","callout":[],"children":[],"id":"404097f9-1f5f-484d-a91c-d484f1245d2d","title":"预期：发送的消息稳定展示在会话详情中不消失；会话状态在任务真正结束后才变为完成；不出现先显示完成再继续执行"},{"parent":"351b8c70-0bcd-4ae1-ab88-015cce920cc2","callout":[],"children":[],"id":"40134842-9bb0-49ae-9ff2-55826ee4aa71","title":"备注：#328"}],"collapsed":true,"id":"351b8c70-0bcd-4ae1-ab88-015cce920cc2","title":"🔴【P0】goal 模式下消息消失且状态提前完成"},{"parent":"b5e2203e-db81-4303-9a53-cba0d04c801b","callout":[],"children":[{"parent":"16b04348-a61f-4c0b-a74d-1a76f2e01ba9","callout":[],"children":[],"id":"fa7972fa-3e93-4be9-8fca-98bd6ff934e3","title":"前置：前置：goal 正在执行；角色：房间成员；入口：goal 状态区操作按钮"},{"parent":"16b04348-a61f-4c0b-a74d-1a76f2e01ba9","callout":[],"children":[],"id":"d24f94c4-a982-489a-9aa5-d41c6179be6c","title":"操作：点击暂停，等待一段时间后点击继续"},{"parent":"16b04348-a61f-4c0b-a74d-1a76f2e01ba9","callout":[],"children":[],"id":"f79a9e0e-5238-4c66-bfd6-5efeffc6a527","title":"预期：运行中提供可用的暂停入口；暂停后继续按钮持续可见可点击；点击继续后任务从暂停处恢复执行；暂停操作本身不报错"},{"parent":"16b04348-a61f-4c0b-a74d-1a76f2e01ba9","callout":[],"children":[],"id":"84bba3f4-81a1-4412-8ce0-40e5b376588d","title":"备注：#401 #158 #343"}],"collapsed":true,"id":"16b04348-a61f-4c0b-a74d-1a76f2e01ba9","title":"🔴【P0】goal 运行中缺少暂停与继续"},{"parent":"b5e2203e-db81-4303-9a53-cba0d04c801b","callout":[],"children":[{"parent":"6d8896a3-eaab-4a0f-bbb2-47e325860b3f","callout":[],"children":[],"id":"e18d7b3a-942f-4400-aad7-4fe04e800d75","title":"前置：前置：goal 正在执行；角色：房间成员；入口：goal 状态区"},{"parent":"6d8896a3-eaab-4a0f-bbb2-47e325860b3f","callout":[],"children":[],"id":"46e02aaa-0bcc-4425-bdbc-08838f216574","title":"操作：调用 /goal 后立即清除目标，或在进行中删除 goal，观察后续轮次"},{"parent":"6d8896a3-eaab-4a0f-bbb2-47e325860b3f","callout":[],"children":[],"id":"504531cc-0ab5-432f-896e-55fc6d98b5c1","title":"预期：清除或删除后 Agent 停止后续轮次执行且目标不再重新出现；不报 workspace agent session not found；取消导致的命令中断在工具调用中给出可读的错误说明"},{"parent":"6d8896a3-eaab-4a0f-bbb2-47e325860b3f","callout":[],"children":[],"id":"d6b84328-eee8-4c3f-9693-8f730d3e7dc1","title":"备注：#329 #443 #49"}],"collapsed":true,"id":"6d8896a3-eaab-4a0f-bbb2-47e325860b3f","title":"🔴【P0】取消或删除 goal 后仍继续执行"}],"collapsed":true,"id":"b5e2203e-db81-4303-9a53-cba0d04c801b","title":"异常场景（4）"},{"parent":"5b796089-9b4e-4e52-8064-b10e76dd846f","callout":[],"children":[{"parent":"c58214cb-f670-43a3-9303-186a5cddde13","callout":[],"children":[{"parent":"f6e1f763-cf0c-4c8f-809c-4ef82c1f2be3","callout":[],"children":[],"id":"32b8c4de-ae36-46cc-8836-c4d916a3987c","title":"前置：会话中已存在一个进行中的目标"},{"parent":"f6e1f763-cf0c-4c8f-809c-4ef82c1f2be3","callout":[],"children":[],"id":"12d346b6-1bea-4428-bf3d-88f5fd55aa3d","title":"操作：再次执行 /goal 设置新目标"},{"parent":"f6e1f763-cf0c-4c8f-809c-4ef82c1f2be3","callout":[],"children":[],"id":"e091a115-cf6f-48a3-b7bc-136fc7bdfe1f","title":"预期：明确的替换或拒绝行为，不出现两个目标同时进行中且状态互相覆盖"}],"collapsed":true,"id":"f6e1f763-cf0c-4c8f-809c-4ef82c1f2be3","title":"🟡【P2】同一会话中重复设置目标"}],"collapsed":true,"id":"c58214cb-f670-43a3-9303-186a5cddde13","title":"边界场景（1）"}],"collapsed":true,"id":"5b796