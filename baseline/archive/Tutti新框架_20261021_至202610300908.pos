4d-4d99-ae01-ba8adff8d7e2","title":"操作：点击 Re-check 后查看 Usage limit 区域"},{"parent":"f4c1179c-83e2-4275-9286-6b464124ac53","callout":[],"children":[],"id":"dce965fe-c776-44d8-838c-46c8b81df542","title":"预期：额度按产品定义同步刷新或保持原值且行为稳定一致；不出现进度条与百分比来源不同导致的错配"}],"collapsed":true,"id":"f4c1179c-83e2-4275-9286-6b464124ac53","title":"🟡【P2】Re-check 后额度数据同步刷新"},{"parent":"97cadebd-f0f5-438a-8e36-36b353bb6807","callout":[],"children":[{"parent":"d6f4d921-e85e-4a2c-9422-e9e971ae2655","callout":[],"children":[],"id":"a6c54ba0-7d9b-4c0c-925b-359ee1e623ee","title":"前置：Agent 已安装且已登录"},{"parent":"d6f4d921-e85e-4a2c-9422-e9e971ae2655","callout":[],"children":[],"id":"d2458707-42b3-4707-aba8-6e8ec15d632f","title":"操作：在重置前 1 秒、重置时刻和重置后 1 秒查看"},{"parent":"d6f4d921-e85e-4a2c-9422-e9e971ae2655","callout":[],"children":[],"id":"bd58eee1-598c-4c0c-b64b-0e5eea2aa93e","title":"预期：重置前后数据切换准确，不出现负倒计时或旧周期残留"}],"collapsed":true,"id":"d6f4d921-e85e-4a2c-9422-e9e971ae2655","title":"🟡【P2】临近重置"},{"parent":"97cadebd-f0f5-438a-8e36-36b353bb6807","callout":[],"children":[{"parent":"46f6eb94-3eec-46c1-bc3b-39acc934fc56","callout":[],"children":[],"id":"9d2cb888-bd68-4cee-a005-c8b382cfa896","title":"前置：Agent 已安装且已登录"},{"parent":"46f6eb94-3eec-46c1-bc3b-39acc934fc56","callout":[],"children":[],"id":"14d107f1-7dc5-421b-8cec-dc2dfa702fa1","title":"操作：返回剩余 0%"},{"parent":"46f6eb94-3eec-46c1-bc3b-39acc934fc56","callout":[],"children":[],"id":"b9e023e8-7d64-4745-b12f-7ef24376fadb","title":"预期：进度条为空并显示 0% left，同时明确重置时间"}],"collapsed":true,"id":"46f6eb94-3eec-46c1-bc3b-39acc934fc56","title":"🟡【P2】剩余 0%"},{"parent":"97cadebd-f0f5-438a-8e36-36b353bb6807","callout":[],"children":[{"parent":"0110ed61-9b76-4f23-80f2-159a03e84bbe","callout":[],"children":[],"id":"8ae8be3a-ccfa-4c8e-9640-7ee82c42a063","title":"前置：Agent 已安装且已登录"},{"parent":"0110ed61-9b76-4f23-80f2-159a03e84bbe","callout":[],"children":[],"id":"7c748af3-0b65-41f9-9acd-24a2d0185b4e","title":"操作：返回剩余 100%"},{"parent":"0110ed61-9b76-4f23-80f2-159a03e84bbe","callout":[],"children":[],"id":"d41b402e-8330-4921-8663-5a2d66809bbc","title":"预期：进度条填满且文字显示 100% left，不超出轨道"}],"collapsed":true,"id":"0110ed61-9b76-4f23-80f2-159a03e84bbe","title":"🟡【P2】剩余 100%"},{"parent":"97cadebd-f0f5-438a-8e36-36b353bb6807","callout":[],"children":[{"parent":"5719fd28-29e7-48a2-b3d5-0bf2a2245a16","callout":[],"children":[],"id":"1ef17b54-dd4e-4d7b-a92e-24f941404fed","title":"前置：Agent 已安装且已登录"},{"parent":"5719fd28-29e7-48a2-b3d5-0bf2a2245a16","callout":[],"children":[],"id":"fc76aef1-164e-4562-9976-78612d6adb7b","title":"操作：接口返回 63.49% 和 99.99%"},{"parent":"5719fd28-29e7-48a2-b3d5-0bf2a2245a16","callout":[],"children":[],"id":"bf53cd54-92b7-4951-9247-b850fc3f2f60","title":"预期：按产品约定统一取整，文字和进度条采用同一舍入规则"}],"collapsed":true,"id":"5719fd28-29e7-48a2-b3d5-0bf2a2245a16","title":"🟡【P2】小数百分比"},{"parent":"97cadebd-f0f5-438a-8e36-36b353bb6807","callout":[],"children":[{"parent":"3806641a-54bb-4b5e-8df6-1708b31dc5ae","callout":[],"children":[],"id":"e23171d2-3102-46d8-8afc-91b04623e31d","title":"前置：Agent 已安装且已登录"},{"parent":"3806641a-54bb-4b5e-8df6-1708b31dc5ae","callout":[],"children":[],"id":"a4c19aa1-6268-49f0-85e8-2652941e89aa","title":"操作：设置重置时间跨日、跨月和跨年"},{"parent":"3806641a-54bb-4b5e-8df6-1708b31dc5ae","callout":[],"children":[],"id":"7e69f3cc-5d06-47dc-9a3a-b24846d306a9","title":"预期：日期显示正确且排序、时区换算无误"}],"collapsed":true,"id":"3806641a-54bb-4b5e-8df6-1708b31dc5ae","title":"🟡【P2】跨日跨月跨年"},{"parent":"97cadebd-f0f5-438a-8e36-36b353bb6807","callout":[],"children":[{"parent":"f0854ec9-28a1-4a76-97e3-7acd7e06f43f","callout":[],"children":[],"id":"bcd4130c-a28c-497c-82c3-948e52e71152","title":"前置：该 Agent 额度已用尽"},{"parent":"f0854ec9-28a1-4a76-97e3-7acd7e06f43f","callout":[],"children":[],"id":"44a466df-6a9b-47c9-9537-dcaadd91f66c","title":"操作：查看并点击用量限制区域"},{"parent":"f0854ec9-28a1-4a76-97e3-7acd7e06f43f","callout":[],"children":[],"id":"a95cd4d1-d12b-4059-9fe9-057a45819389","title":"预期：面板展示剩余 0 且样式有区分；点击仍可进入详情查看重置时间"}],"collapsed":true,"id":"f0854ec9-28a1-4a76-97e3-7acd7e06f43f","title":"🟡【P2】额度为 0 时的入口展示"}],"collapsed":true,"id":"97cadebd-f0f5-438a-8e36-36b353bb6807","title":"边界场景（7）"}],"collapsed":true,"id":"e3c3a40c-5626-4793-b12c-3bcaf3090c65","title":"3.3 Usage limit"},{"parent":"dde3d537-0aa0-4974-b29f-77b0eccee5e1","callout":[],"children":[{"parent":"880fca1e-6152-4fb9-892e-823877248d1a","callout":[],"children":[{"parent":"519a8c58-7f42-4b8f-ac79-4550db24c553","callout":[],"children":[{"parent":"1af0b4cd-ac09-40a6-bc28-33e026abc338","callout":[],"children":[],"id":"d93d583e-1803-4a16-b436-06bed281e691","title":"前置：Agent 已安装"},{"parent":"1af0b4cd-ac09-40a6-bc28-33e026abc338","callout":[],"children":[],"id":"1536b12b-34b4-4da5-9256-249fb4c92071","title":"操作：首次进入 Agent Management 页，观察卡片检测过程"},{"parent":"1af0b4cd-ac09-40a6-bc28-33e026abc338","callout":[],"children":[],"id":"ed9cf310-770e-403e-9b4f-0bca295ad671","title":"预期：自动依次执行 Environment、CLI &amp; Adapter、Signed in 三步并逐步更新状态；无需手动点击即可给出最终可用状态"}],"collapsed":true,"id":"1af0b4cd-ac09-40a6-bc28-33e026abc338","title":"🔴【P0】进入管理页后的首次自动检测"},{"parent":"519a8c58-7f42-4b8f-ac79-4550db24c553","callout":[],"children":[{"parent":"75fb1477-d564-4b86-b95b-79f24fc7a35d","callout":[],"children":[],"id":"f8c5ba61-16ff-4eba-b800-89526d6614c5","title":"前置：该 Agent 已安装"},{"parent":"75fb1477-d564-4b86-b95b-79f24fc7a35d","customWidth":432.4,"callout":[],"children":[],"id":"88a1194a-10d9-4442-b883-00ff7994297e","title":"操作：进入 Agent Management 页查看 Availability Check 区域"},{"parent":"75fb1477-d564-4b86-b95b-79f24fc7a35d","callout":[],"children":[],"id":"7ede8885-975f-4db5-88f9-3a4499cbf9e4","title":"预期：该区域固定展示 Environment、CLI &amp; Adapter、Signed in 三个步骤，顺序一致；不向用户暴露更细的内部检查项"}],"collapsed":true,"id":"75fb1477-d564-4b86-b95b-79f24fc7a35d","title":"🔴【P0】检测按环境、CLI、登录三步展示"},{"parent":"519a8c58-7f42-4b8f-ac79-4550db24c553","callout":[],"children":[{"parent":"c435fca9-ccb3-447a-aa1d-8e58e7dd9dfc","callout":[],"children":[],"id":"08a485cc-cd32-4581-ba3f-8aecd02da8b2","title":"前置：Agent 卡片已完成过一次检测"},{"parent":"c435fca9-ccb3-447a-aa1d-8e58e7dd9dfc","callout":[],"children":[],"id":"f6bf8dfa-b2d7-4f79-803a-38c3de9bd0d6","title":"操作：点击卡片底部的 Re-check"},{"parent":"c435fca9-ccb3-447a-aa1d-8e58e7dd9dfc","callout":[],"children":[],"id":"2e8a2602-7c50-499d-b0c1-4f4dc89c38f0","title":"预期：三步全部重新执行，过程中有明确的进行中状态，完成后按最新结果更新各步状态与卡片状态文案"}],"collapsed":true,"id":"c435fca9-ccb3-447a-aa1d-8e58e7dd9dfc","title":"🔴【P0】点击 Re-check 重新执行检测"},{"parent":"519a8c58-7f42-4b8f-ac79-4550db24c553","callout":[],"children":[{"parent":"419e143b-e8f1-405d-8251-762cbf7af3f5","callout":[],"children":[],"id":"88eabc20-0551-405a-9811-c69fd702369f","title":"前置：某一检测步骤处于失败态"},{"parent":"419e143b-e8f1-405d-8251-762cbf7af3f5","callout":[],"children":[],"id":"80879a0f-e83c-4757-8e6d-561ed4fa75ba","title":"操作：修复该失败原因后点击 Re-check"},{"parent":"419e143b-e8f1-405d-8251-762cbf7af3f5","callout":[],"children":[],"id":"494705ab-b6f4-4f8e-928a-fb67ddfeafc7","title":"预期：该步由失败变为通过并据此重新计算卡片整体可用状态，不保留旧的失败描述"}],"collapsed":true,"id":"419e143b-e8f1-405d-8251-762cbf7af3f5","title":"🟠【P1】修复失败项后重新检测的结果更新"},{"parent":"519a8c58-7f42-4b8f-ac79-4550db24c553","callout":[],"children":[{"parent":"0778152b-c91f-47ec-867e-48ac70b26bd1","callout":[],"children":[],"id":"0bc1e9c0-6ad9-4ba8-816f-5ce95b8227c4","title":"前置：依赖与账号均正常的环境"},{"parent":"0778152b-c91f-47ec-867e-48ac70b26bd1","callout":[],"children":[],"id":"58a3e94e-0ca3-4aec-923b-d5097483c9ec","title":"操作：进入 Agent Management 页触发检测并等待完成"},{"parent":"0778152b-c91f-47ec-867e-48ac70b26bd1","callout":[],"children":[],"id":"d53133b6-364e-48b7-97bf-fc2bcebfa92c","title":"预期：Environment、CLI &amp; Adapter、Signed in 三项均显示通过图标；卡片状态文案变为 Available"}],"collapsed":true,"id":"0778152b-c91f-47ec-867e-48ac70b26bd1","title":"🔴【P0】三步检测全部通过"},{"parent":"519a8c58-7f42-4b8f-ac79-4550db24c553","callout":[],"children":[{"parent":"f81dcd9c-c0a4-46cd-8980-39be6ec648fa","callout":[],"children":[],"id":"9916f10b-98d4-468d-bbf5-c583aad92117","title":"前置：该 Agent 已安装"},{"parent":"f81dcd9c-c0a4-46cd-8980-39be6ec648fa","callout":[],"children":[],"id":"9e2ee3b5-3cdd-48d5-886b-4ab774196f53","title":"操作：触发检测并在过程中与结束后分别观察三步的状态图标"},{"parent":"f81dcd9c-c0a4-46cd-8980-39be6ec648fa","callout":[],"children":[],"id":"2482e2b2-9b9b-46ad-a719-c27cddbaa84c","title":"预期：进行中、通过、失败三种状态的图标与文案有明确区分且不只依赖颜色；已完成的步骤不会被后续步骤的状态覆盖"}],"collapsed":true,"id":"f81dcd9c-c0a4-46cd-8980-39be6ec648fa","title":"🟠【P1】各步骤的进行中、通过、失败三种状态展示"}],"collapsed":true,"id":"519a8c58-7f42-4b8f-ac79-4550db24c553","title":"正常场景（7）"},{"parent":"880fca1e-6152-4fb9-892e-823877248d1a","callout":[],"children":[{"parent":"f5e14398-7653-4dfd-8286-f77e26957bde","callout":[],"children":[{"parent":"922dacae-e317-471f-bcaa-dcef3b004a02","callout":[],"children":[],"id":"e37e1420-c86b-4c6c-a30d-afd01768c09b","title":"前置：前置：刚安装新版本应用；角色：Agent 所有者；入口：管理智能体页面"},{"parent":"922dacae-e317-471f-bcaa-dcef3b004a02","callout":[],"children":[],"id":"74d3e12e-325b-4cb5-a519-383632536708","title":"操作：安装完成后打开管理智能体页面观察各 Agent 检测状态"},{"parent":"922dacae-e317-471f-bcaa-dcef3b004a02","callout":[],"children":[],"id":"92024d02-9d44-4ecc-9f8c-868462cd678e","title":"预期：检测在合理时间内给出明确结果（已登录或需要登录），不长时间停留在检查中形成死锁；若首次检测失败提供刷新入口，一次刷新即可恢复真实状态"}],"collapsed":true,"id":"922dacae-e317-471f-bcaa-dcef3b004a02","title":"🔴【P0】安装新包后检测"},{"parent":"f5e14398-7653-4dfd-8286-f77e26957bde","callout":[],"children":[{"parent":"639eccbc-89e6-4bee-bccb-604f0c8dfa6b","callout":[],"children":[],"id":"5dfa74a8-b965-4509-affb-07463e1ff768","title":"前置：Claude 与 Codex 均未安装；角色：Agent 所有者；入口：Agent管理页面"},{"parent":"639eccbc-89e6-4bee-bccb-604f0c8dfa6b","callout":[],"children":[],"id":"3e498c51-de0e-4f73-8629-9e29d599eec8","title":"操作：只点击 Codex 的连接按钮，等待完成后查看两个卡片状态"},{"parent":"639eccbc-89e6-4bee-bccb-604f0c8dfa6b","callout":[],"children":[],"id":"d7048999-f4ef-493c-826a-574fff0238f6","title":"预期：只有 Codex 状态变为已连接，Claude 状态保持不变；不出现连接结果串到另一个 Agent；无需刷新即可看到正确状态"}],"collapsed":true,"id":"639eccbc-89e6-4bee-bccb-604f0c8dfa6b","title":"🔴【P0】连接一个 Agent 后另一个不显示已连接"},{"parent":"f5e14398-7653-4dfd-8286-f77e26957bde","callout":[],"children":[{"parent":"30b18188-7051-4b47-8b71-f8aac6e1ae63","callout":[],"children":[],"id":"de21d16c-3241-446a-9dba-164f8b8f9d00","title":"前置：前置：房间处于打开状态；角色：Agent 所有者；入口：Agent管理页面"},{"parent":"30b18188-7051-4b47-8b71-f8aac6e1ae63","callout":[],"children":[],"id":"4f63fd11-d9bd-4c97-b656-fc900be98b7d","title":"操作：电脑锁屏休眠数小时后唤醒并查看各 Agent 检测状态"},{"parent":"30b18188-7051-4b47-8b71-f8aac6e1ae63","callout":[],"children":[],"id":"bba4e646-4fb7-4a24-9e6b-ffd4b6aca40a","title":"预期：唤醒后检测在合理时间内完成并给出真实状态；不长时间停留在检查中；不出现已安装的 Agent 被误判为需要重新安装"},{"parent":"30b18188-7051-4b47-8b71-f8aac6e1ae63","callout":[],"children":[],"id":"2dd2daf4-401a-4c59-96ae-3e26e4591d4c","title":"备注：#260 #386 #388"}],"collapsed":true,"id":"30b18188-7051-4b47-8b71-f8aac6e1ae63","title":"🔴【P0】锁屏休眠后检测"},{"parent":"f5e14398-7653-4dfd-8286-f77e26957bde","callout":[],"children":[{"parent":"d396509a-31ae-447d-a87b-a9e14e8b857c","callout":[],"children":[],"id":"36dd0c3b-af43-48fc-90ac-61c7a1d626ca","title":"前置：Agent 已安装且已登录，已进入 Agent Management 页"},{"parent":"d396509a-31ae-447d-a87b-a9e14e8b857c","callout":[],"children":[],"id":"adb544a5-c1d1-46cc-acac-fbea9dbdeade","title":"操作：让网络或 CLI 检测超过超时阈值"},{"parent":"d396509a-31ae-447d-a87b-a9e14e8b857c","callout":[],"children":[],"id":"8ccb3754-596e-4c38-99be-c5d28164d151","title":"预期：对应项显示超时，其他独立检查继续或按规则结束"}],"collapsed":true,"id":"d396509a-31ae-447d-a87b-a9e14e8b857c","title":"🟠【P1】单项检测超时"}],"collapsed":true,"id":"f5e14398-7653-4dfd-8286-f77e26957bde","title":"异常场景（8）"},{"parent":"880fca1e-6152-4fb9-892e-823877248d1a","callout":[],"children":[{"parent":"a612faab-5649-466c-a0b1-0761753f0244","callout":[],"children":[{"parent":"b94e8d7c-6ed2-4274-9f8a-2ce41656211b","callout":[],"children":[],"id":"ff0a7e4f-ac65-40e9-80b8-c96a8efb0a26","title":"前置：空环境、断网且未登录"},{"parent":"b94e8d7c-6ed2-4274-9f8a-2ce41656211b","callout":[],"children":[],"id":"15dc435b-5ac8-4774-b65f-3b65bbe58a54","title":"操作：触发检测并查看三步的状态与描述区"},{"parent":"b94e8d7c-6ed2-4274-9f8a-2ce41656211b","callout":[],"children":[],"id":"cd916d3b-5ec8-49c2-9247-39c559f70601","title":"预期：三步均标记为失败，且各自标题下方的描述区分别给出该步的具体失败原因与恢复建议；不把所有原因堆在同一处，也不出现笼统的统一报错"}],"collapsed":true,"id":"b94e8d7c-6ed2-4274-9f8a-2ce41656211b","title":"🟡【P2】三步全部失败时的展示"},{"parent":"a612faab-5649-466c-a0b1-0761753f0244","callout":[],"children":[{"parent":"d3c5fe39-4660-43c4-9463-98226dae4506","callout":[],"children":[],"id":"d7639c04-03cc-4e11-bcd9-a1e6a06e7e11","title":"前置：Agent 已安装且已登录，已进入 Agent Management 页"},{"parent":"d3c5fe39-4660-43c4-9463-98226dae4506","callout":[],"children":[],"id":"2d827be9-e1cb-46cb-9c49-7ba52d8f8043","title":"操作：连续点击 Re-check 20 次"},{"parent":"d3c5fe39-4660-43c4-9463-98226dae4506","callout":[],"children":[],"id":"b6486fe5-46c9-4114-9f4d-9b143a4f0616","title":"预期：按钮防抖或取消前序任务，仅保留一轮有效检测"}],"collapsed":true,"id":"d3c5fe39-4660-43c4-9463-98226dae4506","title":"🟡【P2】快速重复检测"},{"parent":"a612faab-5649-466c-a0b1-0761753f0244","callout":[],"children":[{"parent":"a63eccb5-9c9c-45ea-bccd-c10636ab46bc","callout":[],"children":[],"id":"a1962f4c-d219-4edc-ad62-3579c3378dec","title":"前置：Agent 已安装且已登录，已进入 Agent Management 页"},{"parent":"a63eccb5-9c9c-45ea-bccd-c10636ab46bc","callout":[],"children":[],"id":"3993986e-bd09-4101-bb29-9f4984c310d1","title":"操作：分别在超时阈值前后 1 毫秒返回结果"},{"parent":"a63eccb5-9c9c-45ea-bccd-c10636ab46bc","callout":[],"children":[],"id":"2b852c64-c8f9-4d3b-b460-6fa268da00e7","title":"预期：阈值内判定成功，超出时按超时规则处理且结果稳定"}],"collapsed":true,"id":"a63eccb5-9c9c-45ea-bccd-c10636ab46bc","title":"🟡【P2】检测耗时临界"},{"parent":"a612faab-5649-466c-a0b1-0761753f0244","callout":[],"children":[{"parent":"a39c0bb8-18cd-4531-89f8-b743ccc56e8c","callout":[],"children":[],"id":"74684e5e-fa20-494b-ae82-cce128e437cb","title":"前置：检测正在进行中"},{"parent":"a39c0bb8-18cd-4531-89f8-b743ccc56e8c","callout":[],"children":[],"id":"698d047a-2dd7-4afb-8456-9289c4a06615","title":"操作：连续点击刷新入口多次"},{"parent":"a39c0bb8-18cd-4531-89f8-b743ccc56e8c","callout":[],"children":[],"id":"a4dd7277-b061-4c4d-b978-36eb7bbaa439","title":"预期：不并发发起多次检测；界面状态与实际检测任务一致"}],"collapsed":true,"id":"a39c0bb8-18cd-4531-89f8-b743ccc56e8c","title":"🟡【P2】检测进行中重复点击刷新"},{"parent":"a612faab-5649-466c-a0b1-0761753f0244","callout":[],"children":[{"parent":"0244668e-5340-48da-b656-8655b71dea94","callout":[],"children":[],"id":"74c937b9-38f8-4ca4-86f3-a6b98bbd2e01","title":"前置：Agent 已安装且检测正在进行中"},{"parent":"0244668e-5340-48da-b656-8655b71dea94","callout":[],"children":[],"id":"87d5c5c4-7953-49bb-8a19-88cb43765e10","title":"操作：检测中让系统休眠，恢复后继续操作"},{"parent":"0244668e-5340-48da-b656-8655b71dea94","callout":[],"children":[],"id":"771fa65d-891a-4fe1-9dc2-21ab7d9defbb","title":"预期：旧任务被安全恢复或终止，用户可再次点击 Re-check且状态不假成功"}],"collapsed":true,"id":"0244668e-5340-48da-b656-8655b71dea94","title":"🟡【P2】系统休眠恢复"}],"collapsed":true,"id":"a612faab-5649-466c-a0b1-0761753f0244","title":"边界场景（5）"}],"collapsed":true,"id":"880fca1e-6152-4fb9-892e-823877248d1a","title":"3.4 Availability Check — 三步整体流程"},{"parent":"dde3d537-0aa0-4974-b29f-77b0eccee5e1","callout":[],"children":[{"parent":"12cbdcc2-0407-45d5-8159-723212447065","callout":[],"children":[{"parent":"499eae05-4ec5-4886-876c-d8226f03af35","callout":[],"children":[{"parent":"692d160e-a5ea-42eb-aacd-8444d3418b4c","callout":[],"children":[],"id":"9964fd23-b642-4a76-9f6a-72f1f0d3279e","title":"前置：网络可访问该 Agent 的安装源与服务 API"},{"parent":"692d160e-a5ea-42eb-aacd-8444d3418b4c","callout":[],"children":[],"id":"a349cca6-5356-4c65-a45e-9d5a60d7594d","title":"操作：触发检测并查看 Environment 项下的三个字段"},{"parent":"692d160e-a5ea-42eb-aacd-8444d3418b4c","callout":[],"children":[],"id":"0416a0b9-28fe-4731-b815-64d2e795e5dd","title":"预期：Environment 显示通过；Install source、Service API、Proxy 三个字段均展示实际取值，取值与该 Agent 的实际配置一致"}],"collapsed":true,"id":"692d160e-a5ea-42eb-aacd-8444d3418b4c","title":"🔴【P0】Environment 检测通过时的字段展示"},{"parent":"499eae05-4ec5-4886-876c-d8226f03af35","callout":[],"children":[{"parent":"8e2e3854-2fbb-4a35-ae46-46e575013bf4","callout":[],"children":[],"id":"f8c33456-b9e3-49c3-87b6-24aa25993d68","title":"前置：三个 Agent 均已安装"},{"parent":"8e2e3854-2fbb-4a35-ae46-46e575013bf4","callout":[],"children":[],"id":"b08a5355-0c1d-45c5-b051-88a3df5ed8ec","title":"操作：分别查看三张卡片 Environment 下的 Install source 与 Service API"},{"parent":"8e2e3854-2fbb-4a35-ae46-46e575013bf4","callout":[],"children":[],"id":"ac7b8cbf-f55b-458a-b54a-9f3856a05945","title":"预期：各 Agent 展示各自实际使用的安装源与服务 API 域名，互不串用；对不依赖外部服务 API 的 Agent，Service API 展示为 Not Applicable"}],"collapsed":true,"id":"8e2e3854-2fbb-4a35-ae46-46e575013bf4","title":"🔴【P0】不同 Agent 的 Install source 与 Service API 取值差异"},{"parent":"499eae05-4ec5-4886-876c-d8226f03af35","callout":[],"children":[{"parent":"f6fb2bce-b398-40fc-9dde-80df9aa6495a","callout":[],"children":[],"id":"02e2c3dd-ba44-45f5-95aa-d03e3ea26a67","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"f6fb2bce-b398-40fc-9dde-80df9aa6495a","callout":[],"children":[],"id":"b6c65fd8-9dea-48c2-95d1-593267eb9186","title":"操作：在受支持操作系统和架构上执行检测"},{"parent":"f6fb2bce-b398-40fc-9dde-80df9aa6495a","callout":[],"children":[],"id":"969e524a-cf21-4a83-b3e8-a6a837dfd468","title":"预期：Environment 显示通过，识别到正确平台和运行环境"}],"collapsed":true,"id":"f6fb2bce-b398-40fc-9dde-80df9aa6495a","title":"🔴【P0】系统环境通过"},{"parent":"499eae05-4ec5-4886-876c-d8226f03af35","callout":[],"children":[{"parent":"b2daeba9-5f0e-49a3-a885-ec5b2a4c3115","callout":[],"children":[],"id":"94fbf0fc-8904-47bd-902f-9d190f2c6bd4","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"b2daeba9-5f0e-49a3-a885-ec5b2a4c3115","callout":[],"children":[],"id":"7b030c81-32bd-41ae-9adb-f1f2b07a63ef","title":"操作：首次断网失败，恢复网络后点击 Re-check"},{"parent":"b2daeba9-5f0e-49a3-a885-ec5b2a4c3115","callout":[],"children":[],"id":"ea602bec-71ce-462f-97ed-ceed4afe3ce8","title":"预期：Environment 变为通过，并继续完成后续检查"}],"collapsed":true,"id":"b2daeba9-5f0e-49a3-a885-ec5b2a4c3115","title":"🔴【P0】网络恢复后重检"},{"parent":"499eae05-4ec5-4886-876c-d8226f03af35","callout":[],"children":[{"parent":"f2b33b1c-3a35-47dc-af0d-3662de21c909","callout":[],"children":[],"id":"eaa54bd4-76e3-46f5-9692-d633d6b8d513","title":"前置：系统已配置有效的 HTTP/HTTPS 代理"},{"parent":"f2b33b1c-3a35-47dc-af0d-3662de21c909","callout":[],"children":[],"id":"0ba643c1-b899-4c64-8b6e-999e51ecf425","title":"操作：触发检测并查看 Environment 项下的 Proxy 字段"},{"parent":"f2b33b1c-3a35-47dc-af0d-3662de21c909","callout":[],"children":[],"id":"658fd5e9-362e-4b8a-9ede-f120213afe8b","title":"预期：Environment 检测通过；Proxy 字段展示当前实际生效的代理地址与端口，与系统配置一致；检测走代理完成，不误报离线"}],"collapsed":true,"id":"f2b33b1c-3a35-47dc-af0d-3662de21c909","title":"🔴【P0】配置代理时 Proxy 字段的展示"},{"parent":"499eae05-4ec5-4886-876c-d8226f03af35","callout":[],"children":[{"parent":"ce2b1fb1-3bc3-4c34-a139-70ba231b51b5","callout":[],"children":[],"id":"cb6871eb-1cb6-410d-85dd-87901579efa4","title":"前置：系统未配置任何代理"},{"parent":"ce2b1fb1-3bc3-4c34-a139-70ba231b51b5","callout":[],"children":[],"id":"72a581b6-7eac-4124-b3ad-26a7143a7ffe","title":"操作：查看 Environment 下的 Proxy 字段"},{"parent":"ce2b1fb1-3bc3-4c34-a139-70ba231b51b5","callout":[],"children":[],"id":"85197869-d6b5-4b43-bf3f-ea40a4a76094","title":"预期：按产品约定展示为无代理或占位值，不展示 undefined、null 或空白"}],"collapsed":true,"id":"ce2b1fb1-3bc3-4c34-a139-70ba231b51b5","title":"🟠【P1】未配置代理时 Proxy 字段的展示"}],"collapsed":true,"id":"499eae05-4ec5-4886-876c-d8226f03af35","title":"正常场景（6）"},{"parent":"12cbdcc2-0407-45d5-8159-723212447065","callout":[],"children":[{"parent":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","callout":[],"children":[{"parent":"c647d68b-43b6-4cb4-b02c-4fa08e9f16ff","callout":[],"children":[],"id":"91689617-65c2-4d8e-a1e0-0500bd09eca3","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"c647d68b-43b6-4cb4-b02c-4fa08e9f16ff","callout":[],"children":[],"id":"fbb38dc9-b938-46d2-99cf-49332e133252","title":"操作：配置需要认证但凭据错误的代理"},{"parent":"c647d68b-43b6-4cb4-b02c-4fa08e9f16ff","callout":[],"children":[],"id":"897fddb5-50aa-4169-97d7-dd7d293aa474","title":"预期：Environment 标记为失败且不在日志或界面泄露代理密码"}],"collapsed":true,"id":"c647d68b-43b6-4cb4-b02c-4fa08e9f16ff","title":"🔴【P0】代理认证失败"},{"parent":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","callout":[],"children":[{"parent":"8397996a-8927-404b-93d4-18d94c7c09fe","callout":[],"children":[],"id":"19f952d1-68f6-4b5b-a3bf-fa3207878b8f","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"8397996a-8927-404b-93d4-18d94c7c09fe","callout":[],"children":[],"id":"3d61b5d1-3e09-4597-b830-99aa16d157c6","title":"操作：在不受支持的系统版本或架构检测"},{"parent":"8397996a-8927-404b-93d4-18d94c7c09fe","callout":[],"children":[],"id":"c9adc487-542e-4ee1-8b5e-c0d237a353dd","title":"预期：Environment 标记为失败并明确最低要求，不继续误判为就绪"}],"collapsed":true,"id":"8397996a-8927-404b-93d4-18d94c7c09fe","title":"🔴【P0】受限系统环境"},{"parent":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","callout":[],"children":[{"parent":"0615a406-bcb3-4899-80fb-8db11909a442","callout":[],"children":[],"id":"0453f69a-0265-403c-b955-bc75c56445ba","title":"前置：配置的安装源域名无法访问"},{"parent":"0615a406-bcb3-4899-80fb-8db11909a442","callout":[],"children":[],"id":"66b7b128-f5a4-418b-9e19-3fc8fd5f9a07","title":"操作：触发检测并查看 Environment 步骤"},{"parent":"0615a406-bcb3-4899-80fb-8db11909a442","callout":[],"children":[],"id":"22551cb1-8043-4339-9b04-91b8ff644a4f","title":"预期：Environment 标记为失败，其下方描述区说明安装源不可达并给出该来源地址；不笼统提示网络异常"},{"parent":"0615a406-bcb3-4899-80fb-8db11909a442","callout":[],"children":[],"id":"5c66cc54-d16f-4e1c-b0e8-7ff47b47f623","title":"备注：依据产品备注：登录过程对外只展示环境 / CLI / 注册三步，具体报错原因展示在对应标题下方的描述区域"}],"collapsed":true,"id":"0615a406-bcb3-4899-80fb-8db11909a442","title":"🟠【P1】Install source 不可达时的检测结论"},{"parent":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","callout":[],"children":[{"parent":"ba4438b0-65ee-411c-8a91-d7b05f955de5","callout":[],"children":[],"id":"124cd8e1-e1f8-4f25-9697-9d22f0ce6606","title":"前置：配置了指向不存在端口的代理"},{"parent":"ba4438b0-65ee-411c-8a91-d7b05f955de5","callout":[],"children":[],"id":"a3135057-1046-4bb1-8a6c-8429d8a3d583","title":"操作：触发检测并查看 Environment 步骤"},{"parent":"ba4438b0-65ee-411c-8a91-d7b05f955de5","callout":[],"children":[],"id":"393c48eb-7819-4d11-8b39-b115252e0f6d","title":"预期：描述区明确指出代理不可用并展示所使用的代理地址；不在界面或日志中回显代理密码"}],"collapsed":true,"id":"ba4438b0-65ee-411c-8a91-d7b05f955de5","title":"🟠【P1】Proxy 配置无效时的检测结论"},{"parent":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","callout":[],"children":[{"parent":"0fc88161-ec22-447f-833d-c87494c7f895","callout":[],"children":[],"id":"610b99fb-aeee-4f26-986f-eee6ee7bd40a","title":"前置：Service API 域名可解析但返回 4xx 或 5xx"},{"parent":"0fc88161-ec22-447f-833d-c87494c7f895","callout":[],"children":[],"id":"5fac5125-8031-4ed6-b682-9f425cd60a4f","title":"操作：触发检测并查看 Environment 步骤"},{"parent":"0fc88161-ec22-447f-833d-c87494c7f895","callout":[],"children":[],"id":"231f73b8-4617-4e3f-9c1c-fdd976bdcedf","title":"预期：Environment 标记为失败并在描述区区分连接失败与服务返回错误；不误判为网络不通"},{"parent":"0fc88161-ec22-447f-833d-c87494c7f895","callout":[],"children":[],"id":"ca2b4387-f78c-49b3-a15e-c9de98d77a32","title":"备注：依据产品备注：登录过程对外只展示环境 / CLI / 注册三步，具体报错原因展示在对应标题下方的描述区域"}],"collapsed":true,"id":"0fc88161-ec22-447f-833d-c87494c7f895","title":"🟠【P1】Service API 返回错误状态码"},{"parent":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","callout":[],"children":[{"parent":"620ca110-5640-4bfd-abd4-84a6590916ea","callout":[],"children":[],"id":"1db4b04c-8b05-4ee6-8240-4edfcd7920ba","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"620ca110-5640-4bfd-abd4-84a6590916ea","callout":[],"children":[],"id":"165caf51-4e4a-4d88-954e-9d0220dc38a1","title":"操作：使用过期或不受信证书连接检测服务"},{"parent":"620ca110-5640-4bfd-abd4-84a6590916ea","callout":[],"children":[],"id":"061b9522-94dd-43c3-bca5-cc285d27eac4","title":"预期：安全拒绝连接并提示证书或安全连接异常"}],"collapsed":true,"id":"620ca110-5640-4bfd-abd4-84a6590916ea","title":"🟠【P1】TLS 证书异常"},{"parent":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","callout":[],"children":[{"parent":"9b567c8b-c511-4b6d-b63b-2a6c0c5c35cf","callout":[],"children":[],"id":"17efc836-bba5-433a-9167-a551fa31b438","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"9b567c8b-c511-4b6d-b63b-2a6c0c5c35cf","callout":[],"children":[],"id":"fc148083-8bc1-43d4-a4f5-f6230894b664","title":"操作：断开网络后检测"},{"parent":"9b567c8b-c511-4b6d-b63b-2a6c0c5c35cf","callout":[],"children":[],"id":"e50d0f4d-b099-457a-96b6-74006f7cb9cb","title":"预期：Environment 标记为失败并提示检查连接，不错误显示为 Available"}],"collapsed":true,"id":"9b567c8b-c511-4b6d-b63b-2a6c0c5c35cf","title":"🟠【P1】完全断网"},{"parent":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","callout":[],"children":[{"parent":"6870086d-c6d9-44e9-bccd-116e21ab09da","callout":[],"children":[],"id":"cb3cc687-7af7-4492-8815-6e9d89acc04b","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"6870086d-c6d9-44e9-bccd-116e21ab09da","callout":[],"children":[],"id":"05244932-7612-45e3-9cd6-5ccc4bdc712b","title":"操作：模拟域名无法解析"},{"parent":"6870086d-c6d9-44e9-bccd-116e21ab09da","callout":[],"children":[],"id":"ae404207-9566-47cd-abc1-ce99e743acd9","title":"预期：显示可区分的网络错误，检测在超时内结束"}],"collapsed":true,"id":"6870086d-c6d9-44e9-bccd-116e21ab09da","title":"🟡【P2】DNS 失败"}],"collapsed":true,"id":"683be0f5-0fea-4b5e-a4c4-d133238bb3e6","title":"异常场景（8）"},{"parent":"12cbdcc2-0407-45d5-8159-723212447065","callout":[],"children":[{"parent":"1dead01e-c9b0-41b3-8175-207f5c2add6b","callout":[],"children":[{"parent":"ec874a8c-f5be-472b-824f-3a9bc3cd2829","callout":[],"children":[],"id":"e6583644-5c77-42aa-8f2c-57b12648317f","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"ec874a8c-f5be-472b-824f-3a9bc3cd2829","callout":[],"children":[],"id":"51cd34e6-8b2e-4044-89be-94a7478444c4","title":"操作：仅启用 IPv6 网络后检测"},{"parent":"ec874a8c-f5be-472b-824f-3a9bc3cd2829","callout":[],"children":[],"id":"8f9fd160-4905-460c-9a49-a8f3ade2637e","title":"预期：服务支持时正常通过，不因仅检查 IPv4 而误报"}],"collapsed":true,"id":"ec874a8c-f5be-472b-824f-3a9bc3cd2829","title":"🟡【P2】IPv6 单栈"},{"parent":"1dead01e-c9b0-41b3-8175-207f5c2add6b","callout":[],"children":[{"parent":"5f75c5f5-dbbd-476a-a556-9b82532f2308","callout":[],"children":[],"id":"b0d17f62-973f-4870-bf80-7bcfa891569c","title":"前置：该 Agent 不依赖外部服务 API"},{"parent":"5f75c5f5-dbbd-476a-a556-9b82532f2308","callout":[],"children":[],"id":"27d9e1ac-f928-479e-bf09-a4a56d483fa0","title":"操作：查看 Environment 下的 Service API 字段"},{"parent":"5f75c5f5-dbbd-476a-a556-9b82532f2308","callout":[],"children":[],"id":"9249eb59-e668-4ef3-b1a6-56d2041ed293","title":"预期：展示为 Not Applicable 且该字段不参与通过与否的判定"}],"collapsed":true,"id":"5f75c5f5-dbbd-476a-a556-9b82532f2308","title":"🟡【P2】Service API 为 Not Applicable 时的展示"},{"parent":"1dead01e-c9b0-41b3-8175-207f5c2add6b","callout":[],"children":[{"parent":"6a9b0d1e-f140-458e-bbbb-170c1850af2a","callout":[],"children":[],"id":"f831427d-270c-40dd-ade9-33baf77ef5a5","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"6a9b0d1e-f140-458e-bbbb-170c1850af2a","callout":[],"children":[],"id":"298774ca-f3ff-4c5c-90a2-cd8eca68d868","title":"操作：检测期间交替断网和恢复"},{"parent":"6a9b0d1e-f140-458e-bbbb-170c1850af2a","callout":[],"children":[],"id":"2b2c6841-3a55-4048-90b5-744eb529abf8","title":"预期：最终状态可解释，重检后能恢复，不停留在永久加载"}],"collapsed":true,"id":"6a9b0d1e-f140-458e-bbbb-170c1850af2a","title":"🟡【P2】网络间歇抖动"},{"parent":"1dead01e-c9b0-41b3-8175-207f5c2add6b","callout":[],"children":[{"parent":"17f4a9ce-595f-41c3-870f-210000c27934","callout":[],"children":[],"id":"a3cba6c8-5216-4279-b227-24ac491eef57","title":"前置：配置超过卡片宽度的安装源地址或代理地址"},{"parent":"17f4a9ce-595f-41c3-870f-210000c27934","callout":[],"children":[],"id":"bcb2c63e-f740-4cc1-89d6-e8d8ad95f8af","title":"操作：查看 Environment 下的对应字段"},{"parent":"17f4a9ce-595f-41c3-870f-210000c27934","callout":[],"children":[],"id":"8d45717f-a880-4c55-ae24-de3043fa23e5","title":"预期：文本截断或换行且可查看完整值，不撑破卡片布局也不遮挡其他字段"},{"parent":"17f4a9ce-595f-41c3-870f-210000c27934","callout":[],"children":[],"id":"b6d5fcd3-f999-4296-9d0a-41f45fdfff98","title":"备注：依据新版 UI 图新增"}],"collapsed":true,"id":"17f4a9ce-595f-41c3-870f-210000c27934","title":"🟡【P2】超长的安装源或代理地址展示"},{"parent":"1dead01e-c9b0-41b3-8175-207f5c2add6b","callout":[],"children":[{"parent":"5b712748-f661-4404-a877-d7ab8be304b5","callout":[],"children":[],"id":"078efb2c-ba99-4e4d-a158-5bf0a314d12b","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"5b712748-f661-4404-a877-d7ab8be304b5","callout":[],"children":[],"id":"66757e5d-3459-47e7-931f-2505adb19b78","title":"操作：将网络延迟设置为接近超时阈值"},{"parent":"5b712748-f661-4404-a877-d7ab8be304b5","callout":[],"children":[],"id":"0c3abce9-db12-4db0-a4d5-e6df1a5bd61d","title":"预期：界面保持响应，最终结果符合超时规则"}],"collapsed":true,"id":"5b712748-f661-4404-a877-d7ab8be304b5","title":"🟡【P2】高延迟网络"}],"collapsed":true,"id":"1dead01e-c9b0-41b3-8175-207f5c2add6b","title":"边界场景（5）"}],"collapsed":true,"id":"12cbdcc2-0407-45d5-8159-723212447065","title":"3.5 Availability Check — Environment"},{"parent":"dde3d537-0aa0-4974-b29f-77b0eccee5e1","callout":[],"children":[{"parent":"9732a8fe-d5f4-44e7-91e4-6fd28b44411e","callout":[],"children":[{"parent":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","callout":[],"children":[{"parent":"0afe0f83-212f-47b7-b175-dbbe7f1277b8","callout":[],"children":[],"id":"af03f727-43f3-45ea-a24b-f49f0874f238","title":"前置：CLI 与适配器均已正确安装"},{"parent":"0afe0f83-212f-47b7-b175-dbbe7f1277b8","callout":[],"children":[],"id":"247d95cb-3172-45c3-9256-56f5824ddf90","title":"操作：查看 CLI &amp; Adapter 步骤下方的信息"},{"parent":"0afe0f83-212f-47b7-b175-dbbe7f1277b8","callout":[],"children":[],"id":"d0bbe5fe-4198-44a0-a9f8-a23e9d23a1b8","title":"预期：展示 Version 及其对应的 CLI 可执行路径，另起一行展示 Adapter 路径；版本号与路径与本机实际情况一致"}],"collapsed":true,"id":"0afe0f83-212f-47b7-b175-dbbe7f1277b8","title":"🔴【P0】CLI &amp; Adapter 通过时的版本与双路径展示"},{"parent":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","callout":[],"children":[{"parent":"dc038c85-adcb-4987-9038-01571b34ade7","callout":[],"children":[],"id":"7f9a6b4b-bfa7-4cc9-bb91-c94957191412","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"dc038c85-adcb-4987-9038-01571b34ade7","callout":[],"children":[],"id":"fdb03ef0-04ef-452d-8ee7-635139c269d3","title":"操作：配置兼容版本组合后检测"},{"parent":"dc038c85-adcb-4987-9038-01571b34ade7","callout":[],"children":[],"id":"99a6b058-e0ab-45ea-ac05-a622bdd68a23","title":"预期：CLI 与 Adapter 两行均判定通过且最终可以进入 Available 状态"}],"collapsed":true,"id":"dc038c85-adcb-4987-9038-01571b34ade7","title":"🔴【P0】CLI 与适配器兼容"},{"parent":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","callout":[],"children":[{"parent":"417c659d-5234-42a6-b11f-37cc8f901bdc","callout":[],"children":[],"id":"cb88d92f-c655-4abc-a8b9-986b24bbab49","title":"前置：目标 CLI 已安装在用户目录下的标准路径"},{"parent":"417c659d-5234-42a6-b11f-37cc8f901bdc","callout":[],"children":[],"id":"2fb1b72f-1c89-4a63-82c7-878f73cc7e0c","title":"操作：触发检测并查看 CLI &amp; Adapter 步骤"},{"parent":"417c659d-5234-42a6-b11f-37cc8f901bdc","callout":[],"children":[],"id":"ff87c539-59b0-4326-b5ea-2d7fc9fb6cab","title":"预期：该步显示通过，展示实际的 CLI 版本号与可执行文件路径，与本机安装情况一致"},{"parent":"417c659d-5234-42a6-b11f-37cc8f901bdc","callout":[],"children":[],"id":"0a4e797f-9094-4f55-b075-e0c47ad722b9","title":"备注：合并自各 Agent 的「CLI 已安装」用例；各 Agent 的版本号与路径见备注矩阵"}],"collapsed":true,"id":"417c659d-5234-42a6-b11f-37cc8f901bdc","title":"🔴【P0】CLI 已安装时展示版本与可执行路径"},{"parent":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","callout":[],"children":[{"parent":"36eace45-301e-4427-a87d-2dfce9badf8a","callout":[],"children":[],"id":"6a8088ca-a953-49e4-b336-9bf0d05918b4","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"36eace45-301e-4427-a87d-2dfce9badf8a","callout":[],"children":[],"id":"3a8e4192-ef24-40c0-9c57-5f795dad3897","title":"操作：将合法 CLI 所在目录加入 PATH 后检测"},{"parent":"36eace45-301e-4427-a87d-2dfce9badf8a","callout":[],"children":[],"id":"24ada0ab-005d-4f53-b2aa-2ae9c5d9b89b","title":"预期：找到当前进程实际可执行文件并报告版本"}],"collapsed":true,"id":"36eace45-301e-4427-a87d-2dfce9badf8a","title":"🔴【P0】PATH 中发现 CLI"},{"parent":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","callout":[],"children":[{"parent":"4e5a6732-7abf-4000-af7c-be360bd75087","callout":[],"children":[],"id":"8e201557-d29b-4fda-823f-49110c2eeec9","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"4e5a6732-7abf-4000-af7c-be360bd75087","callout":[],"children":[],"id":"9d30c6bc-c471-42d1-8c77-589a0f4022f9","title":"操作：升级 CLI 版本并点击 Re-check"},{"parent":"4e5a6732-7abf-4000-af7c-be360bd75087","callout":[],"children":[],"id":"01840ac0-0d4c-40d9-b342-d6478feb4150","title":"预期：版本与路径更新为当前实际值，不展示旧缓存"}],"collapsed":true,"id":"4e5a6732-7abf-4000-af7c-be360bd75087","title":"🔴【P0】升级后重新检测"},{"parent":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","callout":[],"children":[{"parent":"f99d2a8b-d90c-413c-8f0d-81c39888376f","callout":[],"children":[],"id":"db6a97a8-749f-4207-9a4e-613c1d4a76c0","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"f99d2a8b-d90c-413c-8f0d-81c39888376f","callout":[],"children":[],"id":"1d057bcf-9463-4364-93ce-6f107f4e18b1","title":"操作：替换为新适配器版本并重新检测"},{"parent":"f99d2a8b-d90c-413c-8f0d-81c39888376f","callout":[],"children":[],"id":"82b980bb-3651-45a1-9a5f-1d0a550a35fe","title":"预期：展示新版本与路径，兼容性重新计算"}],"collapsed":true,"id":"f99d2a8b-d90c-413c-8f0d-81c39888376f","title":"🔴【P0】更新适配器后重检"},{"parent":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","callout":[],"children":[{"parent":"74370b89-1e95-472f-be98-b51af0dc3b57","callout":[],"children":[],"id":"1835c66c-0b81-4e44-b0c9-69c87dfa305f","title":"前置：该 Agent 的适配器已正确安装"},{"parent":"74370b89-1e95-472f-be98-b51af0dc3b57","callout":[],"children":[],"id":"c0c5f855-a737-4be3-ba69-2c4383023f1e","title":"操作：触发检测并查看 CLI &amp; Adapter 步骤中的 Adapter 行"},{"parent":"74370b89-1e95-472f-be98-b51af0dc3b57","callout":[],"children":[],"id":"692d613b-425f-4f70-b47a-8cf5624f3a44","title":"预期：展示适配器的实际安装路径与版本，与该 Agent 对应且不与其他 Agent 串用"},{"parent":"74370b89-1e95-472f-be98-b51af0dc3b57","callout":[],"children":[],"id":"5aedf443-2b45-43ca-8f17-9685cb1c09f1","title":"备注：合并自 Tutti / Codex / Claude 三个 Agent 的「适配器已安装」用例"}],"collapsed":true,"id":"74370b89-1e95-472f-be98-b51af0dc3b57","title":"🔴【P0】适配器已安装时展示版本与路径"},{"parent":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","callout":[],"children":[{"parent":"11cb4d30-d948-4ac5-ba39-0fc4cabfecf1","callout":[],"children":[],"id":"d8d0c9d2-eddd-4765-a1f4-9021e78d6e9a","title":"前置：本地 CLI 为受支持版本"},{"parent":"11cb4d30-d948-4ac5-ba39-0fc4cabfecf1","callout":[],"children":[],"id":"6bfd4149-e9e8-4613-b5ed-28e8cb727833","title":"操作：执行环境检测"},{"parent":"11cb4d30-d948-4ac5-ba39-0fc4cabfecf1","callout":[],"children":[],"id":"96aff094-f715-4787-b0e9-fed5966bb018","title":"预期：版本识别正确，检测通过，展示的版本号与实际一致"}],"collapsed":true,"id":"11cb4d30-d948-4ac5-ba39-0fc4cabfecf1","title":"🟠【P1】受支持版本的检测通过"}],"collapsed":true,"id":"b29ccc0d-892b-41c9-84ed-2c2060a314e3","title":"正常场景（8）"},{"parent":"9732a8fe-d5f4-44e7-91e4-6fd28b44411e","callout":[],"children":[{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"16b2ff3d-df09-42de-a8a7-c2f306e6090f","callout":[],"children":[],"id":"fa7add2d-2da8-4a8b-ba08-7425a273067e","title":"前置：PATH 中不存在目标 CLI"},{"parent":"16b2ff3d-df09-42de-a8a7-c2f306e6090f","callout":[],"children":[],"id":"249e4ab1-845e-46a9-9457-7dcfd14f1a25","title":"操作：触发检测并查看 CLI &amp; Adapter 步骤与卡片底部按钮"},{"parent":"16b2ff3d-df09-42de-a8a7-c2f306e6090f","callout":[],"children":[],"id":"b2423786-ab65-4c7c-b759-38c365d5d854","title":"预期：该步标记为失败并在描述区说明 CLI 未安装；卡片整体不判定为 Available；底部提供可直接发起安装的入口，安装完成后重新检测可通过"},{"parent":"16b2ff3d-df09-42de-a8a7-c2f306e6090f","callout":[],"children":[],"id":"9ce1addd-d0d7-4ca7-8c83-f328e655a08d","title":"备注：合并自各 Agent 的「CLI 未安装」用例"}],"collapsed":true,"id":"16b2ff3d-df09-42de-a8a7-c2f306e6090f","title":"🔴【P0】CLI 未安装时的检测结论与安装引导"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"b5ccd934-0c5a-4fb3-aef9-be7aec95f035","callout":[],"children":[],"id":"45e8b80e-7989-40d4-83fe-458a442b4f1b","title":"前置：前置：本地 CLI 版本与 VM 中版本不一致；角色：Agent 所有者；入口：管理智能体检测"},{"parent":"b5ccd934-0c5a-4fb3-aef9-be7aec95f035","callout":[],"children":[],"id":"7430cf04-9087-439c-a588-6b21942f449c","title":"操作：执行环境检测"},{"parent":"b5ccd934-0c5a-4fb3-aef9-be7aec95f035","callout":[],"children":[],"id":"d63be781-4d9d-4624-834e-0141b2c3cead","title":"预期：检测能兼容版本差异并按向上兼容策略给出可用结论；不因字段不匹配直接判定失败；界面展示实际检测到的版本号"},{"parent":"b5ccd934-0c5a-4fb3-aef9-be7aec95f035","callout":[],"children":[],"id":"30409170-d82f-431c-b1e4-26657eb952f9","title":"备注：#321"}],"collapsed":true,"id":"b5ccd934-0c5a-4fb3-aef9-be7aec95f035","title":"🔴【P0】本地与 VM 版本不一致时的兼容"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"32aba534-e9e1-455e-a05f-91fc44c3efad","callout":[],"children":[],"id":"92713223-1518-4f21-b5bf-1f091d29bf21","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"32aba534-e9e1-455e-a05f-91fc44c3efad","callout":[],"children":[],"id":"fe92369c-390a-4c81-ac05-1d6944c8bbf3","title":"操作：将适配器目录设为不可读"},{"parent":"32aba534-e9e1-455e-a05f-91fc44c3efad","callout":[],"children":[],"id":"2b169085-39d4-4f01-b32e-58dce94893f2","title":"预期：检测失败并提示访问权限，不泄露敏感文件内容"}],"collapsed":true,"id":"32aba534-e9e1-455e-a05f-91fc44c3efad","title":"🔴【P0】适配器路径无权限"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"8bb1e09d-37c8-455c-88e1-1814c52c9496","callout":[],"children":[],"id":"360a8a82-ffd5-44c8-b8cc-ac68638066c2","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"8bb1e09d-37c8-455c-88e1-1814c52c9496","callout":[],"children":[],"id":"160b160f-695d-4ed5-ba86-fc87a4020d76","title":"操作：保留文件但移除执行权限后检测"},{"parent":"8bb1e09d-37c8-455c-88e1-1814c52c9496","callout":[],"children":[],"id":"ee96b189-083d-4748-baa4-a15ecdaddbba","title":"预期：识别为不可执行并提示权限问题，不显示已安装可用"}],"collapsed":true,"id":"8bb1e09d-37c8-455c-88e1-1814c52c9496","title":"🟠【P1】CLI 无执行权限"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"c5bfd68d-7ae9-4d2b-924a-a2681c3a7f9d","callout":[],"children":[],"id":"b4ce6bbf-57a2-4e8d-871a-460479f34668","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"c5bfd68d-7ae9-4d2b-924a-a2681c3a7f9d","callout":[],"children":[],"id":"c8d94351-db44-41c0-99db-3ede4ed66d7b","title":"操作：让 CLI --version 返回非零退出码"},{"parent":"c5bfd68d-7ae9-4d2b-924a-a2681c3a7f9d","callout":[],"children":[],"id":"b54fd077-ee28-44a9-a92b-a6b379954c86","title":"预期：版本检测失败并显示可操作错误，不使用无效输出"}],"collapsed":true,"id":"c5bfd68d-7ae9-4d2b-924a-a2681c3a7f9d","title":"🟠【P1】CLI 版本命令失败"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"2510860e-7e98-4018-94b1-0bd01a993fa8","callout":[],"children":[],"id":"67ff6497-5bbe-49cf-ae2b-79172326e2c8","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"2510860e-7e98-4018-94b1-0bd01a993fa8","callout":[],"children":[],"id":"3449843e-f333-42c7-ae82-bda88e2e312c","title":"操作：检测后删除或移动可执行文件再执行 Re-check"},{"parent":"2510860e-7e98-4018-94b1-0bd01a993fa8","callout":[],"children":[],"id":"098f2932-adf3-4c21-9057-75f04dc63298","title":"预期：状态更新为未安装或路径失效，不保留 Available 状态"}],"collapsed":true,"id":"2510860e-7e98-4018-94b1-0bd01a993fa8","title":"🟠【P1】CLI 路径失效"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"dafd8976-8428-4c48-b462-0cb26d91170c","callout":[],"children":[],"id":"66c47788-07a6-496f-81e8-f8ec70a32e4e","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"dafd8976-8428-4c48-b462-0cb26d91170c","callout":[],"children":[],"id":"f80c37ca-7e56-49a3-9d5d-b9e79283fb3e","title":"操作：配置 CLI 与适配器不兼容的版本组合"},{"parent":"dafd8976-8428-4c48-b462-0cb26d91170c","callout":[],"children":[],"id":"affa66ee-a9f3-47f1-a11b-c4f761d4a28f","title":"预期：明确提示版本冲突和建议版本，卡片状态不显示为 Available"}],"collapsed":true,"id":"dafd8976-8428-4c48-b462-0cb26d91170c","title":"🟠【P1】版本不兼容"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"0f51eef7-0c8b-4121-8772-fd70beae4515","callout":[],"children":[],"id":"9288bdf5-d487-4a4e-982a-10e9c0a4b529","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"0f51eef7-0c8b-4121-8772-fd70beae4515","callout":[],"children":[],"id":"5c60448d-435e-49d3-b71d-54906722bc24","title":"操作：让适配器启动后无响应"},{"parent":"0f51eef7-0c8b-4121-8772-fd70beae4515","callout":[],"children":[],"id":"b84dd73f-5b02-4de5-8f98-7f1054f51198","title":"预期：在阈值内结束并标记超时，可再次点击 Re-check"}],"collapsed":true,"id":"0f51eef7-0c8b-4121-8772-fd70beae4515","title":"🟠【P1】适配器初始化超时"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"6b42c774-f986-426f-8eba-eaebb717125d","callout":[],"children":[],"id":"5aed35f8-a6c1-4a1d-b68d-73e3a73f9717","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"6b42c774-f986-426f-8eba-eaebb717125d","callout":[],"children":[],"id":"dfdb2437-1f75-49b9-9c02-17e7885f7c7e","title":"操作：破坏适配器入口文件或依赖后检测"},{"parent":"6b42c774-f986-426f-8eba-eaebb717125d","callout":[],"children":[],"id":"f66d1f93-1976-4275-8ca9-5b8345bced9c","title":"预期：识别为不可加载，不仅依据文件存在判定通过"}],"collapsed":true,"id":"6b42c774-f986-426f-8eba-eaebb717125d","title":"🟠【P1】适配器损坏"},{"parent":"038fda96-a2e4-4594-910a-dcecd1284ec1","callout":[],"children":[{"parent":"93a2adda-5685-4d8e-8b7d-a342618f73db","callout":[],"children":[],"id":"621c490c-9bdd-49e3-9c5f-e136a5d67766","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"93a2adda-5685-4d8e-8b7d-a342618f73db","callout":[],"children":[],"id":"e668916b-c526-4e2d-9ad9-bf29ad5e1c5b","title":"操作：保留 CLI 但移除适配器后检测"},{"parent":"93a2adda-5685-4d8e-8b7d-a342618f73db","callout":[],"children":[],"id":"628dc2ff-c581-4207-8d85-b776c2573ca2","title":"预期：CLI &amp; Adapter 中的 Adapter 判定失败，提供安装或修复指引，卡片状态不为 Available"}],"collapsed":true,"id":"93a2adda-5685-4d8e-8b7d-a342618f73db","title":"🟠【P1】适配器未安装"}],"collapsed":true,"id":"038fda96-a2e4-4594-910a-dcecd1284ec1","title":"异常场景（10）"},{"parent":"9732a8fe-d5f4-44e7-91e4-6fd28b44411e","callout":[],"children":[{"parent":"a6fff37f-6683-4f25-a028-b9d569c978c4","callout":[],"children":[{"parent":"b7ac1d48-2b41-4fde-b794-a7e46ede9e24","callout":[],"children":[],"id":"ab05b335-1aea-4b67-bee6-629a7a8c1947","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"b7ac1d48-2b41-4fde-b794-a7e46ede9e24","callout":[],"children":[],"id":"911c1ce5-accc-4591-83cf-71a9c03de5c5","title":"操作：PATH 中同时存在多个不同版本 CLI"},{"parent":"b7ac1d48-2b41-4fde-b794-a7e46ede9e24","callout":[],"children":[],"id":"93f491da-f4d1-4fa2-b16f-754672a88e6e","title":"预期：按明确优先级选择实际执行版本并展示对应路径"}],"collapsed":true,"id":"b7ac1d48-2b41-4fde-b794-a7e46ede9e24","title":"🟡【P2】多个 CLI 版本"},{"parent":"a6fff37f-6683-4f25-a028-b9d569c978c4","callout":[],"children":[{"parent":"0510f385-0eb4-4a4c-8639-7223ae2a499c","callout":[],"children":[],"id":"e001b699-6621-4a30-b6ae-64ec8f8108ba","title":"前置：Agent 已安装，已进入 Agent Management 页"},{"parent":"0510f385-0eb4-4a4c-8639-7223ae2a499c","callout":[],"children":[],"id":"d55913e7-8a76-4c0f-85a9-5a5583fcffd4","title":"操作：同一 Agent 存在全局和工作区两个适配器"},{"parent":"0510f385-0eb4-4a4c-8639-7223ae2a499c","callout":[],"children":[],"id":"6b836f15-c8ae-4f8f-ac24-7a7470df15ff","title":"预期：按明确优先级选择并展示实际使用路径"}],"collapsed":true,"id":"0510f385-0eb4-4a4c-8639-7223ae2a499c","title":"🟡【P2】多适配器并存"},{"parent":"a6fff37f-6683-4f25-a028-b9d569c978c4","callout":[],"children":[{"parent":"01a8b658-dce3-4135-8296-416587a651f9","callout":[],"children":[],"id":"873e9684-306a-47a1-be29-18b5f601b09c","title":"前置：本地 CLI 恰好为最低支持版本"},{"parent":"01a8b658-dce3-4135-8296-416587a651f9","callout":[],"children":[],"id":"218f75df-0dfd-4fe8-81f6-02746b3060b0","title":"操作：执行环境检测"},{"parent":"01a8b658-dce3-4135-8296-416587a651f9","callout":[],"children":[],"id":"5cc572b2-2907-474d-9091-981081538bae","title":"预期：判定为通过而非不兼容，不出现边界值被误判"}],"collapsed":true,"id":"01a8b658-dce3-4135-8296-416587a651f9","title":"🟡【P2】最低支持版本的边界判定"},{"parent":"a6fff37f-6683-4f25-a028-b9d569c978c4","callout":[],"children":[{"parent":"79245080-36cd-489b-b4f2-aa7c9e0aaf47","callout":[],"children":[],"id":"f6b2a4a0-70cf-403c-a980-870760627280","title":"前置：CLI 可被找到但既取不到版本也取不到规范路径"},{"parent":"79245080-36cd-489b-b4f2-aa7c9e0aaf47","callout":[],"children":[],"id":"404c0738-adb5-4a1c-b310-2cf1ff7f7949","title":"操作：触发检测并查看该步骤"},{"parent":"79245080-36cd-489b-b4f2-aa7c9e0aaf47","callout":[],"children":[],"id":"24ff0bcf-5692-421e-b195-1e95617980d6","title":"预期：按规则判定该步是否通过，缺失字段展示为安全占位；不展示 undefined 或空行"},{"parent":"79245080-36cd-489b-b4f2-aa7c9e0aaf47","callout":[],"children":[],"id":"52a49672-124c-4406-95bf-a7e37c142e87","title":"备注：依据新版 UI 图新增"}],"