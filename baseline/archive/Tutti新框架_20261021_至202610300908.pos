513","callout":[],"children":[{"parent":"6a5b7816-7914-4a1a-9b87-9c918e7357eb","callout":[],"children":[],"id":"6a441a08-cdbd-499c-a563-d9d731b6731a","title":"操作：清空搜索输入"},{"parent":"6a5b7816-7914-4a1a-9b87-9c918e7357eb","callout":[],"children":[],"id":"d913e14a-ab2b-42f1-a9b4-6218624ae9cb","title":"预期：恢复项目和对话分组原始列表与排序"}],"collapsed":true,"id":"6a5b7816-7914-4a1a-9b87-9c918e7357eb","title":"🟡【P2】空搜索词"},{"parent":"641b6b0c-1ad4-465d-be8a-a76024ed1513","callout":[],"children":[{"parent":"0e1451d9-7008-497e-87e0-2e0cbc2ab12a","callout":[],"children":[],"id":"c6715472-f011-43c2-ba1b-e80b35c20dbc","title":"操作：搜索中文、空格、emoji 和转义字符"},{"parent":"0e1451d9-7008-497e-87e0-2e0cbc2ab12a","callout":[],"children":[],"id":"338f1805-ee1e-4fe1-850c-d3541074a451","title":"预期：安全匹配，不触发脚本或查询注入"}],"collapsed":true,"id":"0e1451d9-7008-497e-87e0-2e0cbc2ab12a","title":"🟡【P2】特殊字符搜索"}],"collapsed":true,"id":"641b6b0c-1ad4-465d-be8a-a76024ed1513","title":"边界场景"}],"collapsed":true,"id":"bf6b840b-ba0d-4c21-8a62-f04a514bf808","title":"显示更多与搜索兼容"},{"parent":"4eb15a80-6ede-40b2-9b4a-c427a728538b","callout":[],"children":[{"parent":"5a839bca-bf5e-4d4d-bb89-ef3c1a30c0ab","callout":[],"children":[{"parent":"d98570d9-17e2-4d7c-b6c8-0c009d1e4edd","callout":[],"children":[{"parent":"8dc2712d-dde8-4840-a84a-a8f5bfefd456","callout":[],"children":[],"id":"9ea85f7a-9fcb-4615-9c3a-ba6214d3296a","title":"操作：前置：房间内存在至少两个项目且各有会话；角色：房间成员；入口：左侧会话列表分组下拉；步骤：首次进入房间查看左侧会话列表"},{"parent":"8dc2712d-dde8-4840-a84a-a8f5bfefd456","callout":[],"children":[],"id":"d90cb294-afb5-4155-9ab6-964422a3e36a","title":"预期：分组下拉默认选中「默认」，会话按所属项目分组展示，未选择项目的会话归入「对话」分组；刷新页面后仍保持项目分组"}],"collapsed":true,"id":"8dc2712d-dde8-4840-a84a-a8f5bfefd456","title":"默认按项目分组显示"}],"collapsed":true,"id":"d98570d9-17e2-4d7c-b6c8-0c009d1e4edd","title":"正常场景"}],"collapsed":true,"id":"5a839bca-bf5e-4d4d-bb89-ef3c1a30c0ab","title":"分组方式切换"},{"parent":"4eb15a80-6ede-40b2-9b4a-c427a728538b","callout":[],"children":[{"parent":"0759b7f3-f90a-438f-8e5a-14e59cfa29cb","callout":[],"children":[{"parent":"7723d4e0-658e-45d3-b6c0-58c9b3442a29","callout":[],"children":[{"parent":"cae80bb6-05f0-4ed5-83a1-890cbe340e4d","callout":[],"children":[],"id":"f6bd6ec5-0743-4508-b757-00b796832604","title":"操作：前置：存在多条更新时间不同的会话；角色：房间成员；入口：分组下拉切换为「活跃优先级」；步骤：切换后查看列表顺序"},{"parent":"cae80bb6-05f0-4ed5-83a1-890cbe340e4d","callout":[],"children":[],"id":"425ec377-d3f2-4c48-b1a2-63307d1022c9","title":"预期：会话按最近更新时间由新到旧排列；新产生消息的会话立即移动到列表首位；刷新后顺序保持一致"}],"collapsed":true,"id":"cae80bb6-05f0-4ed5-83a1-890cbe340e4d","title":"按更新时间倒序展示"},{"parent":"7723d4e0-658e-45d3-b6c0-58c9b3442a29","callout":[],"children":[{"parent":"60fb0a57-34ce-441c-b12a-6fa1440e32b3","callout":[],"children":[],"id":"e25e2ee7-de5b-4302-8f6e-a10c34b4422c","title":"操作：前置：活跃优先级分组下存在多条会话；角色：房间成员；入口：左侧会话列表；步骤：查看任一会话条目"},{"parent":"60fb0a57-34ce-441c-b12a-6fa1440e32b3","callout":[],"children":[],"id":"9a6defe3-187b-4113-9e38-35aebe5be356","title":"预期：每条会话显示发起该会话的 Agent 图标与名称、会话标题、所属项目名称；无项目的会话不显示项目字段而非显示空白占位"}],"collapsed":true,"id":"60fb0a57-34ce-441c-b12a-6fa1440e32b3","title":"活跃分组下会话条目信息"}],"collapsed":true,"id":"7723d4e0-658e-45d3-b6c0-58c9b3442a29","title":"正常场景"}],"collapsed":true,"id":"0759b7f3-f90a-438f-8e5a-14e59cfa29cb","title":"活跃优先级分组排序"},{"parent":"4eb15a80-6ede-40b2-9b4a-c427a728538b","callout":[],"children":[{"parent":"e8f485cd-60d6-451c-aad8-a56ffb294672","callout":[],"children":[{"parent":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","callout":[],"children":[{"parent":"8624f8f8-1d76-4b4e-b219-f564c550c8d5","callout":[],"children":[],"id":"867b978a-217c-4c91-a9ae-b41c6ec18b5b","title":"操作：前置：房间内存在我的 Agent 与共享 Agent；角色：房间成员；入口：左侧会话列表 Agent 筛选器；步骤：首次点击展开筛选器"},{"parent":"8624f8f8-1d76-4b4e-b219-f564c550c8d5","callout":[],"children":[],"id":"2ef75158-382b-4895-8442-c73aa3b6f0e2","title":"预期：筛选器内所有 Agent 均为勾选状态，会话列表展示全部 Agent 的会话；筛选器按钮不显示已筛选数量角标"}],"collapsed":true,"id":"8624f8f8-1d76-4b4e-b219-f564c550c8d5","title":"默认选中全部 Agent"},{"parent":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","callout":[],"children":[{"parent":"d0006c0a-cff5-4f94-9f7a-b48aa4082839","callout":[],"children":[],"id":"95a08cc2-c6c9-407d-a5b3-a96d0d83502b","title":"操作：前置：我的 Agent 与共享 Agent 各有若干会话；角色：房间成员；入口：Agent 筛选器；步骤：点击展开列表，逐个核对每个 Agent 右侧的会话数量"},{"parent":"d0006c0a-cff5-4f94-9f7a-b48aa4082839","callout":[],"children":[],"id":"033b217a-d26c-4933-9da4-e30fa26b2d9d","title":"预期：列表分「我的 Agent」和「共享 Agent」两组；每个 Agent 右侧数量与该 Agent 在会话列表中的实际会话条数一致；新建一条会话后重新展开，对应 Agent 数量加一"}],"collapsed":true,"id":"d0006c0a-cff5-4f94-9f7a-b48aa4082839","title":"展开 Agent 列表并核对会话数量"},{"parent":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","callout":[],"children":[{"parent":"db836991-bf92-49f8-91f1-ebf8d4b61c38","callout":[],"children":[],"id":"c6f59103-9ad4-4c89-a3c8-e93f23e229bb","title":"操作：前置：筛选器内全部勾选；角色：房间成员；入口：Agent 筛选器；步骤：取消勾选其中两个 Agent"},{"parent":"db836991-bf92-49f8-91f1-ebf8d4b61c38","callout":[],"children":[],"id":"bc3479bb-28e1-4c98-99b1-efd2c140c865","title":"预期：被取消的 Agent 会话从列表中移除，其余会话保留；筛选器按钮上显示剩余已勾选 Agent 的图标，勾选数量同步更新"}],"collapsed":true,"id":"db836991-bf92-49f8-91f1-ebf8d4b61c38","title":"取消勾选部分 Agent"},{"parent":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","callout":[],"children":[{"parent":"01aa5e06-8675-4a67-a9e3-cbfb2d60312b","callout":[],"children":[],"id":"801a1f8f-4f34-4a33-abeb-e9e4a3cf236e","title":"操作：前置：筛选器展开；角色：房间成员；入口：Agent 筛选器；步骤：只勾选 Claude Code"},{"parent":"01aa5e06-8675-4a67-a9e3-cbfb2d60312b","callout":[],"children":[],"id":"da2be390-b8fa-4546-85e4-3190f7638c90","title":"预期：会话列表仅展示 Claude Code 发起的会话，条数与筛选器中该 Agent 的数量一致；其他 Agent 的会话不出现在列表中"}],"collapsed":true,"id":"01aa5e06-8675-4a67-a9e3-cbfb2d60312b","title":"仅勾选一个 Agent"},{"parent":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","callout":[],"children":[{"parent":"49454109-0a9d-401f-a5a0-4a20e298c3a4","callout":[],"children":[],"id":"61838d67-2752-40f2-84b6-507769b7f40e","title":"操作：前置：已取消部分 Agent 勾选；角色：房间成员；入口：Agent 筛选器内「重置选项」按钮；步骤：点击重置"},{"parent":"49454109-0a9d-401f-a5a0-4a20e298c3a4","callout":[],"children":[],"id":"5ca4e03a-d7c9-4934-bc71-51edcbed2c41","title":"预期：所有 Agent 恢复勾选，会话列表恢复展示全部会话；筛选器按钮上的筛选角标消失"}],"collapsed":true,"id":"49454109-0a9d-401f-a5a0-4a20e298c3a4","title":"点击重置恢复全选"},{"parent":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","callout":[],"children":[{"parent":"0da0f7ea-34a4-4e07-bfef-145b199c6e6c","callout":[],"children":[],"id":"3f8620a7-ae00-46d8-bc99-0fd67db4b0c4","title":"操作：前置：分组方式为项目分组，存在多个项目；角色：房间成员；入口：Agent 筛选器；步骤：仅勾选 Codex"},{"parent":"0da0f7ea-34a4-4e07-bfef-145b199c6e6c","callout":[],"children":[],"id":"a108e269-f190-448d-a415-8ea5a54cb4c5","title":"预期：各项目分组内只保留 Codex 的会话；不含 Codex 会话的项目分组显示为空或不展示，项目本身不消失；切回全选后各分组会话完整恢复"}],"collapsed":true,"id":"0da0f7ea-34a4-4e07-bfef-145b199c6e6c","title":"项目分组下按 Agent 筛选"},{"parent":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","callout":[],"children":[{"parent":"9dab33ed-2f69-4d1d-9644-596fcc0a410c","callout":[],"children":[],"id":"fecbf3fa-d40f-4774-96cd-628e700fd8de","title":"操作：前置：分组方式为活跃优先级；角色：房间成员；入口：Agent 筛选器；步骤：仅勾选一个 Agent"},{"parent":"9dab33ed-2f69-4d1d-9644-596fcc0a410c","callout":[],"children":[],"id":"5ef076e9-1525-4078-a248-ff52558744f9","title":"预期：列表仅保留该 Agent 的会话且仍按更新时间倒序排列；筛选条件在切换分组方式后依然生效"}],"collapsed":true,"id":"9dab33ed-2f69-4d1d-9644-596fcc0a410c","title":"活跃优先级分组下按 Agent 筛选"},{"parent":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","callout":[],"children":[{"parent":"6c7658ce-4d34-4e67-a457-42d0146c4ebe","callout":[],"children":[],"id":"04cb50f2-d70d-4bea-9429-fc5287d6837c","title":"操作：前置：已仅勾选 Claude Code；角色：房间成员；入口：左侧搜索按钮；步骤：点击搜索并输入其他 Agent 会话中存在的关键词"},{"parent":"6c7658ce-4d34-4e67-a457-42d0146c4ebe","callout":[],"children":[],"id":"cb8c2f57-d5ef-484f-a952-46db5dcdad2e","title":"预期：搜索结果只包含 Claude Code 的会话；其他 Agent 中含该关键词的会话不出现；清空搜索后列表回到仅 Claude Code 的筛选结果"}],"collapsed":true,"id":"6c7658ce-4d34-4e67-a457-42d0146c4ebe","title":"筛选 Agent 后再搜索"}],"collapsed":true,"id":"1f31eff8-fc34-4d3a-aae0-c6e2226b9414","title":"正常场景"},{"parent":"e8f485cd-60d6-451c-aad8-a56ffb294672","callout":[],"children":[{"parent":"f8fc4190-8df2-4138-b906-426360e04e6d","callout":[],"children":[{"parent":"83c93cd5-079b-41c5-800f-5f41a0c9f0d4","callout":[],"children":[],"id":"5b47a85d-82bd-497f-8052-4c4cf1df4177","title":"操作：前置：筛选器内全部勾选；角色：房间成员；入口：Agent 筛选器；步骤：逐个取消所有 Agent 的勾选"},{"parent":"83c93cd5-079b-41c5-800f-5f41a0c9f0d4","callout":[],"children":[],"id":"5a695790-1be4-4d0c-952d-f5dd174f1cf5","title":"预期：会话列表不展示任何会话并显示空态提示；不出现加载中不结束或报错；重新勾选任一 Agent 后对应会话立即恢复展示"}],"collapsed":true,"id":"83c93cd5-079b-41c5-800f-5f41a0c9f0d4","title":"全部取消勾选"}],"collapsed":true,"id":"f8fc4190-8df2-4138-b906-426360e04e6d","title":"边界场景"}],"collapsed":true,"id":"e8f485cd-60d6-451c-aad8-a56ffb294672","title":"Agent 筛选"},{"parent":"4eb15a80-6ede-40b2-9b4a-c427a728538b","callout":[],"children":[{"parent":"60e6dd95-a48c-4931-bcc5-df97015d43e3","callout":[],"children":[{"parent":"74bb0ebc-bebb-4b2a-b3c4-950ebf0466bb","callout":[],"children":[{"parent":"4f1a9e5d-c45b-4e21-91c9-826835a776c3","callout":[],"children":[],"id":"b827f761-1192-4340-8722-c43e16658dae","title":"前置：房间内多名成员都发起过会话；角色：房间成员；入口：会话列表的人员筛选器"},{"parent":"4f1a9e5d-c45b-4e21-91c9-826835a776c3","callout":[],"children":[],"id":"ba9df53d-d1d8-4b33-8030-96196e1a6c3b","title":"操作：查看筛选器的默认状态"},{"parent":"4f1a9e5d-c45b-4e21-91c9-826835a776c3","callout":[],"children":[],"id":"3753fae8-8a60-46fb-8800-9f9d66904696","title":"预期：\n1) 搜索筛选 ｜ 默认全部成员均为选中，会话列表展示全部成员的会话\n2) 视觉展示 ｜ 筛选器按钮不显示已筛选角标"},{"parent":"4f1a9e5d-c45b-4e21-91c9-826835a776c3","callout":[],"children":[],"id":"abadd0da-5887-4354-8968-0ba41027767f","title":"备注：项目下由只展示自己的会话改为展示房间内所有成员的会话；同一项目在不同成员侧合并为一个项目节点"}],"collapsed":true,"id":"4f1a9e5d-c45b-4e21-91c9-826835a776c3","title":"🔴【P0】默认展示全部成员"},{"parent":"74bb0ebc-bebb-4b2a-b3c4-950ebf0466bb","callout":[],"children":[{"parent":"a50bf18e-7398-4bd9-bf36-1e9a68ff0d6e","callout":[],"children":[],"id":"edc44df8-64de-40eb-af6a-9af90d6407b2","title":"前置：人员筛选器已展开；角色：房间成员；入口：筛选器中的成员项"},{"parent":"a50bf18e-7398-4bd9-bf36-1e9a68ff0d6e","callout":[],"children":[],"id":"21bacd20-285a-4191-b289-1142714611fe","title":"操作：只勾选成员 A"},{"parent":"a50bf18e-7398-4bd9-bf36-1e9a68ff0d6e","callout":[],"children":[],"id":"987b77ae-d60b-4540-bf6f-1cdd550982c2","title":"预期：\n1) 搜索筛选 ｜ 列表只展示成员 A 发起的会话\n2) 搜索筛选 ｜ 包括成员 A 自己发起的，以及成员 A 借用他人 Agent 发起的会话\n3) 视觉展示 ｜ 筛选器按钮显示已筛选角标"},{"parent":"a50bf18e-7398-4bd9-bf36-1e9a68ff0d6e","callout":[],"children":[],"id":"82e11b49-3236-4dbd-a809-4ee3d092ac32","title":"备注：项目下由只展示自己的会话改为展示房间内所有成员的会话；同一项目在不同成员侧合并为一个项目节点"}],"collapsed":true,"id":"a50bf18e-7398-4bd9-bf36-1e9a68ff0d6e","title":"🔴【P0】筛选单个成员"},{"parent":"74bb0ebc-bebb-4b2a-b3c4-950ebf0466bb","callout":[],"children":[{"parent":"830f1d40-a72e-4d86-b6f8-b10b862e8993","callout":[],"children":[],"id":"7f843d1a-9b37-4f31-873c-403b0c0c1b20","title":"前置：人员筛选器已展开；角色：房间成员；入口：筛选器"},{"parent":"830f1d40-a72e-4d86-b6f8-b10b862e8993","callout":[],"children":[],"id":"14cfa473-b50c-4f67-91d3-52d483baa89d","title":"操作：勾选两名成员，再点击重置"},{"parent":"830f1d40-a72e-4d86-b6f8-b10b862e8993","callout":[],"children":[],"id":"380f52d7-7349-4156-8c4b-32f0cd2ef7d7","title":"预期：\n1) 搜索筛选 ｜ 列表展示这两名成员的会话并集，数量正确\n2) 搜索筛选 ｜ 重置后恢复全选并展示全部会话，角标消失"},{"parent":"830f1d40-a72e-4d86-b6f8-b10b862e8993","callout":[],"children":[],"id":"6c8881cb-de49-4962-b10c-211e7e487737","title":"备注：项目下由只展示自己的会话改为展示房间内所有成员的会话；同一项目在不同成员侧合并为一个项目节点"}],"collapsed":true,"id":"830f1d40-a72e-4d86-b6f8-b10b862e8993","title":"🔴【P0】多选成员与重置"},{"parent":"74bb0ebc-bebb-4b2a-b3c4-950ebf0466bb","callout":[],"children":[{"parent":"9bf6f378-19e6-4b6b-9ff5-eaa94ef5e17c","callout":[],"children":[],"id":"fc9326e0-0262-491c-b8f9-21ecf4ac6739","title":"前置：房间内有多名成员与多个 Agent；角色：房间成员；入口：人员筛选与 Agent 筛选"},{"parent":"9bf6f378-19e6-4b6b-9ff5-eaa94ef5e17c","callout":[],"children":[],"id":"161e75f9-c130-4673-b5c3-9e19b633d23c","title":"操作：同时选中一名成员与一个 Agent"},{"parent":"9bf6f378-19e6-4b6b-9ff5-eaa94ef5e17c","callout":[],"children":[],"id":"c9d6c079-0c6a-4692-8ffa-068bfdd0983d","title":"预期：\n1) 搜索筛选 ｜ 结果为交集，只展示该成员用该 Agent 发起的会话\n2) 搜索筛选 ｜ 取消其中一个条件后另一个仍生效"},{"parent":"9bf6f378-19e6-4b6b-9ff5-eaa94ef5e17c","callout":[],"children":[],"id":"62786677-f023-4102-85a2-204b3af89246","title":"备注：项目下由只展示自己的会话改为展示房间内所有成员的会话；同一项目在不同成员侧合并为一个项目节点"}],"collapsed":true,"id":"9bf6f378-19e6-4b6b-9ff5-eaa94ef5e17c","title":"🟠【P1】人员筛选与 Agent 筛选组合"},{"parent":"74bb0ebc-bebb-4b2a-b3c4-950ebf0466bb","callout":[],"children":[{"parent":"490e983c-538b-4e5a-aac3-fa9351458b70","callout":[],"children":[],"id":"cac36027-0ea4-4bfc-9143-6bae76ddecf4","title":"前置：多个项目下都有多名成员的会话；角色：房间成员；入口：人员筛选器"},{"parent":"490e983c-538b-4e5a-aac3-fa9351458b70","callout":[],"children":[],"id":"1086132e-f490-4401-b36f-fcac350729e3","title":"操作：只筛选成员 A，查看项目分组"},{"parent":"490e983c-538b-4e5a-aac3-fa9351458b70","callout":[],"children":[],"id":"42d779b4-c0b2-4268-8b11-5e6c7db35f23","title":"预期：\n1) 列表展示 ｜ 各项目分组只展示成员 A 的会话\n2) 列表展示 ｜ 筛选后为空的项目分组按产品定义隐藏或显示空态，行为一致"},{"parent":"490e983c-538b-4e5a-aac3-fa9351458b70","callout":[],"children":[],"id":"5dd4b8f7-c3be-41ae-8f6f-56c67a3dc252","title":"备注：筛选后空分组是隐藏还是显示空态需产品确认；项目下由只展示自己的会话改为展示房间内所有成员的会话；同一项目在不同成员侧合并为一个项目节点"}],"collapsed":true,"id":"490e983c-538b-4e5a-aac3-fa9351458b70","title":"🟠【P1】筛选后的项目分组表现"}],"collapsed":true,"id":"74bb0ebc-bebb-4b2a-b3c4-950ebf0466bb","title":"正常场景（5）"},{"parent":"60e6dd95-a48c-4931-bcc5-df97015d43e3","callout":[],"children":[{"parent":"8d69fbad-f3cc-4906-80be-5a7bb9c93a3c","callout":[],"children":[{"parent":"180bf8be-07b6-4114-a70a-c1717b33ae03","callout":[],"children":[],"id":"19beea40-b00c-4940-bf75-c753f97a3756","title":"前置：某成员在当前房间没有发起过会话；角色：房间成员；入口：人员筛选器"},{"parent":"180bf8be-07b6-4114-a70a-c1717b33ae03","callout":[],"children":[],"id":"80e777e1-0143-41f6-8889-7e8e1c875133","title":"操作：只勾选该成员"},{"parent":"180bf8be-07b6-4114-a70a-c1717b33ae03","callout":[],"children":[],"id":"f7940739-b2e5-46b4-b575-ad0cf845bac0","title":"预期：\n1) 提示文案 ｜ 展示无匹配会话的空态提示，不清空原始数据也不报错"},{"parent":"180bf8be-07b6-4114-a70a-c1717b33ae03","callout":[],"children":[],"id":"32dd9470-b843-4a09-a9fb-81c7bc44ea65","title":"备注：项目下由只展示自己的会话改为展示房间内所有成员的会话；同一项目在不同成员侧合并为一个项目节点"}],"collapsed":true,"id":"180bf8be-07b6-4114-a70a-c1717b33ae03","title":"🟠【P1】筛选无结果"},{"parent":"8d69fbad-f3cc-4906-80be-5a7bb9c93a3c","callout":[],"children":[{"parent":"011c88a6-51a3-4af7-a833-cab76f6a4026","callout":[],"children":[],"id":"35d9405c-157a-4c7c-8e36-691095ce4303","title":"前置：某成员已退出房间但其会话仍在；角色：房间成员；入口：人员筛选器"},{"parent":"011c88a6-51a3-4af7-a833-cab76f6a4026","callout":[],"children":[],"id":"56777ff2-2607-4115-a22b-952a5c29ae04","title":"操作：展开筛选器查看成员列表"},{"parent":"011c88a6-51a3-4af7-a833-cab76f6a4026","callout":[],"children":[],"id":"8d717b2a-7fdc-4628-9f67-a766a7e0f00a","title":"预期：\n1) 列表展示 ｜ 该成员是否保留在筛选项中按产品定义一致\n2) 搜索筛选 ｜ 若保留则筛选结果准确，若移除则其会话仍能在全部视图下看到"},{"parent":"011c88a6-51a3-4af7-a833-cab76f6a4026","callout":[],"children":[],"id":"b82855b1-bdd6-4468-b234-2cea2e3f0867","title":"备注：已退出成员是否保留在筛选项中需产品确认；项目下由只展示自己的会话改为展示房间内所有成员的会话；同一项目在不同成员侧合并为一个项目节点"}],"collapsed":true,"id":"011c88a6-51a3-4af7-a833-cab76f6a4026","title":"🟠【P1】已退出成员在筛选项中"}],"collapsed":true,"id":"8d69fbad-f3cc-4906-80be-5a7bb9c93a3c","title":"异常场景（2）"},{"parent":"60e6dd95-a48c-4931-bcc5-df97015d43e3","callout":[],"children":[{"parent":"983191d7-b05a-4376-a087-c357fe1ae89e","callout":[],"children":[{"parent":"2743e59a-3291-4fc7-842d-db35a996dd02","callout":[],"children":[],"id":"3341b890-e6d9-446b-882f-0cdccfe5dc29","title":"前置：已设置人员筛选条件；角色：房间成员；入口：浏览器刷新与其他标签页"},{"parent":"2743e59a-3291-4fc7-842d-db35a996dd02","callout":[],"children":[],"id":"b6f4486f-4575-409b-896d-397530c0f5c8","title":"操作：刷新页面，再切到另一个标签页查看"},{"parent":"2743e59a-3291-4fc7-842d-db35a996dd02","callout":[],"children":[],"id":"fcee0eb2-4b14-459a-bd6b-f670e32a7029","title":"预期：\n1) 持久化 ｜ 筛选是个人设置，刷新后保持，同账号多标签页一致\n2) 权限授权 ｜ 不影响其他成员看到的会话列表"},{"parent":"2743e59a-3291-4fc7-842d-db35a996dd02","callout":[],"children":[],"id":"1328d912-4aa4-4fba-a66f-91d733f37d91","title":"备注：项目下由只展示自己的会话改为展示房间内所有成员的会话；同一项目在不同成员侧合并为一个项目节点"}],"collapsed":true,"id":"2743e59a-3291-4fc7-842d-db35a996dd02","title":"🟡【P2】筛选状态的持久化"},{"