5c5be4e2c56e","callout":[],"children":[{"parent":"8b7d0d8a-e6dc-423e-8e2c-f37bfa1c9efe","customWidth":430,"callout":[],"children":[],"id":"f094bfcd-9765-4390-8448-5c6e7b6df530","title":"操作：两个标签页打开看板并分别设置不同筛选条件"},{"parent":"8b7d0d8a-e6dc-423e-8e2c-f37bfa1c9efe","customWidth":460,"callout":[],"children":[],"id":"94cf6bf8-c402-4d3b-9e92-8045d6ccde7a","title":"预期：各标签页互不干扰，刷新后按定义的持久化规则恢复"}],"collapsed":true,"id":"8b7d0d8a-e6dc-423e-8e2c-f37bfa1c9efe","title":"【P2】多标签页同时修改筛选"}],"collapsed":true,"id":"d872f41d-65b9-40a2-9028-5c5be4e2c56e","title":"异常场景"},{"parent":"a251288b-29ec-4b55-a918-e26f83e6b0d7","callout":[],"children":[{"parent":"71bde62f-815b-4f16-baca-59aec9931f26","callout":[],"children":[{"parent":"08e989ab-9d33-41fb-897a-c13aa084a04f","customWidth":430,"callout":[],"children":[],"id":"939c5da0-c955-4a4b-8b22-70a9b9c51739","title":"操作：四个维度各只保留一个勾选项"},{"parent":"08e989ab-9d33-41fb-897a-c13aa084a04f","customWidth":460,"callout":[],"children":[],"id":"81cd5094-ad26-4227-8245-62dc076a8435","title":"预期：结果为最小交集，条数正确，空结果时有明确提示"}],"collapsed":true,"id":"08e989ab-9d33-41fb-897a-c13aa084a04f","title":"【P1】全部维度均只勾选一项"},{"parent":"71bde62f-815b-4f16-baca-59aec9931f26","callout":[],"children":[{"parent":"a33f473e-5ca4-4574-9ccb-8a17a5a16cd3","customWidth":430,"callout":[],"children":[],"id":"b6cc1e93-5ebf-4f32-8a29-dd8f936dc37c","title":"操作：四个维度全部取消勾选"},{"parent":"a33f473e-5ca4-4574-9ccb-8a17a5a16cd3","customWidth":460,"callout":[],"children":[],"id":"eb9f3ef0-3cbe-44b0-9799-c926f1681a21","title":"预期：按产品定义展示空结果或阻止操作，不出现页面异常"}],"collapsed":true,"id":"a33f473e-5ca4-4574-9ccb-8a17a5a16cd3","title":"【P2】全部维度均取消勾选"},{"parent":"71bde62f-815b-4f16-baca-59aec9931f26","callout":[],"children":[{"parent":"baac436a-4251-4bd9-acb4-0303c494d226","customWidth":430,"callout":[],"children":[],"id":"361bc4e7-6f2e-4ae9-a180-8cf5819fcc8f","title":"操作：在数秒内连续切换 10 次筛选条件"},{"parent":"baac436a-4251-4bd9-acb4-0303c494d226","customWidth":460,"callout":[],"children":[],"id":"191cf41b-5c0b-4594-8931-4