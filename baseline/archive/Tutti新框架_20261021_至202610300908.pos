d-a6c3-ecabe6f617f2","callout":[],"children":[],"id":"77ce2c5b-7cdf-4553-9266-51b2483ee331","title":"操作：取消所有成员选择"},{"parent":"90225d40-b258-4d4d-a6c3-ecabe6f617f2","callout":[],"children":[],"id":"fceaea86-34e2-433e-9e49-99a7fed6d75b","title":"预期：创建按钮不可用或提示至少保留一名订阅者；不能保存"}],"collapsed":true,"id":"90225d40-b258-4d4d-a6c3-ecabe6f617f2","title":"🔴【P0】取消全部订阅者","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"40130bad-9b54-4932-9bed-55c4b058dba3","callout":[],"children":[{"parent":"3eadbdbb-be82-4cab-b630-66d7cd24b767","callout":[],"children":[],"id":"202fd772-8290-4751-a46e-c7c963b6ef84","title":"前置：订阅者列表中存在已退出成员"},{"parent":"3eadbdbb-be82-4cab-b630-66d7cd24b767","callout":[],"children":[],"id":"c4967dd5-bf5b-4ee0-8da5-741b53087778","title":"操作：尝试继续保存自动化"},{"parent":"3eadbdbb-be82-4cab-b630-66d7cd24b767","callout":[],"children":[],"id":"9a2f3d31-a3ed-4e1c-9d63-dd97ee871459","title":"预期：提示移除已退出成员；移除后才能保存&nbsp; <br>"}],"collapsed":true,"id":"3eadbdbb-be82-4cab-b630-66d7cd24b767","title":"🟠【P1】选择已退出房间成员"},{"parent":"40130bad-9b54-4932-9bed-55c4b058dba3","callout":[],"children":[{"parent":"d954b1bb-c833-448f-8351-8112307473e2","callout":[],"children":[],"id":"20bf8b77-f4b3-4244-8067-e6fdc1df0a75","title":"前置：模拟成员列表接口异常"},{"parent":"d954b1bb-c833-448f-8351-8112307473e2","callout":[],"children":[],"id":"1b2f9896-84ad-43ba-a789-0382f2502ec1","title":"操作：打开订阅者下拉菜单"},{"parent":"d954b1bb-c833-448f-8351-8112307473e2","callout":[],"children":[],"id":"9d0c7edc-1c09-4afd-9117-77fca3e78310","title":"预期：展示加载失败状态；不能误保存为空订阅范围"}],"collapsed":true,"id":"d954b1bb-c833-448f-8351-8112307473e2","title":"🟠【P1】订阅者列表加载失败"}],"collapsed":true,"id":"40130bad-9b54-4932-9bed-55c4b058dba3","title":"异常场景"},{"parent":"822b980e-5b9f-4f3c-9515-4225256c0469","callout":[],"children":[{"parent":"de1a4c05-e36f-4da6-88cd-983fe543baa0","callout":[],"children":[{"parent":"327121f6-1a2f-4a6e-9f10-41c3daca1d0e","callout":[],"children":[],"id":"64d91a02-bd4a-4b67-b645-291d21a8d571","title":"前置：房间内存在大量成员"},{"parent":"327121f6-1a2f-4a6e-9f10-41c3daca1d0e","callout":[],"children":[],"id":"c93742b0-d605-4732-86d6-dd5584b470d3","title":"操作：打开订阅者列表并搜索成员"},{"parent":"327121f6-1a2f-4a6e-9f10-41c3daca1d0e","callout":[],"children":[],"id":"b3144ab3-2647-410d-b3ac-b3b9e9df6cc4","title":"预期：列表支持滚动或搜索；成员选择状态准确；不会重复展示或漏选"}],"collapsed":true,"id":"327121f6-1a2f-4a6e-9f10-41c3daca1d0e","title":"🟠【P1】大量房间成员"}],"collapsed":true,"id":"de1a4c05-e36f-4da6-88cd-983fe543baa0","title":"边界场景"}],"collapsed":true,"id":"822b980e-5b9f-4f3c-9515-4225256c0469","title":"会话可见性与订阅者"}],"collapsed":true,"id":"21b0e64b-f981-42f4-8170-cd72b24d01aa","title":"自动化"},{"parent":"fdfb8ac9-47cd-446a-975f-794544a4b38b","callout":[],"children":[{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"02630d17-2259-45a2-b4ed-bdf64b7b11fa","callout":[],"children":[{"parent":"695fb1f1-cf2a-43d0-8de1-74001f83d7d3","callout":[],"children":[{"parent":"216ce96c-3868-451b-ae38-c5e6dfc29f7a","callout":[],"children":[],"id":"6540b3ed-1721-4661-90f1-c84af6a814d9","title":"前置：访问者甲可访问公开房间 A、B，并至少拥有一个自有房间。"},{"parent":"216ce96c-3868-451b-ae38-c5e6dfc29f7a","callout":[],"children":[],"id":"fc469b0a-da6a-46b8-8cb0-50a9340bc0b5","title":"操作：登录后打开 `/platform`；展开左侧“公开房间”分组；逐项读取房间行名称。"},{"parent":"216ce96c-3868-451b-ae38-c5e6dfc29f7a","callout":[],"children":[],"id":"feddbef3-8d06-49d2-9127-8e2ec3e83c4c","title":"预期：侧栏存在独立的“公开房间”分组；A、B 直接显示为可点击房间行；不显示场景卡片、模板入口或复制入口。"}],"collapsed":true,"id":"216ce96c-3868-451b-ae38-c5e6dfc29f7a","title":"🔴【P0】公开房间分组直接列出可访问房间"},{"parent":"695fb1f1-cf2a-43d0-8de1-74001f83d7d3","callout":[],"children":[{"parent":"c6e38d6b-2624-41ac-9ea7-c37231b4cf61","callout":[],"children":[],"id":"ad7a3d13-ce25-48a7-b0e3-cd7712d605ab","title":"前置：访问者甲位于 `/platform`，侧栏可见公开房间 A。"},{"parent":"c6e38d6b-2624-41ac-9ea7-c37231b4cf61","callout":[],"children":[],"id":"389b9715-814d-43b2-86bd-dac537404cd6","title":"操作：点击 A 的房间行；记录最终 URL 与页面主区域。"},{"parent":"c6e38d6b-2624-41ac-9ea7-c37231b4cf61","callout":[],"children":[],"id":"db4ace18-ccf8-4c83-9d0a-314aaa22af78","title":"预期：直接进入 `/platform/room/{A.roomId}` 的标准房间界面；过程中不出现欢迎页、场景选择页或模板详情页。"}],"collapsed":true,"id":"c6e38d6b-2624-41ac-9ea7-c37231b4cf61","title":"🔴【P0】点击公开房间行直接进入标准房间页"},{"parent":"695fb1f1-cf2a-43d0-8de1-74001f83d7d3","callout":[],"children":[{"parent":"f0434fdc-fb24-431f-afe5-934fa54227c2","callout":[],"children":[],"id":"8cf5a60a-b78b-4986-9b59-942687c49e98","title":"前置：访问者甲拥有自有房间，并可访问公开房间 A。"},{"parent":"f0434fdc-fb24-431f-afe5-934fa54227c2","callout":[],"children":[],"id":"453c0feb-af68-4f1e-900c-ad9aaf706f75","title":"操作：在侧栏分别点击自有房间和 A；观察侧栏归属及房间顶部。"},{"parent":"f0434fdc-fb24-431f-afe5-934fa54227c2","callout":[],"children":[],"id":"07e60531-1b3a-4a9f-8f72-aa4b11d335e6","title":"预期：自有房间与公开房间位于不同分组；进入 A 后顶部同时展示“公开房间”身份和 A 的名称；进入自有房间时不误显示公开身份。"}],"collapsed":true,"id":"f0434fdc-fb24-431f-afe5-934fa54227c2","title":"🔴【P0】公开房间与自有房间分组及身份清晰可辨"}],"collapsed":true,"id":"695fb1f1-cf2a-43d0-8de1-74001f83d7d3","title":"正常场景"},{"parent":"02630d17-2259-45a2-b4ed-bdf64b7b11fa","callout":[],"children":[{"parent":"bc81ab2a-4c84-4397-9ec9-e8f5bf8dcf36","callout":[],"children":[{"parent":"7086f39a-87d4-48df-bdd8-441c39b794a2","callout":[],"children":[],"id":"173e6607-f730-4217-b742-b3f79a2a69c4","title":"前置：将公开房间 B 从访问者甲的可访问配置中移除，同时保留其 `roomId`。"},{"parent":"7086f39a-87d4-48df-bdd8-441c39b794a2","callout":[],"children":[],"id":"b3da98c3-830e-4d03-952a-896e31d761de","title":"操作：刷新侧栏；再直接访问 `/platform/room/{B.roomId}`；观察网络响应与页面内容。"},{"parent":"7086f39a-87d4-48df-bdd8-441c39b794a2","callout":[],"children":[],"id":"3c9a4966-9638-4026-bc4a-eece8d6a3bea","title":"预期：侧栏不再列出 B；直达请求被拒绝或进入统一无权限/不可用页面；不得返回 B 的名称、会话、文件、评论或群聊内容。"}],"collapsed":true,"id":"7086f39a-87d4-48df-bdd8-441c39b794a2","title":"🔴【P0】不可访问的公开房间不会泄漏内容"},{"parent":"bc81ab2a-4c84-4397-9ec9-e8f5bf8dcf36","callout":[],"children":[{"parent":"9bb21d4a-2755-49e4-9620-4f556a1384cf","callout":[],"children":[],"id":"f4a2d126-0a35-4cf0-b82f-f33ab20f6262","title":"前置：取得 A 的 `roomId` 与 B 的 `sessionId`。"},{"parent":"9bb21d4a-2755-49e4-9620-4f556a1384cf","callout":[],"children":[],"id":"0ddd224a-5665-4a7c-9d4e-8280c1e8101d","title":"操作：访问 `/platform/room/{A.roomId}?surface=agent&amp;session={B.sessionId}`；同时检查接口响应。"},{"parent":"9bb21d4a-2755-49e4-9620-4f556a1384cf","callout":[],"children":[],"id":"a59290bb-7bf9-4e90-88bb-9cea6dd913ed","title":"预期：不得展示 B 的会话正文、名称、文件或参与者；页面回退到 A 的有效默认会话或显示明确无权限/参数无效状态，具体交互待产品确认。"}],"collapsed":true,"id":"9bb21d4a-2755-49e4-9620-4f556a1384cf","title":"🔴【P0】跨房间 session 参数不能读取其他房间会话"},{"parent":"bc81ab2a-4c84-4397-9ec9-e8f5bf8dcf36","callout":[],"children":[{"parent":"c63ba87a-748d-457b-abe2-4e1c545628df","callout":[],"children":[],"id":"3c5a262d-646f-44b7-98b7-73215cebc28f","title":"前置：准备无映射或已下线的旧模板 ID。"},{"parent":"c63ba87a-748d-457b-abe2-4e1c545628df","callout":[],"children":[],"id":"403adb01-4c07-4d44-9c31-e4ae3bff00db","title":"操作：访问对应旧模板 URL。"},{"parent":"c63ba87a-748d-457b-abe2-4e1c545628df","callout":[],"children":[],"id":"5b8ba61e-90a1-40da-b022-8ba8b0b61149","title":"预期：进入可用的产品首页；不展示空模板页、白屏、报错堆栈或不存在房间的数据。"}],"collapsed":true,"id":"c63ba87a-748d-457b-abe2-4e1c545628df","title":"🟠【P1】无法映射的旧模板链接安全回到产品首页"}],"collapsed":true,"id":"bc81ab2a-4c84-4397-9ec9-e8f5bf8dcf36","title":"异常场景"},{"parent":"02630d17-2259-45a2-b4ed-bdf64b7b11fa","callout":[],"children":[{"parent":"19a0aee0-d18c-4593-8fd2-b6b1e064359a","callout":[],"children":[{"parent":"c20f1cbd-fddf-48fd-ae6f-7c6862738736","callout":[],"children":[],"id":"07d9453a-3378-4ceb-997d-98022bdc19f4","title":"前置：测试环境配置多条公开房间记录，数量上限待产品确认，且名称包含相近前缀。"},{"parent":"c20f1cbd-fddf-48fd-ae6f-7c6862738736","callout":[],"children":[],"id":"4a45073f-4080-4bd4-8fcf-6fd15b09ae0d","title":"操作：滚动公开房间分组；依次点击首条、中间条和末条房间行。"},{"parent":"c20f1cbd-fddf-48fd-ae6f-7c6862738736","callout":[],"children":[],"id":"43889382-2b17-4b1c-90d6-77ac1233b73a","title":"预期：列表可完整浏览；点击后进入与所选名称对应的唯一房间；选中态不串到其他房间。"}],"collapsed":true,"id":"c20f1cbd-fddf-48fd-ae6f-7c6862738736","title":"🟡【P2】大量公开房间时侧栏仍可准确选择"}],"collapsed":true,"id":"19a0aee0-d18c-4593-8fd2-b6b1e064359a","title":"边界场景"}],"id":"02630d17-2259-45a2-b4ed-bdf64b7b11fa","title":"侧栏入口与房间身份"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"10d0eb60-d9cd-4bc2-99b8-81e96039f494","callout":[],"children":[{"parent":"65989842-250b-43f0-a79c-1c2a685eb738","callout":[],"children":[{"parent":"1978e84b-c5b3-4dcc-b0eb-c1066fac613f","callout":[],"children":[],"id":"a7bb5f91-8ba7-4a6b-a7d8-de25179a49bd","title":"前置：A 配置了预设首个会话 A1，访问者甲尚未进入 A。"},{"parent":"1978e84b-c5b3-4dcc-b0eb-c1066fac613f","callout":[],"children":[],"id":"0ac224a7-4e11-41de-acdc-181012dc057c","title":"操作：从侧栏进入 A，不携带 `session` 参数。"},{"parent":"1978e84b-c5b3-4dcc-b0eb-c1066fac613f","callout":[],"children":[],"id":"bab10199-288c-463c-b965-9b5748b8b5a2","title":"预期：A1 被选中并展示完整正文；选择结果与房间配置一致。"}],"collapsed":true,"id":"1978e84b-c5b3-4dcc-b0eb-c1066fac613f","title":"🔴【P0】无 session 参数时打开预设首个会话"},{"parent":"65989842-250b-43f0-a79c-1c2a685eb738","callout":[],"children":[{"parent":"7bbc951c-4d68-473a-befd-67f7f26185df","callout":[],"children":[],"id":"23fee331-5867-4c22-ba57-20fe18e62b78","title":"前置：清除访问者甲对 A 的公告已读状态，但保留登录态。"},{"parent":"7bbc951c-4d68-473a-befd-67f7f26185df","callout":[],"children":[],"id":"e9b6eefa-600b-46f7-bd78-b080e7c5fee6","title":"操作：进入 A。"},{"parent":"7bbc951c-4d68-473a-befd-67f7f26185df","callout":[],"children":[],"id":"6e1df5a7-0273-4818-8501-8cef54279317","title":"预期：打开公告；内容包含公开示例说明、房间用途、推荐浏览顺序和内容边界/免责声明；公告不阻止关闭后浏览会话。"}],"collapsed":true,"id":"7bbc951c-4d68-473a-befd-67f7f26185df","title":"🔴【P0】首次进入打开房间公告"},{"parent":"65989842-250b-43f0-a79c-1c2a685eb738","callout":[],"children":[{"parent":"c2453f24-b88f-4981-9f29-2554931aed59","callout":[],"children":[],"id":"362c2270-bea5-459f-b87f-399106da7ca6","title":"前置：访问者甲已自动看到并关闭 A 的公告。"},{"parent":"c2453f24-b88f-4981-9f29-2554931aed59","callout":[],"children":[],"id":"3720c6cc-b851-4ce4-b828-741b26cf25d8","title":"操作：刷新页面；退出 A 后重新进入；再点击顶部公告入口。"},{"parent":"c2453f24-b88f-4981-9f29-2554931aed59","callout":[],"children":[],"id":"3648dea6-95ed-4ebb-93d8-b20bec14f6be","title":"预期：刷新和重新进入时公告均不再自动弹出；点击顶部入口可再次打开相同公告；公告内容与更新时间正常显示。"}],"collapsed":true,"id":"c2453f24-b88f-4981-9f29-2554931aed59","title":"🟠【P1】已读公告不重复自动打开且可主动重看"}],"collapsed":true,"id":"65989842-250b-43f0-a79c-1c2a685eb738","title":"正常场景"}],"id":"10d0eb60-d9cd-4bc2-99b8-81e96039f494","title":"默认会话与公告"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"1fde614c-3088-4e0e-8b0d-691287a42022","callout":[],"children":[{"parent":"80b5f3a6-ed92-44af-8d3e-a58b5ae04c79","callout":[],"children":[{"parent":"33c2472c-6a4d-46b5-88bd-911b1cb2adeb","callout":[],"children":[],"id":"9ee0769f-b0df-44b5-816f-4a5a906c980f","title":"前置：A1 包含三人以上向同一 Agent 交代任务、追问、补充和收口的完整过程。"},{"parent":"33c2472c-6a4d-46b5-88bd-911b1cb2adeb","callout":[],"children":[],"id":"29d0d226-7aa0-44c8-b566-4d2882afd4c8","title":"操作：从 A1 首条消息滚动至末条；逐条核对消息发送者、头像、时间、正文和 Agent 回复顺序。"},{"parent":"33c2472c-6a4d-46b5-88bd-911b1cb2adeb","callout":[],"children":[],"id":"37e44579-9f8b-4081-8353-4dd954bc318e","title":"预期：上下文完整、顺序稳定；用户消息展示头像和姓名；Agent 回复与对应任务关系清楚；无缺页、重复或跨会话内容。"}],"collapsed":true,"id":"33c2472c-6a4d-46b5-88bd-911b1cb2adeb","title":"🔴【P0】完整展示人与 Agent 的真实协作上下文"},{"parent":"80b5f3a6-ed92-44af-8d3e-a58b5ae04c79","callout":[],"children":[{"parent":"b5cd09ab-92e0-4381-a980-65f1b24de0ab","callout":[],"children":[],"id":"63baf622-df4b-4104-8444-d547d5d9e6d7","title":"前置：A1 的用户消息或 Agent 回复中包含有效文件引用。"},{"parent":"b5cd09ab-92e0-4381-a980-65f1b24de0ab","callout":[],"children":[],"id":"0bc75659-916f-4487-a5e4-ea32eb6e3689","title":"操作：定位引用；点击高亮文件芯片；观察右侧工作台。"},{"parent":"b5cd09ab-92e0-4381-a980-65f1b24de0ab","callout":[],"children":[],"id":"116332a1-0d03-41ee-9b7c-a948cc47f22f","title":"预期：引用样式与线上组件一致；打开与引用 ID 对应的文件；文件名、内容和所属会话一致。"}],"collapsed":true,"id":"b5cd09ab-92e0-4381-a980-65f1b24de0ab","title":"🟠【P1】引用文件按线上高亮芯片展示并可打开"},{"parent":"80b5f3a6-ed92-44af-8d3e-a58b5ae04c79","callout":[],"children":[{"parent":"8ea6e1b0-0820-4181-9208-420f9bace248","callout":[],"children":[],"id":"0165639d-c13d-4e3a-b90b-a65f5510eabd","title":"前置：A1 有支持复制的消息或回复。"},{"parent":"8ea6e1b0-0820-4181-9208-420f9bace248","callout":[],"children":[],"id":"00f4d99a-25e8-4a2e-9b7e-1b3a5687940c","title":"操作：分别执行“复制 Markdown”和“复制引用”；粘贴到本地文本区；刷新 A1。"},{"parent":"8ea6e1b0-0820-4181-9208-420f9bace248","callout":[],"children":[],"id":"cbf22f08-4780-4bda-b13e-dce59558fef7","title":"预期：剪贴板内容符合线上格式；复制动作不创建消息、不修改会话、不触发 Agent；刷新后原内容不变。"}],"collapsed":true,"id":"8ea6e1b0-0820-4181-9208-420f9bace248","title":"🟠【P1】复制 Markdown 与复制引用保持可用且不修改原内容"}],"collapsed":true,"id":"80b5f3a6-ed92-44af-8d3e-a58b5ae04c79","title":"正常场景"},{"parent":"1fde614c-3088-4e0e-8b0d-691287a42022","callout":[],"children":[{"parent":"f2246044-e64c-4154-898e-12597bdcb078","callout":[],"children":[{"parent":"2de15b3b-0f80-47c4-9452-f299c2e53239","callout":[],"children":[],"id":"2784af37-011a-467f-9d6e-01fdb1957792","title":"前置：访问者甲打开 A1，并取得一条消息/回复 ID。"},{"parent":"2de15b3b-0f80-47c4-9452-f299c2e53239","callout":[],"children":[],"id":"c2161f0f-8544-4b26-ad87-6f76d5268d92","title":"操作：确认界面无可用编辑/删除操作；再构造编辑与删除请求提交到服务端；刷新 A1。"},{"parent":"2de15b3b-0f80-47c4-9452-f299c2e53239","callout":[],"children":[],"id":"ed851109-5dda-4836-81c2-69c06410a0ab","title":"预期：前端不提供可执行入口或入口为禁用；服务端返回明确无权限结果（状态码/错误码待研发定义）；原消息仍存在且内容未变化。"}],"collapsed":true,"id":"2de15b3b-0f80-47c4-9452-f299c2e53239","title":"🔴【P0】公开访问者不能编辑或删除示例会话内容"}],"collapsed":true,"id":"f2246044-e64c-4154-898e-12597bdcb078","title":"异常场景"},{"parent":"1fde614c-3088-4e0e-8b0d-691287a42022","callout":[],"children":[{"parent":"e5a63cd1-607e-46ae-9277-fc1eef36e631","callout":[],"children":[{"parent":"c8fa8fac-8ad1-4bc4-927b-7979a96f7a01","callout":[],"children":[],"id":"cefc9e48-4374-4304-880e-9440697d521a","title":"前置：准备包含多屏历史消息及多个文件引用的长会话。"},{"parent":"c8fa8fac-8ad1-4bc4-927b-7979a96f7a01","callout":[],"children":[],"id":"15b09f44-0296-4920-ad8d-d2fe3c3ea142","title":"操作：从中部进入或滚动到历史顶部，再快速滚动到底部；重复打开文件后返回正文。"},{"parent":"c8fa8fac-8ad1-4bc4-927b-7979a96f7a01","callout":[],"children":[],"id":"653cb2e7-43c3-4e22-996d-76425dc68f92","title":"预期：消息不丢失、不重复、不乱序；返回正文时定位合理；加载其他批次时不混入其他会话消息。"}],"collapsed":true,"id":"c8fa8fac-8ad1-4bc4-927b-7979a96f7a01","title":"🟡【P2】长会话滚动与懒加载保持顺序和定位"}],"collapsed":true,"id":"e5a63cd1-607e-46ae-9277-fc1eef36e631","title":"边界场景"}],"collapsed":true,"id":"1fde614c-3088-4e0e-8b0d-691287a42022","title":"会话正文与只读浏览"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"781dc996-6eb1-4246-b014-bf695f5ae444","callout":[],"children":[{"parent":"b65ed80d-60c5-4e3d-a4b3-0891688c9c4d","callout":[],"children":[{"parent":"b1e4e76f-7cea-4612-8907-65b984f9024f","callout":[],"children":[],"id":"1a2fe2c5-fb54-4472-b951-c072136aad86","title":"前置：访问者甲进入 A 的 Agent 会话界面。"},{"parent":"b1e4e76f-7cea-4612-8907-65b984f9024f","callout":[],"children":[],"id":"bf5f560c-0060-4c39-b976-f6ec5bfccf04","title":"操作：定位页面底部 Agent 输入区；尝试点击并输入字符。"},{"parent":"b1e4e76f-7cea-4612-8907-65b984f9024f","callout":[],"children":[],"id":"9f8efff4-a723-4a7e-8264-4479a0ef02ed","title":"预期：输入区保持只读，无法录入；占位文案完整显示“公开房间暂不支持执行 Agent 任务，可通过群聊或评论交流。”；发送按钮不可触发任务。"}],"collapsed":true,"id":"b1e4e76f-7cea-4612-8907-65b984f9024f","title":"🔴【P0】Agent 输入框展示指定只读文案"}],"collapsed":true,"id":"b65ed80d-60c5-4e3d-a4b3-0891688c9c4d","title":"正常场景"},{"parent":"781dc996-6eb1-4246-b014-bf695f5ae444","callout":[],"children":[{"parent":"d062bd7f-31b2-4a0d-a02e-75af9a0838c8","callout":[],"children":[{"parent":"47371d5e-116b-47d5-b324-c26f55e22e5e","callout":[],"children":[],"id":"1d3705c6-cd4a-4f75-bc30-00b22fe80e4d","title":"前置：访问者甲位于 A；打开开发者工具。"},{"parent":"47371d5e-116b-47d5-b324-c26f55e22e5e","callout":[],"children":[],"id":"22803fa7-a7f5-41f1-8fde-01caa27f0d63","title":"操作：尝试粘贴、拖拽文本、按 Enter/Ctrl+Enter/Command+Enter；再移除只读属性或启用发送按钮并提交。"},{"parent":"47371d5e-116b-47d5-b324-c26f55e22e5e","callout":[],"children":[],"id":"2c5222fa-1cc1-45a7-8e50-b14fddfe5034","title":"预期：均不会创建任务或新增消息；不产生 Agent 运行状态、扣费或任务事件；服务端拒绝被强制发出的请求。"}],"collapsed":true,"id":"47371d5e-116b-47d5-b324-c26f55e22e5e","title":"🔴【P0】快捷键与前端状态篡改不能提交 Agent 任务"},{"parent":"d062bd7f-31b2-4a0d-a02e-75af9a0838c8","callout":[],"children":[{"parent":"2e6ddc66-3b0b-40ee-af2c-d2eaa4ae98e9","callout":[],"children":[],"id":"95fd39a0-bbcc-49cb-8efc-fedeb0de19ba","title":"前置：访问者甲进入 A，页面可能按线上组件显示“新会话”。"},{"parent":"2e6ddc66-3b0b-40ee-af2c-d2eaa4ae98e9","callout":[],"children":[],"id":"9d431df5-cb8d-44ab-9cb4-e7ddaadefd67","title":"操作：观察入口状态并尝试点击；刷新并重新进入 A 后再次检查会话列表。"},{"parent":"2e6ddc66-3b0b-40ee-af2c-d2eaa4ae98e9","callout":[],"children":[],"id":"6a05ff47-f93f-4816-ae5d-447180d28d34","title":"预期：入口按最终产品口径隐藏或禁用（口径待产品确认），但始终不能打开可提交的新会话编辑器；刷新和重新进入后会话列表不新增记录。"}],"collapsed":true,"id":"2e6ddc66-3b0b-40ee-af2c-d2eaa4ae98e9","title":"🔴【P0】新会话入口不能被公开访问者使用"}],"collapsed":true,"id":"d062bd7f-31b2-4a0d-a02e-75af9a0838c8","title":"异常场景"},{"parent":"781dc996-6eb1-4246-b014-bf695f5ae444","callout":[],"children":[{"parent":"69e36d73-7a5d-4006-90be-9903e46a7cd6","callout":[],"children":[{"parent":"8179644a-8e41-4df0-81f6-e9ee69cedf8d","callout":[],"children":[],"id":"8cdd8af9-7684-4346-a851-432ede534f14","title":"前置：标签页一先打开普通可执行房间，标签页二打开公开房间 A；两页复用同一登录态。"},{"parent":"8179644a-8e41-4df0-81f6-e9ee69cedf8d","callout":[],"children":[],"id":"b5778d01-4e7d-4a11-bb57-6dda5b592c69","title":"操作：在标签页间切换；复制普通房间的任务请求并将 `roomId` 改为 A；并在 A 页面刷新前后分别提交。"},{"parent":"8179644a-8e41-4df0-81f6-e9ee69cedf8d","callout":[],"children":[],"id":"99b5deb2-0320-4d1a-b59b-fbc9b7cd730a","title":"预期：A 的服务端权限始终以目标房间判断并拒绝请求；普通房间权限缓存不会污染 A；A 无新增任务或会话。"}],"collapsed":true,"id":"8179644a-8e41-4df0-81f6-e9ee69cedf8d","title":"🟠【P1】多标签页不能利用旧页面权限状态提交任务"},{"parent":"69e36d73-7a5d-4006-90be-9903e46a7cd6","callout":[],"children":[{"parent":"fcc4fc34-8131-43c1-b4c5-1df8bc05447c","callout":[],"children":[],"id":"55b5da5d-01fc-47ea-91ee-3de099c898a8","title":"前置：同一账号可访问公开房间 A、一个可执行自有房间和一个使用通用只读提示的普通只读房间。"},{"parent":"fcc4fc34-8131-43c1-b4c5-1df8bc05447c","callout":[],"children":[],"id":"2790d4ac-2a10-4100-b77b-e251a157e227","title":"操作：依次进入三类房间并记录 Agent 输入区状态与提示；通过浏览器返回/前进重复切换。"},{"parent":"fcc4fc34-8131-43c1-b4c5-1df8bc05447c","callout":[],"children":[],"id":"9ec26a0a-49e8-421a-aaac-dc5ca1876125","title":"预期：只有 A 显示公开房间指定提示；可执行房间仍可输入；普通只读房间保持自身提示；切换后无缓存串用。"}],"collapsed":true,"id":"fcc4fc34-8131-43c1-b4c5-1df8bc05447c","title":"🟠【P1】公开房间自定义只读提示不污染其他房间"}],"collapsed":true,"id":"69e36d73-7a5d-4006-90be-9903e46a7cd6","title":"边界场景"}],"collapsed":true,"id":"781dc996-6eb1-4246-b014-bf695f5ae444","title":"Agent 输入与新建会话限制"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"9967ca10-b31e-4a7d-9e6d-6367275c0ec0","callout":[],"children":[{"parent":"74948e02-2767-4664-af9e-60c9a76d2b27","callout":[],"children":[{"parent":"ef801ef2-0ae1-44c8-806d-dc26e2890cb7","callout":[],"children":[],"id":"851047ee-16c3-489c-84c5-26cb635c11cb","title":"前置：A1 的 Agent 回复下有交付文件卡片 F1。"},{"parent":"ef801ef2-0ae1-44c8-806d-dc26e2890cb7","callout":[],"children":[],"id":"a0530bae-ccba-4eae-a814-0c8a28da95a1","title":"操作：点击 F1 卡片；等待右侧工作台加载完成；对照文件 ID、名称和内容摘要。"},{"parent":"ef801ef2-0ae1-44c8-806d-dc26e2890cb7","callout":[],"children":[],"id":"d92e5602-6fd3-4cf0-a1b7-9f790685347d","title":"预期：右侧工作台成功打开 F1；内容非占位或空快照；不出现“无法打开此标签页”；文件与当前回复关联一致。"}],"collapsed":true,"id":"ef801ef2-0ae1-44c8-806d-dc26e2890cb7","title":"🔴【P0】Agent 回复下方文件卡片打开真实文件"},{"parent":"74948e02-2767-4664-af9e-60c9a76d2b27","callout":[],"children":[{"parent":"bb3d4fda-3ce6-4b3e-9833-dcb7bf4e3a78","callout":[],"children":[],"id":"d57971ea-0ba8-4d88-a887-a6b89089b38a","title":"前置：同一回复内同时展示 F1 的高亮文件名与文件卡片。"},{"parent":"bb3d4fda-3ce6-4b3e-9833-dcb7bf4e3a78","callout":[],"children":[],"id":"8064b016-c0b5-4367-8fcd-6bd0a4d49242","title":"操作：分别点击两处入口；记录打开的文件标识和内容。"},{"parent":"bb3d4fda-3ce6-4b3e-9833-dcb7bf4e3a78","callout":[],"children":[],"id":"96988634-a5b4-45c3-b8ab-01d190fc14b3","title":"预期：两处均打开 F1，名称、版本和内容一致；不会打开其他房间或旧快照中的同名文件。"}],"collapsed":true,"id":"bb3d4fda-3ce6-4b3e-9833-dcb7bf4e3a78","title":"🟠【P1】高亮文件名与文件卡片打开同一文件"},{"parent":"74948e02-2767-4664-af9e-60c9a76d2b27","callout":[],"children":[{"parent":"7fd8ac55-adf4-4d11-8be0-ab3dc7467aa3","callout":[],"children":[],"id":"a8cc22b7-a2a3-4e9e-85a2-917f189a9436","title":"前置：F1 按公开权限允许下载，并已知其服务端大小或校验值。"},{"parent":"7fd8ac55-adf4-4d11-8be0-ab3dc7467aa3","callout":[],"children":[],"id":"75cbebca-2d91-48a2-8bf1-2eedb25fe6fe","title":"操作：从预览或文件菜单下载 F1；打开本地文件并比对名称、格式、大小或校验值。"},{"parent":"7fd8ac55-adf4-4d11-8be0-ab3dc7467aa3","callout":[],"children":[],"id":"bebf053f-5249-4120-8549-8f6b029512d7","title":"预期：下载成功；文件可打开且内容完整；与预览及服务端记录一致。"}],"collapsed":true,"id":"7fd8ac55-adf4-4d11-8be0-ab3dc7467aa3","title":"🟠【P1】允许下载的交付文件可完整下载"}],"collapsed":true,"id":"74948e02-2767-4664-af9e-60c9a76d2b27","title":"正常场景"},{"parent":"9967ca10-b31e-4a7d-9e6d-6367275c0ec0","callout":[],"children":[{"parent":"43f04489-ef23-4eef-b6a6-993ede0105e4","callout":[],"children":[{"parent":"ba2e663a-a226-4669-bff7-22f1fece19bb","callout":[],"children":[],"id":"8de89444-41bf-4071-a544-57df6681094c","title":"前置：取得 A 的文件 F1 ID、B 的文件 F2 ID及私有房间 C 的文件 F3 ID。"},{"parent":"ba2e663a-a226-4669-bff7-22f1fece19bb","callout":[],"children":[],"id":"66f99d07-0f52-4ac2-ae8b-6342f2f7c557","title":"操作：在 A 的预览/下载请求中依次替换为 F2、F3；观察响应和页面。"},{"parent":"ba2e663a-a226-4669-bff7-22f1fece19bb","callout":[],"children":[],"id":"ed44f539-ac59-478a-8460-8a2c8aed80ec","title":"预期：服务端校验文件与目标房间及访问权限；不得返回 F2/F3 内容、下载地址或敏感元数据；A 页面不串入其他房间文件。"}],"collapsed":true,"id":"ba2e663a-a226-4669-bff7-22f1fece19bb","title":"🔴【P0】篡改文件 ID 不能读取无权限文件"},{"parent":"43f04489-ef23-4eef-b6a6-993ede0105e4","callout":[],"children":[{"parent":"c3db84fb-0ee3-4911-97e4-4241667490d5","callout":[],"children":[],"id":"5b9ad63a-c474-41ac-8e08-d0ebe0acd54a","title":"前置：模拟预览接口一次失败后恢复。"},{"parent":"c3db84fb-0ee3-4911-97e4-4241667490d5","callout":[],"children":[],"id":"96f27a19-0907-423b-b41c-bd2c8d1e6dd7","title":"操作：点击 F1；在错误状态下重试；关闭工作台再重新打开。"},{"parent":"c3db84fb-0ee3-4911-97e4-4241667490d5","callout":[],"children":[],"id":"3d7bc528-9d8d-4eb9-a18f-7b362a555c58","title":"预期：展示明确错误和可用重试方式；会话正文保持可浏览；恢复后可加载 F1，不需离开房间。"}],"collapsed":true,"id":"c3db84fb-0ee3-4911-97e4-4241667490d5","title":"🟠【P1】文件预览失败时可恢复且不影响会话"}],"collapsed":true,"id":"43f04489-ef23-4eef-b6a6-993ede0105e4","title":"异常场景"},{"parent":"9967ca10-b31e-4a7d-9e6d-6367275c0ec0","callout":[],"children":[{"parent":"dba3801f-d01d-4be2-8976-e97bb47b13cd","callout":[],"children":[{"parent":"9d89dd04-8c12-4259-bc08-9c7dcb8ec059","callout":[],"children":[],"id":"6f8cdbef-7876-4780-974e-f128e74718d3","title":"前置：A1、A2 各有一个同名但内容不同的文件。"},{"parent":"9d89dd04-8c12-4259-bc08-9c7dcb8ec059","callout":[],"children":[],"id":"ab61e8cf-41e6-4c05-bc1a-b119d6312dec","title":"操作：分别从 A1、A2 的文件卡片打开同名文件；在工作台间切换。"},{"parent":"9d89dd04-8c12-4259-bc08-9c7dcb8ec059","callout":[],"children":[],"id":"7a4daf00-16f2-49f0-9cec-233b80f3bcf9","title":"│&nbsp; └─ 预期：每次打开的内容均与来源会话的文件 ID 一致；同名不导致缓存覆盖或错误复用。"}],"collapsed":true,"id":"9d89dd04-8c12-4259-bc08-9c7dcb8ec059","title":"🟡【P2】同名文件按唯一关联打开不串版本"}],"collapsed":true,"id":"dba3801f-d01d-4be2-8976-e97bb47b13cd","title":"边界场景"}],"collapsed":true,"id":"9967ca10-b31e-4a7d-9e6d-6367275c0ec0","title":"交付文件预览与下载"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"e543a2eb-690c-4192-9e48-ed405cae86f9","callout":[],"children":[{"parent":"d549caf3-c4d7-4b7a-ace3-c0c459580204","callout":[],"children":[{"parent":"ca77ea5f-1425-428c-8a8b-957dbcdca72c","callout":[],"children":[],"id":"4d8d1448-639f-4005-b9c5-47569eedbed5","title":"前置：建立 A 的预期资产清单，覆盖各项目/会话产出。"},{"parent":"ca77ea5f-1425-428c-8a8b-957dbcdca72c","callout":[],"children":[],"id":"91193790-d926-4e93-8280-5b5b1079d228","title":"操作：进入 A 的“房间资产”；按项目或会话展开并逐项核对。"},{"parent":"ca77ea5f-1425-428c-8a8b-957dbcdca72c","callout":[],"children":[],"id":"91d53f6a-9d6f-44bf-bf86-76332589eacd","title":"预期：所有应公开资产均出现且只出现一次；名称、类型、来源项目/会话与清单一致；不出现 B 或 C 的资产。"}],"collapsed":true,"id":"ca77ea5f-1425-428c-8a8b-957dbcdca72c","title":"🔴【P0】房间资产列出公开房间全部产出"},{"parent":"d549caf3-c4d7-4b7a-ace3-c0c459580204","callout":[],"children":[{"parent":"f3218cfe-0d60-47e9-aeb1-281a73cd16f3","callout":[],"children":[],"id":"82557b92-451d-4e10-83d4-6480547f2b56","title":"前置：A 有允许预览和下载的资产 F1，且 F1 关联 A1。"},{"parent":"f3218cfe-0d60-47e9-aeb1-281a73cd16f3","callout":[],"children":[],"id":"8563f06d-32f4-4e96-9ecd-787ad8270734","title":"操作：从资产页预览 F1、下载 F1，再点击“定位到会话”。"},{"parent":"f3218cfe-0d60-47e9-aeb1-281a73cd16f3","callout":[],"children":[],"id":"38940765-095e-4cab-9eb1-445fd705d586","title":"预期：预览和下载遵循公开权限并打开同一文件；定位后进入 A1 且焦点落在 F1 的关联位置或相应上下文。"}],"collapsed":true,"id":"f3218cfe-0d60-47e9-aeb1-281a73cd16f3","title":"🟠【P1】资产可预览、下载并定位来源会话"}],"collapsed":true,"id":"d549caf3-c4d7-4b7a-ace3-c0c459580204","title":"正常场景"},{"parent":"e543a2eb-690c-4192-9e48-ed405cae86f9","callout":[],"children":[{"parent":"8599716b-a04c-44f9-9b3a-6c77d949861c","callout":[],"children":[{"parent":"12ae5522-6217-4ce7-b1da-80abe4cf619c","callout":[],"children":[],"id":"1dbe82ac-70f6-4160-9e7d-0317334c0356","title":"前置：访问者甲进入 A 的房间资产页。"},{"parent":"12ae5522-6217-4ce7-b1da-80abe4cf619c","callout":[],"children":[],"id":"d022e452-3496-4329-9bb5-f181ef9e0748","title":"操作：确认上传、重命名、替换、移动、删除等入口状态；再直接调用对应接口；刷新资产页。"},{"parent":"12ae5522-6217-4ce7-b1da-80abe4cf619c","callout":[],"children":[],"id":"95dbc6d6-5ed5-439b-8833-81c66fcbe483","title":"预期：无可执行修改入口；所有变更接口均被服务端拒绝；资产清单和文件内容无变化。"}],"collapsed":true,"id":"12ae5522-6217-4ce7-b1da-80abe4cf619c","title":"🔴【P0】公开访问者不能修改或上传房间资产"}],"collapsed":true,"id":"8599716b-a04c-44f9-9b3a-6c77d949861c","title":"异常场景"},{"parent":"e543a2eb-690c-4192-9e48-ed405cae86f9","callout":[],"children":[{"parent":"3f481dc0-be4c-425b-a9c8-698896d79093","callout":[],"children":[{"parent":"02a976c6-2e6b-4ca1-948a-c496c44885d9","callout":[],"children":[],"id":"7bb18198-82db-45ad-8999-2f35fb7e327a","title":"前置：A 至少有两个项目，包含不同资产和一个同名资产。"},{"parent":"02a976c6-2e6b-4ca1-948a-c496c44885d9","callout":[],"children":[],"id":"e4cfc9cf-6a45-4938-8881-4a69a0030eee","title":"操作：依次切换“全部”及各项目/会话筛选；记录列表与数量。"},{"parent":"02a976c6-2e6b-4ca1-948a-c496c44885d9","callout":[],"children":[],"id":"937683db-2436-4876-8033-8c9b0ed1d961","title":"预期：筛选结果只包含对应范围资产；切回“全部”后恢复完整清单；同名资产的来源标识清楚。"}],"collapsed":true,"id":"02a976c6-2e6b-4ca1-948a-c496c44885d9","title":"🟡【P2】切换项目筛选后资产归属保持准确"}],"collapsed":true,"id":"3f481dc0-be4c-425b-a9c8-698896d79093","title":"边界场景"}],"collapsed":true,"id":"e543a2eb-690c-4192-9e48-ed405cae86f9","title":"房间资产"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"515d4c4d-d3e2-482c-811a-355b8009837a","callout":[],"children":[{"parent":"c6121b51-18a8-49c5-87b4-759b19a86a28","callout":[],"children":[{"parent":"a73543f2-6f0e-4ede-b301-1aabb38a0f00","callout":[],"children":[],"id":"c7269f6e-8101-4186-9fe6-0c641d2c5d85","title":"前置：访问者甲有 A 的评论权限；记录发送前评论数与角标。"},{"parent":"a73543f2-6f0e-4ede-b301-1aabb38a0f00","callout":[],"children":[],"id":"cdfb646e-7c98-4393-9e90-255a3bd173a0","title":"操作：打开全局评论面板；输入文本 并发送。"},{"parent":"a73543f2-6f0e-4ede-b301-1aabb38a0f00","callout":[],"children":[],"id":"132287dc-4124-42ca-891f-73ed3e70199d","title":"预期：发送成功后评论立即显示且作者为甲；评论数/角标同步增加一次；不需要刷新。"}],"collapsed":true,"id":"a73543f2-6f0e-4ede-b301-1aabb38a0f00","title":"🔴【P0】公开访问者可发送全局评论且角标立即更新"},{"parent":"c6121b51-18a8-49c5-87b4-759b19a86a28","callout":[],"children":[{"parent":"9318723a-fe63-4cf2-aa8a-1bfaac362587","callout":[],"children":[],"id":"0963bc69-c8ea-40c4-9e41-9b18dce1a58a","title":"前置：A 有一条可回复评论，且存在可提及成员。"},{"parent":"9318723a-fe63-4cf2-aa8a-1bfaac362587","callout":[],"children":[],"id":"f0b88c7b-1907-4d97-9d57-9d0312cd921d","title":"操作：对该评论发起回复；输入正文并选择 `@成员`；发送。"},{"parent":"9318723a-fe63-4cf2-aa8a-1bfaac362587","callout":[],"children":[],"id":"853f7392-ae0a-41f6-b96b-016b2d474df2","title":"预期：回复出现在正确父评论下；提及对象和显示文本正确；不会误创建顶层评论或 Agent 任务。"}],"collapsed":true,"id":"9318723a-fe63-4cf2-aa8a-1bfaac362587","title":"🟠【P1】公开访问者可回复评论并提及成员"},{"parent":"c6121b51-18a8-49c5-87b4-759b19a86a28","callout":[],"children":[{"parent":"b690e55c-581c-4e1e-8656-2b4445ce9175","callout":[],"children":[],"id":"d2eb49da-2e08-498b-a105-0ad24cb5c872","title":"前置：访问者甲已发送唯一评论；标签页二已打开 A 的评论面板。"},{"parent":"b690e55c-581c-4e1e-8656-2b4445ce9175","callout":[],"children":[],"id":"43c29030-7c2c-48d2-97b2-c188fcc395a1","title":"操作：刷新标签页一；退出 A 后重新进入；在标签页二刷新评论列表。"},{"parent":"b690e55c-581c-4e1e-8656-2b4445ce9175","callout":[],"children":[],"id":"c2e12943-0843-4d69-b5cd-2a808020f2a0","title":"预期：三个操作后均能看到同一条评论且只出现一次；作者、时间、回复关系保持不变；数据不是“刷新即消失”的临时态。"}],"collapsed":true,"id":"b690e55c-581c-4e1e-8656-2b4445ce9175","title":"🔴【P0】评论刷新、重新进入和多标签页后持续存在"}],"collapsed":true,"id":"c6121b51-18a8-49c5-87b4-759b19a86a28","title":"正常场景"},{"parent":"515d4c4d-d3e2-482c-811a-355b8009837a","callout":[],"children":[{"parent":"92b240b3-4eb5-45dd-a9e5-2ecf82260dec","callout":[],"children":[{"parent":"45c54904-1f08-4d45-a48a-612de3d9fa4c","callout":[],"children":[],"id":"5547c716-94ef-4c5a-92ec-1b8fb1bb0f2e","title":"前置：访问者甲可评论 A，但不可访问私有房间 C；取得 A/C 的 `roomId` 和评论接口格式。"},{"parent":"45c54904-1f08-4d45-a48a-612de3d9fa4c","callout":[],"children":[],"id":"3113b1a8-11db-412e-8951-6fd07b93a3b2","title":"操作：向 C 构造评论请求；向 A 提交包含伪造 Agent 指令字段或任务参数的评论请求；查询任务与评论结果。"},{"parent":"45c54904-1f08-4d45-a48a-612de3d9fa4c","callout":[],"children":[],"id":"d304745e-a53d-497c-8e0f-fc0d36bd4c98","title":"预期：C 的请求被拒绝且不泄漏评论数据；A 只按普通评论处理或拒绝非法字段，绝不创建会话、任务或 Agent 输出。"}],"collapsed":true,"id":"45c54904-1f08-4d45-a48a-612de3d9fa4c","title":"🔴【P0】评论接口不能绕过房间权限或触发 Agent"},{"parent":"92b240b3-4eb5-45dd-a9e5-2ecf82260dec","callout":[],"children":[{"parent":"9ba1179c-0f75-4717-8e2a-363e9f444c90","callout":[],"children":[],"id":"253435f4-82ed-46c6-ab15-d64c6e634c32","title":"前置：模拟评论发送接口超时或失败。"},{"parent":"9ba1179c-0f75-4717-8e2a-363e9f444c90","callout":[],"children":[],"id":"0f63054f-5430-42a6-a0a1-4c4079d1e3b5","title":"操作：发送唯一评论；观察即时列表和角标；恢复网络后刷新。"},{"parent":"9ba1179c-0f75-4717-8e2a-363e9f444c90","callout":[],"children":[],"id":"aa3de600-2f32-4ca0-8d23-0c4839f910cf","title":"预期：失败状态明确；未落库评论不会被计入最终列表或角标；若提供重试，重试成功后只生成一条评论。"}],"collapsed":true,"id":"9ba1179c-0f75-4717-8e2a-363e9f444c90","title":"🟠【P1】评论发送失败不会产生幽灵评论或错误角标"}],"collapsed":true,"id":"92b240b3-4eb5-45dd-a9e5-2ecf82260dec","title":"异常场景"},{"parent":"515d4c4d-d3e2-482c-811a-355b8009837a","callout":[],"children":[{"parent":"8d72c3cd-c6d9-46ca-bf0e-d8311c0a3d98","callout":[],"children":[{"parent":"76ee5495-0d60-4fbf-a0c2-232ce53d00c0","callout":[],"children":[],"id":"f7b1c6e9-68b0-4939-b846-21cdb9a3ebe2","title":"前置：评论输入区可用并输入唯一文本。"},{"parent":"76ee5495-0d60-4fbf-a0c2-232ce53d00c0","callout":[],"children":[],"id":"8fc7e605-5d36-41d0-90c2-b64a4732cb30","title":"操作：快速双击发送或在请求未完成时连续按提交快捷键。"},{"parent":"76ee5495-0d60-4fbf-a0c2-232ce53d00c0","callout":[],"children":[],"id":"519f38d0-b030-4100-9d4e-d12afdfe6048","title":"预期：最终只落库一条评论，或重复请求被明确去重；角标只增加一次。"}],"collapsed":true,"id":"76ee5495-0d60-4fbf-a0c2-232ce53d00c0","title":"🟡【P2】重复点击发送不会生成重复评论"}],"collapsed":true,"id":"8d72c3cd-c6d9-46ca-bf0e-d8311c0a3d98","title":"边界场景"}],"collapsed":true,"id":"515d4c4d-d3e2-482c-811a-355b8009837a","title":"全局评论"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"bc1d90b2-536b-4fe5-9867-c13238b7bcd4","callout":[],"children":[{"parent":"87cc7c94-8c66-4b41-a206-d7ac2ee5a87a","callout":[],"children":[{"parent":"00ccf34b-fbdf-4e97-86c0-c2ba1e4dd3d5","callout":[],"children":[],"id":"443cb49f-29f7-4c16-aaa3-3115fc6929b4","title":"前置：访问者甲有 A 的划线评论权限，A1 有可选择文本。"},{"parent":"00ccf34b-fbdf-4e97-86c0-c2ba1e4dd3d5","callout":[],"children":[],"id":"16a0c111-6d90-4953-b384-2b6a5a57397d","title":"子主题"},{"parent":"00ccf34b-fbdf-4e97-86c0-c2ba1e4dd3d5","callout":[],"children":[],"id":"d8adbdb7-6386-44e1-8afa-0997629a7abd","title":"预期：评论发送成功；面板清楚展示被引用文本和所在会话；评论与所选文本锚点绑定。"}],"collapsed":true,"id":"00ccf34b-fbdf-4e97-86c0-c2ba1e4dd3d5","title":"🔴【P0】选中会话正文可创建对应划线评论"}],"collapsed":true,"id":"87cc7c94-8c66-4b41-a206-d7ac2ee5a87a","title":"正常场景"},{"parent":"bc1d90b2-536b-4fe5-9867-c13238b7bcd4","callout":[],"children":[{"parent":"f1947695-c531-4ba9-973c-fe98672a3330","callout":[],"children":[{"parent":"5aca2173-1c81-4135-8931-6a307e98fbea","callout":[],"children":[],"id":"d324d565-c036-419b-8bee-c1ad7eee4654","title":"前置：访问者甲可在 A 创建划线评论，但无 Agent 执行权限。"},{"parent":"5aca2173-1c81-4135-8931-6a307e98fbea","callout":[],"children":[],"id":"9d597587-a56b-4caf-bd76-47b9fdfb6842","title":"操作：在划线评论正文中输入 `@Agent` 和任务式文本；再向请求中加入伪造任务字段或任务引用后提交；查询会话、任务和 Agent 运行记录。"},{"parent":"5aca2173-1c81-4135-8931-6a307e98fbea","callout":[],"children":[],"id":"1a65c2cc-43f2-4097-a2b0-a19d5c3f1b77","title":"预期：内容仅作为划线评论保存，或非法字段被服务端拒绝；不创建新会话、Agent 任务、流式输出或后台执行记录。 &nbsp;<br>"}],"collapsed":true,"id":"5aca2173-1c81-4135-8931-6a307e98fbea","title":"🔴【P0】划线评论不能绕过限制触发 Agent"}],"collapsed":true,"id":"f1947695-c531-4ba9-973c-fe98672a3330","title":"异常场景"},{"parent":"bc1d90b2-536b-4fe5-9867-c13238b7bcd4","callout":[],"children":[{"parent":"a0115cea-ab53-4187-be07-fee0bfb37c8a","callout":[],"children":[{"parent":"253539c3-4605-4968-8379-39fd299dfb9f","callout":[],"children":[],"id":"d589b35b-2a67-41d1-aa32-f09b3ab96bb1","title":"前置：A1 有跨段落长文本。"},{"parent":"253539c3-4605-4968-8379-39fd299dfb9f","callout":[],"children":[],"id":"abc03d7f-1348-4ec5-b8ed-75b35d85c8bb","title":"操作：选择跨段落文本及超长文本并尝试创建划线评论。"},{"parent":"253539c3-4605-4968-8379-39fd299dfb9f","callout":[],"children":[],"id":"2e01afe5-f592-4345-acf3-3c32b824000d","title":"预期：按线上组件规则成功创建或给出明确限制提示；页面不崩溃，锚点不错误绑定；具体长度上限待研发确认。"}],"collapsed":true,"id":"253539c3-4605-4968-8379-39fd299dfb9f","title":"🟡【P2】跨段落或超长选区的处理符合线上规则"}],"collapsed":true,"id":"a0115cea-ab53-4187-be07-fee0bfb37c8a","title":"边界场景"}],"collapsed":true,"id":"bc1d90b2-536b-4fe5-9867-c13238b7bcd4","title":"划线评论"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"7eb94252-c35a-4761-a648-ca9b04b9785e","callout":[],"children":[{"parent":"8f127928-8856-45bd-95bf-c545adbf598d","callout":[],"children":[{"parent":"79acbb8e-f482-4b85-b37e-0858d9738ad0","callout":[],"children":[],"id":"11b4c9df-c7a3-40a1-b76c-cfbbbbf1e689","title":"前置：A 群聊有多名成员的历史消息。"},{"parent":"79acbb8e-f482-4b85-b37e-0858d9738ad0","callout":[],"children":[],"id":"7ae9c910-148c-49b5-9627-0191079288b4","title":"操作：点击顶部“群聊”；滚动查看历史消息并核对发送者、头像、时间和顺序。"},{"parent":"79acbb8e-f482-4b85-b37e-0858d9738ad0","callout":[],"children":[],"id":"460aecf9-c17d-490b-a741-440adc2acbff","title":"预期：群聊窗口正常打开；历史消息完整且顺序正确；官方账号展示与会话中的姓名和头像一致。"}],"collapsed":true,"id":"79acbb8e-f482-4b85-b37e-0858d9738ad0","title":"🔴【P0】群聊可打开并完整查看历史消息"},{"parent":"8f127928-8856-45bd-95bf-c545adbf598d","callout":[],"children":[{"parent":"7655bd45-52db-459b-97d4-e6f109051ff8","callout":[],"children":[],"id":"a58fc706-fb22-4fc6-982f-b8c45e51bd99","title":"前置：访问者甲有 A 的群聊发送权限。"},{"parent":"7655bd45-52db-459b-97d4-e6f109051ff8","callout":[],"children":[],"id":"1a7c0d80-dd48-4ef1-b76b-3298e3d1e4f9","title":"操作：输入唯一文本 `A-群聊-时间戳` 并发送。"},{"parent":"7655bd45-52db-459b-97d4-e6f109051ff8","callout":[],"children":[],"id":"c46a7e68-10ef-4fa9-9610-17005809e2b4","title":"预期：消息立即出现在当前群聊，作者为甲且仅出现一次；不创建 Agent 任务或会话。"}],"collapsed":true,"id":"7655bd45-52db-459b-97d4-e6f109051ff8","title":"🔴【P0】公开访问者可发送群聊消息且立即显示"},{"parent":"8f127928-8856-45bd-95bf-c545adbf598d","callout":[],"children":[{"parent":"70fbbb4a-c949-40c3-ab28-99237bb66c43","callout":[],"children":[],"id":"7750905e-c373-4d10-a6f1-eab170e68fe2","title":"前置：A 有可提及成员与可引用会话/文件。"},{"parent":"70fbbb4a-c949-40c3-ab28-99237bb66c43","callout":[],"children":[],"id":"b5d83132-16bf-43f8-bb88-81c2fbb1c7fc","title":"操作：在群聊中选择 `@成员`；通过引用入口选择 A 内内容；补充文本后发送。"},{"parent":"70fbbb4a-c949-40c3-ab28-99237bb66c43","callout":[],"children":[],"id":"6374901b-793c-4dd0-8ac8-a949eabc8b54","title":"预期：提及和引用展示正确并可回到 A 内对应内容；不能选择或读取 B/C 的内容。"}],"collapsed":true,"id":"70fbbb4a-c949-40c3-ab28-99237bb66c43","title":"🟠【P1】群聊支持提及成员与引用允许的内容"},{"parent":"8f127928-8856-45bd-95bf-c545adbf598d","callout":[],"children":[{"parent":"ee935ef2-352d-4c7e-ac68-0ddf37b01f04","callout":[],"children":[],"id":"ce6b9439-5618-413f-bf4f-4d33ce0dcb0c","title":"前置：访问者甲已发送唯一群聊消息；标签页二同时打开 A 群聊。"},{"parent":"ee935ef2-352d-4c7e-ac68-0ddf37b01f04","callout":[],"children":[],"id":"c17ea8cc-f82a-4a87-bbb8-3c2be633a3f2","title":"操作：刷新标签页一；退出 A 后重新进入；刷新标签页二。"},{"parent":"ee935ef2-352d-4c7e-ac68-0ddf37b01f04","callout":[],"children":[],"id":"168e8be4-76c7-47e9-a067-39c9f87b2a5c","title":"预期：各处均显示同一条消息且只出现一次；数据持久化，不因刷新消失；消息不出现在 B 的群聊。"}],"collapsed":true,"id":"ee935ef2-352d-4c7e-ac68-0ddf37b01f04","title":"🔴【P0】群聊消息刷新、重新进入和多标签页后持续存在"}],"collapsed":true,"id":"8f127928-8856-45bd-95bf-c545adbf598d","title":"正常场景"},{"parent":"7eb94252-c35a-4761-a648-ca9b04b9785e","callout":[],"children":[{"parent":"00c53118-102c-4de6-8af9-2f4430070bdf","callout":[],"children":[{"parent":"46819e78-dfdf-47e5-99f4-c40b93b5ea54","callout":[],"children":[],"id":"73784198-14db-43c0-85a5-8ea7d5198cd7","title":"前置：访问者甲可向 A 群聊发送消息但无 Agent 执行权限。"},{"parent":"46819e78-dfdf-47e5-99f4-c40b93b5ea54","callout":[],"children":[],"id":"cd0e47b6-c39b-48e5-bd22-9a56f3d7f608","title":"操作：发送包含 `@Agent`、任务式文本、伪造任务引用或任务字段的群聊请求；观察任务列表和网络请求。"},{"parent":"46819e78-dfdf-47e5-99f4-c40b93b5ea54","callout":[],"children":[],"id":"f99bc41c-1036-4193-8846-6c2bd595fa67","title":"预期：内容仅作为人与人消息展示，或非法字段被拒绝；不创建 Agent 会话、任务、流式输出或后台执行记录。"}],"collapsed":true,"id":"46819e78-dfdf-47e5-99f4-c40b93b5ea54","title":"🔴【P0】群聊消息不能触发 Agent 任务"},{"parent":"00c53118-102c-4de6-8af9-2f4430070bdf","callout":[],"children":[{"parent":"6575acb4-06cb-42fc-a716-d51cbf997ce4","callout":[],"children":[],"id":"d824bed3-0ce1-4889-9f07-6738e1a46b2a","title":"前置：模拟群聊发送请求首次超时但服务端处理结果未知。"},{"parent":"6575acb4-06cb-42fc-a716-d51cbf997ce4","callout":[],"children":[],"id":"cacbf9b2-0037-4340-b53f-62fe68d07ff5","title":"操作：点击重试或再次发送；恢复网络后刷新两个标签页。"},{"parent":"6575acb4-06cb-42fc-a716-d51cbf997ce4","callout":[],"children":[],"id":"44409bd9-16b8-4e96-99ac-167598762e21","title":"预期：最终至多保留一条相同客户端消息；若不能自动去重则给出明确状态供用户判断，具体去重规则待产品确认。"}],"collapsed":true,"id":"6575acb4-06cb-42fc-a716-d51cbf997ce4","title":"🟠【P1】发送超时重试不产生重复群聊消息"}],"collapsed":true,"id":"00c53118-102c-4de6-8af9-2f4430070bdf","title":"异常场景"},{"parent":"7eb94252-c35a-4761-a648-ca9b04b9785e","callout":[],"children":[{"parent":"3dec0420-3970-42c1-bc81-1341bc7ca2e3","callout":[],"children":[{"parent":"79eb71cf-127f-4536-8f52-3d24fb82de49","callout":[],"children":[],"id":"2d67a8ca-24a2-456d-a706-dd2c57fa1e5d","title":"前置：A 群聊历史超过一屏且另一账号乙可同时发消息。"},{"parent":"79eb71cf-127f-4536-8f52-3d24fb82de49","callout":[],"children":[],"id":"b35d474e-a930-4775-90d7-af0f29bb0007","title":"操作：甲向上加载历史；乙发送新消息；甲回到底部并刷新。"},{"parent":"79eb71cf-127f-4536-8f52-3d24fb82de49","callout":[],"children":[],"id":"04bdd747-5097-49a2-a1f2-068135496202","title":"预期：历史不重复、不乱序；乙的新消息可见且未被历史分页覆盖；刷新后顺序一致。"}],"collapsed":true,"id":"79eb71cf-127f-4536-8f52-3d24fb82de49","title":"🟡【P2】群聊长历史加载不丢失新消息"}],"collapsed":true,"id":"3dec0420-3970-42c1-bc81-1341bc7ca2e3","title":"边界场景"}],"collapsed":true,"id":"7eb94252-c35a-4761-a648-ca9b04b9785e","title":"群聊"},{"parent":"a68c1f44-bd22-4a49-8671-32357703e55a","callout":[],"children":[{"parent":"603090f2-400a-4055-8e8a-54ee4c6626c1","callout":[],"children":[{"parent":"1145aff5-6721-44a5-a785-b63b8fc81220","callout":[],"children":[{"parent":"5fec0cec-d3e7-4d9a-a1e5-683c492d45c7","callout":[],"children":[],"id":"553650b6-c0fa-45f6-9028-bf1ba9a7ed24","title":"前置：官方维护者拥有 A 的管理权限，访问者甲无管理权限。"},{"parent":"5fec0cec-d3e7-4d9a-a1e5-683c492d45c7","callout":[],"children":[],"id":"58f78518-7319-4b5a-98fd-0477f96aefc2","title":"操作：维护者打开公告或房间设置；甲在另一会话查看相同页面。"},{"parent":"5fec0cec-d3e7-4d9a-a1e5-683c492d45c7","callout":[],"children":[],"id":"04737ae3-5f37-4202-b170-ff46e300c066","title":"预期：维护者按线上权限看到可用管理操作；甲的管理操作隐藏或禁用；两者权限由账号与房间角色决定，而非“公开房间”身份一刀切。"}],"collapsed":true,"id":"5fec0cec-d3e7-4d9a-a1e5-683c492d45c7","title":"🟠【P1】官方维护者仍可按线上权限维护公开房间"}],"collapsed":true,"id":"1145aff5-6721-44a5-a785-b63b8fc81220","title":"正常场景"},{"parent":"603090f2-400a-4055-8e8a-54ee4c6626c1","callout":[],"children":[{"parent":"df077fe8-9f96-4955-9f61-4898534ded13","callout":[],"children":[{"parent":"b9600432-1157-424b-9329-c94717b12e8d","callout":[],"children":[],"id":"46501ea8-896d-44b7-be47-96e365f9a5e2","title":"前置：访问者甲进入 A，并取得公告、房间设置的读取结果与版本号。"},{"parent":"b9600432-1157-424b-9329-c94717b12e8d","callout":[],"children":[],"id":"b3401da0-81ad-4d67-88ce-e292b28fca7c","title":"操作：尝试点击“编辑公告”、重命名或设置入口；再直接发送修改公告、房间名、公开状态和配置的接口请求；刷新页面。"},{"parent":"b9600432-1157-424b-9329-c94717b12e8d","callout":[],"children":[],"id":"8d5f994b-0c40-405b-97b4-20c3d264f2a0","title":"预期：前端不可执行；服务端逐项拒绝；公告、房间名、公开状态、配置和版本号均未被修改。"}],"collapsed":true,"id":"b9600432-1157-424b-9329-c94717b12e8d","title":"🔴【P0】公开访问者不能编辑公告和房间配置"},{"parent":"df077fe8-9f96-4955-9f61-4898534ded13","callout":[],"children":[{"parent":"48d3327e-7441-4139-b5db-21e2ab70d9a2","callout":[],"children":[],"id":"722062d1-f559-43a5-8814-b17c889e701a","title":"前置：访问者甲进入 A，页面可能显示“邀请协作者”。"},{"parent":"48d3327e-7441-4139-b5db-21e2ab70d9a2","callout":[],"children":[],"id":"d3fdc29b-d681-4861-8ceb-3084d1ecc2c2","title":"操作：点击邀请入口；构造邀请甲/乙、修改成员角色及将甲设为管理员的请求；重新登录并查询成员权限。"},{"parent":"48d3327e-7441-4139-b5db-21e2ab70d9a2","callout":[],"children":[],"id":"6a638c1f-4484-47dc-b9e0-732c05fa820a","title":"预期：入口不可执行；服务端拒绝邀请和提权；成员列表、角色及甲的权限保持不变。"}],"collapsed":true,"id":"48d3327e-7441-4139-b5db-21e2ab70d9a2","title":"🔴【P0】公开访问者不能邀请协作者或提升自己权限"},{"parent":"df077fe8-9f96-4955-9f61-4898534ded13","callout":[],"children":[{"parent":"c45ef0c2-3893-4c0e-bd0e-103ccaa669b7","callout":[],"children":[],"id":"f8fef574-01c5-412d-8185-c5749c9f1055","title":"前置：访问者甲进入 A，准备一个本地测试文件 Fnew。"},{"parent":"c45ef0c2-3893-4c0e-bd0e-103ccaa669b7","callout":[],"children":[],"id":"b04685e7-3fbd-4c21-90b3-5add76386e22","title":"操作：拖拽或通过上传入口提交 Fnew；构造上传、创建分享链接及修改分享权限请求；刷新资产页。"},{"parent":"c45ef0c2-3893-4c0e-bd0e-103ccaa669b7","callout":[],"children":[],"id":"1ccfd02e-a46e-4ebd-9e5e-f5b468b45b3d","title":"预期：所有操作均被拒绝；A 不新增文件；不生成可访问的分享链接；无残留上传分片或元数据。 &nbsp;<br>"}],"collapsed":true,"id":"c45ef0c2-3893-4c0e-bd0e-103ccaa669b7","title":"🔴【P0】公开访问者不能上传附件或分享文件"}],"collapsed":true,"id":"df077fe8-9f96-4955-9f61-4898534ded13","title":"异常场景"}],"collapsed":true,"id":"603090f2-400a-4055-8e8a-54ee4c6626c1","title":"房间管理与内容修改权限"}],"collapsed":true,"id":"a68c1f44-bd22-4a49-8671-32357703e55a","title":"公开房间"},{"parent":"fdfb8ac9-47cd-446a-975f-794544a4b38b","callout":[],"children":[{"parent":"2fc89a6d-ce8f-4215-87ed-7f984ff7a354","children":[{"parent":"69e13b07bf2d7982","children":[{"parent":"9ecd3cd64d8dc810","children":[],"id":"1c28727cf707509d","title":"前置：所有者已登录并开启本地房间入口；仅 QA-Mac 在线，且未绑定本地房间；用户主目录为 /Users/qa。"},{"parent":"9ecd3cd64d8dc810","children":[],"id":"5a7c46ab445db03c","title":"操作：<br>1) 打开“添加房间”，选择“本地房间”。<br>2) 确认默认选中 QA-Mac，填写名称和头像后创建。"},{"parent":"9ecd3cd64d8dc810","children":[],"id":"f7622a7fb46670be","title":"预期：<br>1) 创建结果｜房间名称、头像和绑定电脑正确，只新增一个房间。<br>2) 默认目录｜使用 /Users/qa，不自动创建根项目。"}],"id":"9ecd3cd64d8dc810","title":"🔴【P0】使用唯一在线电脑创建房间"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"b4c3bc15-d554-4af0-a0a2-6c50e70009a7","callout":[],"children":[],"id":"9a4f73f1-f40b-4034-a303-4e20e18f1ae8","title":"前置：所有者有两台在线且未绑定房间的电脑；另有一台他人的在线电脑；从电脑一打开创建页。"},{"parent":"b4c3bc15-d554-4af0-a0a2-6c50e70009a7","callout":[],"children":[],"id":"ec6bc9c7-c676-4bd6-b943-5212bd2ef569","title":"操作：<br>1) 展开电脑列表，选择电脑二并创建。<br>2) 不选项目发送“基础读写任务”，检查两台电脑的文件。"},{"parent":"b4c3bc15-d554-4af0-a0a2-6c50e70009a7","callout":[],"children":[],"id":"682ad457-5b4b-4970-8ef2-1039ef431e02","title":"预期：<br>1) 电脑列表｜只提供本人可选电脑。<br>2) 执行位置｜房间绑定电脑二，结果仅写入电脑二的用户主目录。"},{"parent":"b4c3bc15-d554-4af0-a0a2-6c50e70009a7","callout":[],"children":[],"id":"f0a1d3ad-a409-4950-b207-6b7a75b3afd5","title":"待确认：Q05 搜索和数量口径"}],"id":"b4c3bc15-d554-4af0-a0a2-6c50e70009a7","title":"🔴【P0】有多台在线电脑时选择创建目标"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"91bfcfa7-2ab7-4775-be3f-9d1d722c1ba3","callout":[],"children":[],"id":"46a96afe-e458-410e-a49f-a37fe99cfbe1","title":"前置：所有者进入项目入口；绑定电脑在线；项目甲含标记文件、保留文件和 Git 记录。"},{"parent":"91bfcfa7-2ab7-4775-be3f-9d1d722c1ba3","callout":[],"children":[],"id":"d7f445e5-94e1-4fd3-9af7-999da8aad9ed","title":"操作：<br>1) 记录原文件内容和 Git 版本。<br>2) 通过目录选择器关联项目甲，再在该项目运行基础读写任务。"},{"parent":"91bfcfa7-2ab7-4775-be3f-9d1d722c1ba3","callout":[],"children":[],"id":"eace100f-227b-4afa-bfdd-d98c216e4b4f","title":"预期：<br>1) 关联结果｜展示项目甲的实际路径，不上传、复制或搬迁整个目录。<br>2) 文件结果｜关联时原文件和 Git 版本不变；运行结果只写入项目甲。"},{"parent":"91bfcfa7-2ab7-4775-be3f-9d1d722c1ba3","callout":[],"children":[],"id":"9286fb15-1de9-4c01-aa8a-641e9002ab64","title":"待确认：Q05 搜索和数量口径"}],"id":"91bfcfa7-2ab7-4775-be3f-9d1d722c1ba3","title":"🔴【P0】关联电脑上的已有项目"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"ebb78a66-3941-4671-aa53-fe1fd59ea4e1","callout":[],"children":[],"id":"323f6e3e-606d-4782-9d88-29efb5cd6f92","title":"前置：可编辑成员在另一台设备登录；已获得项目编辑权限和 Agent 分享；外部测试目录可读写。"},{"parent":"ebb78a66-3941-4671-aa53-fe1fd59ea4e1","callout":[],"children":[],"id":"3418d649-75d3-4986-8730-9961a10317eb","title":"操作：<br>1) 在添加项目入口输入外部测试目录的完整路径并关联。<br>2) 选择该项目运行基础读写任务。"},{"parent":"ebb78a66-3941-4671-aa53-fe1fd59ea4e1","callout":[],"children":[],"id":"6c230637-3d16-4e1b-b472-b81d0ebc8379","title":"预期：<br>1) 关联结果｜保留输入路径，不改为用户主目录内的路径。<br>2) 执行位置｜结果写入绑定电脑的外部目录，操作设备和虚拟机不产生项目副本。"},{"parent":"ebb78a66-3941-4671-aa53-fe1fd59ea4e1","callout":[],"children":[],"id":"53a45caa-2e5f-44f4-a54e-341d9a3befef","title":"待确认：Q05 搜索和数量口径；Q04 可编辑成员管理范围"}],"id":"ebb78a66-3941-4671-aa53-fe1fd59ea4e1","title":"🔴【P0】关联用户主目录以外的项目"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"41b95606-8748-4b36-af55-5387f3f08d9d","callout":[],"children":[],"id":"17d0b698-d9a5-41c1-b7e1-099699ef66b8","title":"前置：所有者进入新建项目页；用户主目录下的 Tutti 文件夹可写；项目名未被占用。"},{"parent":"41b95606-8748-4b36-af55-5387f3f08d9d","callout":[],"children":[],"id":"d34e6e08-db23-46d7-b621-10152bce674f","title":"操作：<br>1) 输入 qa-本轮标记-new 并创建一次。<br>2) 在运行 Agent 前检查新目录，再在新项目运行基础读写任务。"},{"parent":"41b95606-8748-4b36-af55-5387f3f08d9d","callout":[],"children":[],"id":"783dfd4b-dd21-45f8-8058-baa1ea7f68e1","title":"预期：<br>1) 创建结果｜仅新增一个空目录和一个项目，路径为“用户主目录/Tutti/项目名”。<br>2) 执行位置｜任务在新目录执行，页面路径与实际路径相同。"},{"parent":"41b95606-8748-4b36-af55-5387f3f08d9d","callout":[],"children":[],"id":"e831d1c7-ae83-4321-837f-ba1fb91d2fd2","title":"待确认：Q05 搜索和数量口径"}],"id":"41b95606-8748-4b36-af55-5387f3f08d9d","title":"🔴【P0】输入名称创建空项目"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"f12a394a-15eb-4019-8712-fcf64cbd8c76","callout":[],"children":[],"id":"ffdc32fc-3f67-4522-b530-7d4b99b85609","title":"前置：项目甲、乙已关联；绑定电脑上的 Agent 可用。"},{"parent":"f12a394a-15eb-4019-8712-fcf64cbd8c76","callout":[],"children":[],"id":"e24d34cb-eaad-4f28-b1f6-1a7bd85e0e16","title":"操作：<br>1) 选择项目甲新建会话，运行基础读写任务。<br>2) 在另一个首页标签页改选项目乙。<br>3) 返回原会话，要求读取结果文件并追加 SECOND 标记一次。"},{"parent":"f12a394a-15eb-4019-8712-fcf64cbd8c76","callout":[],"children":[],"id":"d7a5fafc-c891-4008-9b92-7983edd8dafc","title":"预期：<br>1) 项目归属｜原会话仍显示项目甲，两轮任务均在项目甲执行。<br>2) 文件结果｜项目甲保存两轮结果，项目乙没有本例输出。"}],"id":"f12a394a-15eb-4019-8712-fcf64cbd8c76","title":"🔴【P0】新会话始终使用创建时选中的项目"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"80462ec3-3ebd-4cba-ba87-fd0aa68aa9d3","callout":[],"children":[],"id":"29c6c79e-11b1-4504-9650-2bc8cceb4b80","title":"前置：所有者进入新会话页；未选择项目；已确认房间默认目录为绑定电脑的用户主目录。"},{"parent":"80462ec3-3ebd-4cba-ba87-fd0aa68aa9d3","callout":[],"children":[],"id":"bd29ee6a-d71b-4c3b-bdf6-069b08c878f3","title":"操作：<br>1) 新建会话并运行基础读写任务。<br>2) 在首页改选项目乙，再恢复原会话读取结果文件。"},{"parent":"80462ec3-3ebd-4cba-ba87-fd0aa68aa9d3","callout":[],"children":[],"id":"ec58ffe0-584f-463b-8b15-4cde43c9d4c5","title":"预期：<br>1) 执行位置｜两次均使用房间默认目录，不自动关联项目乙。<br>2) 项目数量｜新会话不会额外创建项目。"}],"id":"80462ec3-3ebd-4cba-ba87-fd0aa68aa9d3","title":"🔴【P0】未选项目时使用房间默认目录"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"e89a4246-16a7-4882-b91b-f168fd3f0fa1","callout":[],"children":[],"id":"da4139c1-f8b6-45c6-857f-572be464c2bc","title":"前置：所有者进入项目甲详情；项目已有会话历史，当前无运行任务；记录原文件和 Git 版本。"},{"parent":"e89a4246-16a7-4882-b91b-f168fd3f0fa1","callout":[],"children":[],"id":"43a5b225-ac11-442d-b2e8-116ac58ad773","title":"操作：<br>1) 移除项目甲。<br>2) 检查本机文件和旧会话，再重新关联该目录并读取保留文件。"},{"parent":"e89a4246-16a7-4882-b91b-f168fd3f0fa1","callout":[],"children":[],"id":"7ff8f6fb-3131-4da5-a755-a30e7199d34d","title":"预期：<br>1) 移除结果｜项目从可选列表消失，本机目录、文件和 Git 版本保留。<br>2) 旧会话｜按确认规则继续或拒绝执行，不自动改用其他目录；重新关联后可读取原文件。"},{"parent":"e89a4246-16a7-4882-b91b-f168fd3f0fa1","callout":[],"children":[],"id":"41907043-4ba1-453e-b75d-e82a63b35edd","title":"待确认：Q05 搜索和数量口径；Q06 项目移除后的旧会话"}],"id":"e89a4246-16a7-4882-b91b-f168fd3f0fa1","title":"🔴【P0】移除项目时保留本机文件"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"4bf87d78-9a94-4b7d-8647-f8eb09889840","callout":[],"children":[],"id":"af314f8f-8f6a-4a56-8074-81482a767710","title":"前置：电脑一的本机、虚拟机及电脑二存在同名 Agent；各自登录状态或版本不同。"},{"parent":"4bf87d78-9a94-4b7d-8647-f8eb09889840","callout":[],"children":[],"id":"e07842d7-5039-4424-a85b-b4d06d3f2e6b","title":"操作：<br>1) 分别记录三处状态。<br>2) 只修改电脑一本机 Agent 的登录状态，再核对三处实际状态。"},{"parent":"4bf87d78-9a94-4b7d-8647-f8eb09889840","callout":[],"children":[],"id":"e76f1303-538c-4d21-97a3-cea9a696bd67","title":"预期：<br>1) 状态变化｜只有电脑一本机的目标 Agent 改变。<br>2) 来源对应｜各处显示各自实际版本和登录状态。"}],"id":"4bf87d78-9a94-4b7d-8647-f8eb09889840","title":"🔴【P0】本机与虚拟机的 Agent 状态各自独立"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"f83c6a90-f96b-4003-976d-cdc535125d0f","callout":[],"children":[],"id":"fc3de7fc-bf58-4179-8e3b-bf7fc7f03e6d","title":"前置：绑定电脑本机、其虚拟机和另一台电脑均有同名 Agent。"},{"parent":"f83c6a90-f96b-4003-976d-cdc535125d0f","callout":[],"children":[],"id":"273f18f2-e9ae-4115-b0e4-d54aeeb6fd06","title":"操作：<br>1) 展开会话的 Agent 列表。<br>2) 选择可用 Agent 运行基础读写任务。"},{"parent":"f83c6a90-f96b-4003-976d-cdc535125d0f","callout":[],"children":[],"id":"b6589ee0-53a8-444e-ac8c-503d52f50c7e","title":"预期：<br>1) 候选范围｜可执行目标属于房间绑定电脑的本机环境。<br>2) 执行位置｜输出只写入该电脑，不切换至同名虚拟机或其他电脑。"}],"id":"f83c6a90-f96b-4003-976d-cdc535125d0f","title":"🔴【P0】会话只选择房间绑定电脑上的 Agent"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"3a767589-83aa-40d7-b7d5-fa27e6eba7d2","callout":[],"children":[],"id":"20efcd3c-4f51-439a-9e14-8e145d426206","title":"前置：所有者管理专用测试电脑；账号和网络可用；三种 Agent 按各自支持方式分别测试。"},{"parent":"3a767589-83aa-40d7-b7d5-fa27e6eba7d2","callout":[],"children":[],"id":"1fc6bace-7ae7-41e3-b336-0ae460cd0e83","title":"操作：<br>1) 先自行安装 Agent，记录安装路径和版本，再在 Tutti 中识别。<br>2) 完成登录，在项目甲运行基础读写任务，再读取上一轮结果。"},{"parent":"3a767589-83aa-40d7-b7d5-fa27e6eba7d2","callout":[],"children":[],"id":"4db9797a-bfe6-4373-8417-9787eaee5b0c","title":"预期：<br>1) 安装结果｜来源、路径、版本显示准确，登录后可选择使用。<br>2) 运行结果｜两轮均在绑定电脑执行；重新进入仍识别同一安装。原自行安装的程序未被另一份安装替代。"}],"id":"3a767589-83aa-40d7-b7d5-fa27e6eba7d2","title":"🔴【P0】识别并使用已自行安装的 Agent"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"05329f6f-07de-4b77-9751-d5d3b7a82f46","callout":[],"children":[],"id":"222a59d3-08aa-47c7-9546-be4f9b78ee74","title":"前置：所有者管理专用测试电脑；账号和网络可用；三种 Agent 按各自支持方式分别测试。"},{"parent":"05329f6f-07de-4b77-9751-d5d3b7a82f46","callout":[],"children":[],"id":"df195511-050d-4692-afad-e6b98cf0ce50","title":"操作：<br>1) 确认尚未安装目标 Agent，通过 Tutti 的本机安装入口安装。<br>2) 完成登录，在项目甲运行基础读写任务，再读取上一轮结果。"},{"parent":"05329f6f-07de-4b77-9751-d5d3b7a82f46","callout":[],"children":[],"id":"e5a9e80d-4c05-4e80-9120-7e4881d7716c","title":"预期：<br>1) 安装结果｜来源、路径、版本显示准确，登录后可选择使用。<br>2) 运行结果｜两轮均在绑定电脑执行；重新进入仍识别同一安装。实际使用本次安装的程序。"}],"id":"05329f6f-07de-4b77-9751-d5d3b7a82f46","title":"🔴【P0】通过 Tutti 安装并使用 Agent"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"8353ff78-f259-49d1-9599-73ed2d7bc5bf","callout":[],"children":[],"id":"c17cabba-b7a2-4674-ad0c-d0ea3285ea1e","title":"前置：所有者从绑定电脑打开 Agent 管理页；Codex 已安装但未登录。"},{"parent":"8353ff78-f259-49d1-9599-73ed2d7bc5bf","callout":[],"children":[],"id":"e245e42b-3046-4eaa-804f-4717b215745d","title":"操作：<br>1) 确认管理的是目标电脑，点击 Codex 登录。<br>2) 按页面提供的本机浏览器授权流程完成登录。<br>3) 在项目甲运行基础读写任务。"},{"parent":"8353ff78-f259-49d1-9599-73ed2d7bc5bf","callout":[],"children":[],"id":"ec4518fa-5788-4da5-b1ca-c358a25322d3","title":"预期：<br>1) 登录结果｜本次登录只作用于目标电脑上的该 Agent，虚拟机状态不变。<br>2) 使用结果｜任务成功写入目标电脑；原会话历史保留。"}],"id":"8353ff78-f259-49d1-9599-73ed2d7bc5bf","title":"🔴【P0】从本机登录 Codex"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"fca09563-f284-4bd3-8936-70b83d4b6272","callout":[],"children":[],"id":"f083c11f-7835-4aa7-87ef-2f8f3a6a0e53","title":"前置：所有者从绑定电脑打开 Agent 管理页；Claude Code 已安装但未登录。"},{"parent":"fca09563-f284-4bd3-8936-70b83d4b6272","callout":[],"children":[],"id":"36de419d-63f5-4987-8db5-e204be5ab605","title":"操作：<br>1) 确认管理的是目标电脑，点击 Claude Code 登录。<br>2) 按页面提供的本机浏览器授权流程完成登录。<br>3) 在项目甲运行基础读写任务。"},{"parent":"fca09563-f284-4bd3-8936-70b83d4b6272","callout":[],"children":[],"id":"84a638de-24ce-4d27-9c57-4177b67c1518","title":"预期：<br>1) 登录结果｜本次登录只作用于目标电脑上的该 Agent，虚拟机状态不变。<br>2) 使用结果｜任务成功写入目标电脑；原会话历史保留。"}],"id":"fca09563-f284-4bd3-8936-70b83d4b6272","title":"🔴【P0】从本机登录 Claude Code"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"3c676615-5574-4c49-a00c-1bff413450cb","callout":[],"children":[],"id":"809c8a33-5880-4b46-868f-c36f6e68bec4","title":"前置：所有者从另一台设备打开 Agent 管理页；Codex 已安装但未登录。"},{"parent":"3c676615-5574-4c49-a00c-1bff413450cb","callout":[],"children":[],"id":"3290c3d2-5077-4f45-a965-6386a9067e18","title":"操作：<br>1) 确认管理的是目标电脑，点击 Codex 登录。<br>2) 按页面提供的远程授权流程完成登录。<br>3) 在项目甲运行基础读写任务。"},{"parent":"3c676615-5574-4c49-a00c-1bff413450cb","callout":[],"children":[],"id":"060d9ce8-c8c5-4255-80be-e71ef16995e0","title":"预期：<br>1) 登录结果｜本次登录只作用于目标电脑上的该 Agent，虚拟机状态不变。<br>2) 使用结果｜任务成功写入目标电脑；操作设备无需另外安装 Agent。"}],"id":"3c676615-5574-4c49-a00c-1bff413450cb","title":"🔴【P0】从另一台设备登录 Codex"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"945d6de6-2892-4cb7-8731-29de490590c7","callout":[],"children":[],"id":"b9c5d482-9af1-4113-ae84-e90056bf8709","title":"前置：所有者从另一台设备打开 Agent 管理页；Claude Code 已安装但未登录。"},{"parent":"945d6de6-2892-4cb7-8731-29de490590c7","callout":[],"children":[],"id":"1ca31eac-fcd8-4d1f-88d3-5e9f2d98361d","title":"操作：<br>1) 确认管理的是目标电脑，点击 Claude Code 登录。<br>2) 按页面提供的远程授权流程完成登录。<br>3) 在项目甲运行基础读写任务。"},{"parent":"945d6de6-2892-4cb7-8731-29de490590c7","callout":[],"children":[],"id":"0b498099-5197-49e4-9492-b0efd10f7526","title":"预期：<br>1) 登录结果｜本次登录只作用于目标电脑上的该 Agent，虚拟机状态不变。<br>2) 使用结果｜任务成功写入目标电脑；操作设备无需另外安装 Agent。"}],"id":"945d6de6-2892-4cb7-8731-29de490590c7","title":"🔴【P0】从另一台设备登录 Claude Code"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"4d8b45df-6c3b-4eb6-a1e6-98718fea77da","callout":[],"children":[],"id":"c787629c-23fd-447f-a8d0-2a66ed59be8c","title":"前置：所有者从绑定电脑打开 Agent 管理页；Tutti Agent 已安装但未登录。"},{"parent":"4d8b45df-6c3b-4eb6-a1e6-98718fea77da","callout":[],"children":[],"id":"060487ba-6d58-4291-8454-a0ffa100d18e","title":"操作：<br>1) 确认管理的是目标电脑，点击 Tutti Agent 登录。<br>2) 按页面提供的Tutti 账号流程完成登录。<br>3) 在项目甲运行基础读写任务。"},{"parent":"4d8b45df-6c3b-4eb6-a1e6-98718fea77da","callout":[],"children":[],"id":"703230c4-60b5-4467-a58d-07b9810f93dd","title":"预期：<br>1) 登录结果｜本次登录只作用于目标电脑上的该 Agent，虚拟机状态不变。<br>2) 使用结果｜任务成功写入目标电脑；原会话历史保留。"}],"id":"4d8b45df-6c3b-4eb6-a1e6-98718fea77da","title":"🔴【P0】从本机登录 Tutti Agent"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"22408259-faa2-40b6-acb7-b2f502a61c71","callout":[],"children":[],"id":"7868e1fd-5621-4e99-b4ab-c14dcf6110e4","title":"前置：所有者从另一台设备打开 Agent 管理页；Tutti Agent 已安装但未登录。"},{"parent":"22408259-faa2-40b6-acb7-b2f502a61c71","callout":[],"children":[],"id":"92fa5b7f-6353-4990-a8ab-a35050f7620b","title":"操作：<br>1) 确认管理的是目标电脑，点击 Tutti Agent 登录。<br>2) 按页面提供的Tutti 账号流程完成登录。<br>3) 在项目甲运行基础读写任务。"},{"parent":"22408259-faa2-40b6-acb7-b2f502a61c71","callout":[],"children":[],"id":"c9ccadff-122c-4df1-a029-24b183cd3503","title":"预期：<br>1) 登录结果｜本次登录只作用于目标电脑上的该 Agent，虚拟机状态不变。<br>2) 使用结果｜任务成功写入目标电脑；操作设备无需另外安装 Agent。"}],"id":"22408259-faa2-40b6-acb7-b2f502a61c71","title":"🔴【P0】从另一台设备登录 Tutti Agent"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"30995f3e-1e31-47ef-92d5-bb2f5f54c7a8","callout":[],"children":[],"id":"a8d10b17-cfd7-4d20-b44d-1e6844ac0dcd","title":"前置：目标 Agent 有可更新版本；本机受管 Agent、同名虚拟机 Agent 和个人命令行各运行一个受控等待任务。"},{"parent":"30995f3e-1e31-47ef-92d5-bb2f5f54c7a8","callout":[],"children":[],"id":"7102378d-8354-4405-9bda-fd40af966f9d","title":"操作：<br>1) 更新本机受管 Agent。<br>2) 核对停止确认和更新完成的先后顺序，再放行各等待任务。<br>3) 用更新后的 Agent 运行基础读写任务。"},{"parent":"30995f3e-1e31-47ef-92d5-bb2f5f54c7a8","callout":[],"children":[],"id":"3d886205-5f9b-4301-9ffe-9ad53ddd4d48","title":"预期：<br>1) 更新顺序｜先确认目标任务已停止，再开始更新；新任务使用新版本。<br>2) 影响范围｜被停止任务不继续写入，虚拟机和个人命令行任务正常完成；项目和历史保留。"}],"id":"30995f3e-1e31-47ef-92d5-bb2f5f54c7a8","title":"🔴【P0】更新 Agent 前先停止其运行任务"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"8acd6e2a-7c98-4b77-a91d-3f0fcc9c8591","callout":[],"children":[],"id":"0b394ed5-3069-4572-ad77-6c52382c4408","title":"前置：Codex 已安装并登录；项目甲可用；参与查看的成员已有分享权限。"},{"parent":"8acd6e2a-7c98-4b77-a91d-3f0fcc9c8591","callout":[],"children":[],"id":"0c60ba51-fc76-4f39-921a-2667540672fa","title":"操作：<br>1) 在项目甲新建会话，运行基础读写任务。<br>2) 在原会话要求读取结果文件、追加 SECOND 标记一次并读回。"},{"parent":"8acd6e2a-7c98-4b77-a91d-3f0fcc9c8591","callout":[],"children":[],"id":"c0a6cac8-ab02-4834-a8dd-66140b0a499e","title":"预期：<br>1) 会话状态｜能看到输出、工具执行及完成状态，两轮归属同一会话。<br>2) 文件结果｜均在项目甲执行，结果含目录和两轮标记且不重复；其他项目和虚拟机无本例写入。"}],"id":"8acd6e2a-7c98-4b77-a91d-3f0fcc9c8591","title":"🔴【P0】Codex 连续执行两轮任务"},{"parent":"69e13b07bf2d7982","callout":[],"children":[{"parent":"ab4d8a7a-13e4-4b8b-91df-c5447f3bc076","callout":[],"children":[],"id":"312f2db2-df49-4428-8e46-a913e3fb3c44","title":"前置：Claude Code 已安装并登录；项目甲可用；参与查看的成员已有分享权限。"},{"parent":"ab4d8a7a-13e4-4b8b-91df-c5447f3bc076","callout":[],"children":[],"id":"5f752800-4ed2-4fe1-bde6-775a8c111b79","title":"操作：<br>1) 在项目甲新建会话，运行基础读写任务。<br>2) 在原会话要求读取结果文件、追加 SECOND 标记一次并读回。"},{"parent":"ab4d8a7a-13e4-4b8b-91df-c5447f3bc076","callout":[],"c