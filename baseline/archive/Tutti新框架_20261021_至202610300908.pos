250aab9d","title":"操作：悬浮话题内消息，点击「更多」。"},{"parent":"1e49bfe7-7d2a-4d2e-ba19-0327cc6c3c14","callout":[],"children":[],"id":"9d70a12a-534d-4fe4-9029-21b062fb617a","title":"预期：展示复制消息链接、多选、编辑、撤回、删除等操作项。"}],"collapsed":true,"id":"1e49bfe7-7d2a-4d2e-ba19-0327cc6c3c14","title":"更多 操作","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"8f6795d6-5fff-4b4d-9926-c7d5d799e5e6","callout":[],"children":[],"id":"3e30fe24-9cca-4802-97e0-3859ef9df141","title":"操作：多个成员对同一话题消息添加相同表情。"},{"parent":"8f6795d6-5fff-4b4d-9926-c7d5d799e5e6","callout":[],"children":[],"id":"8a839d07-e625-46f3-bea0-6e2b60dd6800","title":"预期：表情聚合展示，计数和成员列表正确。"}],"collapsed":true,"id":"8f6795d6-5fff-4b4d-9926-c7d5d799e5e6","title":"多人添加同一表情回应","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"20cf7a3d-e3c4-49d8-8bb2-c81979eacd6a","callout":[],"children":[],"id":"79de9566-2a0a-4a12-a586-5ab2c226a9c1","title":"操作：更多菜单中点击「复制消息链接」，并打开该链接。"},{"parent":"20cf7a3d-e3c4-49d8-8bb2-c81979eacd6a","callout":[],"children":[],"id":"46980709-f665-4659-8d7e-38188dc46fa7","title":"预期：可跳转到对应群聊、展开对应话题，并定位到目标消息。"}],"collapsed":true,"id":"20cf7a3d-e3c4-49d8-8bb2-c81979eacd6a","title":"复制消息链接 操作","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"7908564f-cc80-44f7-881f-dc9b34e9fc9f","callout":[],"children":[],"id":"90c144a7-0498-4fa6-a542-a1d8f0b862ad","title":"操作：更多菜单中点击「多选」，勾选多条话题消息。"},{"parent":"7908564f-cc80-44f7-881f-dc9b34e9fc9f","callout":[],"children":[],"id":"55d0a8d3-e89a-4e0d-a088-81cd9f6f475c","title":"预期：进入多选模式，选中态和选择数量正确，可退出多选。"}],"collapsed":true,"id":"7908564f-cc80-44f7-881f-dc9b34e9fc9f","title":"多选 操作","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"05a1b639-cbef-4600-b9f2-6e560c72aa14","customWidth":422,"callout":[],"children":[],"id":"fb764e21-1441-4ff2-960f-8ca62c154054","title":"操作：更多菜单中点击「多选」，勾选多条话题消息，选择复制消息链接。"},{"parent":"05a1b639-cbef-4600-b9f2-6e560c72aa14","callout":[],"children":[],"id":"9fea0530-ba7f-45a6-b312-dc76b974cc86","title":"预期：复制成功，链接打开只展示勾选的消息。"}],"collapsed":true,"id":"05a1b639-cbef-4600-b9f2-6e560c72aa14","title":"多选后复制消息链接 操作","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"8d145bf3-c505-46f1-8281-8ebadb6c324d","customWidth":422,"callout":[],"children":[],"id":"95844a75-93a2-4659-b319-be4ee576351d","title":"操作：更多菜单中点击「多选」，勾选多条话题消息，选择合并转发。"},{"parent":"8d145bf3-c505-46f1-8281-8ebadb6c324d","callout":[],"children":[],"id":"276526ea-5403-449e-a1d5-f48dbbdf74ec","title":"预期：转发成功，卡片显示在话题内，卡片打开只展示勾选的消息。"}],"collapsed":true,"id":"8d145bf3-c505-46f1-8281-8ebadb6c324d","title":"多选后合并转发 操作","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"8e4aaf12-1c52-4bda-8899-1ec59bb88632","customWidth":422,"callout":[],"children":[],"id":"8a30ca02-6805-4113-bb75-72eeff5b37c1","title":"操作：更多菜单中点击「多选」，勾选多条话题消息，选择发送给Agent。"},{"parent":"8e4aaf12-1c52-4bda-8899-1ec59bb88632","callout":[],"children":[],"id":"8f8f109f-98e8-475f-bd12-2f7399764dfd","title":"预期：Agent下拉列表展示所有可用的Agent，自己的和成员的；消息成功发送给Agent，Agent 收到的内容与原消息一致"}],"collapsed":true,"id":"8e4aaf12-1c52-4bda-8899-1ec59bb88632","title":"多选后发送给Agent 操作"},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"f1e2dfbc-4bbc-456a-9013-db8a225e2e4d","callout":[],"children":[],"id":"8932bf13-7c21-408c-a865-b162236e1136","title":"操作：更多菜单中点击「编辑」，修改本人发送的话题消息并保存。"},{"parent":"f1e2dfbc-4bbc-456a-9013-db8a225e2e4d","callout":[],"children":[],"id":"f9c15a4a-25b4-4fb2-9994-92539bf8ef50","title":"预期：消息内容更新成功，显示编辑后内容，卡片摘要同步更新。"}],"collapsed":true,"id":"f1e2dfbc-4bbc-456a-9013-db8a225e2e4d","title":"编辑 操作","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"922781b6-c579-4cbc-8622-44fb33997944","callout":[],"children":[],"id":"1864c95e-7ee4-421b-ad2e-6e4e9767a0e8","title":"操作：在允许时间内通过更多菜单点击「撤回」本人发送的话题消息。"},{"parent":"922781b6-c579-4cbc-8622-44fb33997944","callout":[],"children":[],"id":"b1d0257e-5ad6-426b-a2a0-4f5f8853c0d5","title":"预期：消息撤回成功，话题详情和其他成员端同步更新。"}],"collapsed":true,"id":"922781b6-c579-4cbc-8622-44fb33997944","title":"撤回 操作","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"8996da04-afee-43ce-8343-e8a893763e88","callout":[],"children":[{"parent":"7da3e97a-72ca-4590-84f8-2b133d8a8efe","callout":[],"children":[],"id":"5c2d3c3b-62d8-4503-8a35-0a56dc39cb65","title":"操作：更多菜单中点击「删除」并确认。"},{"parent":"7da3e97a-72ca-4590-84f8-2b133d8a8efe","callout":[],"children":[],"id":"17d56228-95ed-49f7-8cf0-0d623474d0d9","title":"预期：消息按产品规则删除，回复总数和卡片摘要同步更新。"}],"collapsed":true,"id":"7da3e97a-72ca-4590-84f8-2b133d8a8efe","title":"删除 操作","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"8996da04-afee-43ce-8343-e8a893763e88","title":"正常场景"},{"parent":"d49df91a-5d7f-43b4-9c92-57c301dfb84f","callout":[],"children":[{"parent":"f6578b3e-e3b7-4621-ae80-b896f1ab62d1","callout":[],"children":[{"parent":"906947d5-4b6d-4a34-b501-edc5b4dd5aa7","callout":[],"children":[],"id":"bf0a894d-4b89-43e5-ac1b-a9402386aee6","title":"操作：选择不可用或无权限的 Agent 发送消息。"},{"parent":"906947d5-4b6d-4a34-b501-edc5b4dd5aa7","callout":[],"children":[],"id":"f567ecc0-5064-402d-83a5-218f1f100ad6","title":"预期：发送失败并提示原因，不展示发送成功。"}],"collapsed":true,"id":"906947d5-4b6d-4a34-b501-edc5b4dd5aa7","title":"发送给Agent 不可用"},{"parent":"f6578b3e-e3b7-4621-ae80-b896f1ab62d1","callout":[],"children":[{"parent":"08b4296e-9885-4e0f-aa8a-4f9f525b834b","callout":[],"children":[],"id":"46c3b535-2605-4cad-94c1-6349cc87aedc","title":"操作：一端删除消息后，另一端继续点击操作栏按钮。"},{"parent":"08b4296e-9885-4e0f-aa8a-4f9f525b834b","callout":[],"children":[],"id":"014b4306-67b7-422a-b05b-221c0b5980cf","title":"预期：提示消息不存在或已删除，不产生异常状态。"}],"collapsed":true,"id":"08b4296e-9885-4e0f-aa8a-4f9f525b834b","title":"操作已删除消息","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f6578b3e-e3b7-4621-ae80-b896f1ab62d1","callout":[],"children":[{"parent":"754a39a5-6eaa-48c7-a766-864666b34f2a","callout":[],"children":[],"id":"98633b04-6f33-4151-ab5b-8eb65a0c8cf4","title":"操作：点击删除后在确认弹窗中取消。"},{"parent":"754a39a5-6eaa-48c7-a766-864666b34f2a","callout":[],"children":[],"id":"b2f99d76-86b0-42c4-b896-6bb6dedaba3d","title":"预期：消息不删除，话题回复数和卡片摘要不变。"}],"collapsed":true,"id":"754a39a5-6eaa-48c7-a766-864666b34f2a","title":"取消删除","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"f6578b3e-e3b7-4621-ae80-b896f1ab62d1","callout":[],"children":[{"parent":"0a1c3084-565b-4f38-9f21-defe6f520173","callout":[],"children":[],"id":"fdf28d32-4bde-4a4a-822d-33e6d291b6b0","title":"操作：普通成员尝试编辑他人话题消息。"},{"parent":"0a1c3084-565b-4f38-9f21-defe6f520173","callout":[],"children":[],"id":"2d5488da-8b7b-4f1e-9f3f-dbb005fb21c1","title":"预期：编辑入口隐藏、置灰或提示无权限，消息不被修改。"}],"collapsed":true,"id":"0a1c3084-565b-4f38-9f21-defe6f520173","title":"编辑他人消息","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"f6578b3e-e3b7-4621-ae80-b896f1ab62d1","title":"异常场景"},{"parent":"d49df91a-5d7f-43b4-9c92-57c301dfb84f","callout":[],"children":[{"parent":"29eb7f7d-2ec1-4a47-a3d3-cfd85cb133c2","callout":[],"children":[{"parent":"c2b6c69a-51ea-4e74-877d-cd629e99cee5","callout":[],"children":[],"id":"c9693b18-8a73-4dd0-b6ef-c699e5140d6f","title":"操作：编辑消息时清空内容并保存。"},{"parent":"c2b6c69a-51ea-4e74-877d-cd629e99cee5","callout":[],"children":[],"id":"945bbc3a-fc4c-411e-86c4-0141a5be1167","title":"预期：不可保存或提示内容不能为空，原消息保持不变。"}],"collapsed":