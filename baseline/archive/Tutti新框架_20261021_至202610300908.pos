6-bac3-88c92da19f2c","title":"前置：已打开微信授权流程"},{"parent":"3f33f750-e051-4a52-bcda-1b6057e970a4","callout":[],"children":[],"id":"8f569aab-954c-4037-b321-632c3c1c5502","title":"操作：在微信侧拒绝授权"},{"parent":"3f33f750-e051-4a52-bcda-1b6057e970a4","callout":[],"children":[],"id":"2ed8d4f0-2957-4d29-b7f0-afb6a7261a79","title":"预期：登录失败；WorkBuddy 保持未登录；页面提供重新授权入口，不出现假登录状态。<br>"}],"collapsed":true,"id":"3f33f750-e051-4a52-bcda-1b6057e970a4","title":"🔴【P0】微信拒绝授权<br>"},{"parent":"a14b9778-6fcf-44f4-9a84-3e39898c9399","callout":[],"children":[{"parent":"2930e96a-f211-449f-9e5b-c000ce4a6e78","callout":[],"children":[],"id":"6d1e99c2-9058-4f63-ab85-06f18d16c29a","title":"前置：登录二维码已过期"},{"parent":"2930e96a-f211-449f-9e5b-c000ce4a6e78","callout":[],"children":[],"id":"a4a280a0-e581-4094-86ad-fc5bb123da9f","title":"操作：使用微信扫描过期二维码"},{"parent":"2930e96a-f211-449f-9e5b-c000ce4a6e78","callout":[],"children":[],"id":"c6f613ac-77da-45fb-82dd-61963f3d5f06","title":"预期：提示二维码已过期并支持刷新；刷新后生成的新二维码可正常使用。<br>"}],"collapsed":true,"id":"2930e96a-f211-449f-9e5b-c000ce4a6e78","title":"🟠【P1】微信二维码过期"},{"parent":"a14b9778-6fcf-44f4-9a84-3e39898c9399","callout":[],"children":[{"parent":"98767422-dc9b-4feb-9bfc-c7a366480901","callout":[],"children":[],"id":"9bd88df8-906e-40dc-b77b-37f617f2b520","title":"前置：已打开微信登录流程"},{"parent":"98767422-dc9b-4feb-9bfc-c7a366480901","callout":[],"children":[],"id":"bd855bff-51fb-4349-8292-2ab22605d955","title":"操作：关闭登录弹窗或返回上一页"},{"parent":"98767422-dc9b-4feb-9bfc-c7a366480901","callout":[],"children":[],"id":"8a8f2a5f-c1f7-4231-8686-2c09732af9ab","title":"预期：不建立登录态；回到原页面；不出现卡死、重复弹窗或半登录状态。<br>"}],"collapsed":true,"id":"98767422-dc9b-4feb-9bfc-c7a366480901","title":"🟠【P1】微信登录取消或返回"},{"parent":"a14b9778-6fcf-44f4-9a84-3e39898c9399","callout":[],"children":[{"parent":"279298e9-1ff6-48e1-832f-affa2670b417","callout":[],"children":[],"id":"3f17b3af-f7f6-4c0e-81e7-f796f8f4d11b","title":"前置：微信授权成功但用户信息接口失败"},{"parent":"279298e9-1ff6-48e1-832f-affa2670b417","callout":[],"children":[],"id":"9df779b8-73b3-45a7-8a88-ecbc764ac153","title":"操作：完成授权"},{"parent":"279298e9-1ff6-48e1-832f-affa2670b417","callout":[],"children":[],"id":"5245a462-7d68-4617-8fd4-ae9a7e184bdc","title":"预期：提示登录信息获取失败；不创建 WorkBuddy 账号绑定；支持重新登录。"}],"collapsed":true,"id":"279298e9-1ff6-48e1-832f-affa2670b417","title":"🟠【P1】微信账号信息获取失败"}],"collapsed":true,"id":"a14b9778-6fcf-44f4-9a84-3e39898c9399","title":"异常场景"},{"parent":"74b59ba9-9e10-45ea-8f32-9d18bfcf2cf1","callout":[],"children":[{"parent":"54ac89b4-359d-4721-a3cc-04255ac2e924","callout":[],"children":[{"parent":"a2c6c3b2-1cbf-4132-81d9-4f5c55981029","callout":[],"children":[],"id":"9f5c21fc-f782-423a-8a23-e950c5898bb6","title":"前置：登录二维码有效"},{"parent":"a2c6c3b2-1cbf-4132-81d9-4f5c55981029","callout":[],"children":[],"id":"8d786d8d-0e82-4b7e-b818-565a4b8df07c","title":"操作：连续扫码、连续点击确认或快速刷新二维码"},{"parent":"a2c6c3b2-1cbf-4132-81d9-4f5c55981029","callout":[],"children":[],"id":"ee5076b8-0ff3-4b7e-aaf1-14eace8e00b0","title":"预期：只创建一个登录会话和一个账号绑定，不出现重复账号或重复配置。<br>"}],"collapsed":true,"id":"a2c6c3b2-1cbf-4132-81d9-4f5c55981029","title":"🟡【P2】重复扫码或重复确认"},{"parent":"54ac89b4-359d-4721-a3cc-04255ac2e924","callout":[],"children":[{"parent":"b4ac5033-36a8-4ff0-9e30-ee6cbed78f39","callout":[],"children":[],"id":"8fc99045-f91d-4a43-ad2e-86cef58484d9","title":"前置：设备上存在多个微信账号"},{"parent":"b4ac5033-36a8-4ff0-9e30-ee6cbed78f39","callout":[],"children":[],"id":"6f869f6a-97e1-43eb-8501-6bd0b1682270","title":"操作：先用账号 A 登录，再退出并用账号 B 登录"},{"parent":"b4ac5033-36a8-4ff0-9e30-ee6cbed78f39","callout":[],"children":[],"id":"eb16f2a3-2e36-4626-b772-1b0f6a95dd01","title":"预期：WorkBuddy 绑定关系切换正确；账号 A 与账号 B 的配置、额度和历史不混淆。"}],"collapsed":true,"id":"b4ac5033-36a8-4ff0-9e30-ee6cbed78f39","title":"🟡【P2】多微信账号切换"},{"parent":"54ac89b4-359d-4721-a3cc-04255ac2e924","callout":[],"children":[{"parent":"6c8c3a1b-4958-496f-b9a1-74ec05d7aa54","callout":[],"children":[],"id":"4d266aea-bf61-4c49-a3b0-b03e9166a967","title":"前置：已打开微信登录流程"},{"parent":"6c8c3a1b-4958-496f-b9a1-74ec05d7aa54","callout":[],"children":[],"id":"b48cea1e-4448-4e0a-90b6-787708284114","title":"操作：扫码后中断网络，再恢复网络"},{"parent":"6c8c3a1b-4958-496f-b9a1-74ec05d7aa54","callout":[],"children":[],"id":"a91af2a0-dd35-450d-a2b4-8b398898fcd7","title":"预期：登录状态最终明确成功或失败；不长期停留在加载中；恢复后可重试。"}],"collapsed":true,"id":"6c8c3a1b-4958-496f-b9a1-74ec05d7aa54","title":"🟡【P2】登录过程中网络中断"}],"collapsed":true,"id":"54ac89b4-359d-4721-a3cc-04255ac2e924","title":"边界场景"}],"collapsed":true,"id":"74b59ba9-9e10-45ea-8f32-9d18bfcf2cf1","title":"WorkBuddy 微信登录"},{"parent":"a5f6893f-b31d-4420-9b5d-93e59b29bf88","callout":[],"children":[{"parent":"df7a34f9-18d6-42b2-bd61-af759d2cb543","callout":[],"children":[{"parent":"439fe829-d6a4-411e-b16c-c69e4525d50d","callout":[],"children":[{"parent":"8ea18ad0-41b8-4130-b730-933876cd9cd4","callout":[],"children":[],"id":"6e893b3b-3a01-48fc-a166-0aa94c8e86fc","title":"前置：中国大陆地区；已完成微信登录"},{"parent":"8ea18ad0-41b8-4130-b730-933876cd9cd4","callout":[],"children":[],"id":"8c8d96c8-f293-44cd-827e-ca488e1af90c","title":"操作：打开模型来源弹窗"},{"parent":"8ea18ad0-41b8-4130-b730-933876cd9cd4","callout":[],"children":[],"id":"717edb1a-5038-4099-9d49-49bc7de39894","title":"预期：官方订阅展示为已登录，并展示正确账号信息。"}],"collapsed":true,"id":"8ea18ad0-41b8-4130-b730-933876cd9cd4","title":"🔴【P0】官方订阅已登录状态","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"439fe829-d6a4-411e-b16c-c69e4525d50d","callout":[],"children":[{"parent":"07ab64e1-9ba8-4326-90bb-92fe58721b03","callout":[],"children":[],"id":"4fe29f05-391f-4a1f-811c-20bffe65d40d","title":"前置：中国大陆地区；用户拥有可用 Tutti API 或套餐额度"},{"parent":"07ab64e1-9ba8-4326-90bb-92fe58721b03","callout":[],"children":[],"id":"ee2eedce-b94c-4e96-95b2-314f8c588a6a","title":"操作：选择 Tutti API 来源并查看额度"},{"parent":"07ab64e1-9ba8-4326-90bb-92fe58721b03","callout":[],"children":[],"id":"7e963ff0-dbc0-4ae5-bccc-86b8968c6d96","title":"预期：展示当前 API/套餐状态和额度；可选择支持的模型并发起任务。<br>"}],"collapsed":true,"id":"07ab64e1-9ba8-4326-90bb-92fe58721b03","title":"🔴【P0】Tutti API 来源","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"439fe829-d6a4-411e-b16c-c69e4525d50d","callout":[],"children":[{"parent":"2ec52c47-74f1-4410-b10d-11a8c46ab9b0","callout":[],"children":[],"id":"4f2dca8d-a196-450f-afcc-156f1d862bd2","title":"前置：进入模型来源弹窗；拥有第三方 API Key"},{"parent":"2ec52c47-74f1-4410-b10d-11a8c46ab9b0","callout":[],"children":[],"id":"13ac7f1b-c5b6-4ec7-a967-df517e67608a","title":"操作：点击 API Key「新增」，填写供应商和 API Key 并保存"},{"parent":"2ec52c47-74f1-4410-b10d-11a8c46ab9b0","callout":[],"children":[],"id":"a4cef8f9-539d-4ff0-800c-8594fd61b155","title":"预期：<br>1) 保存结果｜配置成功并出现在 API Key 列表<br>2) 安全性｜Key 脱敏展示，不出现在日志和会话内容中<br>3) 调用结果｜可使用该 Key 调用对应模型<br>"}],"collapsed":true,"id":"2ec52c47-74f1-4410-b10d-11a8c46ab9b0","title":"🔴【P0】新增 API Key","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"439fe829-d6a4-411e-b16c-c69e4525d50d","callout":[],"children":[{"parent":"1bc8d165-f7bf-4f7a-ba68-275340607fcf","callout":[],"children":[],"id":"d7654f1d-9d5f-4937-818a-5ba23424817e","title":"前置：已存在 API Key 配置"},{"parent":"1bc8d165-f7bf-4f7a-ba68-275340607fcf","callout":[],"children":[],"id":"9946a508-c2c8-41a0-a729-95015a64263a","title":"操作：编辑供应商或 Key，或删除该配置"},{"parent":"1bc8d165-f7bf-4f7a-ba68-275340607fcf","callout":[],"children":[],"id":"2a57d69d-e979-4e80-b644-1f1d38748543","title":"预期：修改后配置立即生效；删除后不可继续调用；已有任务按产品定义处理。"}],"collapsed":true,"id":"1bc8d165-f7bf-4f7a-ba68-275340607fcf","title":"🟠【P1】编辑和删除 API Key","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"439fe829-d6a4-411e-b16c-c69e4525d50d","title":"正常场景"},{"parent":"df7a34f9-18d6-42b2-bd61-af759d2cb543","callout":[],"children":[{"parent":"bd0f0c66-e907-4101-aa92-712c39f594ba","callout":[],"children":[{"parent":"c014d253-6ac1-4e21-abdf-b54f9ab176d1","callout":[],"children":[],"id":"6121d569-34fd-4dcf-bf44-5a4241395c64","title":"前置：配置错误、过期或撤销的 API Key<br>"},{"parent":"c014d253-6ac1-4e21-abdf-b54f9ab176d1","callout":[],"children":[],"id":"9b73e1c3-8b7d-421d-970c-2ff2fe72ca51","title":"操作：使用该来源发起任务"},{"parent":"c014d253-6ac1-4e21-abdf-b54f9ab176d1","callout":[],"children":[],"id":"89e25b02-bf45-4000-b8d7-365ed03b0994","title":"预期：任务被拦截；提示认证失败；不长期排队；不回显完整 Key。"}],"collapsed":true,"id":"c014d253-6ac1-4e21-abdf-b54f9ab176d1","title":"🔴【P0】API Key 无效"},{"parent":"bd0f0c66-e907-4101-aa92-712c39f594ba","callout":[],"children":[{"parent":"7daa9d95-b334-404b-b634-0269294127c6","callout":[],"children":[],"id":"d3f34ca9-0c38-4761-bcb3-a9c9e5c67e53","title":"前置：选择错误供应商并输入 Key"},{"parent":"7daa9d95-b334-404b-b634-0269294127c6","callout":[],"children":[],"id":"31a6c2d4-c414-420d-8088-9ec0915c1f9b","title":"操作：保存并发起任务"},{"parent":"7daa9d95-b334-404b-b634-0269294127c6","callout":[],"children":[],"id":"e8941243-6017-4d8a-94ea-b765e294ad3d","title":"预期：保存或调用阶段给出明确错误；不将配置显示为可用。"}],"collapsed":true,"id":"7daa9d95-b334-404b-b634-0269294127c6","title":"🟠【P1】供应商与 API Key 不匹配"},{"parent":"bd0f0c66-e907-4101-aa92-712c39f594ba","callout":[],"children":[{"parent":"cc0a8ed1-ec21-4d8e-88b5-febb083015a2","callout":[],"children":[],"id":"f81a0a45-dbd7-44fc-b80c-237e9a7b38dd","title":"前置：Tutti API、官方订阅或第三方 Key 对应额度不足"},{"parent":"cc0a8ed1-ec21-4d8e-88b5-febb083015a2","callout":[],"children":[],"id":"a5be6910-cb31-4b95-9e62-6c8c99b7d0f4","title":"操作：发起任务"},{"parent":"cc0a8ed1-ec21-4d8e-88b5-febb083015a2","callout":[],"children":[],"id":"c5fe185b-73c8-4d4b-b927-a831006cde90","title":"预期：提示具体额度问题；不无限重试、不重复扣费；提供可切换的可用来源。<br>"}],"collapsed":true,"id":"cc0a8ed1-ec21-4d8e-88b5-febb083015a2","title":"🟠【P1】额度不足或额度耗尽"},{"parent":"bd0f0c66-e907-4101-aa92-712c39f594ba","callout":[],"children":[{"parent":"ae6937ae-2187-4fc8-8878-6f892e9b8f08","callout":[],"children":[],"id":"c673ffcc-5c57-48c7-b28e-0d6b0b992ed3","title":"前置：当前来源不支持工具调用、上下文长度、多模态或代码执行能力"},{"parent":"ae6937ae-2187-4fc8-8878-6f892e9b8f08","callout":[],"children":[],"id":"b0e842d2-d036-487f-ab0e-7b6b3fe05720","title":"操作：发送依赖该能力的任务"},{"parent":"ae6937ae-2187-4fc8-8878-6f892e9b8f08","callout":[],"children":[],"id":"c2d741dd-1d0e-4755-99e4-5105ded4c1f4","title":"预期：发送前提示限制，或返回明确兼容性错误；不误报成功。"}],"collapsed":true,"id":"ae6937ae-2187-4fc8-8878-6f892e9b8f08","title":"🟠【P1】模型能力不兼容"}],"collapsed":true,"id":"bd0f0c66-e907-4101-aa92-712c39f594ba","title":"异常场景"},{"parent":"df7a34f9-18d6-42b2-bd61-af759d2cb543","callout":[],"children":[{"parent":"d0b8ec18-19d9-49f5-b55a-ac0d7b2e0217","callout":[],"children":[{"parent":"468db4c2-57f9-4cca-983e-f53fd0665053","callout":[],"children":[],"id":"58146dbb-54b0-4008-8868-5f34d910043d","title":"前置：同时配置官方订阅、Tutti API 和 API Key"},{"parent":"468db4c2-57f9-4cca-983e-f53fd0665053","callout":[],"children":[],"id":"5920e017-50c0-4b1d-b421-456017f10dda","title":"操作：分别切换来源并发送相同任务"},{"parent":"468db4c2-57f9-4cca-983e-f53fd0665053","callout":[],"children":[],"id":"91235337-4710-4253-9e86-e9badb62362d","title":"预期：任务使用当前选中的来源；模型、额度、错误提示和调用记录不串联。"}],"collapsed":true,"id":"468db4c2-57f9-4cca-983e-f53fd0665053","title":"🟡【P2】多来源切换","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"d0b8ec18-19d9-49f5-b55a-ac0d7b2e0217","callout":[],"children":[{"parent":"0ed1ccce-7ccb-47fd-bf8f-759e9f82b01f","callout":[],"children":[],"id":"14897ce0-d18f-4255-8663-72350789040d","title":"前置：WorkBuddy 任务正在运行"},{"parent":"0ed1ccce-7ccb-47fd-bf8f-759e9f82b01f","callout":[],"children":[],"id":"c3ea90b1-0e08-4818-af30-2ef07201bfeb","title":"操作：切换模型来源"},{"parent":"0ed1ccce-7ccb-47fd-bf8f-759e9f82b01f","callout":[],"children":[],"id":"56a99dd0-d5b4-47ba-9391-61e0ad906750","title":"预期：当前任务继续使用原来源或明确中断；新任务使用新来源；不发生中途换源。"}],"collapsed":true,"id":"0ed1ccce-7ccb-47fd-bf8f-759e9f82b01f","title":"🟡【P2】来源切换时任务正在执行"},{"parent":"d0b8ec18-19d9-49f5-b55a-ac0d7b2e0217","callout":[],"children":[{"parent":"8368878d-c748-46c4-9726-368ec863572c","callout":[],"children":[],"id":"3d620e90-9016-42df-a6e8-f1255acfd0aa","title":"前置：配置多个供应商或同一供应商多个 API Key"},{"parent":"8368878d-c748-46c4-9726-368ec863572c","callout":[],