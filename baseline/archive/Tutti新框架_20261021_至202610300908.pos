d0-a238-b6c62e529ef4","callout":[],"children":[{"parent":"7ef9653b-9489-49ba-86ca-7840a64ea18a","callout":[],"children":[{"parent":"d79885d5-9234-437a-bf83-7f2c5b44771e","callout":[],"children":[],"id":"297b9347-b2e0-45d0-aa99-699b54883414","title":"前置：会话可正常执行"},{"parent":"d79885d5-9234-437a-bf83-7f2c5b44771e","callout":[],"children":[],"id":"350067f2-dbbe-4d3a-b4bd-44dca0d4a016","title":"操作：让 Agent 用一个非法的时间表达式创建定时任务"},{"parent":"d79885d5-9234-437a-bf83-7f2c5b44771e","callout":[],"children":[],"id":"5744ad52-bf33-4591-ab42-05a2a817ee97","title":"预期：创建被拒绝并提示表达式非法，不创建出永不触发或立即狂触发的任务"},{"parent":"d79885d5-9234-437a-bf83-7f2c5b44771e","callout":[],"children":[],"id":"26a737f4-6dd2-430c-b996-901487694ff1","title":"备注：附件3 CC-015"}],"collapsed":true,"id":"d79885d5-9234-437a-bf83-7f2c5b44771e","title":"🟡【P2】非法定时表达式","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"7ef9653b-9489-49ba-86ca-7840a64ea18a","title":"异常场景（1）"},{"parent":"c7c0e5df-920d-44d0-a238-b6c62e529ef4","callout":[],"children":[{"parent":"78da2d8f-b60d-471e-a722-56545a1e15b4","callout":[],"children":[{"parent":"c5e6fe9f-9bb4-468b-b7be-d85b5d3b0819","callout":[],"children":[],"id":"51f6b86d-8ccd-4221-a6a5-5e47cc81749c","title":"前置：已创建一个触发间隔很短的定时任务"},{"parent":"c5e6fe9f-9bb4-468b-b7be-d85b5d3b0819","callout":[],"children":[],"id":"dd5a0eaa-7e7d-434d-a373-4ec92fc4f440","title":"操作：观察连续多次触发的执行情况"},{"parent":"c5e6fe9f-9bb4-468b-b7be-d85b5d3b0819","callout":[],"children":[],"id":"36301c1f-e34d-463c-b1bf-f630c0197d24","title":"预期：按预期频率触发，不堆积未完成的执行，可随时删除停止"}],"collapsed":true,"id":"c5e6fe9f-9bb4-468b-b7be-d85b5d3b0819","title":"🟡【P2】高频定时任务的触发","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"78da2d8f-b60d-471e-a722-56545a1e15b4","title":"边界场景（1）"}],"collapsed":true,"id":"c7c0e5df-920d-44d0-a238-b6c62e529ef4","title":"Cron 定时任务"},{"parent":"d1ae4c91-ed42-444f-810d-b3929b2656c5","callout":[],"children":[{"parent":"059e715e-c4d5-4e88-ba59-9e3e479f46e6","callout":[],"children":[{"parent":"f1775dc6-1172-4350-b997-b7f0afe2b4d4","callout":[],"children":[{"parent":"c909a4c7-7645-4abb-af98-f6902343eb03","callout":[],"children":[],"id":"07e7301d-cbfc-4ee0-8a05-2ab2a34a60b4","title":"前置：工作流中包含人工确认节点"},{"parent":"c909a4c7-7645-4abb-af98-f6902343eb03","callout":[],"children":[],"id":"216a2e98-2f46-4c64-a09a-e3ec5a211b2e","title":"操作：执行到确认节点时先不操作，观察一段时间后再确认"},{"parent":"c909a4c7-7645-4abb-af98-f6902343eb03","callout":[],"children":[],"id":"21200cb5-e6a4-4f30-8250-e14ef087cf80","title":"预期：确认节点持续等待用户操作不自动放行；确认后从该节点继续执行"},{"parent":"c909a4c7-7645-4abb-af98-f6902343eb03","callout":[],"children":[],"id":"d45bc015-e8c8-4703-b788-35300b3249c1","title":"备注：来源 附件3 CC-024；附件3 CC-024"}],"collapsed":true,"id":"c909a4c7-7645-4abb-af98-f6902343eb03","title":"🟠【P1】人工确认节点的等待与放行"},{"parent":"f1775dc6-1172-4350-b997-b7f0afe2b4d4","callout":[],"children":[{"parent":"547aaccd-3b8c-477c-a21a-ed2346a5067d","callout":[],"children":[],"id":"99ba0874-cbcd-4805-84d3-56a939bff1af","title":"前置：会话可正常执行"},{"parent":"547aaccd-3b8c-477c-a21a-ed2346a5067d","callout":[],"children":[],"id":"d67e5297-69a1-4e90-a89a-0a7701f8993e","title":"操作：让 Agent 执行一个包含多步骤与工具调用的工作流"},{"parent":"547aaccd-3b8c-477c-a21a-ed2346a5067d","callout":[],"children":[],"id":"8cceceb8-c1d3-46e3-90c3-bc1c94d80b29","title":"预期：步骤按顺序执行，进度可见，每步的输入输出可查看"},{"parent":"547aaccd-3b8c-477c-a21a-ed2346a5067d","callout":[],"children":[],"id":"48657147-cade-4598-95c8-c13cea6ee8f4","title":"备注：来源 附件3 CC-024；附件3 CC-024"}],"collapsed":true,"id":"547aaccd-3b8c-477c-a21a-ed2346a5067d","title":"🟠【P1】多步骤工作流执行与进度"}],"collapsed":true,"id":"f1775dc6-1172-4350-b997-b7f0afe2b4d4","title":"正常场景（2）"},{"parent":"059e715e-c4d5-4e88-ba59-9e3e479f46e6","callout":[],"children":[{"parent":"4e2b4a43-cd3f-4f93-aa6c-bdd2e324b22f","callout":[],"children":[{"parent":"c1b1dbcf-5fc0-4d60-9b0c-fa30da767f7b","callout":[],"children":[],"id":"0f50c829-5ac0-4c16-acf3-fa131ade44c3","title":"前置：工作流执行中"},{"parent":"c1b1dbcf-5fc0-4d60-9b0c-fa30da767f7b","callout":[],"children":[],"id":"485f4750-4948-4713-80d2-1e07769f78ff","title":"操作：在其中一步故意拒绝，随后从该步重试"},{"parent":"c1b1dbcf-5fc0-4d60-9b0c-fa30da767f7b","callout":[],"children":[],"id":"1254246c-b614-4b2c-b839-a9e5185a95a7","title":"预期：给出明确的失败步骤；可从该步恢复继续，不需要整体重跑"},{"parent":"c1b1dbcf-5fc0-4d60-9b0c-fa30da767f7b","callout":[],"children":[],"id":"d2f4913c-cf3a-4f80-929d-8cbf4f89015e","title":"备注：来源 附件3 CC-024；附件3 CC-024"}],"collapsed":true,"id":"c1b1dbcf-5fc0-4d60-9b0c-fa30da767f7b","title":"🟠【P1】步骤被拒绝后的恢复"}],"collapsed":true,"id":"4e2b4a43-cd3f-4f93-aa6c-bdd2e324b22f","title":"异常场景（1）"},{"parent":"059e715e-c4d5-4e88-ba59-9e3e479f46e6","callout":[],"children":[{"parent":"e35cbfbe-6c59-4e64-84f0-24b75721bbf1","callout":[],"children":[{"parent":"99141482-3ad9-4cdd-839e-df6677e2681a","callout":[],"children":[],"id":"258ef4e6-e530-455c-98d5-000ebe1826f1","title":"前置：会话可正常执行"},{"parent":"99141482-3ad9-4cdd-839e-df6677e2681a","callout":[],"children":[],"id":"6bf91bae-cca7-49b7-8f84-ad56bd1ff08a","title":"操作：让 Agent 执行一个包含数十个步骤的工作流"},{"parent":"99141482-3ad9-4cdd-839e-df6677e2681a","callout":[],"children":[],"id":"44d16577-8c11-44a7-b4c2-77e8033aab4d","title":"预期：全部步骤按序完成，进度可查看，长列表可折叠不卡死"}],"collapsed":true,"id":"99141482-3ad9-4cdd-839e-df6677e2681a","title":"🟡【P2】步骤数很多的工作流"}],"collapsed":true,"id":"e35cbfbe-6c59-4e64-84f0-24b75721bbf1","title":"边界场景（1）"}],"collapsed":true,"id":"059e715e-c4d5-4e88-ba59-9e3e479f46e6","title":"Workflow 工具"},{"parent":"d1ae4c91-ed42-444f-810d-b3929b2656c5","callout":[],"children":[{"parent":"553932ec-ebff-4024-819f-dd7086443bae","callout":[],"children":[{"parent":"bf31fb95-0ef1-4d17-b058-1dded66c9658","callout":[],"children":[{"parent":"63d9330c-9ae4-4b6a-b1e9-c22b47cfd4dd","callout":[],"children":[],"id":"c60abc07-9ac8-43b1-a9ad-d2ee920d44d4","title":"前置：系统通知权限已开启"},{"parent":"63d9330c-9ae4-4b6a-b1e9-c22b47cfd4dd","callout":[],"children":[],"id":"5a5cc8ce-72cc-4b47-b270-b6ec0a668ef6","title":"操作：让 Agent 分别在应用前台和后台状态下触发通知"},{"parent":"63d9330c-9ae4-4b6a-b1e9-c22b47cfd4dd","callout":[],"children":[],"id":"994558a5-0d62-4968-a588-847914ecfaae","title":"预期：两种状态下通知均及时送达且内容正确；点击通知能回到对应会话"},{"parent":"63d9330c-9ae4-4b6a-b1e9-c22b47cfd4dd","callout":[],"children":[],"id":"1b292a23-77c4-41be-8d9d-34169e6499bf","title":"备注：来源 附件3 CC-019；附件3 CC-019"}],"collapsed":true,"id":"63d9330c-9ae4-4b6a-b1e9-c22b47cfd4dd","title":"🟠【P1】前台与后台通知送达"}],"collapsed":true,"id":"bf31fb95-0ef1-4d17-b058-1dded66c9658","title":"正常场景（1）"},{"parent":"553932ec-ebff-4024-819f-dd7086443bae","callout":[],"children":[{"parent":"75afc191-83e2-496f-83a0-20e4835b98af","callout":[],"children":[{"parent":"c14f8143-0401-4d53-9d77-8dfe915b27ff","callout":[],"children":[],"id":"7dbf6f0e-f9b0-4863-87ca-e5e38ebf0e48","title":"前置：系统通知权限已关闭"},{"parent":"c14f8143-0401-4d53-9d77-8dfe915b27ff","callout":[],"children":[],"id":"51bb6ac2-2d85-4fbc-a2fa-a4ebb4df72b6","title":"操作：让 Agent 触发一次通知"},{"parent":"c14f8143-0401-4d53-9d77-8dfe915b27ff","callout":[],"children":[],"id":"5c382e4d-c976-420f-8a40-61ff1d7d7eb0","title":"预期：应用内仍有可见提示，并引导用户开启系统通知权限，不静默丢失"},{"parent":"c14f8143-0401-4d53-9d77-8dfe915b27ff","callout":[],"children":[],"id":"6e59b33e-97ad-473b-9188-efc2a831c656","title":"备注：附件3 CC-019"}],"collapsed":true,"id":"c14f8143-0401-4d53-9d77-8dfe915b27ff","title":"🟠【P1】系统通知权限关闭时"}],"collapsed":true,"id":"75afc191-83e2-496f-83a0-20e4835b98af","title":"异常场景（1）"},{"parent":"553932ec-ebff-4024-819f-dd7086443bae","callout":[],"children":[{"parent":"2927e655-c49f-48ad-bdb4-4601767720ec","callout":[],"children":[{"parent":"c641fb83-e2e0-44f4-9e61-93f6a0b78871","callout":[],"children":[],"id":"29249c79-8e6c-42af-be92-6b4372b45c60","title":"前置：系统通知权限已开启"},{"parent":"c641fb83-e2e0-44f4-9e61-93f6a0b78871","callout":[],"children":[],"id":"9a158252-90ed-44dc-a7d1-db126f38e6d6","title":"操作：连续触发两次同类通知"},{"parent":"c641fb83-e2e0-44f4-9e61-93f6a0b78871","callout":[],"children":[],"id":"3e18e79e-1bf1-48e6-b180-3671de5ce316","title":"预期：同类通知合并或抑制，不重复轰炸用户"},{"parent":"c641fb83-e2e0-44f4-9e61-93f6a0b78871","callout":[],"children":[],"id":"8a331bcf-e96c-45f3-941e-58f243f096c9","title":"备注：来源 附件3 CC-019；附件3 CC-019"}],"collapsed":true,"id":"c641fb83-e2e0-44f4-9e61-93f6a0b78871","title":"🟡【P2】同类通知的重复触发"},{"parent":"2927e655-c49f-48ad-bdb4-4601767720ec","callout":[],"children":[{"parent":"6eb82d1b-ae45-4037-9b4d-1a6efe6243f3","callout":[],"children":[],"id":"89132d3d-a63d-45b2-b7d4-50dfea678afe","title":"前置：系统通知权限已开启"},{"parent":"6eb82d1b-ae45-4037-9b4d-1a6efe6243f3","callout":[],"children":[],"id":"31f381ce-40c7-4ff8-ace6-aa618a1c9b98","title":"操作：让 Agent 触发一条内容很长的通知"},{"parent":"6eb82d1b-ae45-4037-9b4d-1a6efe6243f3","callout":[],"children":[],"id":"febccc6e-5b3e-4b0f-aa54-91de7cae9f44","title":"预期：通知内容合理截断且关键信息可见，点击后能看到完整内容"}],"collapsed":true,"id":"6eb82d1b-ae45-4037-9b4d-1a6efe6243f3","title":"🟡【P2】通知内容超长"}],"collapsed":true,"id":"2927e655-c49f-48ad-bdb4-4601767720ec","title":"边界场景（2）"}],"collapsed":true,"id":"553932ec-ebff-4024-819f-dd7086443bae","title":"PushNotification 工具"},{"parent":"d1ae4c91-ed42-444f-810d-b3929b2656c5","callout":[],"children":[{"parent":"113e75ad-4288-47e9-837a-f54ccd589bed","callout":[],"children":[{"parent":"8739f075-36ba-4460-9a74-4503898ba958","callout":[],"children":[{"parent":"f8a1db68-f84d-42cd-9b8c-608436da1f25","callout":[],"children":[],"id":"1f7231d9-fd6e-4fa6-a80c-155da9d990dd","title":"前置：已生成发现报告"},{"parent":"f8a1db68-f84d-42cd-9b8c-608436da1f25","callout":[],"children":[],"id":"d7e1c0e3-4885-4084-b4f9-1082b94450c8","title":"操作：在会话详情中查看该报告的归属"},{"parent":"f8a1db68-f84d-42cd-9b8c-608436da1f25","callout":[],"children":[],"id":"dc5a354e-48f1-443c-826c-a67a0dc5a384","title":"预期：报告绑定到正确的会话与任务；从会话详情可查看完整结果"},{"parent":"f8a1db68-f84d-42cd-9b8c-608436da1f25","callout":[],"children":[],"id":"43b1beab-0c2f-490c-a0fb-c05b70f85758","title":"备注：来源 附件3 CC-025；附件3 CC-025"}],"collapsed":true,"id":"f8a1db68-f84d-42cd-9b8c-608436da1f25","title":"🟠【P1】报告与会话任务的绑定"},{"parent":"8739f075-