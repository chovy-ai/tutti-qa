示 E、D、C、B、A"}],"collapsed":true,"id":"c287301c-2377-45d8-82ff-698371199a3b","title":"🟠【P1】项目按添加时间倒序"},{"parent":"81085da1-34f0-42d4-bc49-e89d8c874614","callout":[],"children":[{"parent":"f8a78c28-c0c5-41b7-b33c-a9179c0c0b9c","callout":[],"children":[],"id":"622e2347-d256-48b0-8ed7-6a563e54bf65","title":"操作：打开系统选择器后取消"},{"parent":"f8a78c28-c0c5-41b7-b33c-a9179c0c0b9c","callout":[],"children":[],"id":"7b315fe0-1273-4805-94d6-bcb1726aee64","title":"预期：不新增项目，原列表不变"}],"collapsed":true,"id":"f8a78c28-c0c5-41b7-b33c-a9179c0c0b9c","title":"🟠【P1】取消选择"},{"parent":"81085da1-34f0-42d4-bc49-e89d8c874614","callout":[],"children":[{"parent":"9418057e-48cd-4a0c-9bbb-5bbedea40ce9","callout":[],"children":[],"id":"22e3fcc1-4a6d-4581-8029-6a0eb8421c3c","title":"操作：点击新建项目，打开菜单后点击空白区域"},{"parent":"9418057e-48cd-4a0c-9bbb-5bbedea40ce9","callout":[],"children":[],"id":"3a184730-0e19-469f-b0a7-d4a48f304a11","title":"预期：菜单关闭且不执行任何项目操作"}],"collapsed":true,"id":"9418057e-48cd-4a0c-9bbb-5bbedea40ce9","title":"🟠【P1】点击外部关闭"},{"parent":"81085da1-34f0-42d4-bc49-e89d8c874614","callout":[],"children":[{"parent":"f66d6d07-f205-4725-a2ab-5daa0da1eefb","callout":[],"children":[],"id":"d68ea16a-5300-4593-b064-7b60f9baa6db","title":"操作：点击新建项目或关联已有项目，打开菜单后按 Esc"},{"parent":"f66d6d07-f205-4725-a2ab-5daa0da1eefb","callout":[],"children":[],"id":"4da69081-9f5a-4284-9a63-de553a7d43df","title":"预期：菜单关闭并将焦点返回加号按钮"}],"collapsed":true,"id":"f66d6d07-f205-4725-a2ab-5daa0da1eefb","title":"🟠【P1】Esc 关闭"},{"parent":"81085da1-34f0-42d4-bc49-e89d8c874614","callout":[],"children":[{"parent":"4c1899c2-ac2a-4024-932b-7e7f2217c461","callout":[],"children":[],"id":"d5e1363c-1bfd-4a40-a8d9-19092172ad65","title":"操作：完成创建与关联后刷新或重开 Agent 窗口"},{"parent":"4c1899c2-ac2a-4024-932b-7e7f2217c461","callout":[],"children":[],"id":"3e487280-97fe-4c69-ac79-238cb872d78c","title":"预期：项目仍按创建时间倒序，不回退为名称排序"}],"collapsed":true,"id":"4c1899c2-ac2a-4024-932b-7e7f2217c461","title":"🟠【P1】刷新保持顺序"},{"parent":"81085da1-34f0-42d4-bc49-e89d8c874614","ca