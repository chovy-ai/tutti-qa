cbd","callout":[],"children":[{"parent":"d1ae4c91-ed42-444f-810d-b3929b2656c5","callout":[],"children":[{"parent":"c24180b9-8c4e-4329-b666-a7c34e29366f","callout":[],"children":[{"parent":"57d100af-213a-4ffb-bbbe-27143ba0f536","callout":[],"children":[{"parent":"affba30c-006f-46a8-becd-0d466b8f16b3","callout":[],"children":[],"id":"93c5e626-257b-49c4-bc02-968ef835704b","title":"操作：下发指令「执行一条合法 shell 指令，如 ls 查看目录」"},{"parent":"affba30c-006f-46a8-becd-0d466b8f16b3","callout":[],"children":[],"id":"c574ee4a-5876-44aa-80ed-5f2e559fcf77","title":"预期：Agent 正常调用终端执行命令，对话返回完整命令执行结果，无报错、指令输出排版正常"}],"collapsed":true,"id":"affba30c-006f-46a8-becd-0d466b8f16b3","title":"🔴【P0】Agent正常执行shell命令","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"57d100af-213a-4ffb-bbbe-27143ba0f536","callout":[],"children":[{"parent":"f6b76cc4-3211-404f-be64-3ce249735367","callout":[],"children":[],"id":"1696f6fa-e438-4d05-9367-b126467c190c","title":"前置：会话已绑定项目，Agent 可正常执行"},{"parent":"f6b76cc4-3211-404f-be64-3ce249735367","callout":[],"children":[],"id":"96617efc-9b63-425f-a2d1-2fd681f99db2","title":"操作：让 Agent 依次执行 pwd、构建、测试、lint、git diff"},{"parent":"f6b76cc4-3211-404f-be64-3ce249735367","callout":[],"children":[],"id":"5b6a2b18-c5f0-42a5-a554-6f27ed8e73a5","title":"预期：每条命令的工作目录、标准输出与退出码准确返回；执行详情中可展开查看完整输出"},{"parent":"f6b76cc4-3211-404f-be64-3ce249735367","callout":[],"children":[],"id":"828629d7-36ea-4b1d-bbcf-8e0cc8bcd397","title":"备注：来源 附件3 CC-011；附件3 CC-011"}],"collapsed":true,"id":"f6b76cc4-3211-404f-be64-3ce249735367","title":"🔴【P0】常规命令执行与结果返回","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"57d100af-213a-4ffb-bbbe-27143ba0f536","title":"正常场景（2）"},{"parent":"c24180b9-8c4e-4329-b666-a7c34e29366f","callout":[],"children":[{"parent":"5c231527-58d9-4318-9a37-48b84be28f7a","callout":[],"children":[{"parent":"f6640bac-05d0-479c-8ffb-28b1de27c79f","callout":[],"children":[],"id":"2fc891f3-e00c-4681-a51c-384f6da90fa1","titl