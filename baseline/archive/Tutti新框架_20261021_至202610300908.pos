f-56bcbaa2bbe1","callout":[],"children":[],"id":"a3bcb248-65d4-434d-b1ae-0ba2df962624","title":"操作：进入房间查看 Agent 状态并发送一条消息"},{"parent":"3189e12a-7197-447b-b3ef-56bcbaa2bbe1","callout":[],"children":[],"id":"373a6228-ef77-4320-96a1-4ad910ac5bec","title":"预期：房间内显示为已登录且消息可正常发送；不出现房间内提示需要登录、VM 中显示凭据已配置、再发消息又变回未登录的反复横跳"},{"parent":"3189e12a-7197-447b-b3ef-56bcbaa2bbe1","callout":[],"children":[],"id":"7167c3c5-65c0-44e9-a527-a2a6aebcfcbd","title":"备注：#14 #271"}],"collapsed":true,"id":"3189e12a-7197-447b-b3ef-56bcbaa2bbe1","title":"🔴【P0】本地已登录但房间内显示需要登录"},{"parent":"02737369-bae7-415a-b169-75a3103f0c46","callout":[],"children":[{"parent":"7b0aa075-7954-4be0-b591-5a0528ae155b","callout":[],"children":[],"id":"d545d432-0956-41d4-bbd4-f7109e256db8","title":"前置：前置：本地终端中已退出 Claude Code 登录；角色：Agent 所有者；入口：管理智能体页面与智能体应用左下角限制入口"},{"parent":"7b0aa075-7954-4be0-b591-5a0528ae155b","callout":[],"children":[],"id":"9a3a1d61-444c-4e77-8c1e-4666d6e53b02","title":"操作：查看登录状态并点击登录按钮"},{"parent":"7b0aa075-7954-4be0-b591-5a0528ae155b","callout":[],"children":[],"id":"fbc713c9-1b31-44ad-8223-2b20a30b7872","title":"预期：两处均显示为未登录且提示需要重新登录；点击登录能正常进入登录流程而非报错；左下角限制信息不显示为无法加载账户状态"},{"parent":"7b0aa075-7954-4be0-b591-5a0528ae155b","callout":[],"children":[],"id":"7b0faa1a-25be-4483-8afe-507c4f4ac13d","title":"备注：#318 #390"}],"collapsed":true,"id":"7b0aa075-7954-4be0-b591-5a0528ae155b","title":"🔴【P0】本地已退出登录但应用仍显示已登录"},{"parent":"02737369-bae7-415a-b169-75a3103f0c46","callout":[],"children":[{"parent":"d5da817c-8e15-4321-aa6c-a63706628a82","callout":[],"children":[],"id":"74e4b2c2-58b5-4aae-8a50-2828dc1993ad","title":"前置：该 Agent 已登录，应用与终端同时可用"},{"parent":"d5da817c-8e15-4321-aa6c-a63706628a82","callout":[],"children":[],"id":"1ee395bf-e5e3-419e-a39c-b26b6b10100f","title":"操作：在终端执行 {Agent} 对应的登出命令后返回应用"},{"parent":"d5da817c-8e15-4321-aa6c-a63706628a82","callout":[],"children":[],"id":"eedb029d-1895-4f46-ad7c-dde5d0f1f887","title":"预期：应用检测到本地凭据已清除，账号区及输入框状态更新为未登录，不再允许发送消息"}],"collapsed":true,"id":"d5da817c-8e15-4321-aa6c-a63706628a82","title":"🔴【P0】终端登出后应用感知"}],"collapsed":true,"id":"02737369-bae7-415a-b169-75a3103f0c46","title":"异常场景（4）"},{"parent":"9374e239-f3bc-49e8-9f5e-3f0fef40df31","callout":[],"children":[{"parent":"2b159583-3800-4db8-8fdb-9a48cef91763","callout":[],"children":[{"parent":"cf6de0d8-83f0-450f-979c-37078e93d807","callout":[],"children":[],"id":"2521470e-802e-41c0-9d10-522a454d79b7","title":"前置：本地与房间内均已登录"},{"parent":"cf6de0d8-83f0-450f-979c-37078e93d807","callout":[],"children":[],"id":"a375747f-7a96-4cd9-a2d6-e80cf03cdc8c","title":"操作：在本地切换账号后立即进入房间查看状态"},{"parent":"cf6de0d8-83f0-450f-979c-37078e93d807","callout":[],"children":[],"id":"37464f5d-b225-4fc0-a910-1670db2743a5","title":"预期：房间内在合理时间内同步为新账号，不出现新旧账号信息混显"}],"collapsed":true,"id":"cf6de0d8-83f0-450f-979c-37078e93d807","title":"🟡【P2】本地与房间同时切换账号"}],"collapsed":true,"id":"2b159583-3800-4db8-8fdb-9a48cef91763","title":"边界场景（1）"}],"collapsed":true,"id":"9374e239-f3bc-49e8-9f5e-3f0fef40df31","title":"5.5 本地与房间的登录态一致性"},{"parent":"204384d9-744c-42f7-96a0-aa8d73804a15","callout":[],"children":[{"parent":"25d9215b-e40b-4f8f-a7ad-e22211935e13","callout":[],"children":[{"parent":"71823d49-98d2-4632-9367-0d3cf5f16dc1","callout":[],"children":[{"parent":"dccce19f-d156-4f5e-82d0-e5d41720f1e7","callout":[],"children":[],"id":"61e5e28f-978e-4670-a0ae-b8d13b66a16e","title":"前置：Agent 已安装且已登录账号 A"},{"parent":"dccce19f-d156-4f5e-82d0-e5d41720f1e7","callout":[],"children":[],"id":"d6160ffc-eac9-4194-a3cb-2501fba61c8e","title":"操作：点击 Sign in again 并改用账号 B 完成授权"},{"parent":"dccce19f-d156-4f5e-82d0-e5d41720f1e7","callout":[],"children":[],"id":"72be6d3c-aab6-4126-a384-1aabc0caba39","title":"预期：Signed in 展示账号 B，Usage limit 与检测状态同步为新账号；账号 A 的邮箱、额度与环境数据被清除，不残留在卡片上"}],"collapsed":true,"id":"dccce19f-d156-4f5e-82d0-e5d41720f1e7","title":"🔴【P0】在同一 Agent 上切换到另一个账号"},{"parent":"71823d49-98d2-4632-9367-0d3cf5f16dc1","callout":[],"children":[{"parent":"17322777-be11-4a34-b15f-fedf0b8b92f0","callout":[],"children":[],"id":"9afb61b8-4e8a-4f8f-99ff-f990419e5f0c","title":"前置：Agent 已安装且已登录"},{"parent":"17322777-be11-4a34-b15f-fedf0b8b92f0","callout":[],"children":[],"id":"35c2e786-63a3-4363-a7af-db2022e683a1","title":"操作：点击 Sign in again并完成授权流程"},{"parent":"17322777-be11-4a34-b15f-fedf0b8b92f0","callout":[],"children":[],"id":"7fb21363-1b2c-42c1-a71f-c0ea0ddb4f28","title":"预期：新凭据生效，账号状态更新并自动或手动重新检测"}],"collapsed":true,"id":"17322777-be11-4a34-b15f-fedf0b8b92f0","title":"🔴【P0】重新登录成功"}],"collapsed":true,"id":"71823d49-98d2-4632-9367-0d3cf5f16dc1","title":"正常场景（2）"},{"parent":"25d9215b-e40b-4f8f-a7ad-e22211935e13","callout":[],"children":[{"parent":"97bae271-9598-42db-aa43-dfb5a1bc93ca","callout":[],"children":[{"parent":"4637053a-7055-4763-b42e-623ffd3b32a1","callout":[],"children":[],"id":"8a69391d-b47b-4ae7-8e55-2326a90d762a","title":"前置：Agent 已登录账号 A"},{"parent":"4637053a-7055-4763-b42e-623ffd3b32a1","callout":[],"children":[],"id":"147ef308-d7ae-486b-9eb6-8f37fb010ba3","title":"操作：点击 Sign in again 并重新用账号 A 完成授权"},{"parent":"4637053a-7055-4763-b42e-623ffd3b32a1","callout":[],"children":[],"id":"af7cd492-cfb8-41c0-b461-69132b5f0c3f","title":"预期：凭据被正确更新且账号展示保持为 A；不出现重复账号记录或状态回退为未登录"},{"parent":"4637053a-7055-4763-b42e-623ffd3b32a1","callout":[],"children":[],"id":"e56a39b3-842b-4f30-bd1e-10a786b073fb","title":"备注：依据新版 UI 图新增"}],"collapsed":true,"id":"4637053a-7055-4763-b42e-623ffd3b32a1","title":"🟠【P1】Sign in again 后仍登录同一账号"},{"parent":"97bae271-9598-42db-aa43-dfb5a1bc93ca","callout":[],"children":[{"parent":"fbc7dfbe-3c9e-44c9-99a7-62b62b202351","callout":[],"children":[],"id":"ac707064-f745-468d-8c4e-8f07604fa937","title":"前置：Agent 已安装且已登录"},{"parent":"fbc7dfbe-3c9e-44c9-99a7-62b62b202351","callout":[],"children":[],"id":"9ae659ac-b85a-4256-a859-99e521ac845b","title":"操作：启动重新登录后在授权页取消"},{"parent":"fbc7dfbe-3c9e-44c9-99a7-62b62b202351","callout":[],"children":[],"id":"f0a092da-2469-41ec-9be0-84df48017870","title":"预期：保留原有效登录或维持未登录状态，并给出取消反馈"}],"collapsed":true,"id":"fbc7dfbe-3c9e-44c9-99a7-62b62b202351","title":"🟠【P1】重新登录取消"},{"parent":"97bae271-9598-42db-aa43-dfb5a1bc93ca","callout":[],"children":[{"parent":"e5540281-bf40-4114-8027-f5da7d9d92cd","callout":[],"children":[],"id":"45447a05-0066-4c86-9d8d-8925d3b2d82b","title":"前置：Agent 已安装且已登录"},{"parent":"e5540281-bf40-4114-8027-f5da7d9d92cd","callout":[],"children":[],"id":"9d499cac-21b4-4cb7-b7e0-18070e2990d5","title":"操作：登录回调期间断网"},{"parent":"e5540281-bf40-4114-8027-f5da7d9d92cd","callout":[],"children":[],"id":"d6df5ae1-977b-483e-b6e6-6e35f3578b2f","title":"预期：提示登录失败并支持重试，不保存半成品凭据"}],"collapsed":true,"id":"e5540281-bf40-4114-8027-f5da7d9d92cd","title":"🟠【P1】重新登录网络失败"}],"collapsed":true,"id":"97bae271-9598-42db-aa43-dfb5a1bc93ca","title":"异常场景（3）"},{"parent":"25d9215b-e40b-4f8f-a7ad-e22211935e13","callout":[],"children":[{"parent":"7781175d-97f2-4a85-aef2-457678d2cca1","callout":[],"children":[{"parent":"be9cd899-81f8-4e67-a18f-9515f6b4bb9a","callout":[],"children":[],"id":"5d749bcd-0ac3-44ef-b679-52072d3fcd14","title":"前置：Agent 已安装且已登录"},{"parent":"be9cd899-81f8-4e67-a18f-9515f6b4bb9a","callout":[],"children":[],"id":"11d4f6c6-b645-46e1-a9c0-454a02319a3c","title":"操作：两个窗口同时发起不同账号登录"},{"parent":"be9cd899-81f8-4e67-a18f-9515f6b4bb9a","callout":[],"children":[],"id":"bf6efc3b-39f2-409c-a69e-5fcb1f07439c","title":"预期：凭据写入具备确定性并提示最终账号，不发生混合状态"}],"collapsed":true,"id":"be9cd899-81f8-4e67-a18f-9515f6b4bb9a","title":"🟡【P2】多窗口同时登录"},{"parent":"7781175d-97f2-4a85-aef2-457678d2cca1","callout":[],"children":[{"parent":"20f6de52-5b68-4f15-90e7-fe35cee6c8fa","callout":[],"children":[],"id":"43de372b-f0cc-4861-80f8-f7556c2c94d6","title":"前置：Agent 已安装且已登录"},{"parent":"20f6de52-5b68-4f15-90e7-fe35cee6c8fa","callout":[],"children":[],"id":"26ad1c55-12c8-405d-820e-b5f74b4a33a3","title":"操作：快速点击重新登录 10 次"},{"parent":"20f6de52-5b68-4f15-90e7-fe35cee6c8fa","callout":[],"children":[],"id":"4ba793e5-500b-4751-a4bb-c460893eb621","title":"预期：只启动一个有效登录流程，回调只消费一次"}],"collapsed":true,"id":"20f6de52-5b68-4f15-90e7-fe35cee6c8fa","title":"🟡【P2】连续点击重新登录"}],"collapsed":true,"id":"7781175d-97f2-4a85-aef2-457678d2cca1","title":"边界场景（2）"}],"collapsed":true,"id":"25d9215b-e40b-4f8f-a7ad-e22211935e13","title":"5.6 Sign in again 与切换账号"},{"parent":"204384d9-744c-42f7-96a0-aa8d73804a15","callout":[],"children":[{"parent":"be3de6b8-e879-44dd-90e6-b4a76485da2c","callout":[],"children":[{"parent":"49c56508-9bdd-4b48-9548-caf948ff24ae","callout":[],"children":[{"parent":"addd42a7-7a5b-4fe5-89d1-0cbfeddfaeb4","callout":[],"children":[],"id":"2d920814-7ee6-42bd-a674-b86ecda53fa3","title":"前置：已为该 Agent 配置有效 API Key 并开启路由"},{"parent":"addd42a7-7a5b-4fe5-89d1-0cbfeddfaeb4","callout":[],"children":[],"id":"a631870b-0380-46c7-87fd-4847b4eacc91","title":"操作：触发检测并查看 Signed in 步骤，随后发起一次会话"},{"parent":"addd42a7-7a5b-4fe5-89d1-0cbfeddfaeb4","callout":[],"children":[],"id":"410b3c17-d216-4c34-a47f-494b647242de","title":"预期：Signed in 判定为已配置可用，账号名按产品规则展示为空或占位；请求按路由配置转发且会话可正常返回"},{"parent":"addd42a7-7a5b-4fe5-89d1-0cbfeddfaeb4","callout":[],"children":[],"id":"bdea9e66-6b5a-480f-aa09-4bc372122ed6","title":"备注：合并自 Claude / Codex 的「通过 api（开启路由）登录」用例"}],"collapsed":true,"id":"addd42a7-7a5b-4fe5-89d1-0cbfeddfaeb4","title":"🔴【P0】开启路由的 API Key 配置后的登录态"},{"parent":"49c56508-9bdd-4b48-9548-caf948ff24ae","callout":[],"children":[{"parent":"0b6245a9-c160-41f5-a993-6afab8bf2cf8","callout":[],"children":[],"id":"d0c10a9c-e736-42c7-bb3a-edac937af8b1","title":"前置：Codex 已安装未登录，持有有效 API Key"},{"parent":"0b6245a9-c160-41f5-a993-6afab8bf2cf8","callout":[],"children":[],"id":"a91a4d00-cc98-4671-bd32-cc3bc187e853","title":"操作：点击登录，选择 API Key 方式并填入有效 Key"},{"parent":"0b6245a9-c160-41f5-a993-6afab8bf2cf8","callout":[],"children":[],"id":"5a0fcc5f-e8c3-4cd8-abc4-4595eb24d7d1","title":"预期：登录成功且状态可用；用量限制按该配置的支持情况展示或明确说明不支持"}],"collapsed":true,"id":"0b6245a9-c160-41f5-a993-6afab8bf2cf8","title":"🔴【P0】通过 API Key 登录 Codex"},{"parent":"49c56508-9bdd-4b48-9548-caf948ff24ae","callout":[],"children":[{"parent":"d32cfe22-5023-477a-a18c-37cfec13ee99",