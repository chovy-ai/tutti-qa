c-9941-d0b58da60b9e","callout":[],"children":[],"id":"497a6ef6-c2eb-44c5-becc-f6af5c710cae","title":"预期：未安装显示 + 号；安装或处理中显示加载态图标且不可重复点击；已安装并完成连接显示 ✓；三种状态在视觉上可清晰区分"}],"collapsed":true,"id":"583d57f4-6f45-458c-9941-d0b58da60b9e","title":"🔴【P0】卡片状态控件三态区分","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"6bb6849a-0e8e-442a-9486-bf7f9a192121","title":"正常场景"},{"parent":"74656135-9f81-414c-ace2-4615082e8bc9","callout":[],"children":[{"parent":"3e65f0dd-28de-43a3-b96d-ef45eb0abc33","callout":[],"children":[{"parent":"5be7628b-a021-480e-9752-524d8f510d12","callout":[],"children":[],"id":"50a4c06c-0c21-4e48-b749-f53355cb0bf5","title":"前置：连接器页首次打开；角色：房间成员；入口：Marketplace 内容区"},{"parent":"5be7628b-a021-480e-9752-524d8f510d12","callout":[],"children":[],"id":"fdd1d5fc-9f20-49f7-b394-07627692b2a9","title":"操作：在网络断开状态下打开 Marketplace，恢复网络后点击重试"},{"parent":"5be7628b-a021-480e-9752-524d8f510d12","callout":[],"children":[],"id":"bba1a8f3-2dd1-4fcb-8dff-c09212ead615","title":"预期：给出加载失败的明确提示与重试入口，不长时间停留在骨架屏；不误展示为「暂无连接器」空态；重试后列表正常加载"}],"collapsed":true,"id":"5be7628b-a021-480e-9752-524d8f510d12","title":"🟠【P1】市场列表加载失败"},{"parent":"3e65f0dd-28de-43a3-b96d-ef45eb0abc33","callout":[],"children":[{"parent":"6762e923-2080-4c4a-bfda-a31284e1ac2a","callout":[],"children":[],"id":"97e8d46f-ffef-493c-9a82-96f0220d2bca","title":"前置：某一分类当前没有可上架的连接器；角色：房间成员；入口：Marketplace 内容区"},{"parent":"6762e923-2080-4c4a-bfda-a31284e1ac2a","callout":[],"children":[],"id":"624b312e-9216-4650-8ffb-14646b04d8bd","title":"操作：浏览该分类区域"},{"parent":"6762e923-2080-4c4a-bfda-a31284e1ac2a","callout":[],"children":[],"id":"fa28a03b-4a34-4ac7-836a-d21ed5fa5465","title":"预期：该分类不展示空的标题占位，或展示明确的空态说明；其他分类正常展示不受影响"}],"collapsed":true,"id":"6762e923-2080-4c4a-bfda-a31284e1ac2a","title":"🟡【P2】某个分类下无可用连接器"}],"collapsed":true,"id":"3e65f0dd-28de-43a3-b96d-ef45eb0abc33","title":"异常场景"},{"parent":"74656135-9f81-414c-ace2-4615082e8bc9","callout":[],"children":[{"parent":"80acf2dd-ea1d-4e17-b081-98a91424c78a","callout":[],"children":[{"parent":"01f6f8c1-0f67-44e1-a8e5-5a5d428aca68","callout":[],"children":[],"id":"d4765e3b-8483-4138-816c-9ade0ddf229f","title":"前置：市场中连接器数量超过一屏；角色：房间成员；入口：Marketplace 内容区"},{"parent":"01f6f8c1-0f67-44e1-a8e5-5a5d428aca68","callout":[],"children":[],"id":"78853b47-d1e3-4dd9-8481-27a0703c98eb","title":"操作：向下滚动浏览到列表底部"},{"parent":"01f6f8c1-0f67-44e1-a8e5-5a5d428aca68","callout":[],"children":[],"id":"8afa05f8-72e6-4286-892d-187f7d3488f6","title":"预期：滚动流畅且分类标题与卡片对应关系正确；分批加载时有加载反馈；滚动到底部有明确的结束表现，不重复渲染已展示的卡片"}],"collapsed":true,"id":"01f6f8c1-0f67-44e1-a8e5-5a5d428aca68","title":"🟡【P2】连接器数量较多时的浏览"}],"collapsed":true,"id":"80acf2dd-ea1d-4e17-b081-98a91424c78a","title":"边界场景"}],"collapsed":true,"id":"74656135-9f81-414c-ace2-4615082e8bc9","title":"市场分类与卡片展示"},{"parent":"e50b5894-38fc-4566-b62a-9be3904bfbba","callout":[],"children":[{"parent":"cced58af-7ada-4a2e-bb2c-7941b77ff6f3","callout":[],"children":[{"parent":"3f708dd1-e72f-4aa3-8fe8-6a82cbe4c73e","callout":[],"children":[{"parent":"4bf975b5-2efd-4fc7-a669-f3ccd7894961","callout":[],"children":[],"id":"6fa98bbd-3e2a-4f73-8faa-4b1f2522e5e2","title":"前置：目标连接器处于未安装状态；角色：房间成员；入口：Marketplace 卡片右侧 + 号"},{"parent":"4bf975b5-2efd-4fc7-a669-f3ccd7894961","callout":[],"children":[],"id":"f36a2296-81b4-4964-ad44-60b13fdaeb6b","title":"操作：点击 + 号并等待安装完成"},{"parent":"4bf975b5-2efd-4fc7-a669-f3ccd7894961","callout":[],"children":[],"id":"890575f2-ccfb-4f13-8f0f-cf13334768e7","title":"预期：按钮立即变为加载态且不可重复点击；安装完成后 + 号变为授权按钮，卡片左下方显示「需要授权」；该连接器此时尚未出现在已授权可用列表中"}],"collapsed":true,"id":"4bf975b5-2efd-4fc7-a669-f3ccd7894961","title":"🔴【P0】点击 + 号安装连接器","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"3f708dd1-e72f-4aa3-8fe8-6a82cbe4c73e","callout":[],"children":[{"parent":"9307d93e-3d77-4fe9-8dda-b95b41db26fa","callout":[],"children":[],"id":"80f5cb7b-32e7-43d6-a5c4-17134b3688d3","title":"前置：某连接器刚安装成功；角色：房间成员；入口：Marketplace 卡片"},{"parent":"9307d93e-3d77-4fe9-8dda-b95b41db26fa","callout":[],"children":[],"id":"c1f73871-f6f6-4e1f-9c62-cf7dc6262dd0","title":"操作：查看该卡片的按钮与左下角状态文案"},{"parent":"9307d93e-3d77-4fe9-8dda-b95b41db26fa","callout":[],"children":[],"id":"576286e9-27b9-4b22-91c9-3eaf86bd60df","title":"预期：卡片右侧为授权按钮，左下方显示「需要授权」；刷新页面或切换 Tab 后再回到市场，该状态保持不变"}],"collapsed":true,"id":"9307d93e-3d77-4fe9-8dda-b95b41db26fa","title":"🔴【P0】安装成功后的卡片状态","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"3f708dd1-e72f-4aa3-8fe8-6a82cbe4c73e","title":"正常场景"},{"parent":"cced58af-7ada-4a2e-bb2c-7941b77ff6f3","callout":[],"children":[{"parent":"4db007f0-43fc-4683-b1b2-28c38f3128ae","callout":[],"children":[{"parent":"9cc83ef2-3a95-4d72-b650-0d640eec8482","callout":[],"children":[],"id":"270ccbe2-a24e-4d24-9021-674a50d332ae","title":"前置：目标连接器未安装；角色：房间成员；入口：Marketplace 卡片 + 号"},{"parent":"9cc83ef2-3a95-4d72-b650-0d640eec8482","callout":[],"children":[],"id":"65cb99fb-9c0d-443a-b6be-943687d01382","title":"操作：在安装过程中断开网络，等待失败提示后恢复网络并重新点击 + 号"},{"parent":"9cc83ef2-3a95-4d72-b650-0d640eec8482","callout":[],"children":[],"id":"b05fd788-b264-4092-a794-2ac7cffdd18a","title":"预期：给出安装失败的明确原因与可重试的入口；卡片回到未安装的 + 号状态，不残留加载态；本地不遗留半成品运行文件；重试后可安装成功"}],"collapsed":true,"id":"9cc83ef2-3a95-4d72-b650-0d640eec8482","title":"🟠【P1】安装失败的处理"},{"parent":"4db007f0-43fc-4683-b1b2-28c38f3128ae","callout":[],"children":[{"parent":"e1f7c613-ba9e-43fc-8e0e-11af8b363f82","callout":[],"children":[],"id":"fd7dd875-e6a4-425c-9b1a-991ec95dcdbb","title":"前置：某连接器正在安装中；角色：房间成员；入口：Agents 面板与连接器页"},{"parent":"e1f7c613-ba9e-43fc-8e0e-11af8b363f82","callout":[],"children":[],"id":"607c6ce7-473c-4884-8dad-673b39fe4f4a","title":"操作：在安装进行中切换到会话页，稍后再回到连接器页"},{"parent":"e1f7c613-ba9e-43fc-8e0e-11af8b363f82","callout":[],"children":[],"id":"2dca3fb3-743e-4913-8673-13ed7fe15a01","title":"预期：安装任务不因页面切换而中断；返回后卡片展示的是安装完成或失败的真实结果，不停留在旧的加载态"}],"collapsed":true,"id":"e1f7c613-ba9e-43fc-8e0e-11af8b363f82","title":"🟡【P2】安装过程中离开页面"}],"collapsed":true,"id":"4db007f0-43fc-4683-b1b2-28c38f3128ae","title":"异常场景"},{"parent":"cced58af-7ada-4a2e-bb2c-7941b77ff6f3","callout":[],"children":[{"parent":"c16c9621-dba5-4912-b872-3c7a87a816f2","callout":[],"children":[{"parent":"c6d2abd6-13d5-42d6-8c15-305c657561d8","callout":[],"children":[],"id":"ccaa8cde-7cd9-43c9-9325-4ca8826047f2","title":"前置：目标连接器处于未安装状态；角色：房间成员；入口：Marketplace 卡片 + 号"},{"parent":"c6d2abd6-13d5-42d6-8c15-305c657561d8","callout":[],"children":[],"id":"ca609fd4-1fb6-4530-8f1b-3a3cdcb89b04","title":"操作：连续快速点击 + 号 10 次"},{"parent":"c6d2abd6-13d5-42d6-8c15-305c657561d8","callout":[],"children":[],"id":"29fa38fa-0724-4d76-b5e7-dd7b6b7e944a","title":"预期：只发起一次安装任务；按钮在首次点击后即置为不可点击；已安装列表中不出现重复条目"}],"collapsed":true,"id":"c6d2abd6-13d5-42d6-8c15-305c657561d8","title":"🟡【P2】快速连续点击 + 号"},{"parent":"c16c9621-dba5-4912-b872-3c7a87a816f2","callout":[],"children":[{"parent":"4e06b8fa-fbfa-4afb-96c1-7ff56af977dc","callout":[],"children":[],"id":"b7dafc21-6f92-4cb7-9e46-84419fc26018","title":"前置：市场中有多个未安装连接器；角色：房间成员；入口：Marketplace 多张卡片的 + 号"},{"parent":"4e06b8fa-fbfa-4afb-96c1-7ff56af977dc","callout":[],"children":[],"id":"7befbf61-458c-4e49-bf4f-d7dac05799a9","title":"操作：依次快速点击 3 个不同连接器的 + 号"},{"parent":"4e06b8fa-fbfa-4afb-96c1-7ff56af977dc","callout":[],"children":[],"id":"0680ef89-a701-4e29-9412-2411ab2fd850","title":"预期：3 个安装任务互不干扰且各自展示自身进度；完成后 3 张卡片分别变为需要授权状态；不出现进度或结果串到其他卡片"}],"collapsed":true,"id":"4e06b8fa-fbfa-4afb-96c1-7ff56af977dc","title":"🟡【P2】同时安装多个连接器"}],"collapsed":true,"id":"c16c9621-dba5-4912-b872-3c7a87a816f2","title":"边界场景（2）"}],"collapsed":true,"id":"cced58af-7ada-4a2e-bb2c-7941b77ff6f3","title":"安装连接器"},{"parent":"e50b5894-38fc-4566-b62a-9be3904bfbba","callout":[],"children":[{"parent":"e4aa3ba2-3c3a-411b-95d3-833e4a01db93","callout":[],"children":[{"parent":"15f4e8e5-709f-4468-9e67-cbcd7866a2aa","callout":[],"lineStyle":{},"children":[{"parent":"c0e3fc27-e8b0-46c8-a131-a550cb0111f4","callout":[],"children":[],"id":"bf22a1e6-441f-4d1d-b11f-e6443f9b3178","title":"前置：某连接器已安装但未授权；角色：房间成员；入口：卡片右上方 ... 按钮"},{"parent":"c0e3fc27-e8b0-46c8-a131-a550cb0111f4","callout":[],"children":[],"id":"861e515c-6f09-49a5-ae37-4c279c7c67ab","title":"操作：点击卡片右上方的 ... 按钮"},{"parent":"c0e3fc27-e8b0-46c8-a131-a550cb0111f4","callout":[],"children":[],"id":"ade80424-1ab1-4759-9753-45d7f81fcb17","title":"预期：弹出菜单并展示卸载选项；点击菜单外部或按 Esc 可关闭且不执行任何操作"}],"collapsed":true,"style":{"text-decoration":"line-through"},"id":"c0e3fc27-e8b0-46c8-a131-a550cb0111f4","title":"🔴【P0】卡片更多菜单展示卸载选项"},{"parent":"15f4e8e5-709f-4468-9e67-cbcd7866a2aa","callout":[],"children":[{"parent":"3d96dac1-100f-4317-8570-df8b3cd98982","callout":[],"children":[],"id":"6fa2aa4c-4878-4c4a-870d-6c44e4494cc5","title":"前置：某连接器已安装但未授权；角色：房间成员；入口：卡片 ... 菜单中的卸载"},{"parent":"3d96dac1-100f-4317-8570-df8b3cd98982","callout":[],"children":[],"id":"fae55b1b-2927-4de1-a022-0e740420991d","title":"操作：点击卸载并等待完成，随后查看卡片状态与本地运行文件"},{"parent":"3d96dac1-100f-4317-8570-df8b3cd98982","callout":[],"children":[],"id":"3fc6a68a-cd35-4846-a3fc-8ff406b8f9ae","title":"预期：卸载成功；本地运行文件与已安装的 CLI 被删除；卡片回到 + 号状态；该连接器不再出现在 Installed Tab"}],"collapsed":true,"id":"3d96dac1-100f-4317-8570-df8b3cd98982","title":"🔴【P0】卸载未授权的连接器","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"15f4e8e5-709f-4468-9e67-cbcd7866a2aa","callout":[],"children":[{"parent":"7c061e6e-4f05-4298-b9f5-889d9ee44966","callout":[],"children":[],"id":"f9024eeb-1692-49d0-b6cd-e98ded5f11c0","title":"前置：某未授权连接器刚被卸载；角色：房间成员；入口：Marketplace 卡片 + 号"},{"parent":"7c061e6e-4f05-4298-b9f5-889d9ee44966","callout":[],"children":[],"id":"3fc2af55-f859-4742-b786-314dfdc20059","title":"操作：再次点击该卡片的 + 号"},{"parent":"7c061e6e-4f05-4298-b9f5-889d9ee44966","callout":[],"children":[],"id":"dcd9d190-a1b2-4650-be7f-df323165e3ce","title":"预期：重新安装成功并回到「需要授权」状态，而不是直接变为已连接；卡片左下方重新出现需要授权文案"}],"collapsed":true,"id":"7c061e6e-4f05-4298-b9f5-889d9ee44966","title":"🔴【P0】卸载后重新安装","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"15f4e8e5-709f-4468-9e67-cbcd7866a2aa","title":"正常场景（3）"},{"parent":"e4aa3ba2-3c3a-411b-95d3-833e4a01db93","callout":[],"children":[{"parent":"9c8b160d-0d2c-4106-b7f3-042e643e427a","callout":[],"children":[{"parent":"1a78dfb3-e909-4f48-89bd-b93c500665ba","callout":[],"children":[],"id":"2810e12d-720b-411d-ad65-8df909c9c3b9","title":"前置：某已安装未授权连接器的运行文件被其他进程占用；角色：房间成员；入口：卡片 ... 菜单中的卸载"},{"parent":"1a78dfb3-e909-4f48-89bd-b93c500665ba","callout":[],"children":[],"id":"d9787e0d-a576-4e05-9b16-80e9e327b4f8","title":"操作：执行卸载并观察结果"},{"parent":"1a78dfb3-e909-4f48-89bd-b93c500665ba","callout":[],"children":[],"id":"9a6f3e71-2a98-40e9-a40e-02545f24f717","title":"预期：给出卸载失败的明确原因与重试入口；卡片保持已安装状态不变为 + 号；不出现界面显示已卸载但本地文件仍在的不一致"}],"collapsed":true,"id":"1a78dfb3-e909-4f48-89bd-b93c500665ba","title":"🟡【P2】卸载失败的处理"}],"collapsed":true,"id":"9c8b160d-0d2c-4106-b7f3-042e643e427a","title":"异常场景（1）"}],"collapsed":true,"id":"e4aa3ba2-3c3a-411b-95d3-833e4a01db93","title":"未授权状态下的卸载"},{"parent":"e50b5894-38fc-4566-b62a-9be3904bfbba","callout":[],"children":[{"parent":"8dfdc513-d34e-4aff-8c7b-2b72f39da0b4","customWidth":476,"callout":[],"children":[],"id":"e2808e56-70ba-42b9-8530-0f5b8faa5d24","title":"说明：海外用户不展示国内的连接器（钉钉、企微、腾讯文档），国内用户展示全部<br>区分：根据tutti web语言区分国内外用户"},{"parent":"8dfdc513-d34e-4aff-8c7b-2b72f39da0b4","callout":[],"children":[{"parent":"50dc9de2-8848-4139-9bbf-0779291cf0ad","callout":[],"children":[{"parent":"335efe1c-facf-4c97-abcb-620498e1b59d","callout":[],"children":[],"id":"dd7d0a18-cea6-4812-8775-bfdfcc942ca5","title":"前置：账号或访问来源判定为国内；角色：连接器使用者；入口：连接器市场"},{"parent":"335efe1c-facf-4c97-abcb-620498e1b59d","callout":[],"children":[],"id":"513e11c8-41db-46ab-ba37-b76c042ef560","title":"操作：浏览市场里的全部分类"},{"parent":"335efe1c-facf-4c97-abcb-620498e1b59d","callout":[],"children":[],"id":"060ab664-6b93-4869-b36b-1ce25886d387","title":"预期：\n1) 列表展示 ｜ 国内与海外的连接器都展示\n2) 结果校验 ｜ 分类与数量与后台配置一致"}],"collapsed":true,"id":"335efe1c-facf-4c97-abcb-620498e1b59d","title":"🔴【P0】国内用户展示全部连接器","icons":[{"color":"rgb(248, 87, 103)","name":"other","index":"369"}]},{"parent":"50dc9de2-8848-4139-9bbf-0779291cf0ad","callout":[],"children":[{"parent":"f1ca51f4-3231-4c90-8c45-ddc3804793d4","callout":[],"children":[],"id":"fa54c4aa-9292-4660-b954-567ca952eff9","title":"前置：账号或访问来源判定为海外；角色：连接器使用者；入口：连接器市场"},{"parent":"f1ca51f4-3231-4c90-8c45-ddc3804793d4","callout":[],"children":[],"id":"660b6177-f208-4fea-8a93-68f57fd19f9a","title":"操作：浏览市场并搜索一个国内专属的连接器"},{"parent":"f1ca51f4-3231-4c90-8c45-ddc3804793d4","callout":[],"children":[],"id":"c8ff1a3f-5686-4284-b76c-9342f54e0cca","title":"预期：\n1) 列表展示 ｜ 国内专属的连接器不出现在列表中\n2) 搜索匹配 ｜ 搜索该连接器的名称也搜不到，不出现搜到但点不开"}],"collapsed":true,"id":"f1ca51f4-3231-4c90-8c45-ddc3804793d4","title":"🔴【P0】海外用户不展示国内连接器"},{"parent":"50dc9de2-8848-4139-9bbf-0779291cf0ad","callout":[],"children":[{"parent":"5d44a24a-48ca-4b6a-9bd6-e35107ddc1c3","callout":[],"children":[],"id":"c2f2825c-2efe-4eff-98ce-4e3aebba8385","title":"前置：分别用国内与海外账号进入市场；角色：连接器使用者；入口：连接器市场"},{"parent":"5d44a24a-48ca-4b6a-9bd6-e35107ddc1c3","callout":[],"children":[],"id":"55ecfd05-0364-444c-8680-188f58c87806","title":"操作：对照两侧的分类与每类的数量"},{"parent":"5d44a24a-48ca-4b6a-9bd6-e35107ddc1c3","callout":[],"children":[],"id":"0cc27f11-514a-4fba-ba8c-2d4cbfd126e7","title":"预期：\n1) 列表展示 ｜ 海外侧的数量是国内侧的子集，不出现海外多于国内\n2) 视觉展示 ｜ 分类为空时不展示空分类标题"}],"collapsed":true,"id":"5d44a24a-48ca-4b6a-9bd6-e35107ddc1c3","title":"🟠【P1】两种地区的分类与计数"}],"collapsed":true,"id":"50dc9de2-8848-4139-9bbf-0779291cf0ad","title":"正常场景"},{"parent":"8dfdc513-d34e-4aff-8c7b-2b72f39da0b4","callout":[],"children":[{"parent":"e5a393a7-65cf-4da5-b16f-a5d462909507","callout":[],"children":[{"parent":"86e22173-92ee-4128-a6bc-fee4b00cb9c3","callout":[],"children":[],"id":"0166121e-c0ac-4014-8a8b-196ca2d19585","title":"前置：账号此前在国内安装过某个国内连接器，之后判定为海外；角色：连接器使用者；入口：已安装列表与输入框连接器面板"},{"parent":"86e22173-92ee-4128-a6bc-fee4b00cb9c3","callout":[],"children":[],"id":"23612022-9b99-4543-9358-2e9db754e8b2","title":"操作：查看该连接器的状态"},{"parent":"86e22173-92ee-4128-a6bc-fee4b00cb9c3","callout":[],"children":[],"id":"02bbf978-6e75-4587-be07-bac8897459bb","title":"预期：\n1) 列表展示 ｜ 该连接器从已安装列表中移除，不是保留展示为不可用\n2) 列表展示 ｜ 输入框连接器面板中同步不再出现\n3) 副作用 ｜ 移除过程不影响其他已安装连接器的授权与开关状态"}],"collapsed":true,"id":"86e22173-92ee-4128-a6bc-fee4b00cb9c3","title":"🔴【P0】海外用户已安装过国内连接器"},{"parent":"e5a393a7-65cf-4da5-b16f-a5d462909507","callout":[],"children":[{"parent":"193a159a-e1a7-42cc-b154-ee93bc088e13","callout":[],"children":[],"id":"54421f13-3117-45cf-bebc-8b291759828b","title":"前置：被移除的国内连接器此前在会话中调用过；角色：海外用户；入口：历史会话"},{"parent":"193a159a-e1a7-42cc-b154-ee93bc088e13","callout":[],"children":[],"id":"496edc86-b25e-45fa-b72c-6aceef15f357","title":"操作：打开包含该连接器调用的历史会话"},{"parent":"193a159a-e1a7-42cc-b154-ee93bc088e13","callout":[],"children":[],"id":"57e7fcb5-1859-4d1c-ad37-40d1f37060c4","title":"预期：\n1) 消息渲染 ｜ 历史记录正常展示，不因为连接器被移除而报错或变成空白\n2) 提示文案 ｜ 再次调用时说明该连接器在你的地区不可用"}],"collapsed":true,"id":"193a159a-e1a7-42cc-b154-ee93bc088e13","title":"🔴【P0】移除后历史调用记录的展示"},{"parent":"e5a393a7-65cf-4da5-b16f-a5d462909507","callout":[],"children":[{"parent":"c80d0ff5-27b0-4594-a691-3a617d9e3cb8","callout":[],"children":[],"id":"3239f6e2-e5f5-4f08-b37d-d37c459e2201","title":"前置：海外账号；角色：连接器使用者；入口：输入框的连接器面板"},{"parent":"c80d0ff5-27b0-4594-a691-3a617d9e3cb8","callout":[],"children":[],"id":"b6d4dff8-5a83-45dd-ba92-1049ba9ffb41","title":"操作：展开面板查看可选连接器"},{"parent":"c80d0ff5-27b0-4594-a691-3a617d9e3cb8","callout":[],"children":[],"id":"ef7f3c8b-5c68-4478-95bf-e15a3d5bbf2b","title":"预期：\n1) 结果校验 ｜ 与市场的可见范围一致，市场里没有的不出现在面板里\n2) 列表展示 ｜ 「查看更多连接器」跳到市场后看到的也是同一份范围"}],"collapsed":true,"id":"c80d0ff5-27b0-4594-a691-3a617d9e3cb8","title":"🟠【P1】输入框连接器面板的一致性"}],"collapsed":true,"id":"e5a393a7-65cf-4da5-b16f-a5d462909507","title":"异常场景（4）"},{"parent":"8dfdc513-d34e-4aff-8c7b-2b72f39da0b4","callout":[],"children":[{"parent":"1b6baaca-2207-4b56-b3b9-0a7a08e55140","callout":[],"children":[{"parent":"578a6e81-7082-433d-bafe-ec137d578ae9","callout":[],"children":[],"id":"cbd925fb-0754-4284-90b1-d675804f9ac9","title":"前置：账号的地区判定发生变化；角色：连接器使用者；入口：连接器市场"},{"parent":"578a6e81-7082-433d-bafe-ec137d578ae9","callout":[],"children":[],"id":"3e63882a-79bd-4700-a093-c0f2e7f2b907","title":"操作：切换后刷新或重新进入市场"},{"parent":"578a6e81-7082-433d-bafe-ec137d578ae9","callout":[],"children":[],"id":"3b4b8afd-457c-4eb3-b38c-60c1eca95459","title":"预期：\n1) 列表展示 ｜ 列表按新的地区范围更新\n2) 持久化 ｜ 不需要重新登录才生效，或产品明确要求重新登录时给出提示"}],"collapsed":true,"id":"578a6e81-7082-433d-bafe-ec137d578ae9","title":"🟡【P2】地区切换后的实时性"},{"parent":"1b6baaca-2207-4b56-b3b9-0a7a08e55140","callout":[],"children":[{"parent":"34dff570-599b-406e-a721-030b83244265","callout":[],"children":[],"id":"adcd2e5f-34c3-4023-b693-c8c7716ef6ce","title":"前置：房间里同时有国内与海外成员，某会话用到了国内专属连接器；角色：海外成员；入口：会话详情"},{"parent":"34dff570-599b-406e-a721-030b83244265","callout":[],"children":[],"id":"7b631343-35cf-4446-bf10-84411297a69c","title":"操作：海外成员查看该会话与其中的连接器调用"},{"parent":"34dff570-599b-406e-a721-030b83244265","callout":[],"children":[],"id":"64b8d3ab-8a07-4a86-91ad-1a7cc48c8348","title":"预期：\n1) 消息渲染 ｜ 历史记录正常展示，不因为看不到该连接器而报错\n2) 提示文案 ｜ 需要自己调用时说明该连接器在你的地区不可用"}],"collapsed":true,"id":"34dff570-599b-406e-a721-030b83244265","title":"🟡【P2】分享与协作场景下的地区差异"}],"collapsed":true,"id":"1b6baaca-2207-4b56-b3b9-0a7a08e55140","title":"边界场景（2）"}],"collapsed":true,"id":"8dfdc513-d34e-4aff-8c7b-2b72f39da0b4","title":"地区可见范围"}],"collapsed":true,"id":"e50b5894-38fc-4566-b62a-9be3904bfbba","title":"连接器市场（Marketplace）"},{"parent":"de79807e-910d-408f-a135-d0250b4463cc","callout":[],"children":[{"parent":"70232116-ba28-4f17-bdbe-9816d72005e7","callout":[],"children":[{"parent":"1fe0d662-618c-4f9f-9a8e-ee8f551ddd4e","callout":[],"children":[{"parent":"42451ef3-c7e4-47c8-b959-565e3e9d0d07","callout":[],"children":[{"parent":"a1617400-06ce-462e-8de7-8782ef26ca97","callout":[],"children":[],"id":"da2bab4e-8a7e-4da0-8e8a-9c36c138c509","title":"前置：某连接器已安装未授权，卡片左下方显示需要授权；角色：房间成员；入口：Marketplace 卡片上的授权按钮"},{"parent":"a1617400-06ce-462e-8de7-8782ef26ca97","callout":[],"children":[],"id":"e3a60acb-f48b-4e79-b3e8-03a1a6b29b73","title":"操作：点击授权按钮"},{"parent":"a1617400-06ce-462e-8de7-8782ef26ca97","callout":[],"children":[],"id":"db5e6b50-bcce-445c-8bc8-18199b97d617","title":"预期：弹出该连接器的授权弹窗；弹窗中展示连接器图标、授权说明与授权入口；背景变暗且不可操作下层页面"}],"collapsed":true,"id":"a1617400-06ce-462e-8de7-8782ef26ca97","title":"🔴【P0】点击授权按钮弹出授权弹窗","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"42451ef3-c7e4-47c8-b959-565e3e9d0d07","callout":[],"children":[{"parent":"ad210123-b338-4d92-bc45-10e5a8548037","callout":[],"children":[],"id":"3e397aa2-6098-4a0d-b75f-0061a10c471a","title":"前置：授权弹窗已打开；角色：房间成员；入口：授权弹窗"},{"parent":"ad210123-b338-4d92-bc45-10e5a8548037","callout":[],"children":[],"id":"fd4800bf-6be8-4eac-8f14-d51cef2f68fe","title":"操作：查看弹窗内的各元素"},{"parent":"ad210123-b338-4d92-bc45-10e5a8548037","callout":[],"children":[],"id":"9d6d2967-e001-4102-8185-28a6adccaf52","title":"预期：弹窗展示应用图标组、标题、授权范围说明（如可访问的日历、文档、多维表、会话等能力）、可展开的条目说明与主操作按钮；右上角提供关闭按钮"}],"collapsed":true,"id":"ad210123-b338-4d92-bc45-10e5a8548037","title":"🔴【P0】授权弹窗内容完整","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"42451ef3-c7e4-47c8-b959-565e3e9d0d07","callout":[],"children":[{"parent":"327c60bb-27d5-4a67-96e4-9f97d005fe2e","callout":[],"children":[],"id":"f53abadf-19d2-45e7-91bc-c0d18888c979","title":"前置：授权弹窗已打开；角色：房间成员；入口：弹窗内主授权按钮"},{"parent":"327c60bb-27d5-4a67-96e4-9f97d005fe2e","callout":[],"children":[],"id":"fdd50865-dc38-4b35-b0db-d0f7d6133f50","title":"操作：点击授权按钮"},{"parent":"327c60bb-27d5-4a67-96e4-9f97d005fe2e","callout":[],"children":[],"id":"e6a5f4c2-d170-4ade-b5f6-5d32e9614f90","title":"预期：打开该连接器的授权网页链接；网页中展示的是所点击连接器的授权页而非其他连接器；应用内同步进入授权中状态"}],"collapsed":true,"id":"327c60bb-27d5-4a67-96e4-9f97d005fe2e","title":"🔴【P0】点击授权打开网页链接","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"42451ef3-c7e4-47c8-b959-565e3e9d0d07","title":"正常场景（3）"},{"parent":"1fe0d662-618c-4f9f-9a8e-ee8f551ddd4e","callout":[],"children":[{"parent":"36d9c1c1-b50a-43cb-b789-90582db5117f","callout":[],"children":[{"parent":"d80add11-fa35-40f6-a241-6169f833626f","callout":[],"children":[],"id":"e1da0a77-e6b0-47a3-961f-42ab45bdb38c","title":"前置：某连接器已安装未授权且当前网络异常；角色：房间成员；入口：卡片授权按钮"},{"parent":"d80add11-fa35-40f6-a241-6169f833626f","callout":[],"children":[],"id":"c10f06f8-993f-4074-b018-49c1aa9c1f5c","title":"操作：在网络断开时点击授权按钮，恢复网络后重试"},{"parent":"d80add11-fa35-40f6-a241-6169f833626f","callout":[],"children":[],"id":"93da3a7d-03a2-47ee-9a3d-bcbaef3b5cfe","title":"预期：给出无法发起授权的明确提示与重试入口；不弹出空白弹窗；卡片仍保持需要授权状态；恢复网络后重试可正常弹出弹窗"}],"collapsed":true,"id":"d80add11-fa35-40f6-a241-6169f833626f","title":"🟡【P2】授权弹窗打开失败"}],"collapsed":true,"id":"36d9c1c1-b50a-43cb-b789-90582db5117f","title":"异常场景（1）"}],"collapsed":true,"id":"1fe0d662-618c-4f9f-9a8e-ee8f551ddd4e","title":"授权入口与授权弹窗"},{"parent":"70232116-ba28-4f17-bdbe-9816d72005e7","callout":[],"children":[{"parent":"5b475919-f3f6-4607-a097-c4734846e958","callout":[],"children":[{"parent":"2b2f2855-6912-42cd-b578-db9a6380f26b","callout":[],"children":[{"parent":"b8693488-c77d-4f43-ad95-f54a8372a101","callout":[],"children":[],"id":"96c67bb3-568c-499e-932c-58097e626977","title":"前置：已点击授权并打开授权网页；角色：房间成员；入口：Marketplace 卡片"},{"parent":"b8693488-c77d-4f43-ad95-f54a8372a101","callout":[],"children":[],"id":"98c52c9e-6883-4c28-b21d-fda06a25f184","title":"操作：返回应用查看该卡片的按钮状态"},{"parent":"b8693488-c77d-4f43-ad95-f54a8372a101","callout":[],"children":[],"id":"a0a91475-5b6a-40d1-bc42-009db5a34098","title":"预期：授权按钮变为「授权中」且不可点击；按钮旁新增取消按钮；卡片其他信息保持不变"}],"collapsed":true,"id":"b8693488-c77d-4f43-ad95-f54a8372a101","title":"🔴【P0】授权中状态与取消按钮","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"2b2f2855-6912-42cd-b578-db9a6380f26b","callout":[],"children":[{"parent":"13896e15-129b-4ea6-94d7-1ffd4e3301af","callout":[],"children":[],"id":"5effe275-c5df-4015-ae97-993dfc77188e","title":"前置：连接器处于授权中状态；角色：房间成员；入口：授权中状态旁的取消按钮"},{"parent":"13896e15-129b-4ea6-94d7-1ffd4e3301af","callout":[],"children":[],"id":"909c1ac1-ab7f-4d80-90cb-1b7d34ac8e5b","title":"操作：点击取消"},{"parent":"13896e15-129b-4ea6-94d7-1ffd4e3301af","callout":[],"children":[],"id":"492d3b62-e387-4719-93a9-59fc0944e8bb","title":"预期：关闭弹窗并取消本次授权；卡片回到「授权」按钮与「需要授权」文案；连接器未被启用，也不出现在已授权列表"}],"collapsed":true,"id":"13896e15-129b-4ea6-94d7-1ffd4e3301af","title":"🔴【P0】点击取消终止授权","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"2b2f2855-6912-42cd-b578-db9a6380f26b","callout":[],"children":[{"parent":"8bf32e5b-02b9-4827-89fb-1af468cf9391","callout":[],"children":[],"id":"bdea2b0c-4db9-446c-97c1-98f43c5b38c9","title":"前置：连接器处于授权中状态且授权弹窗仍打开；角色：房间成员；入口：弹窗右上角 X"},{"parent":"8bf32e5b-02b9-4827-89fb-1af468cf9391","callout":[],"children":[],"id":"c0bc2ce2-84a0-4464-8700-40bb366d5d4a","title":"操作：点击弹窗右上角的 X"},{"parent":"8bf32e5b-02b9-4827-89fb-1af468cf9391","callout":[],"children":[],"id":"96d141b8-b0bf-4ed9-801b-b01ed8e3f7a3","title":"预期：弹窗关闭并取消本次授权；卡片回到授权按钮状态；再次点击授权可重新发起流程"}],"collapsed":true,"id":"8bf32e5b-02b9-4827-89fb-1af468cf9391","title":"🔴【P0】点击弹窗右上角 X 终止授权","icons":[{"color":"rgb(248, 87, 103)","name":"other","index":"369"}]}],"id":"2b2f2855-6912-42cd-b578-db9a6380f26b","title":"正常场景"},{"parent":"5b475919-f3f6-4607-a097-c4734846e958","callout":[],"children":[{"parent":"7bf42828-fd4c-48fa-8141-ec49e4019f1e","callout":[],"children":[{"parent":"752929dd-3796-4c69-847a-7bb816d4ab44","callout":[],"children":[],"id":"ced36b14-802d-4d7c-887a-73c7e808a36c","title":"前置：已点击授权并打开授权网页；角色：房间成员；入口：浏览器授权页"},{"parent":"752929dd-3796-4c69-847a-7bb816d4ab44","callout":[],"children":[],"id":"afc45f7e-bcd7-448f-ba34-5d96a6a020e6","title":"操作：直接关闭授权网页而不完成登录，回到应用等待若干分钟"},{"parent":"752929dd-3796-4c69-847a-7bb816d4ab44","callout":[],"children":[],"id":"fe09f8b1-fb0c-456b-9fdd-4984a7224873","title":"预期：授权中状态在超时后回到需要授权状态；不长期停留在授权中；卡片可再次发起授权"}],"collapsed":true,"id":"752929dd-3796-4c69-847a-7bb816d4ab44","title":"🟡【P2】外部授权页未完成即关闭","icons":[{"color":"rgb(0, 186, 74)","name"