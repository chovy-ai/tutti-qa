ffd","callout":[],"children":[],"id":"f1b6c6f0-465c-47b4-99a6-2258bbda4bfa","title":"预期：能控制电脑做相关操作"}],"collapsed":true,"id":"451958a1-b3d1-42d1-85ff-585a9981cffd","title":"🔴【P0】输入 /computer use","icons":[]},{"parent":"0f66da71-ba42-4cb9-9a1e-30915d9e8c99","callout":[],"children":[{"parent":"8a3b19ea-1cfb-4c94-88d8-224d776fd3df","callout":[],"children":[],"id":"702457a4-8c6e-45c4-a540-4502bb3ac2cf","title":"操作：在会话输入 /browser 并发送"},{"parent":"8a3b19ea-1cfb-4c94-88d8-224d776fd3df","callout":[],"children":[],"id":"4b9174b2-bf24-4e3f-90cf-fc5d42120889","title":"预期：Agent 唤起浏览器相关能力（如打开/操作浏览器执行任务），对话内有对应的执行反馈；具体触发后的 UI 呈现方式（是否弹出确认、是否显示浏览器画面等）需与产品确认后补充更细的验证点"}],"collapsed":true,"id":"8a3b19ea-1cfb-4c94-88d8-224d776fd3df","title":"🔴【P0】输入 /browser 触发浏览器能力"}],"collapsed":true,"id":"0f66da71-ba42-4cb9-9a1e-30915d9e8c99","title":"正常场景（3）"},{"parent":"72227ed1-e1b3-4938-b754-05d375744867","callout":[],"children":[{"parent":"ad5c5c50-4261-4be0-9702-2f79447df879","callout":[],"children":[{"parent":"52cbd289-5dcc-4075-8339-9764daec5655","callout":[],"children":[],"id":"bfb34c68-b3f5-41dc-b18b-4bbfe0143ed6","title":"前置：前置：共享 Claude 在线；角色：房间成员；入口：会话输入框工具选择与设置入口"},{"parent":"52cbd289-5dcc-4075-8339-9764daec5655","callout":[],"children":[],"id":"a690c5f0-48bb-444d-943c-092c0f132227","title":"操作：尝试选中 browser-use 并打开其设置"},{"parent":"52cbd289-5dcc-4075-8339-9764daec5655","callout":[],"children":[],"id":"ba9d3775-8570-46f5-a485-7a8239365f68","title":"预期：browser-use 可被选中且设置入口可点击；选中后共享 Agent 能使用该工具完成浏览任务；不支持时给出明确说明而非入口不可点击"},{"parent":"52cbd289-5dcc-4075-8339-9764daec5655","callout":[],"children":[],"id":"7c63ed9d-e072-40fe-b725-f03bd85f6b9a","title":"备注：#274 #87"}],"collapsed":true,"id":"52cbd289-5dcc-4075-8339-9764daec5655","title":"🔴【P0】无法选中或配置浏览器工具","icons":[]}],"collapsed":true,"id":"ad5c5c50-4261-4be0-9702-2f79447df879","title":"异常场景（1）"},{"parent":"72227ed1-e1b3-4938-b754-05d375744867","callout":[],"children":[{"parent":"831641ae-98b7-4629-9640-3f8dbc433120","callout":[],"children":[{"