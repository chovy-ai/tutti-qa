2e928c36","callout":[],"children":[{"parent":"4f1ec431-c83a-4faa-9fa0-a1f6cb582fa9","callout":[],"children":[],"id":"835b5899-9775-4ecd-b72c-44efeee29306","title":"前置：Agent 已开启共享"},{"parent":"4f1ec431-c83a-4faa-9fa0-a1f6cb582fa9","callout":[],"children":[],"id":"8592cb5c-3307-4706-bd40-edcc07ce610e","title":"操作：在本地退出该 Agent 的登录，观察共享状态与他人可见性"},{"parent":"4f1ec431-c83a-4faa-9fa0-a1f6cb582fa9","callout":[],"children":[],"id":"2f71e129-d618-4a48-9fea-06de20795d4a","title":"预期：共享自动失效或标记为不可用；其他成员调用时得到明确的不可用提示"}],"collapsed":true,"id":"4f1ec431-c83a-4faa-9fa0-a1f6cb582fa9","title":"🟠【P1】共享开启后掉登录态"}],"collapsed":true,"id":"e0f82645-1e61-4cb0-bb17-625b2e928c36","title":"异常场景（3）"},{"parent":"a70816cd-9f77-4073-ba4b-e34c25ce4045","callout":[],"children":[{"parent":"6a3346a1-8df8-4600-a170-83176f8098fe","callout":[],"children":[{"parent":"c8d73663-695b-420d-84fb-c08045c4bd6b","callout":[],"children":[],"id":"f77cc992-8981-459f-9849-1c66a2bb32f2","title":"前置：该 Agent 已登录且已开启共享"},{"parent":"c8d73663-695b-420d-84fb-c08045c4bd6b","callout":[],"children":[],"id":"3a4378ab-b97f-42d6-a356-efd94be58d6b","title":"操作：从 Set up 弹窗点击 Uninstall managed runtime 卸载后重新安装并登录，查看共享开关状态"},{"parent":"c8d73663-695b-420d-84fb-c08045c4bd6b","callout":[],"children":[],"id":"102b7010-6f1a-4d85-99cf-6c124baeb64f","title":"预期：共享状态按产品规则重置为关闭或恢复为卸载前状态，行为一致且可预期；不出现开关显示开启但其他成员不可见"}],"collapsed":true,"id":"c8d73663-695b-420d-84fb-c08045c4bd6b","title":"🟡【P2】共享开启状态下卸载并重新安装 Agent"},{"parent":"6a3346a1-8df8-4600-a170-83176f8098fe","callout":[],"children":[{"parent":"3944db10-0f2f-4b7e-8383-7ed0b742ed75","callout":[],"children":[],"id":"d1636f1d-b642-48b3-82f1-402d5486bd82","title":"前置：Agent 已登录"},{"parent":"3944db10-0f2f-4b7e-8383-7ed0b742ed75","callout":[],"children":[],"id":"72a61116-5199-4980-abfd-6f766f0ae094","title":"操作：连续快速点击共享开关多次"},{"parent":"3944db10-0f2f-4b7e-8383-7ed0b742ed75","callout":[],"children":[],"id":"6a19da7e-4a4a-4ff4-b217-bfb139195d10","title":"预期：最终状态与最后一次点击一致，不出现界面状态与实际共享状态不符"}],"collapsed"