ildren":[{"parent":"6adb8a40-8331-4d55-93b6-1be1a6d3a34b","callout":[],"children":[],"id":"3d14d8fe-daf2-4c6e-8ea5-9c9d2e2ece20","title":"前置：R1 内任务 T1；角色：A；入口：任务详情页 → 评论"},{"parent":"6adb8a40-8331-4d55-93b6-1be1a6d3a34b","callout":[],"children":[{"parent":"035958aa-feb8-4353-b57c-8b83d183bae2","callout":[],"children":[],"id":"0f0eee7d-01fe-4dff-83b6-46021c4f6fb1","title":"1. 只输入「@B」后发送"}],"collapsed":true,"id":"035958aa-feb8-4353-b57c-8b83d183bae2","title":"操作"},{"parent":"6adb8a40-8331-4d55-93b6-1be1a6d3a34b","callout":[],"children":[{"parent":"f90a0572-6584-4baa-9569-091de03c2dc7","callout":[],"children":[],"id":"7f67a8a9-15d7-441c-8c72-42f11663a616","title":"1) 消息渲染 ｜ 评论能发出去，显示一个高亮的 @B"},{"parent":"f90a0572-6584-4baa-9569-091de03c2dc7","callout":[],"children":[],"id":"0497edee-a5f8-479d-be9c-80e559cefa1a","title":"2) 通知 ｜ B 收到 @ 通知"}],"collapsed":true,"id":"f90a0572-6584-4baa-9569-091de03c2dc7","title":"预期"}],"collapsed":true,"id":"6adb8a40-8331-4d55-93b6-1be1a6d3a34b","title":"🟠【P1】只 @ 成员、没有正文也能发送并通知"},{"parent":"3aace21d-1ec4-4fc0-a6d5-18391550a2ae","callout":[],"children":[{"parent":"896bbbea-7619-4c9c-b315-bf2354fee68f","callout":[],"children":[],"id":"a3ff4780-8981-4b9c-a8c1-8316d4e8dbb5","title":"前置：R1 内任务 T1，A 有一条不带 @ 的评论；角色：A；入口：任务详情页 → 评论"},{"parent":"896bbbea-7619-4c9c-b315-bf2354fee68f","callout":[],"children":[{"parent":"3fc86eb2-386c-44d6-b76e-78317e4232aa","callout":[],"children":[],"id":"50432fc7-2f9d-4d39-bde0-7c1b1ec06ad5","title":"1. 编辑这条评论，加上 @B 后保存"},{"parent":"3fc86eb2-386c-44d6-b76e-78317e4232aa","callout":[],"children":[],"id":"082f577c-f404-48bd-8283-355696656aca","title":"2. 再编辑一次，加上 @A 自己"}],"collapsed":true,"id":"3fc86eb2-386c-44d6-b76e-78317e4232aa","title":"操作"},{"parent":"896bbbea-7619-4c9c-b315-bf2354fee68f","callout":[],"children":[{"parent":"b927baeb-6310-4bcd-b68e-0e17e3cfdfec","callout":[],"children":[],"id":"0c1885dc-5d2c-4caf-b8a1-877663500ada","title":"1) 通知 ｜ B 收到 @ 通知"},{"parent":"b927baeb-6310-4bcd-b68e-0e17e3cfdfec","callout":[],"children":[],"id":"80184990-d0cd-489d-a73f-a50681119d33","title":"2) 通知 ｜ @ 自己不产生通知"}],"collapsed":true,"id":"b927baeb-6310-4bcd-b68e-0e17e3cfdfec","title":"预期"}],"collapsed":true,"id":"896bbbea-7619-4c9c-b315-bf2354fee68f","title":"🟠【P1】编辑评论时新加的 @ 会通知"},{"parent":"3aace21d-1ec4-4fc0-a6d5-18391550a2ae","callout":[],"children":[{"parent":"55ea1a0f-0070-4eb2-a9dd-fe6a95379a3c","callout":[],"children":[],"id":"51872437-a8c1-4d9b-8417-f9abe1f73368","title":"前置：R1 内任务 T1，B 有一条评论；角色：A；入口：B 的评论下回复"},{"parent":"55ea1a0f-0070-4eb2-a9dd-fe6a95379a3c","callout":[],"children":[{"parent":"5aafadc4-3388-4d94-8d2b-ddbc26a8a343","callout":[],"children":[],"id":"14c680ca-c0f4-4474-935b-eb8ce3c566c4","title":"1. 在回复里 @C 后发送"},{"parent":"5aafadc4-3388-4d94-8d2b-ddbc26a8a343","callout":[],"children":[],"id":"0887e305-641e-4ed3-a486-28e69e6b148c","title":"2. 在回复里 @A 自己"},{"parent":"5aafadc4-3388-4d94-8d2b-ddbc26a8a343","callout":[],"children":[],"id":"c536e86e-1b89-4c25-a1c8-8c3ef1fd5253","title":"3. 不带 @ 的普通回复一条"}],"collapsed":true,"id":"5aafadc4-3388-4d94-8d2b-ddbc26a8a343","title":"操作"},{"parent":"55ea1a0f-0070-4eb2-a9dd-fe6a95379a3c","callout":[],"children":[{"parent":"0a088676-0cef-404c-93da-8d4e7fb871c8","callout":[],"children":[],"id":"b188e9f1-ea5c-4b04-aa76-b49bad896dfe","title":"1) 等价性 ｜ C 收到 @ 通知，@ 自己不通知，和评论里的规则一样"},{"parent":"0a088676-0cef-404c-93da-8d4e7fb871c8","callout":[],"children":[],"id":"324b9279-63ff-44df-a8ea-31a691fa8886","title":"2) 通知 ｜ 带 @ 的回复，根评论作者 B 也会收到通知"},{"parent":"0a088676-0cef-404c-93da-8d4e7fb871c8","callout":[],"children":[],"id":"917ba455-6c14-4d14-82fa-785911374564","title":"3) 通知 ｜ 不带 @ 的普通回复谁都不通知，B 也不收到"}],"collapsed":true,"id":"0a088676-0cef-404c-93da-8d4e7fb871c8","title":"预期"},{"parent":"55ea1a0f-0070-4eb2-a9dd-fe6a95379a3c","callout":[],"children":[],"id":"ee03ca3e-917b-4b8e-a841-70bbdd109ca6","title":"备注：已定口径：不带 @ 的普通回复不通知"}],"collapsed":true,"id":"55ea1a0f-0070-4eb2-a9dd-fe6a95379a3c","title":"🟠【P1】在评论的回复里 @，规则和评论一致（抽检）"}],"id":"3aace21d-1ec4-4fc0-a6d5-18391550a2ae","title":"正常场景"},{"parent":"3aa07542-4268-471e-a6a1-7b89982564ad","callout":[],"children":[{"parent":"a184ffa9-0216-4aaa-812b-ae2855d1cee0","callout":[],"children":[{"parent":"8de4d749-2976-49f6-ae54-21756cd8c167","callout":[],"children":[],"id":"1f925732-6560-45be-b825-c3b4b1fcdba1","title":"前置：R1 内任务 T1；角色：A；入口：任务详情页 → 评论"},{"parent":"8de4d749-2976-49f6-ae54-21756cd8c167","callout":[],"children":[{"parent":"56a7bf42-f698-49da-83b5-18de50def95a","callout":[],"children":[],"id":"c5dae896-2323-4ea9-9f88-80596c9522b1","title":"1. 发评论 @B，然后马上编辑去掉 @B"},{"parent":"56a7bf42-f698-49da-83b5-18de50def95a","callout":[],"children":[],"id":"c8cc7c3b-5f96-4374-9b9d-de7d6045d1cb","title":"2. 再发一条评论 @C，然后删除这条评论"}],"collapsed":true,"id":"56a7bf42-f698-49da-83b5-18de50def95a","title":"操作"},{"parent":"8de4d749-2976-49f6-ae54-21756cd8c167","callout":[],"children":[{"parent":"2eecbb2b-805f-4ed8-9bba-de15a6458a33","callout":[],"children":[],"id":"e84b2938-de29-4274-9b0d-ee6e2b411482","title":"1) 通知 ｜ B 的通知中心里没有这条 @ 通知"},{"parent":"2eecbb2b-805f-4ed8-9bba-de15a6458a33","callout":[],"children":[],"id":"af1bfd62-bf23-4bac-9c03-e9fafd03fabb","title":"2) 通知 ｜ C 的通知中心里没有这条 @ 通知"}],"collapsed":true,"id":"2eecbb2b-805f-4ed8-9bba-de15a6458a33","title":"预期"}],"collapsed":true,"id":"8de4d749-2976-49f6-ae54-21756cd8c167","title":"🟡【P2】@ 后编辑删掉 @，或者删除整条评论，被 @ 的人不会有这条通知"}],"collapsed":true,"id":"a184ffa9-0216-4aaa-812b-ae2855d1cee0","title":"边界场景"}],"id":"3aa07542-4268-471e-a6a1-7b89982564ad","title":"评论与回复的 @"},{"parent":"9f12e7ca-62f4-420f-8965-f933b2b0044b","callout":[],"children":[{"parent":"9e786490-660e-4919-8b07-fcfb36e4d7e0","callout":[],"children":[{"parent":"ecb82365-e401-4e8b-a8c2-00c254f00240","callout":[],"children":[{"parent":"b6e743ba-985a-4d3f-aaf8-e220b160ebdd","callout":[],"children":[],"id":"c1f2fa53-80c5-4182-b242-b00fce290bea","title":"前置：R1 内任务 T1 是待办，负责人 B；角色：A（执行发起人）；入口：任务详情页 → 评论"},{"parent":"b6e743ba-985a-4d3f-aaf8-e220b160ebdd","callout":[],"children":[{"parent":"6a355c64-aebe-4fec-8f1e-aae0fecc05cf","callout":[],"children":[],"id":"f8326714-ee41-40de-8b0a-27d0dbb2ebb8","title":"1. A 评论让 Codex 执行，等它完成"}],"collapsed":true,"id":"6a355c64-aebe-4fec-8f1e-aae0fecc05cf","title":"操作"},{"parent":"b6e743ba-985a-4d3f-aaf8-e220b160ebdd","callout":[],"children":[{"parent":"d3cc112a-2742-4147-99ab-c4739f279f5c","callout":[],"children":[],"id":"8c440121-ea35-4553-80c9-c6ce697f375a","title":"1) 通知 ｜ A 收到 Agent 回复通知和「Agent 执行完成」通知，在「重要更新」分组"},{"parent":"d3cc112a-2742-4147-99ab-c4739f279f5c","callout":[],"children":[],"id":"22d53cd4-02a1-4b36-83bb-2aef3e266fbc","title":"2) 通知 ｜ 任务变成验收中后，当前负责人 B 收到待验收通知"}],"collapsed":true,"id":"d3cc112a-2742-4147-99ab-c4739f279f5c","title":"预期"},{"parent":"b6e743ba-985a-4d3f-aaf8-e220b160ebdd","callout":[],"children":[],"id":"f6cc9179-8469-46ae-8239-6c77f8f6cc24","title":"备注：原功能点记录过「没有待验收的通知」，回归时重点看"}],"collapsed":true,"id":"b6e743ba-985a-4d3f-aaf8-e220b160ebdd","title":"🟠【P1】评论调 Agent 执行完成后，通知发起人回复和待验收"},{"parent":"ecb82365-e401-4e8b-a8c2-00c254f00240","callout":[],"children":[{"parent":"13167c3b-c64d-4c83-8352-280b410d2ae9","callout":[],"children":[],"id":"362879cb-2ebd-47d0-9696-a76ed91d26c9","title":"前置：R1 内任务 T1；角色：A；入口：任务详情页 → 评论"},{"parent":"13167c3b-c64d-4c83-8352-280b410d2ae9","callout":[],"children":[{"parent":"38a57f10-ae2c-4c35-b417-ec31e942f3c6","callout":[],"children":[],"id":"ea72411f-e194-412e-87ff-158d843a4f2a","title":"1. A 发评论 @B 和 @Codex，等 Codex 完成"},{"parent":"38a57f10-ae2c-4c35-b417-ec31e942f3c6","callout":[],"children":[],"id":"6a5f6c8a-bbb1-4576-8fdb-df39737c02de","title":"2. A 再发一条 @A 自己 和 @Codex"}],"collapsed":true,"id":"38a57f10-ae2c-4c35-b417-ec31e942f3c6","title":"操作"},{"parent":"13167c3b-c64d-4c83-8352-280b410d2ae9","callout":[],"children":[{"parent":"bc3dbd06-fa85-4a2b-bdcd-509dd685bc8c","callout":[],"children":[],"id":"df19bb83-2227-4a96-891c-969f9399e6b9","title":"1) 通知 ｜ B 收到 @ 通知；A 收到 Agent 回复和执行完成通知"},{"parent":"bc3dbd06-fa85-4a2b-bdcd-509dd685bc8c","callout":[],"children":[],"id":"f2504209-9f6c-4cd8-ba86-312a7cb782cd","title":"2) 通知 ｜ @ 自己那条不给自己发 @ 通知，执行完成通知照常"}],"collapsed":true,"id":"bc3dbd06-fa85-4a2b-bdcd-509dd685bc8c","title":"预期"}],"collapsed":true,"id":"13167c3b-c64d-4c83-8352-280b410d2ae9","title":"🟠【P1】评论里同时 @ 成员和 Agent：两种通知都有"},{"parent":"ecb82365-e401-4e8b-a8c2-00c254f00240","callout":[],"children":[{"parent":"05732c76-05e3-4954-8f2b-7df1aa050a80","callout":[],"children":[],"id":"834535ee-97d8-45a2-892a-3b3ad8bfdfa3","title":"前置：R1 内任务 T1，B 发了一条根评论，A 在这条评论下让 Agent 执行；角色：A、B；入口：B 的评论下回复"},{"parent":"05732c76-05e3-4954-8f2b-7df1aa050a80","callout":[],"children":[{"parent":"b0720ce6-3e89-42d6-aad4-bcb45bfe2d09","callout":[],"children":[],"id":"e6393e61-e4d2-49ed-a800-3e8895b316ad","title":"1. 等 Agent 回复完成"}],"collapsed":true,"id":"b0720ce6-3e89-42d6-aad4-bcb45bfe2d09","title":"操作"},{"parent":"05732c76-05e3-4954-8f2b-7df1aa050a80","callout":[],"children":[{"parent":"b12b3f2b-fb8f-4288-90f6-8c1040cc1472","callout":[],"children":[],"id":"ed939ba7-9c57-4840-b6c0-21fce5ca5688","title":"1) 通知 ｜ 根评论作者 B 收到 Agent 回复通知"},{"parent":"b12b3f2b-fb8f-4288-90f6-8c1040cc1472","callout":[],"children":[],"id":"83bf1057-0a87-498f-b474-43a108fd0e56","title":"2) 通知 ｜ 如果根评论作者就是发起人自己，只收到执行完成通知，不会因为「回复」再多收一条"}],"collapsed":true,"id":"b12b3f2b-fb8f-4288-90f6-8c1040cc1472","title":"预期"}],"collapsed":true,"id":"05732c76-05e3-4954-8f2b-7df1aa050a80","title":"🟠【P1】Agent 回复了根评论，通知根评论的作者"},{"parent":"ecb82365-e401-4e8b-a8c2-00c254f00240","callout":[],"children":[{"parent":"853866f8-7493-41b5-8df3-1f6916a56f2c","callout":[],"children":[],"id":"b9151cea-3aee-4076-903c-a63011704617","title":"前置：R1 内任务 T1；角色：A；入口：任务详情页 → 评论"},{"parent":"853866f8-7493-41b5-8df3-1f6916a56f2c","callout":[],"children":[{"parent":"4d9c8f68-2867-4d2e-85c8-5f0ebb5f2ac2","callout":[],"children":[],"id":"a9c64eaa-8180-46fd-b8dc-de03fc2b2a2c","title":"1. 让 Agent 执行，等它完成"},{"parent":"4d9c8f68-2867-4d2e-85c8-5f0ebb5f2ac2","callout":[],"children":[],"id":"6a2dc4a4-21a0-48df-8736-54d42090faa3","title":"2. 刷新详情页，重新进入看板"}],"collapsed":true,"id":"4d9c8f68-2867-4d2e-85c8-5f0ebb5f2ac2","title":"操作"},{"parent":"853866f8-7493-41b5-8df3-1f6916a56f2c","callout":[],"children":[{"parent":"af73dc5f-a077-4e4c-8d13-d8e5fc750247","callout":[],"children":[],"id":"4073260b-fea9-4299-8f52-2053a6df01af","title":"1) 通知 ｜ A 只收到 1 条「Agent 执行完成」，刷新、重新进入都不会多出来"}],"collapsed":true,"id":"af73dc5f-a077-4e4c-8d13-d8e5fc750247","title":"预期"}],"collapsed":true,"id":"853866f8-7493-41b5-8df3-1f6916a56f2c","title":"🟠【P1】Agent 第一次进入完成状态时通知发起人，只发一次"}],"id":"ecb82365-e401-4e8b-a8c2-00c254f00240","title":"正常场景"},{"parent":"9e786490-660e-4919-8b07-fcfb36e4d7e0","callout":[],"children":[{"parent":"641553b0-600b-4877-9fbf-7471079b6939","callout":[],"children":[{"parent":"6cdcb334-491e-4dad-a3af-27249da64640","callout":[],"children":[],"id":"63111634-ce39-4631-9736-eda1ab0dfeb2","title":"前置：R1 内会执行失败的 Agent；角色：A；入口：用智能体创建 / 任务详情页 → 评论"},{"parent":"6cdcb334-491e-4dad-a3af-27249da64640","callout":[],"children":[{"parent":"a0a7be61-d4c5-4971-bc83-a83bb3b66ed2","callout":[],"children":[],"id":"f8c943f9-0baf-4b79-bf18-b28f4e751b5b","title":"1. 用智能体创建任务 T1，等它失败"},{"parent":"a0a7be61-d4c5-4971-bc83-a83bb3b66ed2","callout":[],"children":[],"id":"0e2cd792-8f93-4efe-bb9f-a33561a25ab7","title":"2. 在任务 T2 里评论让 Agent 执行，等它失败"}],"collapsed":true,"id":"a0a7be61-d4c5-4971-bc83-a83bb3b66ed2","title":"操作"},{"parent":"6cdcb334-491e-4dad-a3af-27249da64640","callout":[],"children":[{"parent":"fdf4cbf6-1424-4ecc-b03e-efa1bd85124a","callout":[],"children":[],"id":"2a4a72d1-c2a0-4961-ae91-b9a2d03c6ce9","title":"1) 通知 ｜ 两次 A 都收到「Agent 执行失败」通知，在「需要处理」分组"},{"parent":"fdf4cbf6-1424-4ecc-b03e-efa1bd85124a","callout":[],"children":[],"id":"c4d7420f-2201-4e48-91d7-dcf1ca897600","title":"2) 通知 ｜ 第一次进入失败状态时才通知，同一次执行不会重复通知"}],"collapsed":true,"id":"fdf4cbf6-1424-4ecc-b03e-efa1bd85124a","title":"预期"},{"parent":"6cdcb334-491e-4dad-a3af-27249da64640","callout":[],"children":[],"id":"9f762006-5f25-431c-9520-3fce96c0b682","title":"备注：已定口径：评论触发的失败也要通知"}],"collapsed":true,"id":"6cdcb334-491e-4dad-a3af-27249da64640","title":"🟡【P2】执行失败通知发起人：新建任务时的失败和评论触发的失败都通知"}],"collapsed":true,"id":"641553b0-600b-4877-9fbf-7471079b6939","title":"异常场景"}],"id":"9e786490-660e-4919-8b07-fcfb36e4d7e0","title":"Agent 回复、完成与失败"},{"parent":"9f12e7ca-62f4-420f-8965-f933b2b0044b","callout":[],"children":[{"parent":"63834f18-1783-419d-9894-98419e07fdd6","callout":[],"children":[{"parent":"751a89a4-baf3-4491-a8bb-8effde6754f4","callout":[],"children":[{"parent":"2a387523-2cc6-4457-9289-f00e8683641e","callout":[],"children":[],"id":"daa1f645-fc90-44e6-be83-5de6a671b72c","title":"前置：R1 内任务 T1 负责人是 B，任务 T2 没有负责人、创建者是 C；角色：A（执行发起人）；入口：任务详情页 → 评论"},{"parent":"2a387523-2cc6-4457-9289-f00e8683641e","callout":[],"children":[{"parent":"e5cbbb61-2bd3-4f47-ae3b-ea2ae9736337","callout":[],"children":[],"id":"07fee867-8c93-4579-ac42-7ad7a5482267","title":"1. A 在 T1、T2 里分别让 Agent 执行，等它们完成"}],"collapsed":true,"id":"e5cbbb61-2bd3-4f47-ae3b-ea2ae9736337","title":"操作"},{"parent":"2a387523-2cc6-4457-9289-f00e8683641e","callout":[],"children":[{"parent":"d4d69bdf-e008-4dc3-9169-ae79783912f3","callout":[],"children":[],"id":"140f7b39-6b44-44b3-b1d3-b87c749c7d06","title":"1) 通知 ｜ T1 变成验收中后 B 收到待验收通知"},{"parent":"d4d69bdf-e008-4dc3-9169-ae79783912f3","callout":[],"children":[],"id":"a1000b60-8e06-4114-84eb-6dd8b8b11812","title":"2) 通知 ｜ T2 没有负责人，所以创建者 C 收到"},{"parent":"d4d69bdf-e008-4dc3-9169-ae79783912f3","callout":[],"children":[],"id":"4de05b44-57d8-43a6-9729-082ad45ec3a5","title":"3) 通知 ｜ 任务在验收中时再评论让 Agent 继续原任务，先变进行中再变回验收中，当前负责人会再收到一次"}],"collapsed":true,"id":"d4d69bdf-e008-4dc3-9169-ae79783912f3","title":"预期"}],"collapsed":true,"id":"2a387523-2cc6-4457-9289-f00e8683641e","title":"🟠【P1】Agent 自动把任务转到验收中：通知当前负责人，没有负责人就通知创建者"},{"parent":"751a89a4-baf3-4491-a8bb-8effde6754f4","callout":[],"children":[{"parent":"8b835bae-529c-454a-94b1-c7027dbcd332","callout":[],"children":[],"id":"c4ff59a1-c50f-49ef-9c8e-c7d97f5521f8","title":"前置：R1 内任务 T1 负责人是 B，T2 没有负责人、创建者是 C；角色：A；入口：看板 / 任务详情页"},{"parent":"8b835bae-529c-454a-94b1-c7027dbcd332","callout":[],"children":[{"parent":"efb66dee-9346-4920-8a28-e239d10e07f9","callout":[],"children":[],"id":"f19e4997-e013-4d60-a241-034ef572b565","title":"1. A 把 T1、T2 都手动改成验收中"}],"collapsed":true,"id":"efb66dee-9346-4920-8a28-e239d10e07f9","title":"操作"},{"parent":"8b835bae-529c-454a-94b1-c7027dbcd332","callout":[],"children":[{"parent":"a1cf9b13-1b52-4c63-88ab-4d11dc430eac","callout":[],"children":[],"id":"096677ec-11ac-4bc7-8d03-ee63f230ad93","title":"1) 通知 ｜ B 收到 T1 的待验收通知，C 收到 T2 的"},{"parent":"a1cf9b13-1b52-4c63-88ab-4d11dc430eac","callout":[],"children":[],"id":"c8024fde-a1eb-4815-ae6a-6c35058e3a5c","title":"2) 通知 ｜ 如果负责人就是操作人自己，不收到通知"}],"collapsed":true,"id":"a1cf9b13-1b52-4c63-88ab-4d11dc430eac","title":"预期"}],"collapsed":true,"id":"8b835bae-529c-454a-94b1-c7027dbcd332","title":"🟠【P1】手动改成验收中：通知当前负责人，没有负责人就通知创建者"}],"collapsed":true,"id":"751a89a4-baf3-4491-a8bb-8effde6754f4","title":"正常场景"}],"collapsed":true,"id":"63834f18-1783-419d-9894-98419e07fdd6","title":"任务待验收通知"}],"id":"9f12e7ca-62f4-420f-8965-f933b2b0044b","title":"通知类型与触发"},{"parent":"6e359861-b78b-4e5a-b6e1-d4ac6780c31d","callout":[],"children":[{"parent":"a4a1c266-7add-45a3-912c-7efb42e8c75e","callout":[],"children":[{"parent":"b1714cba-397e-4f46-9361-342da2f97ea7","callout":[],"children":[{"parent":"9acbf636-c6c0-4974-ba93-a6d895f59372","callout":[],"children":[],"id":"c5c711e1-dad8-4574-b585-799755570831","title":"前置：A 在 R1、R2 里已经收到：1 条任务分配、1 条 Agent 执行失败、1 条 @、1 条 Agent 完成、1 条 Agent 共享通知、1 条 Session 里的 Agent 完成通知，都是未读；角色：A；入口：左侧一级菜单「通知」"},{"parent":"9acbf636-c6c0-4974-ba93-a6d895f59372","callout":[],"children":[{"parent":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","callout":[],"children":[],"id":"cb871929-b326-4b48-9b3b-97943343eb35","title":"1. 打开通知面板"},{"parent":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","callout":[],"children":[],"id":"9aa635f1-c90d-4262-aecb-f1db408d92c7","title":"2. 选「按优先级」查看"},{"parent":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","callout":[],"children":[],"id":"4438efec-126c-4ddd-afea-f4c30d2ee82e","title":"3. 切到「按房间」"},{"parent":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","callout":[],"children":[],"id":"e9ca5660-c2e8-47a2-8255-c62d9c1e91b9","title":"4. 筛选依次选 未读 / 待处理 / Task"},{"parent":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","callout":[],"children":[],"id":"da65562f-ad7e-4a03-acf8-6784b7aaf0b1","title":"5. 点 @ 通知"},{"parent":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","callout":[],"children":[],"id":"fbc78583-8bef-4c8f-967c-b1934a038393","title":"6. 点 Session 类通知"},{"parent":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","callout":[],"children":[],"id":"6b6d8b76-0199-45f3-bb2c-e43711a98352","title":"7. 把一条通知标记为已读"},{"parent":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","callout":[],"children":[],"id":"7851e042-82f7-4daf-a569-7e1df9f921cf","title":"8. 点「全部已读」"}],"collapsed":true,"id":"8e6e3003-86ab-49d1-8658-1525ce3c67b4","title":"操作"},{"parent":"9acbf636-c6c0-4974-ba93-a6d895f59372","callout":[],"children":[{"parent":"e16d5809-fb99-498f-a25a-52bfea3e40ba","callout":[],"children":[],"id":"067d58e4-a53d-4ee5-a686-99042ada5830","title":"1) 未读标识 ｜ 菜单上「通知」的未读数是 6，面板标题旁也是 6"},{"parent":"e16d5809-fb99-498f-a25a-52bfea3e40ba","callout":[],"children":[],"id":"51495a3a-5089-4de9-a044-df69f952a3c5","title":"2) 列表展示 ｜ 按优先级：任务分配和执行失败在「需要处理」，@ 和 Agent 完成在「重要更新」，共享通知在「其他更新」，每组标题旁有数量"},{"parent":"e16d5809-fb99-498f-a25a-52bfea3e40ba","callout":[],"children":[],"id":"db52dc3f-ed6e-4ba5-86bf-8fd18e7c54ab","title":"3) 列表展示 ｜ 按房间：按 R1、R2 分组，每条都显示房间名"},{"parent":"e16d5809-fb99-498f-a25a-52bfea3e40ba","callout":[],"children":[],"id":"e3a15cbc-93e8-4428-88dc-6507d92a5e7d","title":"4) 搜索筛选 ｜ 「未读」只显示未读的；「待处理」只显示需要处理的；「Task」只显示任务相关的，不含 Session 和共享通知"},{"parent":"e16d5809-fb99-498f-a25a-52bfea3e40ba","callout":[],"children":[],"id":"d2bd002e-cace-427e-9de4-4c44fd487bd2","title":"5) 跳转定位 ｜ 点 @ 通知后打开对应任务的详情，并滚动到被 @ 的那条评论，高亮显示"},{"parent":"e16d5809-fb99-498f-a25a-52bfea3e40ba","callout":[],"children":[],"id":"046566c0-28f1-46f3-a789-27a70c433ad9","title":"6) 跳转定位 ｜ 点 Session 类通知跳到对应的 Session"},{"parent":"e16d5809-fb99-498f-a25a-52bfea3e40ba","callout":[],"children":[],"id":"080b27d1-5355-49fd-a8bd-c997e9434119","title":"7) 未读标识 ｜ 单条标为已读后，蓝点消失，未读数 -1"},{"parent":"e16d5809-fb99-498f-a25a-52bfea3e40ba","callout":[],"children":[],"id":"054789f3-d1fb-41da-b9fe-d99e5e3b099f","title":"8) 未读标识 ｜ 全部已读后所有蓝点都消失，未读数清零"}],"collapsed":true,"id":"e16d5809-fb99-498f-a25a-52bfea3e40ba","title":"预期"}],"collapsed":true,"id":"9acbf636-c6c0-4974-ba93-a6d895f59372","title":"🔴【P0】分组、筛选、已读与跳转的完整链路"}],"collapsed":true,"id":"b1714cba-397e-4f46-9361-342da2f97ea7","title":"正常场景"},{"parent":"a4a1c266-7add-45a3-912c-7efb42e8c75e","callout":[],"children":[{"parent":"84960afa-026b-4991-bb7a-6196b1adc1cd","callout":[],"children":[{"parent":"d16f9388-11db-4f56-86c9-9c1040def94b","callout":[],"children":[],"id":"3a74446e-f396-4f93-b654-51531cc953d1","title":"前置：新账号 D 没有任何通知；角色：D；入口：左侧一级菜单「通知」"},{"parent":"d16f9388-11db-4f56-86c9-9c1040def94b","callout":[],"children":[{"parent":"cb8d36f0-57ed-4cc5-9304-584048d1d7a8","callout":[],"children":[],"id":"78c99d29-a936-450c-aa81-b414e7963e3b","title":"1. 打开通知面板，切换各个分组和筛选"}],"collapsed":true,"id":"cb8d36f0-57ed-4cc5-9304-584048d1d7a8","title":"操作"},{"parent":"d16f9388-11db-4f56-86c9-9c1040def94b","callout":[],"children":[{"parent":"b987e39e-efea-4c17-bf78-447121b08636","callout":[],"children":[],"id":"d741380b-46b6-43de-9201-181691b14f21","title":"1) 列表展示 ｜ 显示空态，没有报错；菜单上没有未读数"}],"collapsed":true,"id":"b987e39e-efea-4c17-bf78-447121b08636","title":"预期"}],"collapsed":true,"id":"d16f9388-11db-4f56-86c9-9c1040def94b","title":"🟡【P2】没有通知时的空态"}],"collapsed":true,"id":"84960afa-026b-4991-bb7a-6196b1adc1cd","title":"边界场景"}],"collapsed":true,"id":"a4a1c266-7add-45a3-912c-7efb42e8c75e","title":"分组、筛选与已读"}],"collapsed":true,"id":"6e359861-b78b-4e5a-b6e1-d4ac6780c31d","title":"通知中心"},{"parent":"a91cde12-392a-4704-8cc7-3c0a85487812","callout":[],"childr