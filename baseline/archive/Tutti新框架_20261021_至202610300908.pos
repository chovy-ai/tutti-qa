91b7-866157b5315b","title":"预期：最终配置一致，未修改项不丢失"}],"collapsed":true,"id":"ad0c09cf-5fe6-440b-903a-88e2a6534191","title":"🟡【P2】并发写配置冲突"},{"parent":"1b67ee30-8e2b-4849-98b9-f3051df8d57b","callout":[],"children":[{"parent":"0d08dc48-617b-423a-b759-e53bcadc85d7","callout":[],"children":[],"id":"ef15c2b2-5b96-455e-82b9-88d2972f1114","title":"操作：本地配置文件损坏后启动应用"},{"parent":"0d08dc48-617b-423a-b759-e53bcadc85d7","callout":[],"children":[],"id":"4efda3e6-ab8b-4b12-8f3c-85d1b12e47e4","title":"预期：安全回退默认配置并提示，不导致白屏"}],"collapsed":true,"id":"0d08dc48-617b-423a-b759-e53bcadc85d7","title":"🟡【P2】配置文件损坏"}],"collapsed":true,"id":"1b67ee30-8e2b-4849-98b9-f3051df8d57b","title":"异常场景（4）"},{"parent":"28bd7b88-8386-4b3e-8d5a-9e2fa439fcea","callout":[],"children":[{"parent":"f011e933-82e8-4936-b8b5-92ae1e0a3f25","callout":[],"children":[{"parent":"5cc4ba58-2f6f-4718-8756-5329760c1868","callout":[],"children":[],"id":"be248f78-ff25-4153-84d0-47991129a958","title":"操作：配置中存在不同系统格式路径"},{"parent":"5cc4ba58-2f6f-4718-8756-5329760c1868","callout":[],"children":[],"id":"9a8a077b-4e27-4189-8b7a-fc909c66596c","title":"预期：当前系统无法使用时提示，不崩溃"}],"collapsed":true,"id":"5cc4ba58-2f6f-4718-8756-5329760c1868","title":"🟡【P2】跨系统路径配置"},{"parent":"f011e933-82e8-4936-b8b5-92ae1e0a3f25","callout":[],"children":[{"parent":"2b49a81a-59a8-42bb-9c81-e58270be6d8b","callout":[],"children":[],"id":"544672cc-04b7-4d4c-8398-7f8cef966685","title":"操作：安装 20+ 个 Plugin/MCP/Skill 后启动 Nextop"},{"parent":"2b49a81a-59a8-42bb-9c81-e58270be6d8b","callout":[],"children":[],"id":"689533bf-f717-41e4-afaa-a03a176ee0b9","title":"预期：全部正确同步；管理面板列表可滚动显示；同步时间在合理范围内（不长时间卡顿）"}],"collapsed":true,"id":"2b49a81a-59a8-42bb-9c81-e58270be6d8b","title":"🟡【P2】本地配置包含大量 Plugin/MCP/Skill（30 个以上）"},{"parent":"f011e933-82e8-4936-b8b5-92ae1e0a3f25","callout":[],"children":[{"parent":"a80f942d-7d54-4642-b747-97d89638087c","callout":[],"children":[],"id":"37e837f5-9276-43ed-959b-f9eb65f2741f","title":"操作：断网后修改本地配置"},{"parent":"a80f942d-7d54-4642-b747-97d89638087c","callout":[],"children":[],"id":"8066ac0b-2b7d-4405-a2b8-db1ebb8d6d26","title":"预期：本地配置可保存，需要远程校验的项给出提示"}],"collapsed":true,"id":"a80f942d-7d54-4642-b747-97d89638087c","title":"🟡【P2】离线配置使用"},{"parent":"f011e933-82e8-4936-b8b5-92ae1e0a3f25","callout":[],"children":[{"parent":"251ea180-d4ce-44a4-bd5b-ba9d08937ca9","callout":[],"children":[],"id":"bdee1cae-bde1-4f23-8109-5ca2740892c8","title":"操作：项目历史过多导致配置文件较大"},{"parent":"251ea180-d4ce-44a4-bd5b-ba9d08937ca9","callout":[],"children":[],"id":"5441a5d1-073e-4ee8-bee4-918c1675850a","title":"预期：读取和写入性能可接受，菜单不卡顿"}],"collapsed":true,"id":"251ea180-d4ce-44a4-bd5b-ba9d08937ca9","title":"🟡【P2】配置内容超大"},{"parent":"f011e933-82e8-4936-b8b5-92ae1e0a3f25","callout":[],"children":[{"parent":"b96aa281-b672-47a9-865d-74f85ae879c1","callout":[],"children":[],"id":"1fffc0d2-ac45-4175-bca7-3209370f294f","title":"操作：快速切换模型、权限和项目 20 次"},{"parent":"b96aa281-b672-47a9-865d-74f85ae879c1","callout":[],"children":[],"id":"93bbd8d8-a1f4-4873-83d5-70c1b2119586","title":"预期：最终状态为最后一次成功选择，配置文件未损坏"}],"collapsed":true,"id":"b96aa281-b672-47a9-865d-74f85ae879c1","title":"🟡【P2】频繁切换配置"}],"collapsed":true,"id":"f011e933-82e8-4936-b8b5-92ae1e0a3f25","title":"边界场景（5）"}],"collapsed":true,"id":"28bd7b88-8386-4b3e-8d5a-9e2fa439fcea","title":"Plugin/MCP/Skill 本地同步"}],"collapsed":true,"id":"ed4a4ac8-ba7d-4b17-a303-00e254c7e36c","title":"本地配置同步"}],"collapsed":true,"id":"c6be3184-5ec6-49d8-bb13-783f18607fb6","title":"扩展生态与本地同步"},{"parent":"2c72769a-edab-4380-9807-95c83d5881ee","callout":[],"children":[{"parent":"b16ea64e-6c6a-4d65-95b0-ece0710dbe2a","callout":[],"children":[{"parent":"9ef78e76-81c0-4d50-adda-acde9fa7588b","callout":[],"children":[{"parent":"786228e8-414d-412f-894e-fc60004453db","callout":[],"children":[{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"6461267b-7158-47c1-baef-c03e150fd04d","callout":[],"children":[],"id":"ab6c2e9f-e227-4605-aaa1-be3720a35719","title":"操作：在 {SourceAgent} 的会话（进行中/等待中/已完成/失败任一状态）下点击 Handoff"},{"parent":"6461267b-7158-47c1-baef-c03e150fd04d","callout":[],"children":[],"id":"26c8b708-c4ce-4779-abee-cef64ef4a08b","title":"预期：菜单展示除 {SourceAgent} 本身外的其他可用 Agent（如 Claude Code/Codex/Tutti），包括我的和共享agent，标识可用和不可用状态。需对每个 SourceAgent 分别验证一次"}],"collapsed":true,"id":"6461267b-7158-47c1-baef-c03e150fd04d","title":"🔴【P0】Handoff菜单展示其他可用Agent"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"63193299-170a-4649-b666-eed6b1d644bc","callout":[],"children":[],"id":"f7486f79-580e-44b3-b4ac-992c712481dd","title":"操作：在 {SourceAgent} 的会话下点击 Handoff，选择 {TargetAgent}；分别对进行中/等待中/已完成/失败四种会话状态执行本操作"},{"parent":"63193299-170a-4649-b666-eed6b1d644bc","callout":[],"children":[],"id":"526b4394-0664-4640-836f-4c0c06d8f7db","title":"预期：跳转至该 Agent 的新建会话窗口，选中 {TargetAgent} 分类，新建会话窗口里填充显示「{SourceAgent} + 原会话标题」，项目与原会话一致，权限/模型/推理强度/速度显示 {TargetAgent} 上一次的会话配置，发送后 {TargetAgent} 能识别该会话内容并正确回复"}],"collapsed":true,"id":"63193299-170a-4649-b666-eed6b1d644bc","title":"🔴【P0】交接执行与结果同步"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"68aad651-0555-4296-ae4f-4834d142061c","callout":[],"children":[],"id":"d20801ce-f128-4015-9d76-859b2ca701b6","title":"操作：在 {AgentA} 下新建会话，handoff 给 {AgentB}，{AgentB} 处理完后再 handoff 给 {AgentC}，{AgentC} 处理完后再 handoff 给 {AgentD}"},{"parent":"68aad651-0555-4296-ae4f-4834d142061c","callout":[],"children":[],"id":"a9dda123-c4b9-460d-a7db-fa1191dce246","title":"预期：各 Agent 能基于会话历史上下文继续回复，历史记录追加保存"}],"collapsed":true,"id":"68aad651-0555-4296-ae4f-4834d142061c","title":"🔴【P0】多次Handoff（链式交接）"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"2251605c-149f-44af-a442-b9787568a97a","callout":[],"children":[],"id":"62c20112-3e6c-4321-b27e-088e69f69623","title":"前置：前置：共享 Agent 会话已报错；角色：房间成员；入口：会话中的 Handoff 按钮"},{"parent":"2251605c-149f-44af-a442-b9787568a97a","callout":[],"children":[],"id":"0b444c03-8066-4955-ac68-b3db38c8a29f","title":"操作：在报错状态下查看并点击 Handoff"},{"parent":"2251605c-149f-44af-a442-b9787568a97a","callout":[],"children":[],"id":"7d73ac4d-8469-4c6b-9a0c-2a597c5058a0","title":"预期：Handoff 按钮在报错状态下高亮可点击；菜单中同时包含自己的 Agent 与房间内其他可用 Agent；选择后会话可被接管并继续"},{"parent":"2251605c-149f-44af-a442-b9787568a97a","callout":[],"children":[],"id":"ff36a759-2dcf-4a10-a5ba-dd271b133079","title":"备注：#173"}],"collapsed":true,"id":"2251605c-149f-44af-a442-b9787568a97a","title":"🔴【P0】错误态下 Handoff 入口可用"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"0586480e-36e3-4062-a04b-1e712cd64b5d","callout":[],"children":[],"id":"df385184-6e17-4050-895c-8283c310844e","title":"操作：鼠标悬浮Handoff"},{"parent":"0586480e-36e3-4062-a04b-1e712cd64b5d","callout":[],"children":[],"id":"690b2ca2-7089-48dd-a13b-1d15cd737a05","title":"预期：显示交接给其他Agent"}],"collapsed":true,"id":"0586480e-36e3-4062-a04b-1e712cd64b5d","title":"🔴【P0】鼠标悬浮Handoff"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"0b529177-bfd4-4c58-8e61-fe36fc86468b","callout":[],"children":[],"id":"9a779720-97ca-4ce5-bc10-7123e8ee0539","title":"前置：前置：成员 A 已开启共享且已打开 Tutti；角色：房间成员；入口：会话 Handoff 菜单"},{"parent":"0b529177-bfd4-4c58-8e61-fe36fc86468b","callout":[],"children":[],"id":"c95f322e-1bf1-48cb-a0cb-ae3501131495","title":"操作：选择该共享 Agent 完成交接后继续发送一条消息"},{"parent":"0b529177-bfd4-4c58-8e61-fe36fc86468b","callout":[],"children":[],"id":"885ba13d-fee3-4295-91a8-c1c8686b91be","title":"预期：该共享 Agent 显示为可用可选择；交接成功后会话由该共享 Agent 接管并显示所属成员名称；继续发送的消息能收到回复，历史上下文可被读取"}],"collapsed":true,"id":"0b529177-bfd4-4c58-8e61-fe36fc86468b","title":"🟠【P1】共享 Agent 所属成员在线时可选并可交接"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"d64a118d-3dec-4a61-98a0-b5764f0ba5c9","callout":[],"children":[],"id":"ea8c5a19-f8d5-4a1e-9994-4e8c3a19898f","title":"前置：前置：成员 A 已开启共享但未打开 Tutti；角色：房间成员；入口：任一会话的 Handoff 菜单"},{"parent":"d64a118d-3dec-4a61-98a0-b5764f0ba5c9","callout":[],"children":[],"id":"57903745-6256-4318-80b8-a102a4d151c1","title":"操作：查看该共享 Agent 状态"},{"parent":"d64a118d-3dec-4a61-98a0-b5764f0ba5c9","callout":[],"children":[],"id":"4ac8e598-930e-4f4f-9009-a7a3d9167c5d","title":"预期：该共享 Agent 显示为不可用并置灰不可选择；自己 Agent 的会话与其他成员 Agent 的会话两个入口下状态一致"}],"collapsed":true,"id":"d64a118d-3dec-4a61-98a0-b5764f0ba5c9","title":"🟠【P1】共享 Agent 所属成员离线时不可选"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"5bb9af29-c143-4ae2-ac73-e41f3d77b345","callout":[],"children":[],"id":"de6dfa1c-d181-47f4-8e20-acc68f433e1c","title":"前置：前置：本地未安装 Claude Code；角色：房间成员；入口：其他成员共享 Agent 的会话中点击 Handoff"},{"parent":"5bb9af29-c143-4ae2-ac73-e41f3d77b345","callout":[],"children":[],"id":"9fe2dc33-1123-4fea-a857-399df0e9d452","title":"操作：查看菜单中自己 Claude Code 的状态"},{"parent":"5bb9af29-c143-4ae2-ac73-e41f3d77b345","callout":[],"children":[],"id":"635db5b2-2411-454a-9d4c-03116850c933","title":"预期：自己的 Claude Code 显示为不可用并置灰不可选择；两个入口下的状态展示一致，不出现一处可选一处不可选"}],"collapsed":true,"id":"5bb9af29-c143-4ae2-ac73-e41f3d77b345","title":"🟠【P1】成员会话中我的未安装 Agent 同样不可选"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"ebacf956-ea1c-49df-9536-d64433dafe84","callout":[],"children":[],"id":"96390c69-cc29-4720-9a98-37e49bfcdf50","title":"前置：前置：本地 Codex 已安装且已登录；角色：Agent 所有者；入口：自己 Agent 的会话中点击 Handoff"},{"parent":"ebacf956-ea1c-49df-9536-d64433dafe84","callout":[],"children":[],"id":"662ff73d-1226-4072-96cf-b75ccbd93a03","title":"操作：查看菜单并选择该 Agent 完成交接"},{"parent":"ebacf956-ea1c-49df-9536-d64433dafe84","callout":[],"children":[],"id":"504f3e48-abcf-44b4-a38b-206145a3e718","title":"预期：该 Agent 显示为可用状态可选择；交接后会话归属变更为目标 Agent，输入框上方 Agent 名称同步更新，历史上下文完整保留"}],"collapsed":true,"id":"ebacf956-ea1c-49df-9536-d64433dafe84","title":"🟠【P1】我的 Agent 已安装已登录时可选"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"61fc0792-d504-4c4f-ae30-9f458a69e2b3","callout":[],"children":[],"id":"ed8ccb0d-7697-4527-b4e9-4d3d165cb22c","title":"前置：前置：本地未安装 Claude Code；角色：Agent 所有者；入口：自己 Agent 的会话中点击 Handoff 按钮"},{"parent":"61fc0792-d504-4c4f-ae30-9f458a69e2b3","callout":[],"children":[],"id":"db80d90a-581d-4147-83b4-34f757b93017","title":"操作：查看菜单中该 Agent 的状态"},{"parent":"61fc0792-d504-4c4f-ae30-9f458a69e2b3","callout":[],"children":[],"id":"eb27728e-8465-41df-9f84-ac705b7eefc3","title":"预期：该 Agent 在 Handoff 菜单中显示为不可用并置灰；点击无法选中，不发起交接请求；菜单中其他已安装 Agent 仍可正常选择"}],"collapsed":true,"id":"61fc0792-d504-4c4f-ae30-9f458a69e2b3","title":"🟠【P1】我的 Agent 未安装时在 Handoff 菜单中不可选"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"72335e66-e05a-46fd-a5cc-2e6d30880e93","callout":[],"children":[],"id":"524d21f2-3d65-491e-a07b-6cf5240cedda","title":"前置：前置：本地已安装 Codex 但未登录；角色：Agent 所有者；入口：自己 Agent 的会话中点击 Handoff"},{"parent":"72335e66-e05a-46fd-a5cc-2e6d30880e93","callout":[],"children":[],"id":"a29624cc-9cf3-43ec-b0e1-44cf5fae09db","title":"操作：查看菜单中该 Agent 状态"},{"parent":"72335e66-e05a-46fd-a5cc-2e6d30880e93","callout":[],"children":[],"id":"d5108fdc-c725-46ca-95fa-e56d5e022044","title":"预期：该 Agent 显示为不可用并置灰不可选择；登录后重新打开菜单该 Agent 恢复可选"}],"collapsed":true,"id":"72335e66-e05a-46fd-a5cc-2e6d30880e93","title":"🟠【P1】我的 Agent 未登录时不可选"},{"parent":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","callout":[],"children":[{"parent":"d7839be0-50e0-470c-8ded-10449607cf3b","callout":[],"children":[],"id":"01c587df-2ab2-452a-a5ff-6fb72f5d3b94","title":"前置：前置：房间内 Claude Code、Codex、Tutti Agent 均可用；角色：房间成员；入口：会话 Handoff 菜单"},{"parent":"d7839be0-50e0-470c-8ded-10449607cf3b","callout":[],"children":[],"id":"c183dacb-1d87-4179-893f-4faca8f74a1f","title":"操作：按矩阵逐格执行所有 SourceAgent→TargetAgent 组合（不含自己交接给自己），每个组合分别在会话未开始、运行中、已完成、失败四种状态下各执行一次"},{"parent":"d7839be0-50e0-470c-8ded-10449607cf3b","callout":[],"children":[],"id":"be05e7bd-735e-4c5b-ade8-ff0aa1a39aec","title":"预期：每个组合交接后，目标 Agent 名称与实际选择的 Agent 一致，不出现预期文案残留其他 Agent 名称；会话历史与附件完整继承；运行中交接时源任务先收敛再由目标 Agent 接管，不出现双方同时输出"}],"collapsed":true,"id":"d7839be0-50e0-470c-8ded-10449607cf3b","title":"🟠【P1】跨 Agent 两两交接矩阵执行"}],"collapsed":true,"id":"78f4f08f-2e2a-46fe-8e68-1f975ac68a57","title":"正常场景（12）"},{"parent":"786228e8-414d-412f-894e-fc60004453db","callout":[],"children":[{"parent":"12b4aa73-cd60-4a0e-ac87-8b9ead4b805f","callout":[],"children":[{"parent":"560fd23a-db2f-4a05-b07b-9750b60dbe3b","callout":[],"children":[],"id":"8170f1e4-a1b1-4a5e-adac-0261e39ea75c","title":"操作：在 {SourceAgent} 下新建会话，handoff 给 {TargetAgent}，不发送，删除该会话，再在 {TargetAgent} 下发送该会话"},{"parent":"560fd23a-db2f-4a05-b07b-9750b60dbe3b","callout":[],"children":[],"id":"1acd6685-cc19-43f2-9d8e-430762bf8fe6","title":"预期：可正常发送，但在 {TargetAgent} 详情点击该会话会打开一个新窗口，并显示该会话不可用"}],"collapsed":true,"id":"560fd23a-db2f-4a05-b07b-9750b60dbe3b","title":"🟠【P1】Handoff后删除会话"}],"collapsed":true,"id":"12b4aa73-cd60-4a0e-ac87-8b9ead4b805f","title":"异常场景（1）"},{"parent":"786228e8-414d-412f-894e-fc60004453db","callout":[],"children":[{"parent":"3ad450e5-1c7d-4e2a-b355-4f2defde9a2a","callout":[],"children":[{"parent":"4ca4ce3e-01fe-46a7-8469-a235400a49a7","callout":[],"children":[],"id":"330de389-eabc-460b-93ca-b20f538b2b32","title":"前置：目标设备处于离线状态"},{"parent":"4ca4ce3e-01fe-46a7-8469-a235400a49a7","callout":[],"children":[],"id":"269765a3-30e3-4c38-8754-c76e9e008be6","title":"操作：发起会话交接到该设备"},{"parent":"4ca4ce3e-01fe-46a7-8469-a235400a49a7","callout":[],"children":[],"id":"d4ea7d9e-0fbe-4f2d-ba83-bce2bd4dd8b1","title":"预期：明确提示目标不可用并可重新选择，不产生无法恢复的中间态"}],"collapsed":true,"id":"4ca4ce3e-01fe-46a7-8469-a235400a49a7","title":"🟡【P2】交接给已离线的目标设备"}],"collapsed":true,"id":"3ad450e5-1c7d-4e2a-b355-4f2defde9a2a","title":"边界场景（1）"}],"collapsed":true,"id":"786228e8-414d-412f-894e-fc60004453db","title":"会话交接"}],"collapsed":true,"id":"9ef78e76-81c0-4d50-adda-acde9fa7588b","title":"会话交接（Handoff）"},{"parent":"b16ea64e-6c6a-4d65-95b0-ece0710dbe2a","callout":[],"children":[{"parent":"0998b2e0-a1aa-4caf-b9b7-16d1e5492101","callout":[],"children":[{"parent":"e66a3b52-473b-4e8a-91f0-b6cb8617a4d4","callout":[],"children":[{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"002e20c3-3a9d-407f-851d-9663c3517ae3","callout":[],"children":[],"id":"dd104937-4130-4146-b1bd-2367d0dff21a","title":"前置：前置：任务 B 最后一条消息已完成；角色：房间成员；入口：最后一条消息上的 Fork 操作"},{"parent":"002e20c3-3a9d-407f-851d-9663c3517ae3","callout":[],"children":[],"id":"a5d12262-e538-4b1a-9574-cb7a5a4ae99b","title":"操作：在末尾消息处 Fork 并逐项核对上下文"},{"parent":"002e20c3-3a9d-407f-851d-9663c3517ae3","callout":[],"children":[],"id":"ff6fbe3e-0a6f-4db2-adae-a731a6d35dd1","title":"预期：分支继承源任务全部消息与上下文；在分支中提问引用早期内容时 Agent 能正确回答；源任务不受影响"}],"collapsed":true,"id":"002e20c3-3a9d-407f-851d-9663c3517ae3","title":"🟠【P1】从任务末尾 Fork"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"c6d86899-598c-429e-bd18-ff781e600319","callout":[],"children":[],"id":"10c637c4-3088-4523-9273-470d01feda45","title":"前置：前置：任务 B 至少有 5 轮对话；角色：房间成员；入口：第 3 轮消息上的 Fork 操作"},{"parent":"c6d86899-598c-429e-bd18-ff781e600319","callout":[],"children":[],"id":"abb74dab-1b7e-41bb-8e3d-4eb2431bf6a1","title":"操作：选择第 3 轮消息作为 Fork 点创建分支，逐条对比源任务与分支的消息序列"},{"parent":"c6d86899-598c-429e-bd18-ff781e600319","callout":[],"children":[],"id":"ef62467b-b6d9-4d3c-8754-bfe189291404","title":"预期：分支只包含第 1 至第 3 轮消息且顺序与源任务一致；第 4 轮及以后的消息不出现在分支中；源任务的 5 轮消息保持完整"}],"collapsed":true,"id":"c6d86899-598c-429e-bd18-ff781e600319","title":"🟠【P1】从多轮对话中间节点 Fork"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"b8a38b21-e55f-46ca-a328-dd7ec00cc99a","callout":[],"children":[],"id":"9bb0dfcb-f296-4952-937d-c0b7082cd8ef","title":"前置：前置：任务 A 中存在已完成的普通文本消息；角色：房间成员；入口：目标消息上的 Fork 操作"},{"parent":"b8a38b21-e55f-46ca-a328-dd7ec00cc99a","callout":[],"children":[],"id":"8e99be80-847f-4415-9769-1761ae435266","title":"操作：打开任务 A，在该消息上执行 Fork，等待新任务打开或出现在任务列表"},{"parent":"b8a38b21-e55f-46ca-a328-dd7ec00cc99a","callout":[],"children":[],"id":"68f5aaf4-d49f-4046-8de4-fdbc76dc1070","title":"预期：创建出新分支任务并自动打开或出现在任务列表中；分支包含 Fork 点及之前的全部消息，不包含其后的消息；源任务内容不发生变化"}],"collapsed":true,"id":"b8a38b21-e55f-46ca-a328-dd7ec00cc99a","title":"🟠【P1】从普通文本消息 Fork"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"1a69fcdc-9ae8-4747-ab80-ee696b01af65","callout":[],"children":[],"id":"2278be34-fd26-4087-aa94-520a4cb375c7","title":"前置：前置：已创建分支；角色：房间成员；入口：任务列表与分支详情"},{"parent":"1a69fcdc-9ae8-4747-ab80-ee696b01af65","callout":[],"children":[],"id":"06b2e59f-d27a-437e-8050-6760949f83e9","title":"操作：Fork 后检查分支标题、创建时间、来源入口与列表排序，并点击返回源任务"},{"parent":"1a69fcdc-9ae8-4747-ab80-ee696b01af65","callout":[],"children":[],"id":"96a1f2ff-6f0f-4be1-9532-8014d232b7ab","title":"预期：分支标题可识别且不为空；创建时间为 Fork 时刻；详情中展示来源任务入口并可点击跳回源任务；列表按更新时间排序，分支位置正确"}],"collapsed":true,"id":"1a69fcdc-9ae8-4747-ab80-ee696b01af65","title":"🟠【P1】分支名称、时间与来源展示"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"8f4bff12-1614-41a1-b752-33ece57ea37b","callout":[],"children":[],"id":"504dba3c-2048-461f-a18e-c40c1138c852","title":"前置：前置：已从任务 A 创建分支 B1；角色：房间成员；入口：分支 B1 输入框"},{"parent":"8f4bff12-1614-41a1-b752-33ece57ea37b","callout":[],"children":[],"id":"5800e258-98b3-43b9-ac97-ac775e57558f","title":"操作：在分支发送一条新消息并等待回复，然后返回源任务查看"},{"parent":"8f4bff12-1614-41a1-b752-33ece57ea37b","callout":[],"children":[],"id":"1716d30c-51f3-45df-a87c-3650b8622734","title":"预期：分支正常收到回复并新增消息；源任务的消息数量与内容不发生变化；左侧列表中两条任务分别更新各自的时间"}],"collapsed":true,"id":"8f4bff12-1614-41a1-b752-33ece57ea37b","title":"🟠【P1】分支继续对话不影响源任务"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"8cbd27cd-0279-4423-a220-00c604a4b57f","callout":[],"children":[],"id":"437150c4-0dda-42f0-997a-5430359ab6d1","title":"前置：前置：已创建分支 B1；角色：房间成员；入口：分支的更多操作菜单"},{"parent":"8cbd27cd-0279-4423-a220-00c604a4b57f","callout":[],"children":[],"id":"1aaeee66-3007-410d-a7ad-c4b40f845ffd","title":"操作：依次对 B1 执行重命名、归档，若环境允许再执行删除，然后查看源任务"},{"parent":"8cbd27cd-0279-4423-a220-00c604a4b57f","callout":[],"children":[],"id":"76edf9f9-0fee-4932-a426-1417e9d8a7e8","title":"预期：重命名与归档只作用于分支；源任务标题、状态与消息均不变；删除分支后源任务仍存在且可继续对话"}],"collapsed":true,"id":"8cbd27cd-0279-4423-a220-00c604a4b57f","title":"🟠【P1】分支重命名归档删除不影响源任务"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"b8f01f80-50eb-4ce6-819a-f1a89fe14c7b","callout":[],"children":[],"id":"ffa19206-5b1d-4fbd-9263-e9b6850042d8","title":"前置：前置：任务 A 存在某一目标节点；角色：房间成员；入口：该节点的 Fork 操作"},{"parent":"b8f01f80-50eb-4ce6-819a-f1a89fe14c7b","callout":[],"children":[],"id":"13c5ba43-0c1b-4caf-b6b2-d5d13810a72a","title":"操作：从同一节点依次创建 3 个分支，并分别发送不同指令"},{"parent":"b8f01f80-50eb-4ce6-819a-f1a89fe14c7b","callout":[],"children":[],"id":"7dfe81de-767b-4ac2-90d8-3ac461699e8d","title":"预期：3 个分支均创建成功且互不影响；各自继承相同的历史上下文；各分支的新消息只出现在自身会话中"}],"collapsed":true,"id":"b8f01f80-50eb-4ce6-819a-f1a89fe14c7b","title":"🟠【P1】同一节点创建多个分支"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"b4428147-78cb-4738-844a-2f403e9aca22","callout":[],"children":[],"id":"2c97bade-1637-4b4e-9d45-dcc52ad6bbe8","title":"前置：前置：任务 A 已有若干轮对话；角色：房间成员；入口：Fork 操作"},{"parent":"b4428147-78cb-4738-844a-2f403e9aca22","callout":[],"children":[],"id":"a59a2756-c407-485d-bb50-6478b8dd2ba7","title":"操作：从源任务创建分支 B1，再从 B1 创建 B2，分别在 B1 与 B2 继续对话"},{"parent":"b4428147-78cb-4738-844a-2f403e9aca22","callout":[],"children":[],"id":"4eab76b9-2acd-4101-92e5-351616b943ed","title":"预期：B1 继承源任务上下文，B2 继承 B1 上下文；三条任务各自独立可继续对话；任务详情中能看到各自的来源任务，来源指向正确"}],"collapsed":true,"id":"b4428147-78cb-4738-844a-2f403e9aca22","title":"🟠【P1】多级 Fork"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"f3df5130-9bee-4c4f-befa-c667e0415e84","callout":[],"children":[],"id":"b2ff8f5f-527d-4476-9242-b13ebe8a7a0d","title":"前置：前置：已从任务 A 创建分支 B1；角色：房间成员；入口：任务列表"},{"parent":"f3df5130-9bee-4c4f-befa-c667e0415e84","callout":[],"children":[],"id":"42ad4828-ed07-4849-a816-a1cf07244818","title":"操作：归档源任务 A，再打开分支 B1 并继续对话"},{"parent":"f3df5130-9bee-4c4f-befa-c667e0415e84","callout":[],"children":[],"id":"2eaaa02f-c0b5-4bf9-8870-2e6d22c91f20","title":"预期：分支 B1 仍可打开且历史完整；可继续发送消息并收到回复；分支详情中来源任务标记为已归档但入口仍可查看"}],"collapsed":true,"id":"f3df5130-9bee-4c4f-befa-c667e0415e84","title":"🟠【P1】源任务归档后查看既有分支"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"c6a9161f-4ef5-4c9d-870c-339157fc3b8a","callout":[],"children":[],"id":"0e14029f-9823-4daa-bb92-4c3e49477d61","title":"前置：前置：已从任务 A 创建分支 B1；角色：房间成员；入口：源任务输入框"},{"parent":"c6a9161f-4ef5-4c9d-870c-339157fc3b8a","callout":[],"children":[],"id":"a6db5dc7-66e9-4884-882a-adec963fc7eb","title":"操作：在源任务发送新消息并等待回复，然后查看分支"},{"parent":"c6a9161f-4ef5-4c9d-870c-339157fc3b8a","callout":[],"children":[],"id":"4c52d988-9183-443d-a1c4-587da9ef2074","title":"预期：源任务新增消息与回复；分支消息保持 Fork 时的状态不变，不出现源任务新消息串入分支"}],"collapsed":true,"id":"c6a9161f-4ef5-4c9d-870c-339157fc3b8a","title":"🟠【P1】源任务继续对话不影响分支"},{"parent":"ced9684a-d9c7-493e-be7c-861113ad2075","callout":[],"children":[{"parent":"3d5357fb-fe36-4efa-8036-de7158faae08","callout":[],"children":[],"id":"dada1e1e-2646-4dd8-b0f7-2713b9fb84fb","title":"前置：前置：源任务某节点前包含图片、文档、代码块、引用消息和工具调用结果；角色：房间成员；入口：该节点上的 Fork 操作"},{"parent":"3d5357fb-fe36-4efa-8036-de7158faae08","callout":[],"children":[],"id":"fa14bd7f-f8c5-4953-be55-a3d4bec33594","title":"操作：Fork 后在分支中查看并尝试打开每类内容"},{"parent":"3d5357fb-fe36-4efa-8036-de7158faae08","callout":[],"children":[],"id":"5ba09f6a-ad36-4e09-9517-968427a596f1","title":"预期：分支中图片可正常预览、文档可点击打开、代码块渲染正常、引用消息可跳转、工具调用结果可展开；不出现附件裂图或无法加载预览"}],"collapsed":true,"id":"3d5357fb-fe36-4efa-8036-de7158faae08","title":"🟠【P1】附件与富内容继承"}],"collapsed":true,"id":"ced9684a-d9c7-493e-be7c-861113ad2075","title":"正常场景（11）"},{"parent":"e66a3b52-473b-4e8a-91f0-b6cb8617a4d4","callout":[],"children":[{"parent":"893dbbb2-62e8-4233-b138-336df69b5d66","callout":[],"children":[{"parent":"85e1228d-2aea-4df4-b45c-ef8ddf3098f6","callout":[],"children":[],"id":"7daf5be6-d248-4d80-af06-de4dcfdb91fa","title":"前置：前置：任务处于可 Fork 状态；角色：房间成员；入口：Fork 操作"},{"parent":"85e1228d-2aea-4df4-b45c-ef8ddf3098f6","callout":[],"children":[],"id":"5dc19890-1d8c-48f3-895b-bd03028c9b13","title":"操作：点击 Fork 后立即断开网络，等待若干秒后恢复网络"},{"parent":"85e1228d-2aea-4df4-b45c-ef8ddf3098f6","callout":[],"children":[],"id":"702d53f1-e216-4393-8b40-52f5e498899f","title":"预期：断网期间给出请求失败或重试提示而非一直加载；恢复网络后重试可成功创建分支；不产生重复分支或空白分支"}],"collapsed":true,"id":"85e1228d-2aea-4df4-b45c-ef8ddf3098f6","title":"🟠【P1】Fork 请求期间断网"},{"parent":"893dbbb2-62e8-4233-b138-336df69b5d66","callout":[],"children":[{"parent":"34cd0b15-c042-4522-b52f-a0922acf5647","callout":[],"children":[],"id":"2e4a2665-f3f5-42e0-a5cd-4b83928e5bb8","title":"前置：前置：任务正在执行工具调用；角色：房间成员；入口：工具调用节点"},{"parent":"34cd0b15-c042-4522-b52f-a0922acf5647","callout":[],"children":[],"id":"ea5d778d-ee3f-4bb7-ae9b-1e861e7fb4b5","title":"操作：在工具调用执行期间 Fork，观察源任务与分支中的运行状态"},{"parent":"34cd0b15-c042-4522-b52f-a0922acf5647","callout":[],"children":[],"id":"acf72b85-00c0-4a94-91c0-378381f9eb88","title":"预期：源任务的工具调用继续执行并正常收敛；分支中该工具调用不显示为持续进行中；两边状态最终一致，无长期卡在执行中的记录"}],"collapsed":true,"id":"34cd0b15-c042-4522-b52f-a0922acf5647","title":"🟠【P1】从正在执行工具调用的任务 Fork"},{"parent":"893dbbb2-62e8-4233-b138-336df69b5d66","callout":[],"children":[{"parent":"29550fad-92ee-49b4-af0f-6349ffe0ed54","callout":[],"children":[],"id":"982bfd2e-ba13-4fef-ace4-aff2dec12c5a","title":"前置：前置：任务 D 正在生成回复；角色：房间成员；入口：正在生成的消息节点"},{"parent":"29550fad-92ee-49b4-af0f-6349ffe0ed54","callout":[],"children":[],"id":"931e808f-51f1-4ac3-9f1a-b14bb7136497","title":"操作：在生成过程中尝试 Fork"},{"parent":"29550fad-92ee-49b4-af0f-6349ffe0ed54","callout":[],"children":[],"id":"f60a36e2-0d3a-4da8-8e9d-ce08cd776be9","title":"预期：要么 Fork 入口在生成中不可用并给出说明，要么以已生成的完整消息为界创建分支；不出现分支内容截断到一半或分支与源任务同时继续输出同一段内容"}],"collapsed":true,"id":"29550fad-92ee-49b4-af0f-6349ffe0ed54","title":"🟠【P1】从正在生成回复的节点 Fork"},{"parent":"893dbbb2-62e8-4233-b138-336df69b5d66","callout":[],"children":[{"parent":"be4758ff-0d82-46d3-9894-05d1e16f777f","callout":[],"children":[],"id":"6bdc6f11-538d-4257-90c3-4fd451494282","title":"前置：前置：任务处于可 Fork 状态；角色：房间成员；入口：Fork 操作"},{"parent":"be4758ff-0d82-46d3-9894-05d1e16f777f","callout":[],"children":[],"id":"864164b6-7fb0-4afe-b166-a1d36de0f618","title":"操作：快速双击 Fork 按钮，并在请求未结束时再次触发"},{"parent":"be4758ff-0d82-46d3-9894-05d1e16f777f","callout":[],"children":[],"id":"df991a75-cbd1-4da0-a1cc-fe58aefe0b39","title":"预期：只创建一个分支；按钮在请求期间置为不可点击；任务列表中不出现两条内容相同的分支"}],"collapsed":true,"id":"be4758ff-0d82-46d3-9894-05d1e16f777f","title":"🟠【P1】连续双击或重复提交 Fork"},{"parent":"893dbbb2-62e8-4233-b138-336df69b5d66","callout":[],"children":[{"parent":"76ef4bbc-5d9c-4eb4-9848-a0eb055fcf67","callout":[],"children":[],"id":"5af9b757-e8d9-4185-99bf-c54a128ae526","title":"前置：前置：源任务中某附件已被删除或不可访问；角色：房间成员；入口：该附件之后节点的 Fork 操作"},{"parent":"76ef4bbc-5d9c-4eb4-9848-a0eb055fcf67","callout":[],"children":[],"id":"670ceef1-7ee6-4415-88ca-cead0beac2f7","title":"操作：执行 Fork 并在分支中点击该附件"},{"parent":"76ef4bbc-5d9c-4eb4-9848-a0eb055fcf67","callout":[],"children":[],"id":"c24fe706-f9e0-435e-8863-3224dbbbfa1f","title":"预期：分支创建成功且文本消息完整；失效附件在分支中显示明确的不可用提示而非空白或崩溃；其他附件仍可正常打开"}],"collapsed":true,"id":"76ef4bbc-5d9c-4eb4-9848-a0eb055fcf67","title":"🟠【P1】附件源失效时 Fork"}],"collapsed":true,"id":"893dbbb2-62e8-4233-b138-336df69b5d66","title":"异常场景（5）"},{"parent":"e66a3b52-473b-4e8a-91f0-b6cb8617a4d4","callout":[],"children":[{"parent":"68c6de20-4f63-4a36-88a6-318362a01301","callout":[],"children":[{"parent":"64d9d923-152d-432d-9fd4-1febd52e74e6","callout":[],"children":[],"id":"06468ded-94cf-481b-a328-aef29cdab1bd","title":"前置：前置：同一账号在两个客户端打开同一任务；角色：房间成员；入口：同一节点的 Fork 操作"},{"parent":"64d9d923-152d-432d-9fd4-1febd52e74e6","callout":[],"children":[],"id":"b8b5e899-ccaa-4863-b04a-83bf2dfe8305","title":"操作：两端几乎同时从该节点执行 Fork"},{"parent":"64d9d923-152d-432d-9fd4-1febd52e74e6","callout":[],"children":[],"id":"4995aa92-4738-4b2b-85b2-f0ca6f4d671b","title":"预期：两端各自的操作结果一致：要么生成两条互相独立的分支，要么后发起的一次收到明确提示；不出现一端显示成功另一端一直加载，刷新后两端列表内容相同"}],"collapsed":true,"id":"64d9d923-152d-432d-9fd4-1febd52e74e6","title":"🟡【P2】两端同时 Fork 同一节点"},{"parent":"68c6de20-4f63-4a36-88a6-318362a01301","callout":[],"children":[{"parent":"a668a802-d67c-4f28-8a8b-57405e293ae8","callout":[],"children":[],"id":"dd1e38a9-a696-4dbe-8c19-40ce2e4c66d3","title":"前置：前置：任务仅包含一条用户消息；角色：房间成员；入口：该消息的 Fork 操作"},{"parent":"a668a802-d67c-4f28-8a8b-57405e293ae8","callout":[],"children":[],"id":"07bdc3cd-07f9-485a-83c1-14e9340ee488","title":"操作：从系统允许的最早节点执行 Fork"},{"parent":"a668a802-d67c-4f28-8a8b-57405e293ae8","callout":[],"children":[],"id":"715b3609-0255-4e87-80ce-f3a726cbd3eb","title":"预期：分支创建成功并包含该条消息；分支可继续对话；不出现空会话或创建失败"}],"collapsed":true,"id":"a668a802-d67c-4f28-8a8b-57405e293ae8","title":"🟡【P2】最小内容任务 Fork"},{"parent":"68c6de20-4f63-4a36-88a6-318362a01301","callout":[],"children":[{"parent":"7d6a7b84-531c-4d49-8306-85b2185c66c6","callout":[],"children":[],"id":"a9273df3-7169-468d-9742-16c3f3a7167b","title":"前置：前置：源任务正在对话中；角色：房间成员；入口：Fork 操作"},{"parent":"7d6a7b84-531c-4d49-8306-85b2185c66c6","callout":[],"children":[],"id":"369142db-d2d3-496c-98f1-32d75bc3549b","title":"操作：提交 Fork 的同时在源任务继续发送消息"},{"parent":"7d6a7b84-531c-4d49-8306-85b2185c66c6","callout":[],"children":[],"id":"d5c08969-6fdb-47d0-a026-c17ca62258d6","title":"预期：分支内容以 Fork 点为界，不包含 Fork 之后源任务新增的消息；源任务新消息正常展示；两条任务的消息顺序均正确"}],"collapsed":true,"id":"7d6a7b84-531c-4d49-8306-85b2185c66c6","title":"🟡【P2】源任务在 Fork 期间继续产生消息"},{"parent":"68c6de20-4f63-4a36-88a6-318362a01301","callout":[],"children":[{"parent":"c54bb9d0-345c-4d4e-a9e8-ba75dca81777","callout":[],"children":[],"id":"3fb5fce0-2ffd-4d72-bf41-b743af411a68","title":"前置：前置：源任务包含中文、英文、Emoji、RTL 文本、Markdown、超长 URL 和特殊字符；角色：房间成员；入口：Fork 操作"},{"parent":"c54bb9d0-345c-4d4e-a9e8-ba75dca81777","callout":[],"children":[],"id":"f2c11f6c-fdbf-458e-bcba-bfbb4ef60843","title":"操作：执行 Fork 后逐条查看分支中的消息渲染"},{"parent":"c54bb9d0-345c-4d4e-a9e8-ba75dca81777","callout":[],"children":[],"id":"6ede433a-563d-4062-9fe4-507c465c5553","title":"预期：分支中各类字符与格式渲染与源任务一致，无乱码、截断或转义异常；超长 URL 换行展示且可点击"}],"collapsed":true,"id":"c54bb9d0-345c-4d4e-a9e8-ba75dca81777","title":"🟡【P2】特殊字符与多语言内容 Fork"},{"parent":"68c6de20-4f63-4a36-88a6-318362a01301","callout":[],"children":[{"parent":"1edf6a55-9fdf-4719-9236-d7c16ba3d87b","callout":[],"children":[],"id":"2d265671-6c2a-42f7-a499-01c6803db7aa","title":"前置：前置：任务 C 的消息数量达到系统允许的较大规模；角色：房间成员；入口：Fork 操作"},{"parent":"1edf6a55-9fdf-4719-9236-d7c16ba3d87b","callout":[],"children":[],"id":"2e8931fa-c944-4a29-be8c-8adfc2a7e350","title":"操作：分别从任务前部、中部、末尾各执行一次 Fork，核对继承内容与创建耗时"},{"parent":"1edf6a55-9fdf-4719-9236-d7c16ba3d87b","callout":[],"children":[],"id":"033d8c6d-1723-4487-90ac-b96992f6a860","title":"预期：三次 Fork 均成功；分支继承的消息范围与 Fork 点一致；创建耗时在可接受范围内且界面不卡死"}],"collapsed":true,"id":"1edf6a55-9fdf-4719-9236-d7c16ba3d87b","title":"🟡【P2】超长任务在不同位置 Fork"}],"collapsed":true,"id":"68c6de20-4f63-4a36-88a6-318362a01301","title":"边界场景（5）"}],"collapsed":true,"id":"e66a3b52-473b-4e8a-91f0-b6cb8617a4d4","title":"会话分支"}],"collapsed":true,"id":"0998b2e0-a1aa-4caf-b9b7-16d1e5492101","title":"会话分支（Fork）"},{"parent":"b16ea64e-6c6a-4d65-95b0-ece0710dbe2a","callout":[],"children":[{"parent":"9b6cccd4-a65b-43b6-900d-cf96ab3c5200","callout":[],"children":[{"parent":"e706b487-b0e7-492e-923d-8e11ab167be2","callout":[],"children":[{"parent":"00cc009e-8164-463f-966e-34317b3242c7","callout":[],"children":[{"parent":"cb4bbb4b-e50b-4694-b406-14aaae87b238","callout":[],"children":[],"id":"99be3943-4cc7-4e2b-bded-f794d4b8159f","title":"操作：两个 Agent 选择同一项目分别执行读写任务"},{"parent":"cb4bbb4b-e50b-4694-b406-14aaae87b238","callout":[],"children":[],"id":"823f3353-21d0-401f-80a4-14db7ee1025f","title":"预期：两个 Agent 可同时处于 running 状态；各自修改不同文件，不产生文件冲突；各自的文件卡片正确展示；两个任务均能独立完成"}],"collapsed":true,"id":"cb4bbb4b-e50b-4694-b406-14aaae87b238","title":"🔴【P0】同项目不同Agent协作"},{"parent":"00cc009e-8164-463f-966e-34317b3242c7","callout":[],"children":[{"parent":"7d776dfd-aeab-4ea2-9874-c26a8a0acdfc","callout":[],"children":[],"id":"37789fda-edbc-4704-89ba-3f46fce4c6d4","title":"操作：打开两个标签页，同时发起 {Agent} 和 {Agent} 会话"},{"parent":"7d776dfd-aeab-4ea2-9874-c26a8a0acdfc","callout":[],"children":[],"id":"9f5b4a13-7933-4878-bbf5-90d55ffa98cb","title":"预期：各自会话独立运行"}],"collapsed":true,"id":"7d776dfd-aeab-4ea2-9874-c26a8a0acdfc","title":"🔴【P0】相同多个Agent窗口并行"},{"parent":"00cc009e-8164-463f-966e-34317b3242c7","callout":[],"children":[{"parent":"94ae892b-4bc2-4a32-8ce2-bb0886de577d","callout":[],"children":[],"id":"d642912c-2a29-4613-b8cb-e8ac26c9864c","title":"操作：打开两个标签页，同时发起 {Agent1} 和 {Agent2} 会话"},{"parent":"94ae892b-4bc2-4a32-8ce2-bb0886de577d","callout":[],"children":[],"id":"74c99295-56c6-44e1-b21f-cd7bb1371f63","title":"预期：各自会话独立运行"}],"collapsed":true,"id":"94ae892b-4bc2-4a32-8ce2-bb0886de577d","title":"🔴【P0】不同多个Agent窗口并行"},{"parent":"00cc009e-8164-463f-966e-34317b3242c7","callout":[],"children":[{"parent":"864af275-ad2e-4344-bc27-904d68b9effe","callout":[],"children":[],"id":"f94f54a8-8808-44f3-93a9-38578d6b3319","title":"操作：1.房主 Agent 修改 a.js → 2.协作者 Agent 同时修改 b.js → 3.查看文件系统窗口"},{"parent":"864af275-ad2e-4344-bc27-904d68b9effe","callout":[],"children":[],"id":"970ef210-420b-4c76-88b0-339754c57b52","title":"预期：两个文件独立被修改，内容互不干扰；文件系统窗口显示两者的最新变更；各自的 Agent 窗口对话流中各有对应的文件改动卡片"}],"collapsed":true,"id":"864af275-ad2e-4344-bc27-904d68b9effe","title":"🔴【P0】房主和协作者的 Agent 同时修改不同文件"},{"parent":"00cc009e-8164-463f-966e-34317b3242c7","callout":[],"children":[{"parent":"88781c13-2770-4c8a-b68d-22483bff63e2","callout":[],"children":[],"id":"7d97ff06-ea8e-4c9e-aa73-c58bb42f204f","title":"操作：一个 Agent 运行中，另一个 Agent 空闲"},{"parent":"88781c13-2770-4c8a-b68d-22483bff63e2","callout":[],"children":[],"id":"66994e5c-a741-4ef3-bdc0-33e48bc33b11","title":"预期：状态指示分别准确，不把运行状态串到其他 Agent"}],"collapsed":true,"id":"88781c13-2770-4c8a-b68d-22483bff63e2","title":"🔴【P0】跨Agent状态展示"},{"parent":"00cc009e-8164-463f-966e-34317b3242c7","callout":[],"children":[{"parent":"eecf83fa-83c7-405f-83ea-c6caa264a233","callout":[],"children":[],"id":"d4d2a924-8907-41d1-beb2-dfcca34d5bfb","title":"操作：1.房主给 {Agent} 发送\"实现 login 接口\" → 2.协作者给 Hermes 发送\"实现 register 接口\" → 3.观察两个 Agent 并行工作"},{"parent":"eecf83fa-83c7-405f-83ea-c6caa264a233","callout":[],"children":[],"id":"66c6274a-6394-4934-b492-414980f590e9","title":"预期：两个 Agent 可同时处于 running 状态；各自修改不同文件，不产生文件冲突；各自的文件卡片正确展示；两个任务均能独立完成"}],"collapsed":true,"id":"eecf83fa-83c7-405f-83ea-c6caa264a233","title":"🟡【P2】房主和协作者的Agent共同处理一个任务"}],"collapsed":true,"id":"00cc009e-8164-463f-966e-34317b3242c7","title":"正常场景（9）"},{"parent":"e706b487-b0e7-492e-923d-8e11ab167be2","callout":[],"children":[{"parent":"5dd97e21-7cc9-41e1-9a16-f256499eee05","callout":[],"children":[{"parent":"12c0bb50-9267-4e18-ae8e-b8b0ea677699","callout":[],"children":[],"id":"418b7722-bda7-4e73-9691-68cd0c41eeec","title":"操作：两个 Agent 同时修改同一文件"},{"parent":"12c0bb50-9267-4e18-ae8e-b8b0ea677699","callout":[],"children":[],"id":"870c3775-fb04-4738-905d-6d8acca69c58","title":"预期：检测冲突或保留双方变更，不静默覆盖"}],"collapsed":true,"id":"12c0bb50-9267-4e18-ae8e-b8b0ea677699","title":"🔴【P0】协同写同一文件冲突"},{"parent":"5dd97e21-7cc9-41e1-9a16-f256499eee05","callout":[],"children":[{"parent":"07cdc7cb-3a05-4fcd-aba1-a21cdb5a46f6","callout":[],"children":[],"id":"ee0d2300-2670-4c4e-8657-443216041c7f","title":"操作：同项目中 CLAUDE.md 与 AGENTS.md 指令冲突"},{"parent":"07cdc7cb-3a05-4fcd-aba1-a21cdb5a46f6","callout":[],"children":[],"id":"53d33d74-c49a-4710-93a4-76cc7aec09cf","title":"预期：各 Agent 按自身规则文件优先级执行，不误用对方规则"}],"collapsed":true,"id":"07cdc7cb-3a05-4fcd-aba1-a21cdb5a46f6","title":"🟠【P1】跨Agent规则冲突"},{"parent":"5dd97e21-7cc9-41e1-9a16-f256499eee05","callout":[],"children":[{"parent":"ffedad5a-d71a-4fff-8807-2da0cb394fb2","callout":[],"children":[],"id":"2b70d756-6ed8-44ff-b64f-20e84ce6cb03","title":"操作：协同过程中强制关闭其中一个 Agent"},{"parent":"ffedad5a-d71a-4fff-8807-2da0cb394fb2","callout":[],"children":[],"id":"6d9d5605-bd30-4129-b744-9c06425d1bad","title":"预期：另一个 Agent 正常运行，退出 Agent 状态准确更新"}],"collapsed":true,"id":"ffedad5a-d71a-4fff-8807-2da0cb394fb2","title":"🟡【P2】一个Agent异常退出"}],"collapsed":true,"id":"5dd97e21-7cc9-41e1-9a16-f256499eee05","title":"异常场景（7）"},{"parent":"e706b487-b0e7-492e-923d-8e11ab167be2","callout":[],"children":[{"parent":"46e36299-4c0f-49c6-b8c6-4cb50679b870","callout":[],"children":[{"parent":"dc42804a-dccc-4675-97eb-431ed3315c51","callout":[],"children":[],"id":"7e36922f-fa73-4777-adef-5873468e52f1","title":"操作：3个Agent 分工处理同一任务的不同部分"},{"parent":"dc42804a-dccc-4675-97eb-431ed3315c51","callout":[],"children":[],"id":"ad9e2507-28a6-4645-9069-ff2a57002c0a","title":"预期：3个Agent能共同完成一个任务"}],"collapsed":true,"id":"dc42804a-dccc-4675-97eb-431ed3315c51","title":"🟡【P2】3个Agent 分工处理同一任务的不同部分"},{"parent":"46e36299-4c0f-49c6-b8c6-4cb50679b870","callout":[],"children":[{"parent":"c4716468-c08b-46ca-85a2-d03be0f06108","callout":[],"children":[],"id":"8abe8a63-3ac0-4353-88f6-273ab60f6875","title":"操作：两个 Agent 同时执行超过 30 分钟的任务"},{"parent":"c4716468-c08b-46ca-85a2-d03be0f06108","callout":[],"children":[],"id":"d0848dc1-9f64-4575-9961-d1606145dcb2","title":"预期：状态和日志持续可追踪，断线恢复后不混淆"}],"collapsed":true,"id":"c4716468-c08b-46ca-85a2-d03be0f06108","title":"🟡【P2】协同长任务"},{"parent":"46e36299-4c0f-49c6-b8c6-4cb50679b870","callout":[],"children":[{"parent":"3ffde70d-14fe-4ff7-a658-6f936a734d08","callout":[],"children":[],"id":"79830ed4-4547-487a-8236-68cb36474c38","title":"操作：不同 Agent 创建相同标题会话"},{"parent":"3ffde70d-14fe-4ff7-a658-6f936a734d08","callout":[],"children":[],"id":"62d089e3-c21c-4556-91a1-0f936af91c38","title":"预期：历史列表用 Agent 类型或时间区分，不误打开"}],"collapsed":true,"id":"3ffde70d-14fe-4ff7-a658-6f936a734d08","title":"🟡【P2】同名会话协同"},{"parent":"46e36299-4c0f-49c6-b8c6-4cb50679b870","callout":[],"children":[{"parent":"1ff53f08-498a-4439-8193-ac0b7ab1d64e","callout":[],"children":[],"id":"d9347a11-4798-4e3a-b13e-6ba42f0d8485","title":"操作：同时打开 10 个 标签页，新建会话"},{"parent":"1ff53f08-498a-4439-8193-ac0b7ab1d64e","callout":[],"children":[],"id":"bf00d46a-e84a-4297-ae40-a0faf68f71fb","title":"预期：窗口状态和资源占用可控，历史列表不混乱"}],"collapsed":true,"id":"1ff53f08-498a-4439-8193-ac0b7ab1d64e","title":"🟡【P2】大量Agent窗口"},{"parent":"46e36299-4c0f-49c6-b8c6-4cb50679b870","callout":[],"children":[{"parent":"2b1db756-a805-48d2-9473-b53e5e6edfe9","callout":[],"children":[],"id":"62bd54ca-4c1d-4a89-8b74-2dbae56b479b","title":"操作：频繁在不同 Agent 窗口之间切换"},{"parent":"2b1db756-a805-48d2-9473-b53e5e6edfe9","callout":[],"children":[],"id":"e5e9f249-a091-4468-9e3c-39ff0d4c13c7","title":"预期：焦点、输入框和快捷键作用于当前窗口"}],"collapsed":true,"id":"2b1db756-a805-48d2-9473-b53e5e6edfe9","title":"🟡【P2】快速切换活跃Agent"}],"collapsed":true,"id":"46e36299-4c0f-49c6-b8c6-4cb50679b870","title":"边界场景（6）"}],"collapsed":true,"id":"e706b487-b0e7-492e-923d-8e11ab167be2","title":"多 Agent 并行协作"}],"collapsed":true,"id":"9b6cccd4-a65b-43b6-900d-cf96ab3c5200","title":"多 Agent 并行"}],"collapsed":true,"id":"b16ea64e-6c6a-4d65-95b0-ece0710dbe2a","title":"多会话与多 Agent 协同"}],"collapsed":true,"id":"2c72769a-edab-4380-9807-95c83d5881ee","title":"中间区域"},{"parent":"df696030-0aa7-4c05-86d4-7cd9e421febb","callout":[],"children":[{"parent":"d86c0b06-382c-42cc-8248-f58542b33936","callout":[],"children":[{"parent":"dc75fe20-a761-4a4a-878b-d62412fc7810","callout":[],"children":[{"parent":"a2fe92db-d011-4887-b538-6578b96dee35","callout":[],"children":[{"parent":"19bd481a-159e-46fb-a47d-e951b147a228","callout":[],"children":[{"parent":"8125437a-1017-4ed6-b431-c7f97614ee44","callout":[],"children":[],"id":"48ecf8c8-d81d-49dd-a696-668f653b32fe","title":"前置：房间内已有一条会话且已进入会话详情；角色：房间成员；入口：会话右上角侧边栏图标"},{"parent":"8125437a-1017-4ed6-b431-c7f97614ee44","callout":[],"children":[],"id":"68375665-94cc-4a6f-ab94-e8cb6ca105b2","title":"操作：点击右上角侧边栏图标"},{"parent":"8125437a-1017-4ed6-b431-c7f97614ee44","customWidth":429.4,"callout":[],"children":[],"id":"157dab61-4475-4aa9-8b0f-1f9ea51390d1","title":"预期：\n1) 面板开关 ｜ 右侧面板展开，默认停在总览标签\n2) 列表展示 ｜ 总览内依次展示产物、工作区文件、工具三个分组\n3) 列表展示 ｜ 工具分组下展示终端与浏览器两个入口"}],"collapsed":true,"id":"8125437a-1017-4ed6-b431-c7f97614ee44","title":"🔴【P0】点击侧边栏图标打开右侧面板"},{"parent":"19bd481a-159e-46fb-a47d-e951b147a228","callout":[],"children":[{"parent":"beeae9e7-64f9-4e44-a714-f01a562cac7f","callout":[],"children":[],"id":"2fc44623-5dc2-4af7-b05a-664875715ef1","title":"前置：右侧面板已展开；角色：房间成员；入口：会话右上角侧边栏图标"},{"parent":"beeae9e7-64f9-4e44-a714-f01a562cac7f","callout":[],"children":[],"id":"5e76388e-2ffd-46bf-bb9d-86ef6e6cc1ac","title":"操作：再次点击该图标"},{"parent":"beeae9e7-64f9-4e44-a714-f01a562cac7f","callout":[],"children":[],"id":"c9a5998e-d0b4-4e9d-ba21-f6d947824933","title":"预期：\n1) 面板开关 ｜ 右侧面板收起，左侧对话流恢复原宽度\n2) 持久化 ｜ 收起前打开的标签在下次展开时仍在"}],"collapsed":true,"id":"beeae9e7-64f9-4e44-a714-f01a562cac7f","title":"🔴【P0】再次点击侧边栏图标收起面板"},{"parent":"19bd481a-159e-46fb-a47d-e951b147a228","callout":[],"children":[{"parent":"27f47487-549d-4ed7-90f8-c88fcef4894b","callout":[],"children":[],"id":"924cda01-16be-4123-a339-488c5145bffe","title":"前置：右侧面板已展开；角色：房间成员；入口：面板右上角放大按钮"},{"parent":"27f47487-549d-4ed7-90f8-c88fcef4894b","callout":[],"children":[],"id":"48d0db00-131d-49f3-8cec-6532abef964b","title":"操作：点击放大按钮"},{"parent":"27f47487-549d-4ed7-90f8-c88fcef4894b","callout":[],"children":[],"id":"94d1f07c-cd30-4e64-a280-a61b06796ac7","title":"预期：\n1) 视觉展示 ｜ 右侧面板扩展至最大宽度，左侧对话流保留可见不被完全遮挡\n2) 视觉展示 ｜ 按钮切换为还原态，再次点击可恢复默认宽度"}],"collapsed":true,"id":"27f47487-549d-4ed7-90f8-c88fcef4894b","title":"🟠【P1】扩展至最大宽度"}],"collapsed":true,"id":"19bd481a-159e-46fb-a47d-e951b147a228","title":"正常场景（3）"},{"parent":"a2fe92db-d011-4887-b538-6578b96dee35","callout":[],"children":[{"parent":"61c62259-cfbd-414b-8742-768835dd1b93","callout":[],"children":[{"parent":"3c47e904-c5ef-485c-a6e8-0969725e9bd8","callout":[],"children":[],"id":"367d35f0-fa08-4796-aa83-e92020ab983a","title":"前置：面板已扩展至最大宽度；角色：房间成员；入口：应用窗口"},{"parent":"3c47e904-c5ef-485c-a6e8-0969725e9bd8","callout":[],"children":[],"id":"379ffbf4-6149-4597-8fe4-1ea848b1f6c4","title":"操作：缩小再放大应用窗口"},{"parent":"3c47e904-c5ef-485c-a6e8-0969725e9bd8","callout":[],"children":[],"id":"6a22d331-dc23-4361-af45-741b1699e300","title":"预期：\n1) 视觉展示 ｜ 面板宽度按比例适配，不出现内容被截断或横向滚动条\n2) 持久化 ｜ 缩放结束后仍保持扩展态"}],"collapsed":true,"id":"3c47e904-c5ef-485c-a6e8-0969725e9bd8","title":"🟡【P2】面板宽度在窗口缩放后保持"}],"collapsed":true,"id":"61c62259-cfbd-414b-8742-768835dd1b93","title":"边界场景（1）"}],"collapsed":true,"id":"a2fe92db-d011-4887-b538-6578b96dee35","title":"面板开关与宽度"},{"parent":"dc75fe20-a761-4a4a-878b-d62412fc7810","callout":[],"children":[{"parent":"9e71190e-4737-44d1-a15d-0636fe6d8481","callout":[],"children":[{"parent":"a7cdc940-9abb-4f0d-818e-598ae2d79d61","callout":[],"children":[{"parent":"fb08f10a-ad70-475d-954f-5f49f91e40ef","callout":[],"children":[],"id":"7468051f-132e-4efb-b65d-ac899f1ff432","title":"前置：右侧面板已展开；角色：房间成员；入口：面板标签栏"},{"parent":"fb08f10a-ad70-475d-954f-5f49f91e40ef","callout":[],"children":[],"id":"0f01dfa1-3d97-4484-87bc-723da0a66da7","title":"操作：查看标签栏最左侧"},{"parent":"fb08f10a-ad70-475d-954f-5f49f91e40ef","callout":[],"children":[],"id":"eeb38a8f-df08-4a20-8e0c-8c226d4611df","title":"预期：\n1) 标签页 ｜ 总览固定在标签栏最左侧\n2) 标签页 ｜ 总览标签不提供关闭按钮"}],"collapsed":true,"id":"fb08f10a-ad70-475d-954f-5f49f91e40ef","title":"🔴【P0】总览标签常驻"},{"parent":"a7cdc940-9abb-4f0d-818e-598ae2d79d61","callout":[],"children":[{"parent":"9f4c8948-bf1a-4859-89dd-dc1dc5dd1d37","callout":[],"children":[],"id":"8bee17f5-0ce4-4794-aa61-587ec0107a26","title":"前置：右侧面板已展开；角色：房间成员；入口：标签栏 + 号"},{"parent":"9f4c8948-bf1a-4859-89dd-dc1dc5dd1d37","callout":[],"children":[],"id":"d8341ed2-9307-4651-a960-3c54927923a2","title":"操作：点击 + 号"},{"parent":"9f4c8948-bf1a-4859-89dd-dc1dc5dd1d37","callout":[],"children":[],"id":"d0fd9923-c764-4056-9c6f-b4141725dcb3","title":"预期：\n1) 标签页 ｜ 弹出可新建的标签类型，至少包含工作区文件、终端、浏览器\n2) 标签页 ｜ 选择后在标签栏末尾新增对应标签并自动切换过去"}],"collapsed":true,"id":"9f4c8948-bf1a-4859-89dd-dc1dc5dd1d37","title":"🔴【P0】点击 + 号新建标签"},{"parent":"a7cdc940-9abb-4f0d-818e-598ae2d79d61","callout":[],"children":[{"parent":"9d129a3d-da0c-4699-a4c8-0b1c9c89825a","callout":[],"children":[],"id":"cf2d7043-f5ca-456d-b415-1812d0151fea","title":"前置：标签栏已存在总览、文件预览、浏览器三个标签；角色：房间成员；入口：面板标签栏"},{"parent":"9d129a3d-da0c-4699-a4c8-0b1c9c89825a","callout":[],"children":[],"id":"90c8ea7f-cddb-4a8a-be60-bad7d46a3d9a","title":"操作：依次点击各标签"},{"parent":"9d129a3d-da0c-4699-a4c8-0b1c9c89825a","callout":[],"children":[],"id":"b1d0db43-64b1-4995-8ed7-42ad4043c50b","title":"预期：\n1) 标签页 ｜ 切换到对应标签内容，切换即时无白屏\n2) 持久化 ｜ 离开再回到某标签时，该标签内的滚动位置与展开状态保持"}],"collapsed":true,"id":"9d129a3d-da0c-4699-a4c8-0b1c9c89825a","title":"🔴【P0】多标签切换"},{"parent":"a7cdc940-9abb-4f0d-818e-598ae2d79d61","callout":[],"children":[{"parent":"80b6c1ee-2d42-4321-9183-bd74a54c57c1","callout":[],"children":[],"id":"9dbf3efc-2449-4dcf-aa49-0cdf4994bb4f","title":"前置：标签栏已存在多个标签；角色：房间成员；入口：标签上的关闭按钮"},{"parent":"80b6c1ee-2d42-4321-9183-bd74a54c57c1","callout":[],"children":[],"id":"9dd41c43-d90e-41c0-b1da-4bc4a3c39510","title":"操作：点击某个非总览标签的关闭按钮"},{"parent":"80b6c1ee-2d42-4321-9183-bd74a54c57c1","callout":[],"children":[],"id":"a2328e18-e9b3-4f64-8e9f-e844cb744dbb","title":"预期：\n1) 标签页 ｜ 该标签关闭并从标签栏移除\n2) 标签页 ｜ 焦点落到相邻标签，不会跳回总览也不出现空白页"}],"collapsed":true,"id":"80b6c1ee-2d42-4321-9183-bd74a54c57c1","title":"🟠【P1】关闭标签"}],"collapsed":true,"id":"a7cdc940-9abb-4f0d-818e-598ae2d79d61","title":"正常场景（4）"},{"parent":"9e71190e-4737-44d1-a15d-0636fe6d8481","callout":[],"children":[{"parent":"4631a5fa-3652-4739-809f-a8598915025b","callout":[],"children":[{"parent":"c56f169e-1167-4772-8270-99de9c0a5d6b","callout":[],"children":[],"id":"e04afa90-a662-4874-9849-a55ba9b46381","title":"前置：已打开 8 个以上标签；角色：房间成员；入口：面板标签栏"},{"parent":"c56f169e-1167-4772-8270-99de9c0a5d6b","callout":[],"children":[],"id":"2e89ef8b-a516-43b9-ae97-791f500e0951","title":"操作：继续新建标签并查看标签栏"},{"parent":"c56f169e-1167-4772-8270-99de9c0a5d6b","callout":[],"children":[],"id":"8fc5668a-f339-41d8-b5e3-0e86be758e46","title":"预期：\n1) 标签页 ｜ 标签栏按产品定义收窄、滚动或折叠，不把标签挤出可视区\n2) 标签页 ｜ 总览标签始终可见可点"}],"collapsed":true,"id":"c56f169e-1167-4772-8270-99de9c0a5d6b","title":"🟡【P2】标签数量超出标签栏宽度"},{"parent":"4631a5fa-3652-4739-809f-a8598915025b","callout":[],"children":[{"parent":"2ce8ae7b-5813-4565-aa21-5d853645b46f","callout":[],"children":[],"id":"22f05650-bc4e-42ba-a16d-940aa248cd43","title":"前置：已在标签页打开 Puzzle-game.md；角色：房间成员；入口：产物列表"},{"parent":"2ce8ae7b-5813-4565-aa21-5d853645b46f","callout":[],"children":[],"id":"31cb1c08-1fd8-416c-a0c1-2b2838aa3b6b","title":"操作：再次点击同一个文件"},{"parent":"2ce8ae7b-5813-4565-aa21-5d853645b46f","callout":[],"children":[],"id":"39bdbc8f-037d-4885-84ae-cfda403d2419","title":"预期：\n1) 标签页 ｜ 复用已有标签并切换过去，不新开重复标签"}],"collapsed":true,"id":"2ce8ae7b-5813-4565-aa21-5d853645b46f","title":"🟡【P2】重复打开同一个对象"}],"collapsed":true,"id":"4631a5fa-3652-4739-809f-a8598915025b","title":"边界场景（2）"}],"collapsed":true,"id":"9e71190e-4737-44d1-a15d-0636fe6d8481","title":"标签页管理"}],"collapsed":true,"id":"dc75fe20-a761-4a4a-878b-d62412fc7810","title":"面板与标签页"},{"parent":"d86c0b06-382c-42cc-8248-f58542b33936","callout":[],"children":[{"parent":"df51990e-dac8-4730-a539-8c097aac03ee","callout":[],"children":[{"parent":"7ec173fa-02b4-416e-bdbf-829f92fbd0e6","callout":[],"children":[{"parent":"e4f80dbb-71b5-42ae-b4cd-3824494386a6","callout":[],"children":[{"parent":"9c1aaa2b-3358-4950-8b5c-e818b13f3bec","callout":[],"children":[],"id":"fb8e7cdf-d6d2-47dd-be74-a6c143c16b36","title":"前置：项目下A/B/C会话均已产出文件、网页与图片等多种产物；角色：房间成员；入口：右侧面板总览"},{"parent":"9c1aaa2b-3358-4950-8b5c-e818b13f3bec","callout":[],"children":[],"id":"68e0bd69-0529-4580-a9d4-bbfd9b84b960","title":"操作：查看产物分组"},{"parent":"9c1aaa2b-3358-4950-8b5c-e818b13f3bec","customWidth":450.4,"callout":[],"children":[],"id":"069f75f5-1191-420d-a67d-ec3b46490b67","title":"预期：<br>1) 列表展示 ｜ 只展示该会话所属项目所有Agent产生的产物，不混入其他会话的文件<br>2) 视觉展示 ｜ 文件夹、md、html、tsx、mp4、图片按类型显示对应图标<br>3) 归属与顺序 ｜ 产物顺序与生成顺序一致"}],"collapsed":true,"id":"9c1aaa2b-3358-4950-8b5c-e818b13f3bec","title":"🔴【P0】展示会话下项目产生的产物"},{"parent":"e4f80dbb-71b5-42ae-b4cd-3824494386a6","callout":[],"children":[{"parent":"331f8e6a-835a-46a9-a73d-2be691d5af56","callout":[],"children":[],"id":"990f84ed-13a8-4c18-bd5f-3a0d3be9b6c2","title":"前置：产物分组中至少有一个产物；角色：房间成员；入口：右侧面板总览"},{"parent":"331f8e6a-835a-46a9-a73d-2be691d5af56","callout":[],"children":[],"id":"668867a3-ec13-4b29-80b6-3ac32c1ab057","title":"操作：鼠标悬浮在某个产物上"},{"parent":"331f8e6a-835a-46a9-a73d-2be691d5af56","callout":[],"children":[],"id":"1a6d1ff8-7b9c-434f-a428-e0523d51ce70","title":"预期：\n1) 视觉展示 ｜ 该行右侧出现分享与更多两个按钮\n2) 视觉展示 ｜ 移开鼠标后按钮隐藏，不遮挡文件名"}],"collapsed":true,"id":"331f8e6a-835a-46a9-a73d-2be691d5af56","title":"🟠【P1】产物悬浮显示操作按钮"}],"collapsed":true,"id":"e4f80dbb-71b5-42ae-b4cd-3824494386a6","title":"正常场景（2）"},{"parent":"7ec173fa-02b4-416e-bdbf-829f92fbd0e6","callout":[],"children":[{"parent":"95413753-b14a-4119-8571-7f19100e2ac6","callout":[],"children":[{"parent":"7cf9af65-d559-40df-9451-fe9939091a56","callout":[],"children":[],"id":"35f45f62-e5f1-4f64-9101-92f49dadb034","title":"前置：新建会话仅做了纯问答未产出文件；角色：房间成员；入口：右侧面板总览"},{"parent":"7cf9af65-d559-40df-9451-fe9939091a56","callout":[],"children":[],"id":"efe08597-c14a-4488-8172-62ff834f8f53","title":"操作：查看产物分组"},{"parent":"7cf9af65-d559-40df-9451-fe9939091a56","callout":[],"children":[],"id":"438f44cb-49bd-4469-a127-6744830f5961","title":"预期：\n1) 提示文案 ｜ 产物区给出空态说明而不是空白区域或加载中不结束"}],"collapsed":true,"id":"7cf9af65-d559-40df-9451-fe9939091a56","title":"🟠【P1】会话未产生任何产物"}],"collapsed":true,"id":"95413753-b14a-4119-8571-7f19100e2ac6","title":"异常场景（1）"},{"parent":"7ec173fa-02b4-416e-bdbf-829f92fbd0e6","callout":[],"children":[{"parent":"c0bf160a-63f9-4bf4-9a77-35b2e5d41459","callout":[],"children":[{"parent":"36fcb2dc-1e1d-4191-a400-8a9b4cf9154f","callout":[],"children":[],"id":"2427dc34-09bc-48e4-b5ff-b4b20ead8a50","title":"前置：一次会话产出 50 个以上产物；角色：房间成员；入口：右侧面板总览"},{"parent":"36fcb2dc-1e1d-4191-a400-8a9b4cf9154f","callout":[],"children":[],"id":"40206aef-44c6-49f8-a3aa-ccc4f707a69b","title":"操作：滚动查看产物列表"},{"parent":"36fcb2dc-1e1d-4191-a400-8a9b4cf9154f","callout":[],"children":[],"id":"b4ec650b-661e-4b46-a9c1-a53c8df45e96","title":"预期：\n1) 性能 ｜ 列表可滚动加载，滚动流畅不卡死\n2) 列表展示 ｜ 数量与实际产出一致，不重复不遗漏"}],"collapsed":true,"id":"36fcb2dc-1e1d-4191-a400-8a9b4cf9154f","title":"🟡【P2】产物数量很多"},{"parent":"c0bf160a-63f9-4bf4-9a77-35b2e5d41459","callout":[],"children":[{"parent":"9bc0049b-b92d-46a2-9c6a-f0de828dc23c","callout":[],"children":[],"id":"bca6a34f-ef5b-4042-a6ff-003e09b17892","title":"前置：存在名称超过 60 字符的产物；角色：房间成员；入口：右侧面板总览"},{"parent":"9bc0049b-b92d-46a2-9c6a-f0de828dc23c","callout":[],"children":[],"id":"52be6e7b-d672-4173-a9de-06889871f457","title":"操作：查看该产物在列表中的展示"},{"parent":"9bc0049b-b92d-46a2-9c6a-f0de828dc23c","callout":[],"children":[],"id":"c483047c-3e0b-4bc2-a800-ae870878b424","title":"预期：\n1) 视觉展示 ｜ 名称截断并省略显示，悬浮可见完整名称\n2) 视觉展示 ｜ 截断不影响右侧操作按钮的点击区域"}],"collapsed":true,"id":"9bc0049b-b92d-46a2-9c6a-f0de828dc23c","title":"🟡【P2】超长产物名展示"}],"collapsed":true,"id":"c0bf160a-63f9-4bf4-9a77-35b2e5d41459","title":"边界场景（2）"}],"collapsed":true,"id":"7ec173fa-02b4-416e-bdbf-829f92fbd0e6","title":"产物区展示"},{"parent":"df51990e-dac8-4730-a539-8c097aac03ee","callout":[],"children":[{"parent":"660d4ff8-bb86-4116-8584-89dce224412f","callout":[],"children":[{"parent":"d61e4ef3-3789-4572-a1af-2b7f0de8a310","callout":[],"children":[{"parent":"b4e3e94f-3307-4589-8ca1-0ff961b5cd2d","callout":[],"children":[{"parent":"41492346-0d0a-44f5-8f30-3bdaa69c2121","callout":[],"children":[],"id":"b05280c2-6b61-4db9-9fd2-38bda19b339f","title":"前置：产物中存在 txt、md、html、图片等可预览文件；角色：房间成员；入口：产物列表"},{"parent":"41492346-0d0a-44f5-8f30-3bdaa69c2121","callout":[],"children":[],"id":"b2303dae-9720-46f5-b3f3-fe06a9d3408c","title":"操作：点击其中一个可预览文件"},{"parent":"41492346-0d0a-44f5-8f30-3bdaa69c2121","callout":[],"children":[],"id":"95824793-f998-4bfc-9369-d2da44d9fce6","title":"预期：\n1) 标签页 ｜ 在新标签页打开该文件详情预览，标签名为文件名\n2) 产物预览 ｜ 内容按文件类型正确渲染，md 渲染为富文本、图片显示原图"}],"collapsed":true,"id":"41492346-0d0a-44f5-8f30-3bdaa69c2121","title":"🔴【P0】点击可预览的文件打开详情"},{"parent":"b4e3e94f-3307-4589-8ca1-0ff961b5cd2d","callout":[],"children":[{"parent":"1876e403-13d9-4a66-832a-594eda88dfbc","callout":[],"children":[],"id":"a6dd17dc-100d-456c-a58b-9939d5c9e826","title":"前置：产物中存在 index.html 与 React.tsx；角色：房间成员；入口：产物列表"},{"parent":"1876e403-13d9-4a66-832a-594eda88dfbc","callout":[],"children":[],"id":"0abb0c47-c7c1-46d3-b3c7-3148416fd72b","title":"操作：分别点击这两个文件"},{"parent":"1876e403-13d9-4a66-832a-594eda88dfbc","callout":[],"children":[],"id":"b9c38a2b-6028-4934-809b-0db251d4d204","title":"预期：\n1) 产物预览 ｜ html 按产品定义渲染或展示源码，代码文件带语法高亮\n2) 产物预览 ｜ 长文件可滚动查看，内容不截断"}],"collapsed":true,"id":"1876e403-13d9-4a66-832a-594eda88dfbc","title":"🟠【P1】预览 html 与代码文件"},{"parent":"b4e3e94f-3307-4589-8ca1-0ff961b5cd2d","callout":[],"children":[{"parent":"5b14dac6-1b7b-4089-b9e7-81af9d22fb81","callout":[],"children":[],"id":"6a3ed45a-162a-44e0-9548-e7e49e1c5e2d","title":"前置：产物中存在 onboarding.mp4；角色：房间成员；入口：产物列表"},{"parent":"5b14dac6-1b7b-4089-b9e7-81af9d22fb81","callout":[],"children":[],"id":"720d4e2f-cdba-4605-af72-2af892e3aa7a","title":"操作：点击该视频文件"},{"parent":"5b14dac6-1b7b-4089-b9e7-81af9d22fb81","callout":[],"children":[],"id":"26ea7ddf-3ef8-4341-a4af-9aab592cbae5","title":"预期：\n1) 产物预览 ｜ 视频可播放并有播放控件；加载失败时给出明确提示而非空白"}],"collapsed":true,"id":"5b14dac6-1b7b-4089-b9e7-81af9d22fb81","title":"🟠【P1】预览音视频产物"},{"parent":"b4e3e94f-3307-4589-8ca1-0ff961b5cd2d","callout":[],"children":[{"parent":"1fb62bf4-a8b5-4f88-a3f9-140a137960d6","callout":[],"children":[],"id":"c79f8e22-3a65-4cb1-88ff-a0e6c49ed36b","title":"前置：产物中存在 assets 文件夹；角色：房间成员；入口：产物列表"},{"parent":"1fb62bf4-a8b5-4f88-a3f9-140a137960d6","callout":[],"children":[],"id":"b9c88099-5c39-4841-befb-934ffad736fa","title":"操作：点击该文件夹"},{"parent":"1fb62bf4-a8b5-4f88-a3f9-140a137960d6","callout":[],"children":[],"id":"56224b81-784c-4b7b-9040-fa75676b9485","title":"预期：\n1) 目录导航 ｜ 进入下一级目录，列表刷新为该文件夹内容\n2) 目录导航 ｜ 面包屑或返回入口更新到当前路径，可逐级返回"}],"collapsed":true,"id":"1fb62bf4-a8b5-4f88-a3f9-140a137960d6","title":"🟠【P1】点击文件夹进入下一级"}],"collapsed":true,"id":"b4e3e94f-3307-4589-8ca1-0ff961b5cd2d","title":"正常场景（4）"},{"parent":"d61e4ef3-3789-4572-a1af-2b7f0de8a310","callout":[],"children":[{"parent":"f455e141-663e-460a-8afc-2edf740b853b","callout":[],"children":[{"parent":"a99e0037-d693-412f-ae42-eb565145f752","callout":[],"children":[],"id":"7a88939f-bba9-43e9-99bb-1a7bfca030cd","title":"前置：产物列表已加载，之后该文件在本地被删除；角色：房间成员；入口：产物列表"},{"parent":"a99e0037-d693-412f-ae42-eb565145f752","callout":[],"children":[],"id":"b8a037f8-3c64-4c81-aec9-7e5459b4efc2","title":"操作：点击该产物"},{"parent":"a99e0037-d693-412f-ae42-eb565145f752","callout":[],"children":[],"id":"c2680483-603d-43ed-84de-f96500609c72","title":"预期：\n1) 提示文案 ｜ 提示文件不存在，列表刷新后移除该项\n2) 副作用 ｜ 不打开空白标签页也不残留半开的预览"}],"collapsed":true,"id":"a99e0037-d693-412f-ae42-eb565145f752","title":"🟠【P1】预览已被删除的产物"},{"parent":"f455e141-663e-460a-8afc-2edf740b853b","callout":[],"children":[{"parent":"9f787e3c-9981-4149-a064-64b8a73955cc","callout":[],"children":[],"id":"bc97f3d2-82a5-4513-90e6-5e12109f160e","title":"前置：产物中存在 .bin 等不支持预览的文件；角色：房间成员；入口：产物列表"},{"parent":"9f787e3c-9981-4149-a064-64b8a73955cc","callout":[],"children":[],"id":"09360030-9efa-4fc8-8e6d-911fead73df0","title":"操作：点击该文件"},{"parent":"9f787e3c-9981-4149-a064-64b8a73955cc","callout":[],"children":[],"id":"68e73445-ea16-423a-a86e-8bb206491537","title":"预期：\n1) 提示文案 ｜ 提示不支持预览并给出下载入口，不报错也不卡住面板"}],"collapsed":true,"id":"9f787e3c-9981-4149-a064-64b8a73955cc","title":"🟠【P1】预览不支持的格式"}],"collapsed":true,"id":"f455e141-663e-460a-8afc-2edf740b853b","title":"异常场景（2）"},{"parent":"d61e4ef3-3789-4572-a1af-2b7f0de8a310","callout":[],"children":[{"parent":"084eadf5-e62a-4515-a25a-dcddaf074063","callout":[],"children":[{"parent":"b7979f30-6821-4d3c-b725-3e6eefd8dbea","callout":[],"children":[],"id":"5b835a4d-0a10-4eb5-bb4e-385dd3613237","title":"前置：产物中存在大于 1GB 的文件；角色：房间成员；入口：产物列表"},{"parent":"b7979f30-6821-4d3c-b725-3e6eefd8dbea","callout":[],"children":[],"id":"7dd6f0dd-803b-4988-a6dc-0c617765a32a","title":"操作：点击该文件"},{"parent":"b7979f30-6821-4d3c-b725-3e6eefd8dbea","callout":[],"children":[],"id":"b93e66b1-c0e0-4db1-ae98-6f5ec3ac1fc8","title":"预期：\n1) 性能 ｜ 按产品定义提示大文件处理方式或分段加载，不阻塞整个面板\n2) 提示文案 ｜ 加载过程有进度或等待反馈"}],"collapsed":true,"id":"b7979f30-6821-4d3c-b725-3e6eefd8dbea","title":"🟡【P2】预览超大文件"},{"parent":"084eadf5-e62a-4515-