-4c83-af7a-55a86d5fc06d","callout":[],"children":[{"parent":"9a60cda4-bc95-4c27-ac2e-3382405c2753","callout":[],"children":[],"id":"9125456f-e1a1-4358-b2f4-3671ad5916d2","title":"前置：引用面板已打开"},{"parent":"9a60cda4-bc95-4c27-ac2e-3382405c2753","callout":[],"children":[],"id":"246caac6-cb0d-44e3-8b9f-070f2ec5278d","title":"操作：选择一个当前无任何文件的来源"},{"parent":"9a60cda4-bc95-4c27-ac2e-3382405c2753","callout":[],"children":[],"id":"5d212051-e654-4d5f-a5f3-ee5b4fff30f6","title":"预期：展示无结果空态提示，不显示持续加载中"}],"collapsed":true,"id":"9a60cda4-bc95-4c27-ac2e-3382405c2753","title":"🟠【P1】筛选后无结果的空态"}],"collapsed":true,"id":"972b673f-5e68-4c83-af7a-55a86d5fc06d","title":"异常场景（1）"},{"parent":"e79795de-d463-468d-890b-1dffc79878bc","callout":[],"children":[{"parent":"5c27c701-5bf0-48cf-9c50-1e8b75085f86","callout":[],"children":[{"parent":"c84cccc4-cf65-415a-b6ca-7eeb3bf910d1","callout":[],"children":[],"id":"19de69a1-a53e-4169-9e85-bd9f22e1f63e","title":"前置：引用面板已打开"},{"parent":"c84cccc4-cf65-415a-b6ca-7eeb3bf910d1","callout":[],"children":[],"id":"662fdf6f-e5cf-4212-9081-c95522042919","title":"操作：同时设置来源与类型两个筛选条件"},{"parent":"c84cccc4-cf65-415a-b6ca-7eeb3bf910d1","callout":[],"children":[],"id":"3cef4127-9036-443f-be2e-02e79afa4df8","title":"预期：两个条件同时生效取交集，清除其中一个后另一个仍保持"}],"collapsed":true,"id":"c84cccc4-cf65-415a-b6ca-7eeb3bf910d1","title":"🟡【P2】来源筛选与类型筛选叠加"}],"collapsed":true,"id":"5c27c701-5bf0-48cf-9c50-1e8b75085f86","title":"边界场景（1）"}],"collapsed":true,"id":"e79795de-d463-468d-890b-1dffc79878bc","title":"来源筛选"},{"parent":"81e7db44-d1c6-4a04-a149-c60952bd3d6d","callout":[],"children":[{"parent":"4efcddab-0782-421f-a4c7-2e7a1a68473e","callout":[],"children":[{"parent":"716f0bfd-d2e2-4269-b055-c84323ea166f","callout":[],"children":[{"parent":"dd4bfea9-0819-457c-9d1f-8c6a54a2f6b0","callout":[],"children":[],"id":"0d07f6a2-d14f-4d7b-979c-c0fec841ee35","title":"前置：前置：本地文件夹已上传完成；角色：房间成员；入口：工作区引用面板"},{"parent":"dd4bfea9-0819-457c-9d1f-8c6a54a2f6b0","callout":[],"children":[],"id":"7685b252-27fd-4600-a28b-5d613f78425a","title":"操作：勾选该文件夹后点击使用已选，发送要求 Agent 概述其中文件内容的消息"},{"parent":"dd4bfea9-0819-457c-9d1f-8c6a54a2f6b0","callout":[],"children":[],"id":"304f9ee3-df09-47d0-97e3-c3fe83bcde9c","title":"预期：文件夹出现在工作区目录中并可勾选；引用后显示在输入框附件区；Agent 回复中引用到该文件夹内文件的真实内容，不提示找不到文件"}],"collapsed":true,"id":"dd4bfea9-0819-457c-9d1f-8c6a54a2f6b0","title":"🟠【P1】上传完成后可引用且 Agent 可读取"},{"parent":"716f0bfd-d2e2-4269-b055-c84323ea166f","callout":[],"children":[{"parent":"0776e291-c106-4a5a-aa1e-554df0cc068e","callout":[],"children":[],"id":"d545c0e8-8d87-4033-9f31-e5ca64e60f99","title":"前置：前置：本地存在多个文件与文件夹；角色：房间成员；入口：工作区引用面板右上角上传"},{"parent":"0776e291-c106-4a5a-aa1e-554df0cc068e","callout":[],"children":[],"id":"1e6f815b-54f6-46a4-9439-038056ab5bdf","title":"操作：点击上传，在系统窗口中同时选中多个文件和文件夹"},{"parent":"0776e291-c106-4a5a-aa1e-554df0cc068e","callout":[],"children":[],"id":"e2a1b97c-bae6-4001-b33d-7cf53053922c","title":"预期：系统选择窗口允许同时选择文件与文件夹并支持多选；确认后所选项目全部进入上传队列，数量与所选一致"}],"collapsed":true,"id":"0776e291-c106-4a5a-aa1e-554df0cc068e","title":"🟠【P1】上传时可多选文件与文件夹"},{"parent":"716f0bfd-d2e2-4269-b055-c84323ea166f","callout":[],"children":[{"parent":"4d4d2faf-d269-4d55-a5c4-b11796d83250","callout":[],"children":[],"id":"79c92a90-3009-4de5-bd9a-22e34234ff10","title":"前置：前置：已选择本地文件夹上传；角色：房间成员；入口：房间右上角文件传输中心"},{"parent":"4d4d2faf-d269-4d55-a5c4-b11796d83250","callout":[],"children":[],"id":"89b004ca-fb40-4e30-97c8-36bed31db7ae","title":"操作：确认上传后打开传输中心"},{"parent":"4d4d2faf-d269-4d55-a5c4-b11796d83250","callout":[],"children":[],"id":"b6ecd8a1-03f9-49cd-bb8e-107fdc131a0b","title":"预期：传输中心出现该上传任务并显示进度条与文件名；进度实时增长；上传完成后任务状态变为已完成"}],"collapsed":true,"id":"4d4d2faf-d269-4d55-a5c4-b11796d83250","title":"🟠【P1】上传进度在文件传输中心展示"}],"collapsed":true,"id":"716f0bfd-d2e2-4269-b055-c84323ea166f","title":"正常场景（3）"},{"parent":"4efcddab-0782-421f-a4c7-2e7a1a68473e","callout":[],"children":[{"parent":"441acbb8-7b84-4b05-bca3-933874ba9ff7","callout":[],"children":[{"parent":"f39a204c-1fe7-4d7c-9cdc-556537008982","callout":[],"children":[],"id":"3d14d5d8-d26a-41ff-a1ff-2636e837b303","title":"前置：引用面板已打开"},{"parent":"f39a204c-1fe7-4d7c-9cdc-556537008982","callout":[],"children":[],"id":"e11cc4b2-2ad2-4b7c-a12c-c8060a03eda4","title":"操作：选择一个超过大小上限的本地文件上传"},{"parent":"f39a204c-1fe7-4d7c-9cdc-556537008982","callout":[],"children":[],"id":"6e1dcc0f-b670-427f-898f-11bae2068fcb","title":"预期：拦截并提示大小限制，不产生上传失败后无提示的情况"}],"collapsed":true,"id":"f39a204c-1fe7-4d7c-9cdc-556537008982","title":"🟠【P1】上传超出大小限制的文件"}],"collapsed":true,"id":"441acbb8-7b84-4b05-bca3-933874ba9ff7","title":"异常场景（1）"},{"parent":"4efcddab-0782-421f-a4c7-2e7a1a68473e","callout":[],"children":[{"parent":"f5de8838-6594-4dbd-a68a-84b9f99d963c","callout":[],"children":[{"parent":"4aa6fb9a-2029-40af-acb5-a7ed02f9aca2","callout":[],"children":[],"id":"d78aea83-0f31-46e8-b13d-4d622641c989","title":"前置：前置：本地存在总大小超过 5GB 的文件夹；角色：房间成员；入口：工作区引用面板上传入口"},{"parent":"4aa6fb9a-2029-40af-acb5-a7ed02f9aca2","callout":[],"children":[],"id":"cb57e627-b4f9-4b03-b72d-f6c8cd119687","title":"操作：选择该文件夹并确认上传"},{"parent":"4aa6fb9a-2029-40af-acb5-a7ed02f9aca2","callout":[],"children":[],"id":"77253748-b23a-49a9-9379-2dfeaf20b2a1","title":"预期：上传被拦截并提示超过 5GB 大小限制；工作区中不产生半成品文件；重新选择小于上限的文件夹可正常上传"}],"collapsed":true,"id":"4aa6fb9a-2029-40af-acb5-a7ed02f9aca2","title":"🟡【P2】上传超过大小上限"}],"collapsed":true,"id":"f5de8838-6594-4dbd-a68a-84b9f99d963c","title":"边界场景（1）"}],"collapsed":true,"id":"4efcddab-0782-421f-a4c7-2e7a1a68473e","title":"从本地上传"},{"parent":"81e7db44-d1c6-4a04-a149-c60952bd3d6d","callout":[],"children":[{"parent":"f0368661-d13d-4912-93a2-a5618ab6d681","callout":[],"children":[{"parent":"284c2789-e7f2-4fb9-86e2-13a53102b258","callout":[],"children":[{"parent":"9f853645-209b-4f6f-830d-0a29332bebe1","callout":[],"children":[],"id":"0e0863ad-ad64-40fd-bcc5-b9b933a90c7b","title":"前置：前置：本地版工作区引用面板已打开；角色：房间成员；入口：面板左侧分组"},{"parent":"9f853645-209b-4f6f-830d-0a29332bebe1","callout":[],"children":[],"id":"a4917851-0f00-4ce1-b255-949ac580b56b","title":"操作：查看各分组名称与样式"},{"parent":"9f853645-209b-4f6f-830d-0a29332bebe1","callout":[],"children":[],"id":"4f47f5e6-ffb9-43a5-96ec-34a4c7f6dae9","title":"预期：分组名称显示为「房间工作区」与「本地文件(我的电脑)」；不再使用 workspace 与本地文件(宿主机) 的旧称；各分组名称样式保持一致"},{"parent":"9f853645-209b-4f6f-830d-0a29332bebe1","callout":[],"children":[],"id":"dc0b438f-35d5-4a27-95f5-6a9331a6b7d4","title":"备注：#351"}],"collapsed":true,"id":"9f853645-209b-4f6f-830d-0a29332bebe1","title":"🔴【P0】引用面板分组名称与样式"}],"collapsed":true,"id":"284c2789-e7f2-4fb9-86e2-13a53102b258","title":"正常场景（1）"},{"parent":"f0368661-d13d-4912-93a2-a5618ab6d681","callout":[],"children":[{"parent":"5330aa11-d4ed-4aeb-b419-2676a5128434","callout":[],"children":[{"parent":"462e34f6-d3f2-4879-97b6-cb15010f1185","callout":[],"children":[],"id":"7bd4a0c4-1ac0-4a9c-9123-885eceb9955a","title":"前置：某分组下当前没有文件"},{"parent":"462e34f6-d3f2-4879-97b6-cb15010f1185","callout":[],"children":[],"id":"0424c433-9bdb-4c54-a1c3-caded87179aa","title":"操作：查看该分组"},{"parent":"462e34f6-d3f2-4879-97b6-cb15010f1185","callout":[],"children":[],"id":"f59958f7-981f-47aa-b7f4-ed4c11e2e4a8","title":"预期：分组展示空态或自动隐藏，不显示只有标题的空分组"}],"collapsed":true,"id":"462e34f6-d3f2-4879-97b6-cb15010f1185","title":"🟠【P1】分组内无任何内容"}],"collapsed":true,"id":"5330aa11-d4ed-4aeb-b419-2676a5128434","title":"异常场景（1）"},{"parent":"f0368661-d13d-4912-93a2-a5618ab6d681","callout":[],"children":[{"parent":"826f0781-f04b-4ea4-8be7-25dec81fc52a","callout":[],"children":[{"parent":"6927d819-a381-4ba0-bed3-baca18345425","callout":[],"children":[],"id":"a795bec0-6171-41ac-af54-e8897e3554db","title":"前置：工作区产物来源很多导致分组数量大"},{"parent":"6927d819-a381-4ba0-bed3-baca18345425","callout":[],"children":[],"id":"3f0c88ff-ab86-47e9-8984-84ed266c37e9","title":"操作：查看引用面板的分组列表"},{"parent":"6927d819-a381-4ba0-bed3-baca18345425","callout":[],"children":[],"id":"bf3de44a-05ae-4ed2-970b-61b8d801c7d7","title":"预期：分组可折叠与滚动，命名不重复不截断歧义，定位目标分组不困难"}],"collapsed":true,"id":"6927d819-a381-4ba0-bed3-baca18345425","title":"🟡【P2】分组数量很多时的展示"}],"collapsed":true,"id":"826f0781-f04b-4ea4-8be7-25dec81fc52a","title":"边界场景（1）"}],"collapsed":true,"id":"f0368661-d13d-4912-93a2-a5618ab6d681","title":"引用面板分组命名"}],"collapsed":true,"id":"81e7db44-d1c6-4a04-a149-c60952bd3d6d","title":"4.1 工作区引用（+ 号）"},{"parent":"c4ef9eaa-cda4-4bc6-ac33-0871edb469d9","callout":[],"children":[{"parent":"f2258013-9021-4072-8ecb-764dd7c0a361","callout":[],"children":[{"parent":"5701d169-c2c6-45e5-b475-0f3380048dfa","callout":[],"children":[{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"9bf4cd9b-f1c5-458d-827f-fb0208eb4882","callout":[],"children":[],"id":"19669931-d9c4-4b5b-8e9e-80129bd61832","title":"操作：面板已展示且某项被选中，按 Enter"},{"parent":"9bf4cd9b-f1c5-458d-827f-fb0208eb4882","callout":[],"children":[],"id":"8b80bfdc-a701-4e34-93bf-7ca25eb03b67","title":"预期：当前选中项被插入输入框，面板关闭"}],"collapsed":true,"id":"9bf4cd9b-f1c5-458d-827f-fb0208eb4882","title":"🔴【P0】Enter 选择结果"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"f43483ce-151e-47b6-b557-8aafa532f227","callout":[],"children":[],"id":"9088e32b-d065-44a7-b3e9-6cddbd593300","title":"操作：面板已展示且有多条结果，按 ↑ / ↓ 选中项上下移动"},{"parent":"f43483ce-151e-47b6-b557-8aafa532f227","callout":[],"children":[],"id":"cf3f2f90-d8b9-4ca4-a7e3-268d6821d77d","title":"预期：背景高亮同步变化"}],"collapsed":true,"id":"f43483ce-151e-47b6-b557-8aafa532f227","title":"🔴【P0】上下键切换选中项"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"adb53b19-0e56-4465-ac53-abb9486e8f46","callout":[],"children":[],"id":"9f0cfe9b-5f4e-4044-abd8-69a5ba8addc0","title":"操作：已输入 @ 且面板已展示，删除@"},{"parent":"adb53b19-0e56-4465-ac53-abb9486e8f46","callout":[],"children":[],"id":"4b00e92a-c970-4487-a787-b16c0ef65dd2","title":"预期：面板关闭"}],"collapsed":true,"id":"adb53b19-0e56-4465-ac53-abb9486e8f46","title":"🔴【P0】删除 @ 关闭面板"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"ea95e520-a668-4f3a-9740-940c2520e83d","callout":[],"children":[],"id":"50c3604a-da15-4f40-b606-cc39611fe9f5","title":"操作：将光标置于 token 右侧，按 Backspace"},{"parent":"ea95e520-a668-4f3a-9740-940c2520e83d","callout":[],"children":[],"id":"dbd29c08-2261-4d59-9b2a-34bd2b31355e","title":"预期：整个 token 作为一个单元被删除（不是只删最后一个字符）"}],"collapsed":true,"id":"ea95e520-a668-4f3a-9740-940c2520e83d","title":"🔴【P0】删除已插入的 ref token"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"79ab76f1-95a3-4b78-9292-79316c4657e0","callout":[],"children":[],"id":"6203c839-94dd-46bf-b157-178e995cbc5a","title":"前置：前置：@ 面板已打开；角色：房间成员；入口：@ 面板 Tab"},{"parent":"79ab76f1-95a3-4b78-9292-79316c4657e0","callout":[],"children":[],"id":"8cf8e813-9e23-4f03-be76-42dc7aa3a30c","title":"操作：在会话 Tab 下按某成员筛选，切换到文件 Tab 查看筛选状态"},{"parent":"79ab76f1-95a3-4b78-9292-79316c4657e0","callout":[],"children":[],"id":"7fc0f3fb-cfda-4dc6-a9c0-b27633f82fe1","title":"预期：文件 Tab 保持默认全部筛选状态，不继承会话 Tab 的筛选条件；切回会话 Tab 时其筛选条件仍保留"},{"parent":"79ab76f1-95a3-4b78-9292-79316c4657e0","callout":[],"children":[],"id":"e2c62856-4a63-4601-bbe5-256e1f748103","title":"备注：#353"}],"collapsed":true,"id":"79ab76f1-95a3-4b78-9292-79316c4657e0","title":"🔴【P0】各 Tab 筛选条件相互独立"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"99197d8a-74ab-4c00-8ca8-4805b78ca977","callout":[],"children":[],"id":"1e5b1061-a3d3-455e-b81e-e35dc0eaee89","title":"操作：输入框可编辑，输入 @ 选择一个结果，再输入 @ 选择第二个"},{"parent":"99197d8a-74ab-4c00-8ca8-4805b78ca977","callout":[],"children":[],"id":"7cf5da27-b4c1-4de1-a294-214ea8fe5591","title":"预期：可插入多个引用，顺序正确"}],"collapsed":true,"id":"99197d8a-74ab-4c00-8ca8-4805b78ca977","title":"🔴【P0】多次引用"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"56421e31-16f6-48dc-9afb-77c084a7fd86","callout":[],"children":[],"id":"17328b6f-601a-4cce-afa9-259579f3648e","title":"操作：面板已展开，点击输入框外区域"},{"parent":"56421e31-16f6-48dc-9afb-77c084a7fd86","callout":[],"children":[],"id":"5c4e8bbe-34ef-48e5-841d-387507ab7b07","title":"预期：面板一直显示"}],"collapsed":true,"id":"56421e31-16f6-48dc-9afb-77c084a7fd86","title":"🔴【P0】失焦不关闭面板"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"5302af9b-fc7b-485d-a3be-4b79754f93f2","callout":[],"children":[],"id":"c45a26e4-045f-4c57-8e67-80ee007fd7cb","title":"操作：存在会话或文件结果，打开面板"},{"parent":"5302af9b-fc7b-485d-a3be-4b79754f93f2","callout":[],"children":[],"id":"0852f137-4422-4174-b6b2-0513cfb3a346","title":"预期：头像、应用图标、文件图标展示正确，不错位"}],"collapsed":true,"id":"5302af9b-fc7b-485d-a3be-4b79754f93f2","title":"🔴【P0】头像/图标展示"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"d80f2522-1f45-41e0-95f7-3de7ac0f1304","callout":[],"children":[],"id":"4ba2fb7d-853b-4afa-8795-c0761ffe0e98","title":"前置：前置：@ 面板已打开；角色：房间成员；入口：@ 面板应用分类"},{"parent":"d80f2522-1f45-41e0-95f7-3de7ac0f1304","callout":[],"children":[],"id":"7a52a780-9a16-4483-8b0d-f5158615da65","title":"操作：查看应用分类下的条目"},{"parent":"d80f2522-1f45-41e0-95f7-3de7ac0f1304","callout":[],"children":[],"id":"58f2049d-3ccf-4e59-a8bb-1df6a25d37e2","title":"预期：应用分类下不再展示任务中心条目；其余应用正常展示且可被引用；历史消息中已存在的任务中心引用仍可正常渲染"},{"parent":"d80f2522-1f45-41e0-95f7-3de7ac0f1304","callout":[],"children":[],"id":"31452fa6-c551-4290-a592-d1aca8f3b24f","title":"备注：#59"}],"collapsed":true,"id":"d80f2522-1f45-41e0-95f7-3de7ac0f1304","title":"🔴【P0】应用分类下移除任务中心"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"05dcf87a-4701-431b-9b80-406422cdd789","callout":[],"children":[],"id":"ec620a20-a86b-455f-930e-612fdec2b0ab","title":"操作：已选择某条结果，查看输入框内容"},{"parent":"05dcf87a-4701-431b-9b80-406422cdd789","callout":[],"children":[],"id":"142dc9d6-7c0d-4264-b4f5-9e367c3fcbea","title":"预期：输入框内出现蓝色标签 token（如 @task.txt）；token 为一个整体不可局部编辑；光标移到 token 右侧可继续输入"}],"collapsed":true,"id":"05dcf87a-4701-431b-9b80-406422cdd789","title":"🔴【P0】插入内容格式"},{"parent":"5e928d22-5e15-4469-b33e-754522f66e8c","callout":[],"children":[{"parent":"22fc9a22-e152-4601-8e22-10f19d172d0f","callout":[],"children":[],"id":"e