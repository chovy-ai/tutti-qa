fd-0fc2dfac1c90","title":"预期：另一个 Agent 正常运行，退出 Agent 状态准确更新"}],"collapsed":true,"id":"986abfc1-7d90-4de3-874e-b89174c52bb7","title":"🟡【P2】一个Agent异常退出","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"c4fcaef9-5dfc-4b41-b540-bd081c54c1e0","title":"异常场景（7）"},{"parent":"691e777a-ebe2-43be-b9e5-f7e31ba09d7c","callout":[],"children":[{"parent":"220dbb60-8a0e-48ae-834d-2edcbf56870a","callout":[],"children":[{"parent":"7df0724a-b73d-48c3-bd45-6ad022a4bd2f","callout":[],"children":[],"id":"3c1548b9-4ffb-42bd-86c5-089f785cf7d7","title":"操作：3个Agent 分工处理同一任务的不同部分"},{"parent":"7df0724a-b73d-48c3-bd45-6ad022a4bd2f","callout":[],"children":[],"id":"410a7b5c-c5fa-4507-b021-c9ec16aa582d","title":"预期：3个Agent能共同完成一个任务"}],"collapsed":true,"id":"7df0724a-b73d-48c3-bd45-6ad022a4bd2f","title":"🟡【P2】3个Agent 分工处理同一任务的不同部分","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"220dbb60-8a0e-48ae-834d-2edcbf56870a","callout":[],"children":[{"parent":"c7c6c06d-2790-4d8b-9867-716b8df33176","callout":[],"children":[],"id":"79470bfb-d5b5-4756-91c2-f1ee08064e97","title":"操作：两个 Agent 同时执行超过 30 分钟的任务"},{"parent":"c7c6c06d-2790-4d8b-9867-716b8df33176","callout":[],"children":[],"id":"0506ae66-80dd-4cfd-9db7-655e858ad551","title":"预期：状态和日志持续可追踪，断线恢复后不混淆"}],"collapsed":true,"id":"c7c6c06d-2790-4d8b-9867-716b8df33176","title":"🟡【P2】协同长任务","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"220dbb60-8a0e-48ae-834d-2edcbf56870a","callout":[],"children":[{"parent":"f3bc9492-db19-4277-92bd-ac95f3b02be3","callout":[],"children":[],"id":"acbe8154-b170-48ba-bb0f-34329733476e","title":"操作：不同 Agent 创建相同标题会话"},{"parent":"f3bc9492-db19-4277-92bd-ac95f3b02be3","callout":[],"children":[],"id":"24102f97-c9aa-43a6-ae0e-b9b4bb1420d5","title":"预期：历史列表用 Agent 类型或时间区分，不误打开"}],"collapsed":true,"id":"f3bc9492-db19-4277-92bd-ac95f3b02be3","title":"🟡【P2】同名会话协同","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"220dbb60-8a0e-48ae-834d-2edcbf56870a","callout":[],"children":[{"parent":"3177bafc-9982-4f0d-bc84-35b9a9e483af","callout":[],"children":[],"id":"d4965cb7-1a6d-4774-8ac8-5764f9dffec5","title":"操作：同时打开 10 个 标签页，新建会话"},{"parent":"3177bafc-9982-4f0d-bc84-35b9a9e483af","callout":[],"children":[],"id":"a4b21b16-e9f9-4484-a4b4-2f3834bfe638","title":"预期：窗口状态和资源占用可控，历史列表不混乱"}],"collapsed":true,"id":"3177bafc-9982-4f0d-bc84-35b9a9e483af","title":"🟡【P2】大量Agent窗口","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"220dbb60-8a0e-48ae-834d-2edcbf56870a","callout":[],"children":[{"parent":"09c4cb63-8028-4ef4-a761-11d263541041","callout":[],"children":[],"id":"b9a933c0-d05c-4faf-ab87-3ddc55517d53","title":"操作：频繁在不同 Agent 窗口之间切换"},{"parent":"09c4cb63-8028-4ef4-a761-11d263541041","callout":[],"children":[],"id":"2788a96c-71f5-4990-b965-c07207ed3ff3","title":"预期：焦点、输入框和快捷键作用于当前窗口"}],"collapsed":true,"id":"09c4cb63-8028-4ef4-a761-11d263541041","title":"🟡【P2】快速切换活跃Agent","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]}],"collapsed":true,"id":"220dbb60-8a0e-48ae-834d-2edcbf56870a","title":"边界场景（6）"}],"collapsed":true,"id":"691e777a-ebe2-43be-b9e5-f7e31ba09d7c","title":"多 Agent 并行协作"}],"collapsed":true,"id":"896675a0-1d3f-4da1-a749-c0fea396cff3","title":"多 Agent 并行"}],"collapsed":true,"id":"48b94977-fd2b-424c-8111-6d77d3db1d79","title":"多会话与多 Agent 协同"},{"parent":"28a940bb-0eef-4cac-8062-351774ac194f","callout":[],"lineStyle":{},"children":[{"parent":"e471657d-c7ae-4c32-a7b9-91502e633f2b","callout":[],"children":[{"parent":"d0cd3c20-647f-45e7-9819-618c3ac188c5","customWidth":538.4,"callout":[],"children":[],"id":"b29b8e86-f79e-4fdf-8fef-6a03f9821991","title":"类型清单：<br>文档：document + spreadsheet + presentation + pdf + markdowndoc docm docx odt pages rtf txt；csv numbers ods tsv xls xlsm xlsx；key odp ppt pptm pptx；pdf；md markdown mdx<br>图片：imageavif bmp gif heic heif ico jpeg jpg png svg tif tiff webp<br>视频：video 3gp avi flv m4v mkv mov mp4 mpeg mpg webm wmv<br>网页：website htm html mhtml url webloc xhtml<br>其他：audio + code + other见下面说明"}],"collapsed":true,"id":"d0cd3c20-647f-45e7-9819-618c3ac188c5","title":"说明：一条链路一次测完，不拆成输出与预览两处：让 Agent 产出该类型文件 → 对话流里给出可点击的链接或可预览的样式 → 点开进入右侧面板预览 → 预览页可下载。按类型各一条，把该类的全部扩展名写在操作里"},{"parent":"e471657d-c7ae-4c32-a7b9-91502e633f2b","callout":[],"children":[{"parent":"36596c63-0b00-4045-a709-3c4dc36b18cb","callout":[],"children":[],"id":"dc82a119-2863-4303-b910-6e865ae4fb90","title":"说明：产物在对话流底部以卡片展示，不区分命令还是工具执行产生，但只交付最终产物不给中间产物；卡片可下载与分享，底部「查看所有产物」打开右侧面板"},{"parent":"36596c63-0b00-4045-a709-3c4dc36b18cb","callout":[],"children":[{"parent":"a01ac22c-1533-4e4c-8b29-be206d03bf15","callout":[],"children":[{"parent":"f433de2e-49e9-434e-8fe7-8b344ae08a1f","callout":[],"children":[],"id":"9b1f75a6-6383-4cef-ad8d-831d6a9e8286","title":"前置：Agent 已完成一次会产出文件的任务；角色：房间成员；入口：会话对话流"},{"parent":"f433de2e-49e9-434e-8fe7-8b344ae08a1f","callout":[],"children":[],"id":"9b50be78-2b68-4deb-81f3-4ca0c4fb9483","title":"操作：查看回复底部"},{"parent":"f433de2e-49e9-434e-8fe7-8b344ae08a1f","callout":[],"children":[],"id":"025adc0b-3db3-4969-9398-5f0ce0377cef","title":"预期：\n1) 列表展示 ｜ 以卡片形式横向排列展示本次产物，每张展示文件名、类型与大小\n2) 视觉展示 ｜ 图标与文件类型对应，超长文件名截断可读"},{"parent":"f433de2e-49e9-434e-8fe7-8b344ae08a1f","callout":[],"children":[],"id":"e2673bec-29f4-43e2-9cdb-c1a103a1f5ec","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"f433de2e-49e9-434e-8fe7-8b344ae08a1f","title":"🔴【P0】对话流底部展示产物卡片"},{"parent":"a01ac22c-1533-4e4c-8b29-be206d03bf15","callout":[],"children":[{"parent":"018eb498-ec54-44f3-96a2-8710ac847a36","callout":[],"children":[],"id":"add9ac94-8421-4430-bd01-8359db2bf7c3","title":"前置：一次任务里既有命令直接生成的文件，也有工具调用生成的文件；角色：房间成员；入口：对话流"},{"parent":"018eb498-ec54-44f3-96a2-8710ac847a36","callout":[],"children":[],"id":"45f72ce8-9bd2-4728-adbd-b8f9465fa9d1","title":"操作：查看产物卡片区"},{"parent":"018eb498-ec54-44f3-96a2-8710ac847a36","callout":[],"children":[],"id":"550d4722-c44e-409b-8fcd-e0f527489bc9","title":"预期：\n1) 列表展示 ｜ 两类产物都出现在卡片区，不区分来源\n2) 结果校验 ｜ 卡片数量与本次实际交付的文件数一致"},{"parent":"018eb498-ec54-44f3-96a2-8710ac847a36","callout":[],"children":[],"id":"938b654d-48e2-41c8-990a-5af1164f07bd","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"018eb498-ec54-44f3-96a2-8710ac847a36","title":"🔴【P0】命令与工具产生的产物都展示"},{"parent":"a01ac22c-1533-4e4c-8b29-be206d03bf15","callout":[],"children":[{"parent":"d6edcfd6-eaba-4d5a-addf-d4c8b2acc71a","callout":[],"children":[],"id":"5fa1cd78-7c0d-4e7c-b56e-620843319149","title":"前置：任务过程中产生了临时文件、中间版本与最终文件；角色：房间成员；入口：对话流"},{"parent":"d6edcfd6-eaba-4d5a-addf-d4c8b2acc71a","callout":[],"children":[],"id":"f8b59c3b-3fa0-4a23-a723-98105cef6fba","title":"操作：查看产物卡片区"},{"parent":"d6edcfd6-eaba-4d5a-addf-d4c8b2acc71a","callout":[],"children":[],"id":"4c2a2858-d2be-4135-9a91-528a3a275394","title":"预期：\n1) 列表展示 ｜ 只展示最终交付的文件，中间产物不出现在卡片区\n2) 结果校验 ｜ 这是本条需求的核心，卡片区被中间产物刷屏即视为缺陷"},{"parent":"d6edcfd6-eaba-4d5a-addf-d4c8b2acc71a","callout":[],"children":[],"id":"6c8202a5-ad8b-45e0-bb0f-43731a4153e0","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"d6edcfd6-eaba-4d5a-addf-d4c8b2acc71a","title":"🔴【P0】只交付最终产物"},{"parent":"a01ac22c-1533-4e4c-8b29-be206d03bf15","callout":[],"children":[{"parent":"bf21012a-d3d3-4d3c-8488-f62694364980","callout":[],"children":[],"id":"f52940ad-4aea-4927-96e2-28adfb066191","title":"前置：产物卡片已展示；角色：房间成员；入口：卡片上的下载图标"},{"parent":"bf21012a-d3d3-4d3c-8488-f62694364980","callout":[],"children":[],"id":"7544f2a3-ae6e-4cb3-b789-57c0b4268611","title":"操作：点击下载"},{"parent":"bf21012a-d3d3-4d3c-8488-f62694364980","callout":[],"children":[],"id":"851539b1-13c7-4a3f-b5f8-0a3469e0ffeb","title":"预期：\n1) 文件落盘 ｜ 文件下载到本地，文件名与卡片展示一致\n2) 结果校验 ｜ 内容与预览一致"},{"parent":"bf21012a-d3d3-4d3c-8488-f62694364980","callout":[],"children":[],"id":"5c15873e-3ebc-4840-9f1e-c16cc12feeec","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"bf21012a-d3d3-4d3c-8488-f62694364980","title":"🔴【P0】卡片上的下载"},{"parent":"a01ac22c-1533-4e4c-8b29-be206d03bf15","callout":[],"children":[{"parent":"58083abf-bb93-47dc-8ae3-78385bf275be","callout":[],"children":[],"id":"dfc38140-1892-42b0-bc5d-1f8841dbb81e","title":"前置：产物卡片已展示；角色：房间成员；入口：卡片上的分享图标"},{"parent":"58083abf-bb93-47dc-8ae3-78385bf275be","callout":[],"children":[],"id":"638c62b1-38ae-4e9b-8129-c9a14acbcde7","title":"操作：点击分享"},{"parent":"58083abf-bb93-47dc-8ae3-78385bf275be","callout":[],"children":[],"id":"efc5e178-6d5d-43e5-87c4-62ced76450e8","title":"预期：\n1) 跳转定位 ｜ 打开该文件的分享弹窗\n2) 结果校验 ｜ 与从文件中心或右侧面板分享同一个文件的弹窗内容一致"},{"parent":"58083abf-bb93-47dc-8ae3-78385bf275be","callout":[],"children":[],"id":"7bd00174-d756-41cb-bcb7-214d6ed86a2e","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"58083abf-bb93-47dc-8ae3-78385bf275be","title":"🔴【P0】卡片上的分享"},{"parent":"a01ac22c-1533-4e4c-8b29-be206d03bf15","callout":[],"children":[{"parent":"7d9bea60-95d5-4d3c-9461-2e22432459cd","callout":[],"children":[],"id":"2c922976-2320-4b4b-b890-6556c6849d99","title":"前置：对话流底部有「查看所有产物」入口；角色：房间成员；入口：该入口"},{"parent":"7d9bea60-95d5-4d3c-9461-2e22432459cd","callout":[],"children":[],"id":"eb701068-7bf1-430f-a967-fc25827b43ec","title":"操作：点击「查看所有产物」"},{"parent":"7d9bea60-95d5-4d3c-9461-2e22432459cd","callout":[],"children":[],"id":"36921407-956b-4b08-a74c-5ca1d21bd138","title":"预期：\n1) 跳转定位 ｜ 打开右侧面板并定位到产物区\n2) 列表展示 ｜ 产物区展示的内容与对话流卡片对得上，且包含该会话的全部产物"},{"parent":"7d9bea60-95d5-4d3c-9461-2e22432459cd","callout":[],"children":[],"id":"8abb3dcf-a54a-4254-9874-b0516c8a0e17","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"7d9bea60-95d5-4d3c-9461-2e22432459cd","title":"🔴【P0】查看所有产物打开右侧面板"}],"collapsed":true,"id":"a01ac22c-1533-4e4c-8b29-be206d03bf15","title":"正常场景（8）"},{"parent":"36596c63-0b00-4045-a709-3c4dc36b18cb","callout":[],"children":[{"parent":"92406f01-d162-46cb-8589-1f4a35da6209","callout":[],"children":[{"parent":"2c4fd9d8-925a-47ce-bf92-1a695853d0ae","callout":[],"children":[],"id":"e5d6cc3b-1ca4-4dc4-98b5-46f1f9aa7ab7","title":"前置：产物卡片已展示，此时文件在本地被删除；角色：房间成员；入口：卡片"},{"parent":"2c4fd9d8-925a-47ce-bf92-1a695853d0ae","callout":[],"children":[],"id":"0b28f26c-9e94-4547-9ad3-776a59869bab","title":"操作：点击卡片、下载与分享"},{"parent":"2c4fd9d8-925a-47ce-bf92-1a695853d0ae","callout":[],"children":[],"id":"a7c9027d-e38e-4e71-bc2a-bcece455c562","title":"预期：\n1) 提示文案 ｜ 明确提示文件已不存在\n2) 副作用 ｜ 不下载出零字节文件，分享不生成指向空文件的链接"},{"parent":"2c4fd9d8-925a-47ce-bf92-1a695853d0ae","callout":[],"children":[],"id":"42f7c817-ca73-46f0-9ea6-4dd9b2198ea1","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"2c4fd9d8-925a-47ce-bf92-1a695853d0ae","title":"🔴【P0】产物文件已被删除"},{"parent":"92406f01-d162-46cb-8589-1f4a35da6209","callout":[],"children":[{"parent":"442af501-05b1-4e00-8709-ffebc21dc3ae","callout":[],"children":[],"id":"02bea18c-03bd-4aed-a7aa-27ec923fc482","title":"前置：Agent 完成了一次不产出文件的任务；角色：房间成员；入口：对话流"},{"parent":"442af501-05b1-4e00-8709-ffebc21dc3ae","callout":[],"children":[],"id":"88011ff1-9ace-4deb-b711-76faea2aee23","title":"操作：查看回复底部"},{"parent":"442af501-05b1-4e00-8709-ffebc21dc3ae","callout":[],"children":[],"id":"7467a864-64cc-4dea-ae65-145029d42a56","title":"预期：\n1) 视觉展示 ｜ 不展示空的卡片区与「查看所有产物」入口\n2) 副作用 ｜ 不出现只有边框没有内容的占位"},{"parent":"442af501-05b1-4e00-8709-ffebc21dc3ae","callout":[],"children":[],"id":"6b63c451-cd4b-476b-bc1d-8ebe8b5563e4","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"442af501-05b1-4e00-8709-ffebc21dc3ae","title":"🟠【P1】本次任务没有产物"}],"collapsed":true,"id":"92406f01-d162-46cb-8589-1f4a35da6209","title":"异常场景（2）"},{"parent":"36596c63-0b00-4045-a709-3c4dc36b18cb","callout":[],"children":[{"parent":"fcd5ab96-cda6-4f44-bd4b-b210107bc899","callout":[],"children":[{"parent":"533ffe6c-d2bb-4048-937d-a742314fc56d","callout":[],"children":[],"id":"c3b902f6-aa5c-4893-9da4-849f5103b8f3","title":"前置：我进入成员 B 的会话且其中有产物；角色：成员 A；入口：对话流"},{"parent":"533ffe6c-d2bb-4048-937d-a742314fc56d","callout":[],"children":[],"id":"0e26df18-41de-4427-9229-9a4662e2df24","title":"操作：查看并操作卡片"},{"parent":"533ffe6c-d2bb-4048-937d-a742314fc56d","callout":[],"children":[],"id":"804226e4-68a2-4dbc-abf5-0ab50c216fe1","title":"预期：\n1) 权限授权 ｜ 卡片正常展示，下载与分享按会话权限判定是否可用\n2) 结果校验 ｜ 与自己会话中的表现一致"},{"parent":"533ffe6c-d2bb-4048-937d-a742314fc56d","callout":[],"children":[],"id":"4567e9fd-a15b-41e2-88a6-6daf194b3a74","title":"备注：产物在对话流底部以卡片形式展示，不区分是命令产生的还是工具执行产生的，都会展示；但 Agent 只交付最终产物，不把中间产物给用户。每张卡片有下载与分享，底部有「查看所有产物」入口"}],"collapsed":true,"id":"533ffe6c-d2bb-4048-937d-a742314fc56d","title":"🟡【P2】他人会话中的产物卡片"}],"collapsed":true,"id":"fcd5ab96-cda6-4f44-bd4b-b210107bc899","title":"边界场景（2）"}],"collapsed":true,"id":"36596c63-0b00-4045-a709-3c4dc36b18cb","title":"产物卡片与交付口径"},{"parent":"e471657d-c7ae-4c32-a7b9-91502e633f2b","callout":[],"children":[{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"37166cce-03ec-4c0a-ae30-907bd44b3af7","callout":[],"children":[],"id":"c45d5233-a45c-4e67-b4da-ded87b897b81","title":"前置：会话中让 Agent 生成一个文件；角色：房间成员；入口：会话对话流"},{"parent":"37166cce-03ec-4c0a-ae30-907bd44b3af7","callout":[],"children":[],"id":"454f75a9-f60f-441d-aab7-09a8d022d085","title":"操作：发送一条会产出文件的指令，等待完成后点击对话流里的产物"},{"parent":"37166cce-03ec-4c0a-ae30-907bd44b3af7","callout":[],"children":[],"id":"19915953-b519-4309-8bf4-90834b970701","title":"预期：\n1) 结果回传 ｜ 对话流里给出可点击的产物链接或卡片，不只是一句已生成\n2) 跳转定位 ｜ 点击后直接打开右侧面板的预览，不需要用户自己去产物区或工作区找\n3) 归属与顺序 ｜ 打开的就是本次产出的那个文件，不指向同名旧文件"}],"collapsed":true,"id":"37166cce-03ec-4c0a-ae30-907bd44b3af7","title":"🔴【P0】产出后在对话流给出可点击的产物"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"ee1fc9bc-fb8a-4a51-9662-1176f15d97cd","callout":[],"children":[],"id":"1e8acce5-be66-4f10-adea-4f944eab2911","title":"前置：让 Agent 一次生成多个文件；角色：房间成员；入口：会话对话流与产物区"},{"parent":"ee1fc9bc-fb8a-4a51-9662-1176f15d97cd","callout":[],"children":[],"id":"69f76200-829f-410e-88dc-0bd2f1fe86a9","title":"操作：发送指令，完成后逐个点开"},{"parent":"ee1fc9bc-fb8a-4a51-9662-1176f15d97cd","callout":[],"children":[],"id":"189f7f84-0ddc-45a1-8b2a-fc3505f125f6","title":"预期：\n1) 结果回传 ｜ 每个文件都有各自的入口，数量与实际产出一致\n2) 列表展示 ｜ 与右侧面板产物区里的条目一一对应，不多不少\n3) 产物预览 ｜ 每个都能点开预览"}],"collapsed":true,"id":"ee1fc9bc-fb8a-4a51-9662-1176f15d97cd","title":"🔴【P0】一次产出多个文件"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"066e9ad4-9472-488f-855d-ab788e095f85","callout":[],"children":[],"id":"f16cb287-8842-4d44-88aa-4a70d89364f0","title":"前置：Agent 已产出一个文件；角色：房间成员；入口：三处"},{"parent":"066e9ad4-9472-488f-855d-ab788e095f85","callout":[],"children":[],"id":"cfb7ebec-f053-49fa-bedc-3a1b1c5ae1c6","title":"操作：从三处分别打开该文件"},{"parent":"066e9ad4-9472-488f-855d-ab788e095f85","callout":[],"children":[],"id":"cbe70a10-981c-49fe-a5ae-cb4cc17980ea","title":"预期：\n1) 结果校验 ｜ 三处指向同一个文件，文件名、大小与内容一致\n2) 产物预览 ｜ 三处打开后的预览与下载表现一致"}],"collapsed":true,"id":"066e9ad4-9472-488f-855d-ab788e095f85","title":"🟠【P1】对话流、产物区、文件中心三处一致"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"67d856eb-5e33-4796-b2f4-9ca8c4b41e27","callout":[],"children":[],"id":"90938bd9-0a69-481f-b4c1-4abd03c48f74","title":"前置：让 Agent 生成一个文件夹或压缩包；角色：房间成员；入口：会话对话流"},{"parent":"67d856eb-5e33-4796-b2f4-9ca8c4b41e27","callout":[],"children":[],"id":"1006dbaf-e060-43c6-bcc3-488874439f17","title":"操作：点击对话流里给出的入口"},{"parent":"67d856eb-5e33-4796-b2f4-9ca8c4b41e27","callout":[],"children":[],"id":"550bddff-9f3c-4718-8390-0d776975417c","title":"预期：\n1) 跳转定位 ｜ 进入目录或触发下载，按类型给出唯一结论\n2) 提示文案 ｜ 不可直接预览的类型说明可以下载查看"}],"collapsed":true,"id":"67d856eb-5e33-4796-b2f4-9ca8c4b41e27","title":"🟠【P1】产出目录或压缩包"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"5c2762f6-0861-4db3-8b3f-fa3bf6a969ba","callout":[],"children":[],"id":"3554169b-086b-42d2-bcff-2bc7eead0828","title":"前置：让 Agent 分别产出 docx、doc、odt、rtf、txt、pages 各一份；角色：房间成员；入口：对话流与预览页"},{"parent":"5c2762f6-0861-4db3-8b3f-fa3bf6a969ba","callout":[],"children":[],"id":"8ad0dd2d-6faa-4580-ad71-78e855390744","title":"操作：逐个点开预览并下载"},{"parent":"5c2762f6-0861-4db3-8b3f-fa3bf6a969ba","callout":[],"children":[],"id":"26b257fe-79b5-425c-b5e6-2b3d64193ba8","title":"预期：<br>1) 结果回传 ｜ 对话流里每个都给出可点击入口<br>2) 产物预览 ｜ 各格式都能打开预览，正文、标题与段落排版可读<br>3) 文件落盘 ｜ 下载后的文件能被本地对应应用正常打开"}],"collapsed":true,"id":"5c2762f6-0861-4db3-8b3f-fa3bf6a969ba","title":"🔴【P0】文档类：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"dee69bc2-b7f1-45ba-82bc-14ecb08ec697","callout":[],"children":[],"id":"6dc23867-b735-4c82-bb44-727062499020","title":"前置：让 Agent 分别产出 xlsx、xls、xlsm、csv、tsv、ods、numbers 各一份；角色：房间成员；入口：对话流与预览页"},{"parent":"dee69bc2-b7f1-45ba-82bc-14ecb08ec697","callout":[],"children":[],"id":"bd04b954-a1a9-4a78-904a-816b8019a417","title":"操作：逐个点开预览并下载"},{"parent":"dee69bc2-b7f1-45ba-82bc-14ecb08ec697","customWidth":424.4,"callout":[],"children":[],"id":"40a18605-aaf4-474d-8333-3fb7c1a0b4fb","title":"预期：<br>1) 结果回传 ｜ 对话流里每个都给出可点击入口<br>2) 产物预览 ｜ 能按行列渲染，多 sheet 的能切换<br>3) 消息渲染 ｜ 中文与特殊字符不乱码，数字与日期格式不被破坏<br>4) 文件落盘 ｜ 下载后用本地表格应用打开内容一致"}],"collapsed":true,"id":"dee69bc2-b7f1-45ba-82bc-14ecb08ec697","title":"🔴【P0】表格类：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"7c0240fa-8192-49f8-a133-ea22a4829b7a","callout":[],"children":[],"id":"713dc38f-5717-4c89-a29d-78235aed11dd","title":"前置：让 Agent 分别产出 pptx、ppt、pptm、odp、key 各一份；角色：房间成员；入口：对话流与预览页"},{"parent":"7c0240fa-8192-49f8-a133-ea22a4829b7a","callout":[],"children":[],"id":"4677e727-072b-4da6-9c57-e730ffadfa2c","title":"操作：逐个点开预览并下载"},{"parent":"7c0240fa-8192-49f8-a133-ea22a4829b7a","callout":[],"children":[],"id":"fd191aec-8d57-4482-859f-05ac27457e7c","title":"预期：<br>1) 结果回传 ｜ 最后输出可点击的链接<br>2) 产物预览 ｜ 能按页预览并可翻页，页数与实际一致<br>3) 视觉展示 ｜ 字体缺失时有兜底，不出现整页空白<br>4) 文件落盘 ｜ 下载后可正常打开"}],"collapsed":true,"id":"7c0240fa-8192-49f8-a133-ea22a4829b7a","title":"🔴【P0】演示类：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"1799cde7-3e86-40e1-9cc4-edb4334647c4","callout":[],"children":[],"id":"51793d11-7413-4163-ac89-94d1393e62f1","title":"前置：让 Agent 产出一份多页 PDF；角色：房间成员；入口：对话流与预览页"},{"parent":"1799cde7-3e86-40e1-9cc4-edb4334647c4","callout":[],"children":[],"id":"52a4ded1-b5c8-44db-9622-c307208f537b","title":"操作：点开预览、翻页并下载"},{"parent":"1799cde7-3e86-40e1-9cc4-edb4334647c4","callout":[],"children":[],"id":"fd073733-d3d4-46b3-b855-0c169b6eb4fb","title":"预期：<br>1) 结果回传 ｜ 最后输出可点击的链接<br>2) 产物预览 ｜ 可分页浏览、可缩放，页数与实际一致<br>3) 性能 ｜ 多页 PDF 打开不卡死，滚动流畅<br>4) 文件落盘 ｜ 下载后可正常打开"}],"collapsed":true,"id":"1799cde7-3e86-40e1-9cc4-edb4334647c4","title":"🔴【P0】PDF：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"aaea73af-d3c0-4d9d-87b5-280f8e387c3a","callout":[],"children":[],"id":"55c7acb3-4f39-45ea-b6c3-d79f08f907f5","title":"前置：让 Agent 分别产出 md、markdown、mdx 各一份；角色：房间成员；入口：对话流与预览页"},{"parent":"aaea73af-d3c0-4d9d-87b5-280f8e387c3a","callout":[],"children":[],"id":"58256776-bf7a-4364-a6ae-9152d3c71cfe","title":"操作：逐个点开预览并下载"},{"parent":"aaea73af-d3c0-4d9d-87b5-280f8e387c3a","callout":[],"children":[],"id":"4bc8de9e-b2a4-459e-97a1-38ec4a819f3c","title":"预期：<br>1) 消息渲染 ｜ 按 Markdown 渲染而不是展示源码，标题、列表、表格、代码块都正确<br>2) 产物预览 ｜ mdx 的自定义语法按产品定义渲染或降级为纯文本，不报错<br>3) 文件落盘 ｜ 下载后可正常打开"}],"collapsed":true,"id":"aaea73af-d3c0-4d9d-87b5-280f8e387c3a","title":"🔴【P0】Markdown：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"87651044-3252-452c-8d02-68c414a8b907","callout":[],"children":[],"id":"97ab0645-6b99-4de8-a0c6-0609e5264a13","title":"前置：让 Agent 分别产出 png、jpg、jpeg、gif、webp、svg、bmp、ico、tif、tiff、avif、heic、heif 各一份；角色：房间成员；入口：对话流与预览页"},{"parent":"87651044-3252-452c-8d02-68c414a8b907","callout":[],"children":[],"id":"ec60caa8-b11f-4652-82ad-64122dc8a36b","title":"操作：先看对话流里的展示，再逐个点开预览并下载"},{"parent":"87651044-3252-452c-8d02-68c414a8b907","customWidth":448.4,"callout":[],"children":[],"id":"32585324-309b-436e-9ee7-8d9d96efebf7","title":"预期：<br>1) 消息渲染 ｜ 对话流里直接内嵌缩略图，可点击放大<br>2) 产物预览 ｜ 各格式都能正常显示，gif 能播放动画，svg 按矢量渲染<br>3) 提示文案 ｜ heic、heif、avif 这类浏览器兼容性差的格式，不支持时给出说明与下载入口"}],"collapsed":true,"id":"87651044-3252-452c-8d02-68c414a8b907","title":"🔴【P0】图片类：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"55995902-4b04-4cc1-bfb0-fc3cff7d9536","callout":[],"children":[],"id":"ba5967b8-bdb3-4fe3-86f8-895c8399cfab","title":"前置：让 Agent 分别产出 mp4、mov、webm、mkv、avi、flv、m4v、mpeg、mpg、wmv、3gp 各一份；角色：房间成员；入口：对话流与预览页"},{"parent":"55995902-4b04-4cc1-bfb0-fc3cff7d9536","callout":[],"children":[],"id":"6456c148-baee-4c7e-90d9-5feb6ecc7814","title":"操作：逐个点开预览、播放并下载"},{"parent":"55995902-4b04-4cc1-bfb0-fc3cff7d9536","callout":[],"children":[],"id":"3c46b875-b4fc-46d8-8095-4cdd1c041125","title":"预期：<br>1) 结果回传 ｜ 最后输出可点击的链接<br>2) 产物预览 ｜ 可播放的格式能正常播放并有进度控制<br>3) 提示文案 ｜ 浏览器不支持的编码格式给出明确说明与下载入口，不是黑屏或无限加载<br>4) 文件落盘 ｜ 下载后可正常打开"}],"collapsed":true,"id":"55995902-4b04-4cc1-bfb0-fc3cff7d9536","title":"🔴【P0】视频类：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"2c546063-2c66-49b9-a344-8d8ffedbe2ca","callout":[],"children":[],"id":"d6aeff68-74fa-47fb-a277-aa8aba5ec486","title":"前置：让 Agent 分别产出 html、htm、xhtml、mhtml、url、webloc 各一份；角色：房间成员；入口：对话流与预览页"},{"parent":"2c546063-2c66-49b9-a344-8d8ffedbe2ca","callout":[],"children":[],"id":"a1b75bf9-4ab3-441f-ac87-faf764a9c1d8","title":"操作：逐个点开预览并下载"},{"parent":"2c546063-2c66-49b9-a344-8d8ffedbe2ca","callout":[],"children":[],"id":"ca3828af-6d25-4a7e-a3ba-d1e819b21c6e","title":"预期：<br>1) 结果回传 ｜ 最后输出可点击的链接<br>2) 产物预览 ｜ html 类按网页渲染，样式与脚本按沙箱规则处理<br>3) 跳转定位 ｜ url 与 webloc 这类快捷方式按产品定义打开目标或给出提示，不出现下载一个乱码文件<br>"}],"collapsed":true,"id":"2c546063-2c66-49b9-a344-8d8ffedbe2ca","title":"🔴【P0】网页类：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"105aaaed-419d-4909-89dc-6f60236dbb8f","callout":[],"children":[],"id":"6b20af77-a2c4-4f37-9dd8-3b0d41689ecc","title":"前置：让 Agent 产出常见音频文件；角色：房间成员；入口：对话流与预览页"},{"parent":"105aaaed-419d-4909-89dc-6f60236dbb8f","callout":[],"children":[],"id":"af4aef95-728d-4c95-b2a0-f78be264a9a2","title":"操作：点开预览、播放并下载"},{"parent":"105aaaed-419d-4909-89dc-6f60236dbb8f","callout":[],"children":[],"id":"888b8cd9-5ea5-478d-9973-72b20481aa56","title":"预期：\n1) 产物预览 ｜ 可播放并有进度控制\n2) 提示文案 ｜ 不支持的格式给出说明与下载入口"}],"collapsed":true,"id":"105aaaed-419d-4909-89dc-6f60236dbb8f","title":"🟠【P1】音频类：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"02f5af0c-007f-41b3-83f5-1f5dfdbd2481","callout":[],"children":[],"id":"e81b6c90-4865-46c8-81fe-38f465ad9aac","title":"前置：让 Agent 产出多种语言的代码文件；角色：房间成员；入口：对话流与预览页"},{"parent":"02f5af0c-007f-41b3-83f5-1f5dfdbd2481","callout":[],"children":[],"id":"f7dc64e5-a38b-4513-bc05-e48b8bd00628","title":"操作：逐个点开预览并下载"},{"parent":"02f5af0c-007f-41b3-83f5-1f5dfdbd2481","callout":[],"children":[],"id":"0e5f5fad-8547-4778-b5f9-bb8726c2e15c","title":"预期：\n1) 产物预览 ｜ 按代码高亮展示并带行号\n2) 消息渲染 ｜ 长行不撑破容器，可横向滚动"}],"collapsed":true,"id":"02f5af0c-007f-41b3-83f5-1f5dfdbd2481","title":"🟠【P1】代码类：产出到预览到下载"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"8953faa7-71f0-4604-b954-d55a52d634dc","callout":[],"children":[],"id":"235d7330-4fb9-4324-9dae-1bd664447194","title":"前置：让 Agent 产出一个既不在清单也没有扩展名的文件；角色：房间成员；入口：对话流与预览页"},{"parent":"8953faa7-71f0-4604-b954-d55a52d634dc","callout":[],"children":[],"id":"dae9bbf2-e401-4b4a-aa96-1a7edb29b0c1","title":"操作：点开该产物"},{"parent":"8953faa7-71f0-4604-b954-d55a52d634dc","callout":[],"children":[],"id":"212bf6ae-49b1-4b87-b91a-09af0c2bdb93","title":"预期：\n1) 提示文案 ｜ 明确说明该类型不支持预览，并给出下载入口\n2) 视觉展示 ｜ 图标按未知类型展示，不错标成其他类型\n3) 按钮状态 ｜ 下载按钮仍可用，这是这类文件唯一的获取路径"}],"collapsed":true,"id":"8953faa7-71f0-4604-b954-d55a52d634dc","title":"🟠【P1】其他与未知类型"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"815da54c-1000-44b4-945d-3d8291019b72","callout":[],"children":[],"id":"e796d4ed-6982-4b25-b21d-2cbe84e51e30","title":"前置：产物区中有上述各类文件；角色：房间成员；入口：产物区"},{"parent":"815da54c-1000-44b4-945d-3d8291019b72","callout":[],"children":[],"id":"7574aa0b-68c9-459e-8f22-4d2e86129edc","title":"操作：逐一核对每条的图标"},{"parent":"815da54c-1000-44b4-945d-3d8291019b72","callout":[],"children":[],"id":"78ace35f-5873-4498-9a1a-af165ce59f4e","title":"预期：\n1) 视觉展示 ｜ 图标与文件类型一一对应，同类不同扩展名用同一个图标\n2) 结果校验 ｜ 图标与实际能否预览的结论一致，不出现有图标却打不开"}],"collapsed":true,"id":"815da54c-1000-44b4-945d-3d8291019b72","title":"🟠【P1】产物图标与类型对应"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"57dc46a3-6972-4bbd-a33a-2d7ade33c9ca","callout":[],"children":[],"id":"1806efc0-0c99-4aa4-be74-af5d01474e16","title":"前置：产物区中有一个可预览的文件；角色：房间成员；入口：右侧面板的产物预览页"},{"parent":"57dc46a3-6972-4bbd-a33a-2d7ade33c9ca","callout":[],"children":[],"id":"3429d2b9-3b84-420f-ab37-0c4a3077329b","title":"操作：点开该产物查看预览页"},{"parent":"57dc46a3-6972-4bbd-a33a-2d7ade33c9ca","callout":[],"children":[],"id":"a3c75606-02e7-45d6-ad5d-520525b69d31","title":"预期：\n1) 按钮状态 ｜ 预览页上展示下载按钮，位置固定可见\n2) 视觉展示 ｜ 按钮不遮挡预览内容"}],"collapsed":true,"id":"57dc46a3-6972-4bbd-a33a-2d7ade33c9ca","title":"🔴【P0】预览页展示下载按钮"},{"parent":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","callout":[],"children":[{"parent":"ad55573c-4e1e-42cf-afb8-d23142c03a4d","callout":[],"children":[],"id":"d2ce077f-220a-4fae-a381-ddcf34984348","title":"前置：同一个文件既能从预览页下载，也能从文件更多菜单下载；角色：房间成员；入口：两处"},{"parent":"ad55573c-4e1e-42cf-afb8-d23142c03a4d","callout":[],"children":[],"id":"250d7bec-e2f7-43de-909d-a2ac3d9337e5","title":"操作：分别从两处下载同一个文件"},{"parent":"ad55573c-4e1e-42cf-afb8-d23142c03a4d","callout":[],"children":[],"id":"70f73ddf-9a39-4d4d-998f-dbd53a057794","title":"预期：\n1) 结果校验 ｜ 两处下载到的文件完全一致\n2) 文件落盘 ｜ 命名规则一致，不出现一处带后缀一处不带"}],"collapsed":true,"id":"ad55573c-4e1e-42cf-afb8-d23142c03a4d","title":"🟠【P1】下载与文件更多菜单的一致性"}],"collapsed":true,"id":"a329b6bb-3caa-4a37-b5e0-c2267beb573b","title":"正常场景"},{"parent":"e471657d-c7ae-4c32-a7b9-91502e633f2b","callout":[],"children":[{"parent":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","callout":[],"children":[{"parent":"20c95a0e-fad3-424f-b9ba-cfe0f006ee4a","callout":[],"children":[],"id":"2406bd8f-ccb8-4331-849f-6efbce612fe0","title":"前置：让 Agent 生成文件；角色：房间成员；入口：会话对话流"},{"parent":"20c95a0e-fad3-424f-b9ba-cfe0f006ee4a","callout":[],"children":[],"id":"a717e490-3b07-431d-b898-43061fe60e56","title":"操作：观察 Agent 的回复内容"},{"parent":"20c95a0e-fad3-424f-b9ba-cfe0f006ee4a","callout":[],"children":[],"id":"9e0cf19c-f45d-4e5b-956a-ee911ebfd9c1","title":"预期：\n1) 结果回传 ｜ 不允许只回复文字描述而不给可点击的产物，产出必须可达\n2) 结果校验 ｜ 这是本轮重点关注项，出现只描述不给链接即判缺陷"}],"collapsed":true,"id":"20c95a0e-fad3-424f-b9ba-cfe0f006ee4a","title":"🔴【P0】只描述不给链接即视为缺陷"},{"parent":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","callout":[],"children":[{"parent":"87b976fa-c941-4b25-8a28-9910b8b125c9","callout":[],"children":[],"id":"5efdb0c9-3f1f-4a14-8582-f493f9c908cb","title":"前置：让 Agent 执行一个会失败的产出任务；角色：房间成员；入口：会话对话流"},{"parent":"87b976fa-c941-4b25-8a28-9910b8b125c9","callout":[],"children":[],"id":"019ffe8b-cdd6-4512-9a5f-5bdd978d5b9a","title":"操作：发送指令并等待其失败"},{"parent":"87b976fa-c941-4b25-8a28-9910b8b125c9","callout":[],"children":[],"id":"0a90f04a-4e71-4341-bf1a-527b2ddd8e16","title":"预期：\n1) 提示文案 ｜ 说明产出失败与原因\n2) 副作用 ｜ 不给出指向不存在文件的链接，点开不出现空白或未处理的报错"}],"collapsed":true,"id":"87b976fa-c941-4b25-8a28-9910b8b125c9","title":"🔴【P0】产出失败时不给无效入口"},{"parent":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","callout":[],"children":[{"parent":"979521b4-6287-4d95-aaf3-a86e1ed5aa2e","callout":[],"children":[],"id":"e2cbc3b2-f02a-453d-a3dd-6929384f7fba","title":"前置：Agent 已产出文件且对话流里有入口；角色：房间成员；入口：对话流的产物"},{"parent":"979521b4-6287-4d95-aaf3-a86e1ed5aa2e","callout":[],"children":[],"id":"4f49dc88-a4e1-432f-9ea4-d48ce2fc95d4","title":"操作：在本地或文件中心删除该文件后再点击"},{"parent":"979521b4-6287-4d95-aaf3-a86e1ed5aa2e","callout":[],"children":[],"id":"f162a065-13e5-47d8-9d61-8091ee327862","title":"预期：\n1) 提示文案 ｜ 明确提示文件已不存在\n2) 消息渲染 ｜ 历史对话中的入口保留展示，只在打开时给出失效说明"}],"collapsed":true,"id":"979521b4-6287-4d95-aaf3-a86e1ed5aa2e","title":"🔴【P0】产物在事后被删除"},{"parent":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","callout":[],"children":[{"parent":"8c2dc1c5-4466-405c-9ea1-faeab8ba29c7","callout":[],"children":[],"id":"ef9c9167-4578-401a-a69a-12f3ef604c4b","title":"前置：产出名为 report.tar.gz、data.xlsx.txt 这类多重扩展名的文件；角色：房间成员；入口：产物区与预览页"},{"parent":"8c2dc1c5-4466-405c-9ea1-faeab8ba29c7","callout":[],"children":[],"id":"620986a1-edd8-4bbf-a0cc-03b42930ccdb","title":"操作：查看图标与预览行为"},{"parent":"8c2dc1c5-4466-405c-9ea1-faeab8ba29c7","callout":[],"children":[],"id":"06ccfc8f-8a98-4686-a1d5-39fdf78a955b","title":"预期：\n1) 结果校验 ｜ 按最后一个扩展名判定类型，判定规则前后一致\n2) 提示文案 ｜ 不能预览时给出下载入口"}],"collapsed":true,"id":"8c2dc1c5-4466-405c-9ea1-faeab8ba29c7","title":"🔴【P0】多重扩展名"},{"parent":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","callout":[],"children":[{"parent":"8427fd34-43d5-4e73-964a-86fe71e7415e","callout":[],"children":[],"id":"42b9761a-c2f3-4264-a340-eacef3c62490","title":"前置：产出 .PNG、.XLSX、.PDF 这类大写扩展名的文件；角色：房间成员；入口：产物区与预览页"},{"parent":"8427fd34-43d5-4e73-964a-86fe71e7415e","callout":[],"children":[],"id":"cded12a3-1dbc-4926-80bc-75eb3a7b14bc","title":"操作：查看图标与预览"},{"parent":"8427fd34-43d5-4e73-964a-86fe71e7415e","callout":[],"children":[],"id":"04d60d37-a1fd-489b-a73a-29585c172b35","title":"预期：\n1) 结果校验 ｜ 类型判定不区分大小写，与小写扩展名的行为一致"}],"collapsed":true,"id":"8427fd34-43d5-4e73-964a-86fe71e7415e","title":"🟠【P1】大小写扩展名"},{"parent":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","callout":[],"children":[{"parent":"aec319cb-dd5c-496a-939b-51de82274eff","callout":[],"children":[],"id":"e90cb9ba-2254-4f6e-82b8-7caea7aa8809","title":"前置：预览页已打开，此时该文件在本地被删除；角色：房间成员；入口：预览页的下载按钮"},{"parent":"aec319cb-dd5c-496a-939b-51de82274eff","callout":[],"children":[],"id":"320b1d4f-d4c2-4680-9b25-125d5f7cb15a","title":"操作：点击下载"},{"parent":"aec319cb-dd5c-496a-939b-51de82274eff","callout":[],"children":[],"id":"075c56df-4103-44f1-ad69-c43c059d1105","title":"预期：\n1) 提示文案 ｜ 明确提示文件已不存在\n2) 副作用 ｜ 不产生零字节或损坏的下载文件"}],"collapsed":true,"id":"aec319cb-dd5c-496a-939b-51de82274eff","title":"🔴【P0】下载已被删除的产物"},{"parent":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","callout":[],"children":[{"parent":"7cb4e24c-6183-4a52-8bbd-6cf116c2529c","callout":[],"children":[],"id":"678afd44-b4c4-4a7a-a719-f67edd4be200","title":"前置：正在下载一个较大的产物；角色：房间成员；入口：预览页"},{"parent":"7cb4e24c-6183-4a52-8bbd-6cf116c2529c","callout":[],"children":[],"id":"b08dd7af-8e0b-4087-9634-ef96e0bd6a6d","title":"操作：下载中断开网络"},{"parent":"7cb4e24c-6183-4a52-8bbd-6cf116c2529c","callout":[],"children":[],"id":"25aacd55-a32b-4b63-914f-427f33e05952","title":"预期：\n1) 提示文案 ｜ 给出下载失败提示并可重试\n2) 副作用 ｜ 不留下一个不完整却看起来正常的文件"}],"collapsed":true,"id":"7cb4e24c-6183-4a52-8bbd-6cf116c2529c","title":"🟠【P1】下载过程中断网"},{"parent":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","callout":[],"children":[{"parent":"77d662a0-8f21-4353-9274-034c580546a8","callout":[],"children":[],"id":"d5058c5a-a47f-4bf8-ad0a-4ad3e7b2d342","title":"前置：浏览器设置为阻止自动下载；角色：房间成员；入口：预览页"},{"parent":"77d662a0-8f21-4353-9274-034c580546a8","callout":[],"children":[],"id":"6bf2ce21-56ba-450a-af1a-68ea87119ad8","title":"操作：点击下载"},{"parent":"77d662a0-8f21-4353-9274-034c580546a8","callout":[],"children":[],"id":"3244459c-f51c-4b5b-a9b6-bb42517d61d0","title":"预期：\n1) 提示文案 ｜ 给出被拦截的说明与处理指引，不是静默失败"}],"collapsed":true,"id":"77d662a0-8f21-4353-9274-034c580546a8","title":"🟠【P1】浏览器拦截下载"}],"collapsed":true,"id":"e3fd87c8-891d-41ef-83b9-663c47c5d1cc","title":"异常场景"},{"parent":"e471657d-c7ae-4c32-a7b9-91502e633f2b","callout":[],"children":[{"parent":"34d2d6eb-d9f0-4610-a2f7-aaac57de4031","callout":[],"children":[{"parent":"b9666a76-0b86-4fd4-8d67-88029b6a90ad","callout":[],"children":[],"id":"19a4a20b-041d-4e1e-aad2-c485335e09fe","title":"前置：让 Agent 生成文件名含空格、中文与特殊符号的文件；角色：房间成员；入口：会话对话流"},{"parent":"b9666a76-0b86-4fd4-8d67-88029b6a90ad","callout":[],"children":[],"id":"9a91c1cd-0a16-4c16-87fb-13ad4cc19113","title":"操作：点击打开并下载"},{"parent":"b9666a76-0b86-4fd4-8d67-88029b6a90ad","callout":[],"children":[],"id":"42c092a9-2d0e-4abc-bd39-d5b6ae2bc0a1","title":"预期：\n1) 产物预览 ｜ 可正常打开，文件名展示完整不乱码\n2) 文件落盘 ｜ 落盘与下载后的文件名与展示一致"}],"collapsed":true,"id":"b9666a76-0b86-4fd4-8d67-88029b6a90ad","title":"🟠【P1】文件名含中文与特殊字符"},{"parent":"34d2d6eb-d9f0-4610-a2f7-aaac57de4031","callout":[],"children":[{"parent":"dc8495e2-124d-4b07-8725-00ab69382a04","callout":[],"children":[],"id":"09659c04-3e94-4025-8627-41207ffb0634","title":"前置：让 Agent 一次产出十个以上文件且文件名很长；角色：房间成员；入口：会话对话流"},{"parent":"dc8495e2-124d-4b07-8725-00ab69382a04","callout":[],"children":[],"id":"ebbd21c8-108d-4e38-bd40-65ce4029cb01","title":"操作：查看对话流中的产物展示"},{"parent":"dc8495e2-124d-4b07-8725-00ab69382a04","callout":[],"children":[],"id":"201f4b17-0792-4343-bdbc-465b944002e5","title":"预期：\n1) 视觉展示 ｜ 超长文件名截断合理，悬浮可看完整名\n2) 消息渲染 ｜ 产物区块可折叠或滚动，不把对话流撑得过长"}],"collapsed":true,"id":"dc8495e2-124d-4b07-8725-00ab69382a04","title":"🟡【P2】一次产出很多且文件名很长"},{"parent":"34d2d6eb-d9f0-4610-a2f7-aaac57de4031","callout":[],"children":[{"parent":"1d270aa0-8ff0-486a-ad15-394585c79f21","callout":[],"children":[],"id":"73e84691-e659-49bd-b5e2-7a3fca49b3c8","title":"前置：产出一个超过预览上限的文件；角色：房间成员；入口：预览页"},{"parent":"1d270aa0-8ff0-486a-ad15-394585c79f21","callout":[],"children":[],"id":"18fb0f14-0897-4cf4-a6d3-e81e092ca0e0","title":"操作：点开预览并尝试下载"},{"parent":"1d270aa0-8ff0-486a-ad15-394585c79f21","callout":[],"children":[],"id":"0be83b64-ba69-4e03-bada-502766c51267","title":"预期：\n1) 提示文案 ｜ 说明文件过大不支持在线预览，给出下载入口\n2) 性能 ｜ 不出现长时间加载后才失败；下载有进度或明确的开始反馈"}],"collapsed":true,"id":"1d270aa0-8ff0-486a-ad15-394585c79f21","title":"🟠【P1】超大文件"},{"parent":"34d2d6eb-d9f0-4610-a2f7-aaac57de4031","callout":[],"children":[{"parent":"5f51c86c-cf86-47a0-a869-065455222324","callout":[],"children":[],"id":"e25e17d2-d301-405d-8d13-2b53317cfed4","title":"前置：产出一个零字节文件与一个只有空白的文档；角色：房间成员；入口：预览页"},{"parent":"5f51c86c-cf86-47a0-a869-065455222324","callout":[],"children":[],"id":"72b46c03-5840-4cfa-bb9f-fca023b4db19","title":"操作：分别点开预览"},{"parent":"5f51c86c-cf86-47a0-a869-065455222324","callout":[],"children":[],"id":"d794ac82-9874-4c65-a97d-40d72aefd323","title":"预期：\n1) 产物预览 ｜ 展示空内容的空态而不是报错\n2) 提示文案 ｜ 能看出是文件本身为空，不是加载失败"}],"collapsed":true,"id":"5f51c86c-cf86-47a0-a869-065455222324","title":"🟡【P2】零字节与空内容文件"},{"parent":"34d2d6eb-d9f0-4610-a2f7-aaac57de4031","callout":[],"children":[{"parent":"6e4ba2ab-bb7f-42f9-a24c-7a52c9c446ee","callout":[],"children":[],"id":"683e4ed7-055e-483f-955f-6a2961180a29","title":"前置：已打开预览页；角色：房间成员；入口：下载按钮"},{"parent":"6e4ba2ab-bb7f-42f9-a24c-7a52c9c446ee","callout":[],"children":[],"id":"006f4a21-b4d1-42b8-a074-65b31bfe2259","title":"操作：连续快速点击下载多次"},{"parent":"6e4ba2ab-bb7f-42f9-a24c-7a52c9c446ee","callout":[],"children":[],"id":"7cc7be83-cb48-4ce7-8140-56d0f01d1fe4","title":"预期：\n1) 副作用 ｜ 按产品定义只触发一次或做节流，不产生多个重复文件"}],"collapsed":true,"id":"6e4ba2ab-bb7f-42f9-a24c-7a52c9c446ee","title":"🟡【P2】连续点击下载"}],"collapsed":true,"id":"34d2d6eb-d9f0-4610-a2f7-aaac57de4031","title":"边界场景"}],"collapsed":true,"style":{"text-decoration":"line-through"},"id":"e471657d-c7ae-4c32-a7b9-91502e633f2b","title":"产物的输出、预览与下载"},{"parent":"28a940bb-0eef-4cac-8062-351774ac194f","callout":[],"children":[{"parent":"256fb52f-f8e7-4cdd-9d41-e5bd23a043bd","callout":[],"children":[{"parent":"89c00e0e-9fa0-4d79-87f3-ff0a51d7c7b8","customWidth":538.4,"callout":[],"children":[],"id":"6c8df53b-b20c-4e7c-bf4f-40c3e7e68560","title":"类型清单：<br>文档：document + spreadsheet + presentation + pdf + markdown：doc docm docx odt pages rtf txt；csv numbers ods tsv xls xlsm xlsx；key odp ppt pptm pptx；pdf；md markdown mdx<br>图片：image：avif bmp gif heic heif ico jpeg jpg png svg tif tiff webp<br>视频：video：3gp avi flv m4v mkv mov mp4 mpeg mpg webm wmv<br>网页：website：htm html mhtml url webloc xhtml<br>其他：audio + code + other 见下面说明"}],"collapsed":true,"id":"89c00e0e-9fa0-4d79-87f3-ff0a51d7c7b8","title":"说明：一条链路一次测完，不拆成输出与预览两处，也不再单列产物卡片一组 —— 让 Agent 产出该类型文件 → 对话流底部以卡片形式给出本次产物（不区分命令还是工具执行产生，但只交付最终产物） → 点开进入右侧面板预览 → 卡片、预览页与文件更多菜单三处都可下载，卡片还可分享，底部「查看所有产物」打开右侧面板产物区。按类型各一条，把该类的全部扩展名写在操作里"},{"parent":"256fb52f-f8e7-4cdd-9d41-e5bd23a043bd","callout":[],"children":[{"parent":"aef18457-15e8-45e2-84f0-26af8137d25a","callout":[],"children":[{"parent":"446a0f61-3bfd-4e67-a8c1-9463c71c8498","callout":[],"children":[],"id":"6775809c-fa79-49cf-b2ad-aae489d3a9e0","title":"前置：让 Agent 生成文件；角色：房间成员；入口：会话对话流"},{"parent":"446a0f61-3bfd-4e67-a8c1-9463c71c8498","callout":[],"children":[],"id":"85e0a514-d0cd-4b88-8964-f8b3c623c531","title":"操作：观察 Agent 的回复内容"},{"parent":"446a0f61-3bfd-4e67-a8c1-9463c71c8498","callout":[],"children":[],"id":"72832c9f-7b5a-4c52-abbe-f317f1a92c83","title":"预期：\n1) 结果回传 ｜ 不允许只回复文字描述而不给可点击的产物，产出必须可达\n2) 结果校验 ｜ 这是本轮重点关注项，出现只描述不给链接即判缺陷"}],"collapsed":true,"id":"446a0f61-3bfd-4e67-a8c1-9463c71c8498","title":"🔴【P0】只描述不给链接即视为缺陷","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"aef18457-15e8-45e2-84f0-26af8137d25a","callout":[],"children":[{"parent":"8758b49b-b1ee-4631-816e-c3d8e4da4239","callout":[],"children":[],"id":"4ded189f-ee6e-42ac-99c8-cc3768a33c85","title":"前置：让 Agent 分别产出 docx、doc、odt、rtf、txt、pages 各一份；角色：房间成员；入口：对话流卡片区、预览页、文件更多菜单与右侧面板产物区"},{"parent":"8758b49b-b1ee-4631-816e-c3d8e4da4239","callout":[],"children":[],"id":"82583ecf-b0e7-4ebb-97f7-baab30fe191e","title":"操作：发送指令等待完成，先看对话流底部的卡片，再逐个点开预览，然后分别从卡片、预览页、文件更多菜单三处下载，点卡片上的分享，最后点「查看所有产物」"},{"parent":"8758b49b-b1ee-4631-816e-c3d8e4da4239","customWidth":479.4,"callout":[],"children":[],"id":"f722e82b-333b-41be-8c85-42fe5be1bd58","title":"预期：\n1) 结果回传 ｜ 对话流底部以卡片形式给出本次产物，每张展示文件名、类型与大小，不只是一句已生成\n2) 视觉展示 ｜ 图标与该类型对应，同类不同扩展名用同一个图标，超长文件名截断可读\n3) 产物预览 ｜ 点击卡片直接打开右侧面板预览，正文、标题与段落排版可读\n4) 文件落盘 ｜ 卡片、预览页与文件更多菜单三处都能下载，下载到的文件完全一致，文件名与展示一致，能被本地对应应用正常打开\n5) 跳转定位 ｜ 卡片上的分享打开该文件的分享弹窗，内容与从文件中心分享同一个文件时一致\n6) 结果校验 ｜ 点「查看所有产物」打开右侧面板产物区，本次产物都在其中，与对话流卡片一一对应\n7) 归属与顺序 ｜ 同一份产物在三处资产入口都能找到：右侧面板的产出文件、房间内资产的 Agent 产物、全局我的资产的 Agent 产物，文件名、类型与内容一致"}],"collapsed":true,"id":"8758b49b-b1ee-4631-816e-c3d8e4da4239","title":"🔴【P0】文档类：产出、卡片、预览、下载、分享","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"aef18457-15e8-45e2-84f0-26af8137d25a","callout":[],"children":[{"parent":"b75ee497-c910-479b-aac2-8c83d87f73f8","callout":[],"children":[],"id":"46034844-f0c6-4d6a-ab67-688f4c65c6a2","title":"前置：让 Agent 分别产出 xlsx、xls、xlsm、csv、tsv、ods、numbers 各一份；角色：房间成员；入口：对话流卡片区、预览页、文件更多菜单与右侧面板产物区"},{"parent":"b75ee497-c910-479b-aac2-8c83d87f73f8","callout":[],"children":[],"id":"a891ed79-3ca6-46c4-a13f-60209dac43ab","title":"操作：发送指令等待完成，先看对话流底部的卡片，再逐个点开预览，然后分别从卡片、预览页、文件更多菜单三处下载，点卡片上的分享，最后点「查看所有产物」"},{"parent":"b75ee497-c910-479b-aac2-8c83d87f73f8","callout":[],"children":[],"id":"143c4cfb-15c6-4843-b2e2-a6840670e784","title":"预期：\n1) 结果回传 ｜ 对话流底部以卡片形式给出本次产物，每张展示文件名、类型与大小，不只是一句已生成\n2) 视觉展示 ｜ 图标与该类型对应，同类不同扩展名用同一个图标，超长文件名截断可读\n3) 产物预览 ｜ 点击卡片直接打开右侧面板预览，能按行列渲染，多 sheet 的能切换\n4) 消息渲染 ｜ 中文与特殊字符不乱码，数字与日期格式不被破坏\n5) 文件落盘 ｜ 卡片、预览页与文件更多菜单三处都能下载，下载到的文件完全一致，文件名与展示一致，能被本地对应应用正常打开\n6) 跳转定位 ｜ 卡片上的分享打开该文件的分享弹窗，内容与从文件中心分享同一个文件时一致\n7) 结果校验 ｜ 点「查看所有产物」打开右侧面板产物区，本次产物都在其中，与对话流卡片一一对应\n8) 归属与顺序 ｜ 同一份产物在三处资产入口都能找到：右侧面板的产出文件、房间内资产的 Agent 产物、全局我的资产的 Agent 产物，文件名、类型与内容一致"}],"collapsed":true,"id":"b75ee497-c910-479b-aac2-8c83d87f73f8","title":"🔴【P0】表格类：产出、卡片、预览、下载、分享","icons":[{"color":"rgb(40, 191, 90)","name":"other","index":"368"}]},{"parent":"aef18457-15e8-45e2-84f0-26af8137d25a","callout":[],"children":[{"parent":"f394f87f-ae52-4a20-b69c-eae0e92b81e6","callout":[],"children":[],"id":"1120ca67-578c-4b87-ae1f-94ecc45db0b7","title":"前置：让 Agent 分别产出 pptx、ppt、pptm、odp、key 各一份；角色：房间成员；入口：对话流卡片区、预览页、文件更多菜单与右侧面板产物区"},{"parent":"f394f87f-ae52-4a20-b69c-eae0e92b81e6","callout":[],"children":[],"id":"81a5e8a8-d290-4583-bb1b-6a723a94aa9a","title":"操作：发送指令等待完成，先看对话流底部的卡片，再逐个点开预览，然后分别从卡片、预览页、文件更多菜单三处下载，点卡片上的分享，最后