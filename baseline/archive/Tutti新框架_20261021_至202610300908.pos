示词内容"}],"collapsed":true,"id":"cf205067-ea7a-402e-be45-58ae6b20c928","title":"边界场景（3）"}],"collapsed":true,"id":"47727660-416f-401f-9e44-1fd91f995490","title":"新增提示词"},{"parent":"bbe35e49-d37c-4322-8786-a8f34cef0cc5","callout":[],"children":[{"parent":"8f32c8d7-69d1-4be0-9474-59c19d672d5b","callout":[],"children":[{"parent":"426771c9-fc6e-4d7a-80a5-cc29956a66a6","callout":[],"children":[{"parent":"ff5b048b-5b25-414e-8514-4ce4fad0bd4d","callout":[],"children":[],"id":"f028d3fb-a650-4b96-8cc1-f7571ff9a7b7","title":"前置：前置：已保存多条提示词；角色：房间成员；入口：提示词弹窗搜索框"},{"parent":"ff5b048b-5b25-414e-8514-4ce4fad0bd4d","callout":[],"children":[],"id":"75947b86-cf65-461b-9a6c-8c341e56af62","title":"操作：输入某条提示词正文中的部分字符"},{"parent":"ff5b048b-5b25-414e-8514-4ce4fad0bd4d","callout":[],"children":[],"id":"3d92ba05-91f8-4f12-8100-ded151453b88","title":"预期：模糊匹配出正文包含该字符的提示词；结果条目展示标题并可直接点击使用；清空搜索恢复完整列表"}],"collapsed":true,"id":"ff5b048b-5b25-414e-8514-4ce4fad0bd4d","title":"🟠【P1】按提示词内容模糊搜索"},{"parent":"426771c9-fc6e-4d7a-80a5-cc29956a66a6","callout":[],"children":[{"parent":"fcf369de-afdf-4cc3-a723-2b25d09f66ad","callout":[],"children":[],"id":"f8a4e5ce-12c1-4f15-815a-eb2c8b4aa188","title":"前置：前置：已保存多条提示词；角色：房间成员；入口：提示词弹窗搜索框"},{"parent":"fcf369de-afdf-4cc3-a723-2b25d09f66ad","callout":[],"children":[],"id":"65aa7baf-a14f-40ca-9a09-e2891f9e1c5a","title":"操作：输入某条提示词标题中的部分字符"},{"parent":"fcf369de-afdf-4cc3-a723-2b25d09f66ad","callout":[],"children":[],"id":"9e505732-8ac6-44d7-a24b-1ce6b084b1a2","title":"预期：模糊匹配出标题包含该字符的提示词；不匹配的条目不展示；清空搜索后完整列表恢复"}],"collapsed":true,"id":"fcf369de-afdf-4cc3-a723-2b25d09f66ad","title":"🟠【P1】按标题模糊搜索"}],"collapsed":true,"id":"426771c9-fc6e-4d7a-80a5-cc29956a66a6","title":"正常场景（2）"},{"parent":"8f32c8d7-69d1-4be0-9474-59c19d672d5b","callout":[],"children":[{"parent":"078a1333-b0ad-42ed-81e4-0b25fed541c5","callout":[],"children":[{"parent":"783851e3-b961-444a-9b6f-8d8313ccf089","callout":[],"children":[],"id":"d757b690-fabc-4f90-8626-fc09dac65d5d","title":"前置：已保存若干提示词"},{"pare