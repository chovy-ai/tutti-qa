56-3a4d07c67423","title":"操作：让 Agent 执行一次需要授权的文件写入并同意授权"},{"parent":"8607f28a-7dfa-44d2-a70e-38fae70d8b94","callout":[],"children":[],"id":"88cb04e2-2f9f-41e9-af2f-29ae648c8331","title":"预期：授权后操作正常执行，文件按预期落盘并生成变更卡片"}],"collapsed":true,"id":"8607f28a-7dfa-44d2-a70e-38fae70d8b94","title":"🔴【P0】授权后的敏感文件操作"}],"collapsed":true,"id":"a6631168-3742-414f-9897-8ffd0fc10488","title":"正常场景（1）"},{"parent":"47813d40-63d2-45b7-816f-0d5d5355e419","callout":[],"children":[{"parent":"869a05c8-0ade-4e30-a185-f63a7c5bbbc6","callout":[],"children":[{"parent":"d4321da2-62e5-46c4-96b0-880d5f3dfb19","callout":[],"children":[],"id":"ba0c0ee8-5b3c-4978-a20e-7000c733fb34","title":"操作：拒绝 Agent 的敏感操作授权"},{"parent":"d4321da2-62e5-46c4-96b0-880d5f3dfb19","callout":[],"children":[],"id":"31f61b61-b843-4b10-849e-e28250770a53","title":"预期：任务停止或等待，明确说明未执行该操作"}],"collapsed":true,"id":"d4321da2-62e5-46c4-96b0-880d5f3dfb19","title":"🔴【P0】权限被拒绝"},{"parent":"869a05c8-0ade-4e30-a185-f63a7c5bbbc6","callout":[],"children":[{"parent":"6cd81e61-d080-4adf-a30b-ef605d4a5ea8","callout":[],"children":[],"id":"1c711311-c323-41d5-acc9-586a561fb09e","title":"操作：让 Agent 写入无权限目录"},{"parent":"6cd81e61-d080-4adf-a30b-ef605d4a5ea8","callout":[],"children":[],"id":"cf5447df-37e1-452b-9cfa-b1a473c9fff7","title":"预期：操作被阻止并提示权限限制，不绕过安全边界"}],"collapsed":true,"id":"6cd81e61-d080-4adf-a30b-ef605d4a5ea8","title":"🟡【P2】沙箱限制"}],"collapsed":true,"id":"869a05c8-0ade-4e30-a185-f63a7c5bbbc6","title":"异常场景（2）"},{"parent":"47813d40-63d2-45b7-816f-0d5d5355e419","callout":[],"children":[{"parent":"4a13e302-fee6-4a19-b6f8-4a7ab03a5623","callout":[],"children":[{"parent":"72bf10cf-513c-4f78-9ac8-5c7dadf6859d","callout":[],"children":[],"id":"92359e93-d155-4c2f-b958-fc1066220794","title":"前置：会话已绑定项目"},{"parent":"72bf10cf-513c-4f78-9ac8-5c7dadf6859d","callout":[],"children":[],"id":"1f08ecda-840d-450e-9519-2b98817a1936","title":"操作：让 Agent 读写项目目录之外的文件"},{"parent":"72bf10cf-513c-4f78-9ac8-5c7dadf6859d","callout":[],"children":[],"id":"6965cbd0