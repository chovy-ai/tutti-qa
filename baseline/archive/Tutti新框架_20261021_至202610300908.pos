0】对话显示更多"},{"parent":"f01623af-cab6-483f-aff5-61de1586c168","callout":[],"children":[{"parent":"cd26a3b5-5068-4404-a636-4883a786fa50","callout":[],"children":[],"id":"b107af1f-ead2-40d1-953b-61105d902fbe","title":"操作：在搜索框输入会话标题关键词"},{"parent":"cd26a3b5-5068-4404-a636-4883a786fa50","callout":[],"children":[],"id":"30c7bb1b-9b6f-415d-9b55-8ee0e6f0bab7","title":"预期：跨项目返回匹配会话并保留项目归属语义"}],"collapsed":true,"id":"cd26a3b5-5068-4404-a636-4883a786fa50","title":"🔴【P0】搜索会话"},{"parent":"f01623af-cab6-483f-aff5-61de1586c168","callout":[],"children":[{"parent":"ef54437c-2161-4343-811c-3fb4c2464afe","callout":[],"children":[],"id":"bb4aaac6-58e4-403a-95f7-bccda8fe4633","title":"操作：点击搜索结果"},{"parent":"ef54437c-2161-4343-811c-3fb4c2464afe","callout":[],"children":[],"id":"a11b3dfc-e588-49aa-9460-06965760d870","title":"预期：打开正确会话并定位到所属项目或对话分组"}],"collapsed":true,"id":"ef54437c-2161-4343-811c-3fb4c2464afe","title":"🔴【P0】搜索结果打开"}],"collapsed":true,"id":"f01623af-cab6-483f-aff5-61de1586c168","title":"正常场景"},{"parent":"bf6b840b-ba0d-4c21-8a62-f04a514bf808","callout":[],"children":[{"parent":"9ffc0131-e17e-4367-ad34-bc90d177ac9a","callout":[],"children":[{"parent":"62a5e8ca-8f70-4961-b9ad-38805e0fbab1","callout":[],"children":[],"id":"91cc8a65-1997-490a-9cfd-f4e87257128f","title":"操作：下一页返回已展示 session_id"},{"parent":"62a5e8ca-8f70-4961-b9ad-38805e0fbab1","callout":[],"children":[],"id":"c8a8594d-a7f3-4746-bb6e-ed245275100f","title":"预期：自动去重且顺序稳定"}],"collapsed":true,"id":"62a5e8ca-8f70-4961-b9ad-38805e0fbab1","title":"🟠【P1】分页重复数据"},{"parent":"9ffc0131-e17e-4367-ad34-bc90d177ac9a","callout":[],"children":[{"parent":"432eeade-f7b4-4eb2-a6ba-160120825b3b","callout":[],"children":[],"id":"0196ed48-220d-4818-bfab-4b6e2583330a","title":"操作：点击显示更多时模拟网络失败"},{"parent":"432eeade-f7b4-4eb2-a6ba-160120825b3b","callout":[],"children":[],"id":"95bb14fb-df0d-4888-b46f-b2f84149bf85","title":"预期：保留已加载会话并提供重试"}],"collapsed":true,"id":"432eeade-f7b4-4eb2-a6ba-160120825b3b","title":"🟡【P2】显示更多失败"},{"parent":"9ff