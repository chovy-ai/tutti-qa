d5d7-44b8-9c16-f621b1de709e","callout":[],"children":[],"id":"f7a9f892-5384-4bc2-9651-0102f512773e","title":"备注：来源 附件3 CC-011；附件3 CC-011"}],"collapsed":true,"id":"4d0790d6-d5d7-44b8-9c16-f621b1de709e","title":"🔴【P0】常规命令执行与结果返回"}],"collapsed":true,"id":"47ad4f9e-f412-4e2b-b7a5-43389223c921","title":"正常场景（2）"},{"parent":"0214f891-fbb7-4b7a-a777-841836b29e6a","callout":[],"children":[{"parent":"a883ccaf-300e-433f-876e-df48222714b6","callout":[],"children":[{"parent":"aa6fe7d5-20a2-4cbe-9b70-2ba274fadca4","callout":[],"children":[],"id":"6c07eda7-feb7-48f9-9671-1e22dd5dd17a","title":"前置：会话已绑定项目"},{"parent":"aa6fe7d5-20a2-4cbe-9b70-2ba274fadca4","callout":[],"children":[],"id":"ab88dd42-147b-47cb-8cb3-ff335ff9b4e0","title":"操作：让 Agent 执行一条必然失败的命令（如不存在的可执行文件）"},{"parent":"aa6fe7d5-20a2-4cbe-9b70-2ba274fadca4","callout":[],"children":[],"id":"5c7b00df-ce00-4aa7-8ecf-f9173d1c3f7e","title":"预期：返回非零退出码与完整的标准错误输出；Agent 据此说明失败原因，不伪装成功"},{"parent":"aa6fe7d5-20a2-4cbe-9b70-2ba274fadca4","callout":[],"children":[],"id":"20ed9249-99b0-4ab2-b8a2-a202eedc217a","title":"备注：来源 附件3 CC-011；附件3 CC-011"}],"collapsed":true,"id":"aa6fe7d5-20a2-4cbe-9b70-2ba274fadca4","title":"🔴【P0】命令失败时的退出码与错误输出"}],"collapsed":true,"id":"a883ccaf-300e-433f-876e-df48222714b6","title":"异常场景（1）"},{"parent":"0214f891-fbb7-4b7a-a777-841836b29e6a","callout":[],"children":[{"parent":"d81560cd-430a-4112-a6cb-6e2a77f39387","callout":[],"children":[{"parent":"588b795b-15e0-4a4e-b480-7f6aa626fe6c","callout":[],"children":[],"id":"2b5ec820-ef41-4759-bb52-01bddb383e98","title":"前置：会话已绑定项目"},{"parent":"588b795b-15e0-4a4e-b480-7f6aa626fe6c","callout":[],"children":[],"id":"09066d5a-498c-41fe-838a-4a84547d68ef","title":"操作：让 Agent 执行会产生数万行输出的命令"},{"parent":"588b795b-15e0-4a4e-b480-7f6aa626fe6c","callout":[],"children":[],"id":"388f83b2-2b16-4c4d-80ad-146f1875a39b","title":"预期：输出被截断或折叠展示且有明确提示，界面不卡死，可查看完整输出的方式明确"},{"parent":"588b795b-15e0-4a4e-b480-7f6aa626fe6c","callout":[],"children":[],"id":"f09ef185-d838-4b43-a515-241e0fc68fc4","title":"备注：附件3 CC-011"}],"collapsed":true,"id":"588b795b-15e0-4a4e-b480-7f6aa626fe6c","title":"🟡【P2】命令输出超长时的展示"},{"parent":"d81560cd-430a-4112-a6cb-6e2a77f39387","callout":[],"children":[{"parent":"a3ae972e-7699-4ee0-84b1-d80118bdd0ab","callout":[],"children":[],"id":"02dffbb0-eb26-4bf5-ab5c-76150071d223","title":"前置：会话已绑定项目"},{"parent":"a3ae972e-7699-4ee0-84b1-d80118bdd0ab","callout":[],"children":[],"id":"1d7abe88-d2f9-432a-9cd6-f3c4a9af73df","title":"操作：让 Agent 执行一条会等待用户输入的交互式命令"},{"parent":"a3ae972e-7699-4ee0-84b1-d80118bdd0ab","callout":[],"children":[],"id":"24a97d9f-529f-450d-b1f2-9b087fe35dcf","title":"预期：命令不无限挂起，超时或以非交互方式处理并给出说明"}],"collapsed":true,"id":"a3ae972e-7699-4ee0-84b1-d80118bdd0ab","title":"🟡【P2】需要交互输入的命令"}],"collapsed":true,"id":"d81560cd-430a-4112-a6cb-6e2a77f39387","title":"边界场景（2）"}],"collapsed":true,"id":"0214f891-fbb7-4b7a-a777-841836b29e6a","title":"Bash 工具"},{"parent":"863084f9-96ed-43ab-a63c-b5b45a8604d6","callout":[],"children":[{"parent":"527352aa-69c2-4692-8820-a6416cd8d31d","callout":[],"children":[{"parent":"1aa3bd3b-c882-4bcc-8e89-7aee6f1ece25","callout":[],"children":[{"parent":"ef3651fa-350f-4962-a669-8d178f36926c","callout":[],"children":[],"id":"da7f395d-48c1-4e4f-babb-bf827b01431c","title":"前置：项目中存在文本、代码、配置、空文件"},{"parent":"ef3651fa-350f-4962-a669-8d178f36926c","callout":[],"children":[],"id":"eac69850-08fe-4351-9fcb-14e5baf00be9","title":"操作：让 Agent 依次读取四类文件"},{"parent":"ef3651fa-350f-4962-a669-8d178f36926c","callout":[],"children":[],"id":"aeae6018-ac4f-480a-9532-d9e8b83699dd","title":"预期：内容完整返回；中文与特殊字符不乱码；空文件正常返回空内容而非报错"},{"parent":"ef3651fa-350f-4962-a669-8d178f36926c","callout":[],"children":[],"id":"c9ad42a4-4250-4d09-98ad-b5bba765f2e1","title":"备注：来源 附件3 CC-012；附件3 CC-012"}],"collapsed":true,"id":"ef3651fa-350f-4962-a669-8d178f36926c","title":"🔴【P0】多类型文件读取"}],"collapsed":true,"id":"1aa3bd3b-c882-4bcc-8e89-7aee6f1ece25","title":"正常场景（1）"},{"parent":"527352aa-69c2-4692-8820-a6416cd8d31d","callout":[],"children":[{"parent":"48d4b5bb-c5b5-4a81-96b0-0bf6cf1eac1c","callout":[],"children":[{"parent":"1e239847-569c-4bc0-8d42-3fbfc3443cea","callout":[],"children":[],"id":"c7903766-477a-41e3-bc5d-6240718c8706","title":"前置：项目中存在无读取权限的文件"},{"parent":"1e239847-569c-4bc0-8d42-3fbfc3443cea","callout":[],"children":[],"id":"409ef23e-0b3d-4532-a4eb-a39732b84cdb","title":"操作：让 Agent 分别读取一个不存在的路径和一个无权限文件"},{"parent":"1e239847-569c-4bc0-8d42-3fbfc3443cea","callout":[],"children":[],"id":"095bba96-ccab-4311-ace8-a9c559d3ebb9","title":"预期：两种情况均返回明确的错误原因（不存在 / 无权限），不返回空结果冒充成功"},{"parent":"1e239847-569c-4bc0-8d42-3fbfc3443cea","callout":[],"children":[],"id":"72256fd7-9104-432c-bc6a-d2343c770916","title":"备注：来源 附件3 CC-012；附件3 CC-012"}],"collapsed":true,"id":"1e239847-569c-4bc0-8d42-3fbfc3443cea","title":"🟠【P1】读取不存在或无权限的路径"}],"collapsed":true,"id":"48d4b5bb-c5b5-4a81-96b0-0bf6cf1eac1c","title":"异常场景（1）"},{"parent":"527352aa-69c2-4692-8820-a6416cd8d31d","callout":[],"children":[{"parent":"b7011bb1-aa6c-4cff-956b-0255fbb13e96","callout":[],"children":[{"parent":"13e9ead8-8cac-4b7e-89c9-50740c3bc37b","callout":[],"children":[],"id":"0882385a-71db-4f89-8bbc-8474ad1848cd","title":"前置：项目中存在超过单次读取上限的大文件"},{"parent":"13e9ead8-8cac-4b7e-89c9-50740c3bc37b","callout":[],"children":[],"id":"6a535c74-8992-4a44-aa22-d4e8a706f3a4","title":"操作：让 Agent 读取该大文件并继续读取后续部分"},{"parent":"13e9ead8-8cac-4b7e-89c9-50740c3bc37b","callout":[],"children":[],"id":"22090359-14f5-43bc-a475-b5ad7edd486e","title":"预期：首次分页返回并标明还有后续内容；可继续读取剩余部分且内容衔接不重不漏"},{"parent":"13e9ead8-8cac-4b7e-89c9-50740c3bc37b","callout":[],"children":[],"id":"2ea1f2dd-cd20-4b43-a69e-affbfb45c2df","title":"备注：来源 附件3 CC-012；附件3 CC-012"}],"collapsed":true,"id":"13e9ead8-8cac-4b7e-89c9-50740c3bc37b","title":"🟡【P2】大文件分页读取"},{"parent":"b7011bb1-aa6c-4cff-956b-0255fbb13e96","callout":[],"children":[{"parent":"16d6e3be-0703-4cb6-9c9a-95d281c58fdc","callout":[],"children":[],"id":"de1a654d-41a4-483d-88f2-630ada88e510","title":"前置：项目中存在图片等二进制文件"},{"parent":"16d6e3be-0703-4cb6-9c9a-95d281c58fdc","callout":[],"children":[],"id":"9a8b2aea-933f-42da-964c-3f497e3049c7","title":"操作：让 Agent 读取该二进制文件"},{"parent":"16d6e3be-0703-4cb6-9c9a-95d281c58fdc","callout":[],"children":[],"id":"032d5e0e-8922-423a-aea0-378dfbdf60ce","title":"预期：识别为二进制并给出说明，不输出乱码内容"}],"collapsed":true,"id":"16d6e3be-0703-4cb6-9c9a-95d281c58fdc","title":"🟡【P2】读取二进制文件"}],"collapsed":true,"id":"b7011bb1-aa6c-4cff-956b-0255fbb13e96","title":"边界场景（2）"}],"collapsed":true,"id":"527352aa-69c2-4692-8820-a6416cd8d31d","title":"Read 工具"},{"parent":"863084f9-96ed-43ab-a63c-b5b45a8604d6","callout":[],"children":[{"parent":"d34a92cf-9dcd-4c1a-b3e1-edd28b0e11fa","callout":[],"children":[{"parent":"b165f82c-ed44-49ca-89b9-ce48e5b35767","callout":[],"children":[{"parent":"6d0cae79-2727-4c1f-8e48-27002711a081","callout":[],"children":[],"id":"ab6af55b-ad90-47be-b4ab-ef315d912e34","title":"前置：项目中存在待修改文件"},{"parent":"6d0cae79-2727-4c1f-8e48-27002711a081","callout":[],"children":[],"id":"416f0837-c213-48c8-ab71-ec706b1c293d","title":"操作：让 Agent 先读取再修改文件中的指定片段"},{"parent":"6d0cae79-2727-4c1f-8e48-27002711a081","callout":[],"children":[],"id":"abcafc97-7ca9-48bc-8fc3-d9d794844c12","title":"预期：仅目标片段被修改，其余内容逐字不变；生成的 diff 与实际改动一致"},{"parent":"6d0cae79-2727-4c1f-8e48-27002711a081","callout":[],"children":[],"id":"75abb325-267d-4bb3-9a26-51d70bba66a3","title":"备注：来源 附件3 CC-013；附件3 CC-013"}],"collapsed":true,"id":"6d0cae79-2727-4c1f-8e48-27002711a081","title":"🔴【P0】局部精确修改并生成 diff"}],"collapsed":true,"id":"b165f82c-ed44-49ca-89b9-ce48e5b35767","title":"正常场景（1）"},{"parent":"d34a92cf-9dcd-4c1a-b3e1-edd28b0e11fa","callout":[],"children":[{"parent":"2d9e723a-8634-4d4c-b577-9547a0dbb2f8","callout":[],"children":[{"parent":"684757e3-3eb2-4107-a98a-20f16a5ca05a","callout":[],"children":[],"id":"a0b66e08-b6c4-44b3-b155-55a09f6ddd1e","title":"前置：项目中存在目标字符串出现多次的文件"},{"parent":"684757e3-3eb2-4107-a98a-20f16a5ca05a","callout":[],"children":[],"id":"14b16b31-b333-4572-8c1a-4eb36ec97f23","title":"操作：让 Agent 分别修改一个不存在的目标、和一个在文件中出现多处的字符串"},{"parent":"684757e3-3eb2-4107-a98a-20f16a5ca05a","callout":[],"children":[],"id":"12237999-dd6b-4a96-8763-a24841b59082","title":"预期：两种情况均操作失败并给出可读提示，不发生误改或只改第一处"},{"parent":"684757e3-3eb2-4107-a98a-20f16a5ca05a","callout":[],"children":[],"id":"6b626c9c-adbd-4387-ac33-f13a1f350845","title":"备注：来源 附件3 CC-013；附件3 CC-013"}],"collapsed":true,"id":"684757e3-3eb2-4107-a98a-20f16a5ca05a","title":"🟠【P1】修改目标不存在或匹配到多处"},{"parent":"2d9e723a-8634-4d4c-b577-9547a0dbb2f8","callout":[],"children":[{"parent":"faea7578-2aae-4599-bce3-6ab2e18ce4e6","callout":[],"children":[],"id":"6aba9806-406e-4a69-8ce9-091229ba523f","title":"前置：项目中存在未被本会话读取过的文件"},{"parent":"faea7578-2aae-4599-bce3-6ab2e18ce4e6","callout":[],"children":[],"id":"1ad437b3-3ae9-4dc2-871e-63b62f8180dd","title":"操作：让 Agent 直接修改一个此前未读取过的文件"},{"parent":"faea7578-2aae-4599-bce3-6ab2e18ce4e6","callout":[],"children":[],"id":"6b42ed20-a743-42f9-9372-6b25968de767","title":"预期：先执行读取再修改，或明确提示需要先读取；不在未知内容的情况下盲改"},{"parent":"faea7578-2aae-4599-bce3-6ab2e18ce4e6","callout":[],"children":[],"id":"ae377792-dff1-46f0-882c-c60f065c3461","title":"备注：来源 附件3 CC-013；附件3 CC-013"}],"collapsed":true,"id":"faea7578-2aae-4599-bce3-6ab2e18ce4e6","title":"🟠【P1】未读取即修改的拦截"}],"collapsed":true,"id":"2d9e723a-8634-4d4c-b577-9547a0dbb2f8","title":"异常场景（2）"},{"parent":"d34a92cf-9dcd-4c1a-b3e1-edd28b0e11fa","callout":[],"children":[{"parent":"cc45c514-9f20-4f10-bcb3-87577fefbdb3","callout":[],"children":[{"parent":"4689cf12-ab88-434a-a66c-0e5064ce66bf","callout":[],"children":[],"id":"3b9ca583-8bec-4735-aea0-039ab4facdc6","title":"前置：项目中存在数万行的大文件"},{"parent":"4689cf12-ab88-434a-a66c-0e5064ce66bf","callout":[],"children":[],"id":"1be172a1-2767-4295-99aa-ca376cfb72c6","title":"操作：让 Agent 修改该文件中的一处片段"},{"parent":"4689cf12-ab88-434a-a66c-0e5064ce66bf","callout":[],"children":[],"id":"20fc2550-5996-4c3b-9c0b-e08b7a498534","title":"预期：仅目标片段被修改，diff 生成正常，响应时间可接受"}],"collapsed":true,"id":"4689cf12-ab88-434a-a66c-0e5064ce66bf","title":"🟡【P2】在超大文件中修改片段"}],"collapsed":true,"id":"cc45c514-9f20-4f10-bcb3-87577fefbdb3","title":"边界场景（1）"}],"collapsed":true,"id":"d34a92cf-9dcd-4c1a-b3e1-edd28b0e11fa","title":"Edit 工具"},{"parent":"863084f9-96ed-43ab-a63c-b5b45a8604d6","callout":[],"children":[{"parent":"67f7130a-ec7d-4e34-a0b9-cafd4ceebbce","callout":[],"children":[{"parent":"a2462fc0-f81e-4f1a-bf6a-1bf4405e6489","callout":[],"children":[{"parent":"e1c5be26-6314-4986-a636-e5e9599ebb1f","callout":[],"children":[],"id":"282def55-b5ca-48b1-956d-45f2d80b9032","title":"前置：项目目录可写且存在同名文件"},{"parent":"e1c5be26-6314-4986-a636-e5e9599ebb1f","callout":[],"children":[],"id":"a679cb21-24b4-4f79-bac1-0bbe91bc0e50","title":"操作：让 Agent 新建一个文件，再覆盖一个已存在的文件；覆盖确认卡片出现时先拒绝再允许"},{"parent":"e1c5be26-6314-4986-a636-e5e9599ebb1f","callout":[],"children":[],"id":"c374d5db-7cf7-4bba-9915-f6d4ec75ce95","title":"预期：新建文件正常落盘；覆盖前弹出确认卡片；拒绝后原文件内容逐字不变，允许后内容完整写入"},{"parent":"e1c5be26-6314-4986-a636-e5e9599ebb1f","callout":[],"children":[],"id":"60b2ced2-61dc-4fef-9e23-834e0c9aeeec","title":"备注：来源 附件3 CC-014；附件3 CC-014"}],"collapsed":true,"id":"e1c5be26-6314-4986-a636-e5e9599ebb1f","title":"🔴【P0】新建文件与覆盖确认"}],"collapsed":true,"id":"a2462fc0-f81e-4f1a-bf6a-1bf4405e6489","title":"正常场景（1）"},{"parent":"67f7130a-ec7d-4e34-a0b9-cafd4ceebbce","callout":[],"children":[{"parent":"ac4d3ca8-dbea-4ba6-8cfe-7fe3c8423f1d","callout":[],"children":[{"parent":"087cc6c0-40a4-4710-84e7-f60a41348749","callout":[],"children":[],"id":"f7e3c62f-119b-49ac-8bca-0fb6654b9bd6","title":"前置：存在一个无写权限的目录"},{"parent":"087cc6c0-40a4-4710-84e7-f60a41348749","callout":[],"children":[],"id":"f71cf327-d0c2-44b2-b41f-4ef04d40ea9d","title":"操作：让 Agent 向该目录写入文件"},{"parent":"087cc6c0-40a4-4710-84e7-f60a41348749","callout":[],"children":[],"id":"2aad2c64-6a46-456a-86f9-b62d2f4b49fb","title":"预期：写入被拒绝并提示权限不足，不静默失败也不绕过权限"},{"parent":"087cc6c0-40a4-4710-84e7-f60a41348749","callout":[],"children":[],"id":"dacab4c0-0504-4ca1-8adb-16d28f27bbfe","title":"备注：附件3 CC-014"}],"collapsed":true,"id":"087cc6c0-40a4-4710-84e7-f60a41348749","title":"🟠【P1】只读目录下的写入"}],"collapsed":true,"id":"ac4d3ca8-dbea-4ba6-8cfe-7fe3c8423f1d","title":"异常场景（1）"},{"parent":"67f7130a-ec7d-4e34-a0b9-cafd4ceebbce","callout":[],"children":[{"parent":"efdfe662-40af-46d0-9fd0-542c458f20c6","callout":[],"children":[{"parent":"77b98385-72aa-474a-91d7-4c8b1f828457","callout":[],"children":[],"id":"3c7fd859-2def-41b4-bf48-36d2bc6f2f55","title":"前置：项目目录可写"},{"parent":"77b98385-72aa-474a-91d7-4c8b1f828457","callout":[],"children":[],"id":"2fc05ff3-9e7e-4994-a797-f44434bebdda","title":"操作：让 Agent 在包含中文和空格的目录路径下写入文件"},{"parent":"77b98385-72aa-474a-91d7-4c8b1f828457","callout":[],"children":[],"id":"a1d99841-54fb-4252-92c5-a5ea41428bef","title":"预期：文件写入到正确路径，路径解析不因中文或空格出错；文件卡片展示完整路径"},{"parent":"77b98385-72aa-474a-91d7-4c8b1f828457","callout":[],"children":[],"id":"7075fb03-8afa-4982-b793-23cf139bad3f","title":"备注：来源 附件3 CC-014；附件3 CC-014"}],"collapsed":true,"id":"77b98385-72aa-474a-91d7-4c8b1f828457","title":"🟡【P2】中文与空格路径写入"},{"parent":"efdfe662-40af-46d0-9fd0-542c458f20c6","callout":[],"children":[{"parent":"c009f745-d1e7-4f01-a334-9e87db3c4e84","callout":[],"children":[],"id":"b4af828c-b699-458a-8415-8b754b0dde99","title":"前置：项目目录可写"},{"parent":"c009f745-d1e7-4f01-a334-9e87db3c4e84","callout":[],"children":[],"id":"f0a6e049-7dc0-4142-af3f-190e46262e06","title":"操作：让 Agent 写入一个内容体量很大的文件"},{"parent":"c009f745-d1e7-4f01-a334-9e87db3c4e84","callout":[],"children":[],"id":"8edff190-c738-408b-bf6e-6ac77c544075","title":"预期：文件完整落盘内容不截断，卡片正常生成，界面不卡死"}],"collapsed":true,"id":"c009f745-d1e7-4f01-a334-9e87db3c4e84","title":"🟡【P2】写入超大内容的文件"}],"collapsed":true,"id":"efdfe662-40af-46d0-9fd0-542c458f20c6","title":"边界场景（2）"}],"collapsed":true,"id":"67f7130a-ec7d-4e34-a0b9-cafd4ceebbce","title":"Write 工具"},{"parent":"863084f9-96ed-43ab-a63c-b5b45a8604d6","callout":[],"children":[{"parent":"fd0341fb-55d7-45e1-a165-04e5f0a69a33","callout":[],"children":[{"parent":"465191cd-4f5c-403f-a6e0-402299eff43b","call