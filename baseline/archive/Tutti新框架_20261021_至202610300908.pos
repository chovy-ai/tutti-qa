375-096f1bd516b5","title":"操作：分别点击 png 和 zip 文件查看右侧详情"},{"parent":"8db0f444-4ed7-4f56-b04a-b026454f89ef","callout":[],"children":[],"id":"5782d06f-d33f-4a3e-9205-4d9468247b39","title":"预期：png 文件右侧显示预览图及名称、路径、修改时间、大小；zip 文件右侧展示文件信息但预览区显示暂不支持预览的占位说明，不显示加载失败或空白"}],"collapsed":true,"id":"8db0f444-4ed7-4f56-b04a-b026454f89ef","title":"🟠【P1】不支持预览的文件类型提示"}],"collapsed":true,"id":"375eeb57-59db-4bcc-839e-274714da21a8","title":"正常场景（1）"},{"parent":"d7c023bc-11dc-44db-ba86-d63702f23d4b","callout":[],"children":[{"parent":"3c7416c9-eee7-463b-be48-c85225f199f2","callout":[],"children":[{"parent":"1eca0098-c5e8-435c-a353-40f99948ca38","callout":[],"children":[],"id":"e3bf71e6-efce-4e4f-8ffa-fdf14cfaa455","title":"前置：前置：工作区中存在图片与文本文件；角色：房间成员；入口：工作区引用面板"},{"parent":"1eca0098-c5e8-435c-a353-40f99948ca38","callout":[],"children":[],"id":"fdc0a224-3f7c-49e2-abad-63116ad0e313","title":"操作：分别点击图片与文本文件查看右侧预览"},{"parent":"1eca0098-c5e8-435c-a353-40f99948ca38","callout":[],"children":[],"id":"cc6733eb-2de3-4c4b-8c5f-b4282b368979","title":"预期：支持预览的类型正常展示预览内容；不出现全部文件都提示无法预览；不支持预览的类型给出明确说明"},{"parent":"1eca0098-c5e8-435c-a353-40f99948ca38","callout":[],"children":[],"id":"013cf957-25cf-4289-a811-a7071d838026","title":"备注：#410"}],"collapsed":true,"id":"1eca0098-c5e8-435c-a353-40f99948ca38","title":"🔴【P0】工作区文件全部显示无法预览"}],"collapsed":true,"id":"3c7416c9-eee7-463b-be48-c85225f199f2","title":"异常场景（1）"},{"parent":"d7c023bc-11dc-44db-ba86-d63702f23d4b","callout":[],"children":[{"parent":"6956aef9-ba61-4c44-8d1a-d1e3203bfa6d","callout":[],"children":[{"parent":"fd18b597-bbc1-4608-9e6c-de4fc7108f4e","callout":[],"children":[],"id":"4d05c684-8945-454a-bfcd-0e4853bba5a5","title":"前置：工作区包含超大文件与二进制文件"},{"parent":"fd18b597-bbc1-4608-9e6c-de4fc7108f4e","callout":[],"children":[],"id":"7bfba852-555e-40ef-bffb-c8bb56ec30dd","title":"操作：分别预览这两类文件"},{"parent":"fd18b597-bbc1-4608-9e6c-de4fc7108f4e","callout":[],"children":[],"id":"5d1845d1-fcc8-48be-9883-c5ac8f51730f","title":"预期：超大文件截断预览并提示，二进制文件给出不可预览的说明而非乱码"}],"collapsed":true,"id":"fd18b597-bbc1-4608-9e6c-de4fc7108f4e","title":"🟡【P2】预览超大或二进制文件"}],"collapsed":true,"id":"6956aef9-ba61-4c44-8d1a-d1e3203bfa6d","title":"边界场景（1）"}],"collapsed":true,"id":"d7c023bc-11dc-44db-ba86-d63702f23d4b","title":"文件预览信息"},{"parent":"81e7db44-d1c6-4a04-a149-c60952bd3d6d","callout":[],"children":[{"parent":"25f87bf4-362e-4998-ac33-30090384b343","callout":[],"children":[{"parent":"1f4bb0f5-4a96-4637-ba4b-a5415cc26ca0","callout":[],"children":[{"parent":"b32df033-7cb9-4f5b-87fd-058194b99245","callout":[],"children":[],"id":"7a0f155f-9f15-4fd6-891f-85cc83444642","title":"前置：引用面板已打开且工作区有文件"},{"parent":"b32df033-7cb9-4f5b-87fd-058194b99245","callout":[],"children":[],"id":"b8968380-7eac-48ea-9591-f4b81be9611c","title":"操作：在搜索框输入文件名关键词"},{"parent":"b32df033-7cb9-4f5b-87fd-058194b99245","callout":[],"children":[],"id":"bfe64635-ee7e-4844-8d85-b568b7c8d233","title":"预期：结果与关键词匹配，可直接勾选引用"}],"collapsed":true,"id":"b32df033-7cb9-4f5b-87fd-058194b99245","title":"🔴【P0】按关键词搜索工作区文件"}],"collapsed":true,"id":"1f4bb0f5-4a96-4637-ba4b-a5415cc26ca0","title":"正常场景（1）"},{"parent":"25f87bf4-362e-4998-ac33-30090384b343","callout":[],"children":[{"parent":"c8f74ff2-d1b3-4c01-a9fd-e75dac3fcbd1","callout":[],"children":[{"parent":"f992fc23-219f-45dc-8578-a054e58ed263","callout":[],"children":[],"id":"2e4ac981-5fe3-4c7e-8f6e-7936e1a2336d","title":"前置：前置：工作区引用面板已打开；角色：房间成员；入口：面板搜索框"},{"parent":"f992fc23-219f-45dc-8578-a054e58ed263","callout":[],"children":[],"id":"2f9e4111-40e6-408c-a533-b927a44a06fd","title":"操作：分别输入单个字符 a、i 与一段普通关键词"},{"parent":"f992fc23-219f-45dc-8578-a054e58ed263","callout":[],"children":[],"id":"8f03b751-33c1-4e68-964d-a7ff837a13ae","title":"预期：单字符与多字符搜索均返回匹配结果；不提示加载内容失败请稍后重试；结果中展示的是文件名而非一串无意义字符"},{"parent":"f992fc23-219f-45dc-8578-a054e58ed263","callout":[],"children":[],"id":"06b8d433-2d7f-4a9b-b6b9-951e23a3c27f","title":"备注：#312 #409"}],"collapsed":true,"id":"f992fc23-219f-45dc-8578-a054e58ed263","title":"🔴【P0】搜索单字符时加载失败"}],"collapsed":true,"i