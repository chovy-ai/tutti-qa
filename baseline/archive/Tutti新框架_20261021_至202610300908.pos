-9b8e-65fd37658c49","callout":[],"children":[],"id":"9a614158-faaa-43ee-8046-4d30b0d68ffa","title":"预期：Agent 不把二进制内容错误当文本读取，必要时提示需要具体文件"}],"collapsed":true,"id":"ebe8070f-9a9b-427e-9b8e-65fd37658c49","title":"二进制文件项目"},{"parent":"3c15e78e-c450-4db2-8272-4b73918dd021","callout":[],"children":[{"parent":"26e439cc-a457-4dda-a435-fb05c0bc53ec","callout":[],"children":[],"id":"60671732-b985-4268-88b3-d42b0a1d3264","title":"操作：选择路径包含空格的项目并要求创建文件"},{"parent":"26e439cc-a457-4dda-a435-fb05c0bc53ec","callout":[],"children":[],"id":"e849ca49-0ad7-428d-ae25-73ee5ae0d91e","title":"预期：所有读写命令正确处理路径转义，不写入错误位置"}],"collapsed":true,"id":"26e439cc-a457-4dda-a435-fb05c0bc53ec","title":"项目路径含空格"},{"parent":"3c15e78e-c450-4db2-8272-4b73918dd021","callout":[],"children":[{"parent":"75e39539-3ebd-4a9d-835c-7a1c63c3e9ef","callout":[],"children":[],"id":"9c6161a4-624d-4456-aedf-6cfe8bca829c","title":"操作：项目中存在 readme.md 和 README.md 后询问指定文件"},{"parent":"75e39539-3ebd-4a9d-835c-7a1c63c3e9ef","callout":[],"children":[],"id":"6cec4a7a-4138-494b-8751-44dfdc8d8d49","title":"预期：Agent 区分或按本地文件系统规则准确读取目标文件"}],"collapsed":true,"id":"75e39539-3ebd-4a9d-835c-7a1c63c3e9ef","title":"大小写敏感文件"}],"collapsed":true,"id":"3c15e78e-c450-4db2-8272-4b73918dd021","title":"边界场景"}],"collapsed":true,"id":"e3548e30-114f-4a03-8767-cfb6f35c4ad1","title":"项目上下文读取"},{"parent":"79ff98d6-620b-4f47-9e54-df9e654d19e5","callout":[],"children":[{"parent":"7fbdbc2c-9f8a-4ec1-bf27-46adb7ad84b2","callout":[],"children":[{"parent":"878943d1-3fe8-4bf5-8aff-46043395614c","callout":[],"children":[{"parent":"ee1614b6-7a84-4261-9a6d-83acbb4474bf","callout":[],"children":[],"id":"875ced75-bcdd-469d-a37e-fe5a337b5d37","title":"操作：选择一个没有 CLAUDE.md 的项目，使用 Claude 类 Agent 新起会话"},{"parent":"ee1614b6-7a84-4261-9a6d-83acbb4474bf","callout":[],"children":[],"id":"aad42dbc-0c85-4254-820a-cede72499611","title":"预期：项目根目录不新建 CLAUDE.md，并写入产品约定的项目规则内容"}],"collapsed":true,"id":"ee1614b6-7a84-4261-9a6d-83acbb4474bf","title":"Claude 新会话不创建 CLAUDE.md"},{"pare