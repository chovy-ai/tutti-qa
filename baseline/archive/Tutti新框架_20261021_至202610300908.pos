12-99bd-a3df1f23cc35","callout":[],"children":[],"id":"8a0728df-ba57-48eb-ad08-40c6ae3ab34d","title":"前置：当前目录下有文件；角色：房间成员；入口：列表中的文件"},{"parent":"628971ca-1dbd-4312-99bd-a3df1f23cc35","callout":[],"children":[],"id":"08214080-fc61-46bf-a1dd-0df847f690f1","title":"操作：右键该文件并逐项核对菜单"},{"parent":"628971ca-1dbd-4312-99bd-a3df1f23cc35","callout":[],"children":[],"id":"0f881fc9-cf53-468c-9b38-db7cd43cfc71","title":"预期：\n1) 菜单展示 ｜ 菜单依次包含打开、下载、分享、重命名、复制路径、删除共六项，无多余项也无缺项\n2) 视觉展示 ｜ 删除项使用红色危险样式\n3) 菜单展示 ｜ 不出现文件夹菜单才有的上传与新建两类项"}],"collapsed":true,"id":"628971ca-1dbd-4312-99bd-a3df1f23cc35","title":"🔴【P0】文件菜单项完整性"}],"collapsed":true,"id":"6c1a194a-7d41-4aab-86ee-7545ab7a7348","title":"正常场景（1）"},{"parent":"8f3f559e-7f6e-473f-adf1-b24f41325e86","callout":[],"children":[{"parent":"c28c6ba6-8c8f-4a8a-8c92-33a3218284c1","callout":[],"children":[{"parent":"91ebd21f-957c-4816-8bfc-e26f3d294f3f","callout":[],"children":[],"id":"4866852b-8e35-4dca-88d7-7e6f46893fa7","title":"前置：文件位于窗口右侧或底部边缘；角色：房间成员；入口：列表"},{"parent":"91ebd21f-957c-4816-8bfc-e26f3d294f3f","callout":[],"children":[],"id":"a886026a-90f2-4f5a-b94b-b2236c763fcc","title":"操作：在该位置右键文件"},{"parent":"91ebd21f-957c-4816-8bfc-e26f3d294f3f","callout":[],"children":[],"id":"fdf0147a-766f-45f0-b543-5eca6a809d3d","title":"预期：\n1) 菜单展示 ｜ 菜单自动调整展示方向，八项全部完整可见，不被窗口边界或 Dock 遮挡"}],"collapsed":true,"id":"91ebd21f-957c-4816-8bfc-e26f3d294f3f","title":"🟡【P2】菜单靠近窗口边缘"},{"parent":"c28c6ba6-8c8f-4a8a-8c92-33a3218284c1","callout":[],"children":[{"parent":"6087c5e5-0291-46d1-a5cc-df9690f05439","callout":[],"children":[],"id":"d8cbe96f-b2d1-4d08-860d-1e5508031708","title":"前置：当前目录下有多个文件；角色：房间成员；入口：列表"},{"parent":"6087c5e5-0291-46d1-a5cc-df9690f05439","callout":[],"children":[],"id":"4636ba2e-32f9-42bc-8e75-6804d4b61f94","title":"操作：快速连续右键多个文件后点击其中一项操作"},{"parent":"6087c5e5-0291-46d1-a5cc-df9690f05439","callout":[],"children":[],"id":"118dc222-c941-4844-915d-206133533169","title":"预期：\n1) 结果校验 ｜ 菜单目标与最终右键的文件一致，不作用在之前右键过的文件上"}],"collapsed":true,"id":"6087c5e5-0291-46d1-a5cc-df9690f05439","title":"🟡【P2】快速连续右键多个文件"}],"collapsed":true,"id":"c28c6ba6-8c8f-4a8a-8c92-33a3218284c1","title":"边界场景（2）"}],"collapsed":true,"id":"8f3f559e-7f6e-473f-adf1-b24f41325e86","title":"文件菜单 · 菜单展示"},{"parent":"031c765e-01bb-4602-b294-2e83f67a74c2","callout":[],"children":[{"parent":"387b5bcf-8a6b-4db5-bdb1-d44ea5d4466c","callout":[],"children":[{"parent":"3dabdd54-8d65-4486-a945-201750e8108e","callout":[],"children":[{"parent":"bec2d3f5-67d3-4213-b9f7-a199a5ae17aa","callout":[],"children":[],"id":"e1cfd18f-c5a6-41d1-94bf-469a91e2e174","title":"前置：文件右键菜单已弹出；角色：房间成员；入口：菜单的打开项"},{"parent":"bec2d3f5-67d3-4213-b9f7-a199a5ae17aa","callout":[],"children":[],"id":"2d3dbe6a-cc5a-41c2-979f-69f0a85f4718","title":"操作：点击打开"},{"parent":"bec2d3f5-67d3-4213-b9f7-a199a5ae17aa","callout":[],"children":[],"id":"24a81e79-76f0-4832-ab0d-a63890f913fb","title":"预期：\n1) 产物预览 ｜ 使用对应查看器打开该文件，内容按类型正确渲染\n2) 目录导航 ｜ 当前目录状态保持，关闭后可返回原位置"}],"collapsed":true,"id":"bec2d3f5-67d3-4213-b9f7-a199a5ae17aa","title":"🔴【P0】打开文件"}],"collapsed":true,"id":"3dabdd54-8d65-4486-a945-201750e8108e","title":"正常场景（1）"},{"parent":"387b5bcf-8a6b-4db5-bdb1-d44ea5d4466c","callout":[],"children":[{"parent":"bacb0fae-c087-49f6-9831-1bac4ed5319c","callout":[],"children":[{"parent":"bada4b57-92ad-47ce-bcc0-42594169abc0","callout":[],"children":[],"id":"6ecbcfa2-4399-4007-9296-94aad99a0802","title":"前置：存在损坏文件与不支持预览格式的文件；角色：房间成员；入口：菜单的打开项"},{"parent":"bada4b57-92ad-47ce-bcc0-42594169abc0","callout":[],"children":[],"id":"dadd6b5a-c78d-4042-a569-d8f5a3774904","title":"操作：分别对这两个文件点击打开"},{"parent":"bada4b57-92ad-47ce-bcc0-42594169abc0","callout":[],"children":[],"id":"cf6e47fc-18fa-42b9-967f-6d730492c1a0","title":"预期：\n1) 提示文案 ｜ 展示无法打开或不支持预览的说明并提供下载入口\n2) 菜单展示 ｜ 菜单关闭，文件列表保持可操作"}],"collapsed":true,"id":"bada4b57-92ad-47ce-bcc0-42594169abc0","title":"🔴【P0】打开损坏或不支持预览的文件"},{"parent":"bacb0fae-c087-49f6-9831-1bac4ed5319c","callout":[],"children":[{"parent":"1fbff059-9a92-4d2e-a4ca-1aa1ae4aefbf","callout":[],"children":[],"id":"09aafa1e-22c2-47d5-8ea4-35aa70da0571","title":"前置：菜单已弹出，随后该文件在别处被删除；角色：房间成员；入口：菜单的打开项"},{"parent":"1fbff059-9a92-4d2e-a4ca-1aa1ae4aefbf","callout":[],"children":[],"id":"4a6c3f6a-2dad-405f-a437-99d9d285672a","title":"操作：点击打开"},{"parent":"1fbff059-9a92-4d2e-a4ca-1aa1ae4aefbf","callout":[],"children":[],"id":"59410249-2f0f-43e4-b2ba-a3782f794fe2","title":"预期：\n1) 提示文案 ｜ 提示文件不存在并刷新列表\n2) 列表展示 ｜ 右侧详情面板同步清空或更新为当前实际状态"}],"collapsed":true,"id":"1fbff059-9a92-4d2e-a4ca-1aa1ae4aefbf","title":"🔴【P0】打开时文件已不存在"}],"collapsed":true,"id":"bacb0fae-c087-49f6-9831-1bac4ed5319c","title":"异常场景（2）"},{"parent":"387b5bcf-8a6b-4db5-bdb1-d44ea5d4466c","callout":[],"children":[{"parent":"e11322db-cc4f-4b46-a310-900bfa988254","callout":[],"children":[{"parent":"2a4227ba-65b3-4d17-8248-0854651c65f6","callout":[],"children":[],"id":"8944c41c-69b9-4e9e-9de3-9c9191fead5a","title":"前置：存在大于 1GB 的文件与 0 字节文件；角色：房间成员；入口：菜单的打开项"},{"parent":"2a4227ba-65b3-4d17-8248-0854651c65f6","callout":[],"children":[],"id":"a3102197-fcb2-4c25-a476-74d518f82098","title":"操作：分别打开这两个文件"},{"parent":"2a4227ba-65b3-4d17-8248-0854651c65f6","callout":[],"children":[],"id":"04aeb9cf-a6f9-4173-b64f-0c5cec0cc324","title":"预期：\n1) 性能 ｜ 大文件按产品定义提示处理方式，不阻塞整个文件窗口\n2) 产物预览 ｜ 零字节文件打开空内容视图或提示文件为空"}],"collapsed":true,"id":"2a4227ba-65b3-4d17-8248-0854651c65f6","title":"🟡【P2】打开大文件与零字节文件"}],"collapsed":true,"id":"e11322db-cc4f-4b46-a310-900bfa988254","title":"边界场景（1）"}],"collapsed":true,"id":"387b5bcf-8a6b-4db5-bdb1-d44ea5d4466c","title":"文件菜单 · 打开"},{"parent":"031c765e-01bb-4602-b294-2e83f67a74c2","callout":[],"lineStyle":{},"children":[{"parent":"dd2e016b-6c50-452d-b81e-edb553434d60","callout":[],"children":[{"parent":"7b76151d-29e2-489a-a838-4c5a0114ae94","callout":[],"children":[{"parent":"ec75495f-19f9-4e81-9a6e-0e6c4a388e16","callout":[],"children":[],"id":"2661f2f5-d085-4699-a92b-384ff5843cbb","title":"前置：文件右键菜单已弹出；角色：房间成员；入口：菜单的下载项"},{"parent":"ec75495f-19f9-4e81-9a6e-0e6c4a388e16","callout":[],"children":[],"id":"4e507bc5-2032-48cf-a8ff-8d46312bf962","title":"操作：点击下载，在保存弹窗中修改名称与位置后保存"},{"parent":"ec75495f-19f9-4e81-9a6e-0e6c4a388e16","callout":[],"children":[],"id":"70b46ade-7837-4111-ad90-fc42e7129507","title":"预期：\n1) 提示文案 ｜ 弹出保存弹窗，可修改名称与保存位置\n2) 产物预览 ｜ 保存后按原格式下载成功，文件内容与线上一致"}],"collapsed":true,"id":"ec75495f-19f9-4e81-9a6e-0e6c4a388e16","title":"🔴【P0】下载文件"}],"collapsed":true,"id":"7b76151d-29e2-489a-a838-4c5a0114ae94","title":"正常场景（1）"},{"parent":"dd2e016b-6c50-452d-b81e-edb553434d60","callout":[],"children":[{"parent":"a967c1c2-302c-4693-bdef-2a996c498d4b","callout":[],"children":[{"parent":"ddb5764c-3841-431d-a248-2d987a62edaf","callout":[],"children":[],"id":"800f39a1-d954-410c-a655-0f6867a926ad","title":"前置：构造下载中断；角色：房间成员；入口：菜单的下载项"},{"parent":"ddb5764c-3841-431d-a248-2d987a62edaf","callout":[],"children":[],"id":"7073f481-7513-4d4a-804b-a8e9383461b9","title":"操作：点击下载并在过程中构造失败，再重试"},{"parent":"ddb5764c-3841-431d-a248-2d987a62edaf","callout":[],"children":[],"id":"322fc5ec-991c-4587-ab44-490da80d9410","title":"预期：\n1) 提示文案 ｜ 提示下载失败并说明原因\n2) 恢复重试 ｜ 重试后可正常完成，本地不留下不完整文件"}],"collapsed":true,"id":"ddb5764c-3841-431d-a248-2d987a62edaf","title":"🟠【P1】下载失败与重试"}],"collapsed":true,"id":"a967c1c2-302c-4693-bdef-2a996c498d4b","title":"异常场景（1）"}],"collapsed":true,"style":{"background":"#E7EBED"},"id":"dd2e016b-6c50-452d-b81e-edb553434d60","title":"文件菜单 · 下载"},{"parent":"031c765e-01bb-4602-b294-2e83f67a74c2","callout":[],"children":[{"parent":"2b86c63f-d4af-4de9-ae4c-10008b7633b0","callout":[],"children":[{"parent":"0df94997-9c5e-48cc-970d-5839b483cdae","callout":[],"children":[{"parent":"38e6a420-38ba-4c65-8fd7-bd5b9c0db241","callout":[],"children":[],"id":"bc4c9a70-01b7-47b4-9eb2-966e0e3fbe17","title":"前置：文件右键菜单已弹出；角色：房间成员；入口：菜单的分享项"},{"parent":"38e6a420-38ba-4c65-8fd7-bd5b9c0db241","callout":[],"children":[],"id":"43a53de9-36f9-4ea6-925c-aa5508f20375","title":"操作：点击分享"},{"parent":"38e6a420-38ba-4c65-8fd7-bd5b9c0db241","callout":[],"children":[],"id":"f87771fc-2d7f-4f66-9100-0ff463acdb8d","title":"预期：\n1) 面板开关 ｜ 弹出分享弹窗，标题带出该文件名\n2) 可见范围 ｜ 可见范围选项与可选值和其他入口一致"},{"parent":"38e6a420-38ba-4c65-8fd7-bd5b9c0db241","callout":[],"children":[],"id":"a0461c78-e975-4b4c-a407-f5511779375d","title":"备注：分享弹窗内的可见范围、关联会话与分享结果等断言见分享子模块，此处只验入口"}],"collapsed":true,"id":"38e6a420-38ba-4c65-8fd7-bd5b9c0db241","title":"🔴【P0】从文件菜单发起分享"},{"parent":"0df94997-9c5e-48cc-970d-5839b483cdae","callout":[],"children":[{"parent":"7346ebd2-0cce-4c72-881d-be2d9e823772","callout":[],"children":[],"id":"d6d31791-b575-494c-8233-6025b10fb791","title":"前置：同一个文件可从行内分享图标、右键菜单分享、详情面板分享三处进入；角色：房间成员；入口：三处"},{"parent":"7346ebd2-0cce-4c72-881d-be2d9e823772","callout":[],"children":[],"id":"74cb6a08-39db-4daf-8c4f-a68b8beedd3e","title":"操作：分别从三处打开分享弹窗"},{"parent":"7346ebd2-0cce-4c72-881d-be2d9e823772","callout":[],"children":[],"id":"b96b686a-075e-424b-b28a-1aab81268f28","title":"预期：\n1) 结果校验 ｜ 三处弹窗内容与可选项完全一致，指向同一条分享记录"}],"collapsed":true,"id":"7346ebd2-0cce-4c72-881d-be2d9e823772","title":"🟠【P1】三个分享入口的一致性"},{"parent":"0df94997-9c5e-48cc-970d-5839b483cdae","callout":[],"children":[],"id":"43c57e96-25a2-4d7e-ab6f-fd79fc920075","title":"测试用例见文件/文件夹分享"}],"collapsed":true,"id":"0df94997-9c5e-48cc-970d-5839b483cdae","title":"正常场景（2）"}],"collapsed":true,"id":"2b86c63f-d4af-4de9-ae4c-10008b7633b0","title":"文件菜单 · 分享"},{"parent":"031c765e-01bb-4602-b294-2e83f67a74c2","callout":[],"lineStyle":{},"children":[{"parent":"3def4154-bec9-46a7-ad4f-f53bc6ab3e55","callout":[],"children":[{"parent":"419255cd-360c-4a5a-8ef0-aa3bef33a011","callout":[],"children":[{"parent":"c9b5ae35-feda-4af5-8763-78a4a2da3204","callout":[],"children":[],"id":"bbf7b1a0-af2f-46dc-979d-dcf9dc545cbf","title":"前置：文件右键菜单已弹出；角色：房间成员；入口：菜单的重命名项"},{"parent":"c9b5ae35-feda-4af5-8763-78a4a2da3204","callout":[],"children":[],"id":"208e37db-e0cd-4cc7-856c-30ebf60f2d13","title":"操作：点击重命名并输入新名称确认"},{"parent":"c9b5ae35-feda-4af5-8763-78a4a2da3204","callout":[],"children":[],"id":"51edead1-e3c6-411e-9cc5-0307151c2c20","title":"预期：\n1) 文件落盘 ｜ 重命名成功，列表与右侧详情面板同步更新为新名称\n2) 文件落盘 ｜ 本地对应文件按产品定义同步更名"}],"collapsed":true,"id":"c9b5ae35-feda-4af5-8763-78a4a2da3204","title":"🔴【P0】重命名文件"}],"collapsed":true,"id":"419255cd-360c-4a5a-8ef0-aa3bef33a011","title":"正常场景（1）"},{"parent":"3def4154-bec9-46a7-ad4f-f53bc6ab3e55","callout":[],"children":[{"parent":"9de0a5c8-668f-4676-9ca9-874e7f44acf0","callout":[],"children":[{"parent":"715f87a8-5d2c-4314-af79-2ca8e694498e","callout":[],"children":[],"id":"b7822d5f-c932-463d-8a24-34c581477b32","title":"前置：同级目录下已存在目标名称；角色：房间成员；入口：菜单的重命名项"},{"parent":"715f87a8-5d2c-4314-af79-2ca8e694498e","callout":[],"children":[],"id":"c4211653-ab1c-4fd6-8184-536e8395db23","title":"操作：把文件改名为该已有名称"},{"parent":"715f87a8-5d2c-4314-af79-2ca8e694498e","callout":[],"children":[],"id":"0cd45d72-0d26-4780-86c1-e9fea2613e74","title":"预期：\n1) 提示文案 ｜ 提示已存在同名文件或文件夹\n2) 副作用 ｜ 原名称保持不变"}],"collapsed":true,"id":"715f87a8-5d2c-4314-af79-2ca8e694498e","title":"🔴【P0】文件重命名为同级已有名称"},{"parent":"9de0a5c8-668f-4676-9ca9-874e7f44acf0","callout":[],"children":[{"parent":"0455f51b-1070-4628-b656-b31b941d5cdd","callout":[],"children":[],"id":"e985a2d3-6b23-47b6-a5a4-c295d45be60c","title":"前置：文件重命名输入框已打开；角色：房间成员；入口：名称输入框"},{"parent":"0455f51b-1070-4628-b656-b31b941d5cdd","callout":[],"children":[],"id":"d102f9b0-a561-497b-9ea3-a4742c3aec0d","title":"操作：把一个 .md 文件改名为 .png 后确认"},{"parent":"0455f51b-1070-4628-b656-b31b941d5cdd","callout":[],"children":[],"id":"07866dab-57d3-46eb-ab50-797642987516","title":"预期：\n1) 提示文案 ｜ 按产品定义给出扩展名变更提示或直接允许，行为一致\n2) 搜索筛选 ｜ 改名后该文件在类型筛选中归入新扩展名对应的分类"},{"parent":"0455f51b-1070-4628-b656-b31b941d5cdd","callout":[],"children":[],"id":"440e0235-df9d-4445-ac20-82555dca0b1d","title":"备注：改扩展名是否给提示需产品确认"}],"collapsed":true,"id":"0455f51b-1070-4628-b656-b31b941d5cdd","title":"🟠【P1】重命名时改变扩展名"}],"collapsed":true,"id":"9de0a5c8-668f-4676-9ca9-874e7f44acf0","title":"异常场景（2）"}],"collapsed":true,"style":{"background":"#E7EBED"},"id":"3def4154-bec9-46a7-ad4f-f53bc6ab3e55","title":"文件菜单 · 重命名"},{"parent":